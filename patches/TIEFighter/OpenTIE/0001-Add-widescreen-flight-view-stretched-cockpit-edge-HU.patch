+/* Widescreen stretch of classic cockpit frames for the frame being prepared
+ * (TieFlightHud_CockpitStretchX); 1 keeps the centered 4:3 frame. */
+static float s_cockpit_stretch_x = 1.0f;
+/* Horizontal shift of the current forward-view HUD widget toward its screen
+ * edge (widescreen_hud); applied by every draw-space blit. */
+static float s_widget_shift_x = 0.0f;
+/* Pixels the forward-view (cockpit-off) HUD moves outward on each side: the
+ * width of the side area beyond the 4:3 frame; 0 when not spreading. */
+static float s_hud_spread_px = 0.0f;
+
+/* Outward shift for forward-view HUD content centered at coord-frame x:
+ * the left and right groups move to the screen edges, the center stays. */
+static float TieCockpitRenderer_SpreadShift(float coord_x, int coord_w) {
+	if (s_hud_spread_px <= 0.0f || coord_w <= 0)
+		return 0.0f;
+	if (coord_x < (float)coord_w * 0.4f)
+		return -s_hud_spread_px;
+	if (coord_x > (float)coord_w * 0.6f)
+		return s_hud_spread_px;
