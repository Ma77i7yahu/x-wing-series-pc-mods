+#ifdef TIE_MODERN
+/* X-Wing Alliance style convergence: aim a player's cannon bolt from its
+ * hardpoint at a point straight ahead of the craft instead of parallel to the
+ * nose. The point lies at the current target's range along the nose while the
+ * target is within about 30 degrees and 0.1-2.5 km ahead, otherwise at
+ * flight.laser_convergence metres. With no target selected the bolt keeps the
+ * original parallel path. */
+static void laser_convergeplayerbolt(const FlightObject* shooter, FlightObject* bolt, int32_t length) {
+	enum { UNITS_PER_KM = 40706, COS_30_Q15 = 28378 }; /* panel_outputdistance: units * 161 >> 16 = km/100 */
+	const int metres = TieFlightTweaks_LaserConvergenceMetres();
+	const uint16_t target = pstate.target_obj_idx;
+	int64_t tx, ty, tz;
+	if (metres <= 0 || target == 0xFFFF)
+		return;
+	if (target < NUM_OBJECTS) {
+		if (!objects[target].ship_idx)
+			return;
+		tx = objects[target].world_x;
+		ty = objects[target].world_y;
+		tz = objects[target].world_z;
+	} else if (target >= OBJ_REF_STATIC_BASE && target < OBJ_REF_WAYPOINT_BASE) {
+		if (!staticobjects[target - OBJ_REF_STATIC_BASE].species)
+			return;
+		tx = (int64_t)staticobjects[target - OBJ_REF_STATIC_BASE].world_x * 256;
+		ty = (int64_t)staticobjects[target - OBJ_REF_STATIC_BASE].world_y * 256;
+		tz = (int64_t)staticobjects[target - OBJ_REF_STATIC_BASE].world_z * 256;
+	} else {
+		return;
+	}
+
+	int64_t distance = (int64_t)metres * UNITS_PER_KM / 1000;
+	{
+		const int64_t dx = tx - shooter->world_x, dy = ty - shooter->world_y, dz = tz - shooter->world_z;
+		const int64_t along = (dx * shooter->fwd_x + dy * shooter->fwd_y + dz * shooter->fwd_z) >> 15;
+		const double range = sqrt((double)dx * dx + (double)dy * dy + (double)dz * dz);
+		if (along >= UNITS_PER_KM / 10 && along <= UNITS_PER_KM * 5 / 2 && range > 0.0 &&
+			(double)along * 32768.0 >= COS_30_Q15 * range)
+			distance = along;
+	}
+
+	/* The muzzle is the hardpoint position; the bolt starts `length` ahead of it. */
+	const int32_t muzzle_x = bolt->world_x_prev, muzzle_y = bolt->world_y_prev, muzzle_z = bolt->world_z_prev;
+	const int64_t vx = shooter->world_x + ((distance * shooter->fwd_x) >> 15) - muzzle_x;
+	const int64_t vy = shooter->world_y + ((distance * shooter->fwd_y) >> 15) - muzzle_y;
+	const int64_t vz = shooter->world_z + ((distance * shooter->fwd_z) >> 15) - muzzle_z;
+	const double v_len = sqrt((double)vx * vx + (double)vy * vy + (double)vz * vz);
+	if (!(v_len > 0.0))
+		return;
+	trig2_ctop((int32_t)vx, (int32_t)vy, (int32_t)vz);
+	bolt->heading = trig2_xyangle;
+	bolt->pitch = trig2_zangle;
+	bolt->orient_dirty = 1;
+	bolt->move_dirty = 1;
+	bolt->world_x = muzzle_x + (int32_t)lround((double)vx * length / v_len);
+	bolt->world_y = muzzle_y + (int32_t)lround((double)vy * length / v_len);
+	bolt->world_z = muzzle_z + (int32_t)lround((double)vz * length / v_len);
+}
+#endif
