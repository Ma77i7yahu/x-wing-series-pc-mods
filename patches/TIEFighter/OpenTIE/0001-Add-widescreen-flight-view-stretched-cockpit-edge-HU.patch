+/* Horizontal stretch applied to the classic 4:3 cockpit art (and its PIP
+ * display) so it spans a wider render target; 1 when not stretched. Views
+ * without cockpit art (18 panel hidden, 19 forward HUD) keep the 4:3 frame. */
+static inline float TieFlightHud_CockpitStretchX(const TieSnapshot* snap, int target_w, int target_h) {
+	if (!snap || target_w <= 0 || target_h <= 0 || !TieFlightTweaks_CockpitStretch())
+		return 1.0f;
+	if (snap->cockpit.view_idx == 18 || snap->cockpit.view_idx == 19 || !snap->cockpit.view_name[0])
+		return 1.0f;
+	const int w = snap->cockpit.classic_w, h = snap->cockpit.classic_h;
+	if (!((w == 320 && h == 200) || (w == 640 && h == 480)))
+		return 1.0f;
+	const float stretch = ((float)target_w / (float)target_h) / (4.0f / 3.0f);
+	return stretch > 1.0f ? stretch : 1.0f;
+}
