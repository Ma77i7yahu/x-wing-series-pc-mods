+
+/* flight.xvt_hud: X-Wing vs TIE Fighter's craft lists and damage display.
+ * See xvt_mfd.c. */
+enum { TIE_XVT_LIST_CLOSED = 0, TIE_XVT_LIST_FRIENDLY = 1, TIE_XVT_LIST_ENEMY = 2 };
+
+/* Closes both; called when the player's craft is created. */
+void TieXvtMfd_Reset(void);
+/* F, Shift+F, D, Up, Down and Enter (inputkey codes). True when the key was
