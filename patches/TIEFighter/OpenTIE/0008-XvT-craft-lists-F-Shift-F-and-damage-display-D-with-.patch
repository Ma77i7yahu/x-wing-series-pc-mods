diff --git a/src/tie/xvt_mfd.c b/src/tie/xvt_mfd.c
new file mode 100644
index 0000000..c5f21ff
--- /dev/null
+++ b/src/tie/xvt_mfd.c
@@ -0,0 +1,384 @@
+/* flight.xvt_hud: X-Wing vs TIE Fighter's craft lists (F friendly, Shift+F
+ * enemy; Mfd_DrawCraftListPage) and damage display (D; Damage_DisplayMfdPage).
+ *
+ * The lists and the damage display share Up / Down: the one opened last has
+ * them, and the damage display gets them back when the lists close. Enter
+ * on the damage display moves the highlighted system to the head of the
+ * repair queue, as the damage room does. State changes only from keys, so
+ * flight recordings replay the same repair order. The cockpit renderer
+ * draws what TieXvtMfd_Capture puts in the HUD snapshot. */
+#include "tie/xvt_mfd.h"
+
+#include "tie/collide.h"
+#include "tie/msg.h"
+#include "tie/msg_templates.h"
+#include "tie/panel.h"
+#include "tie/spec.h"
+#include "tie/tie.h"
+#include "tie_runtime/hooks/flight_tweaks.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { NUM_SYSTEMS = 10, TARGETING_SYSTEM = 5, LIST_ROWS = 8 };
+
+static int s_list_mode;
+static unsigned s_list_top;
+static int s_damage_open;
+static int s_damage_has_arrows;
+static int s_damage_selected = -1;
+
+/* XvT's names (strings.txt lines 14-23) for TIE's systems; XvT has no
+ * beam or communications system, so those keep TIE's wording. */
+static const char* const k_system_names[NUM_SYSTEMS] = {
+	"Auto-Ejection", "Hyperdrive",		   "Cannon System", "Flight Controls", "Engines",
+	"Targeting Computer", "Shield System", "Warhead Launcher", "Beam System", "Comm System",
+};
+
+void TieXvtMfd_Reset(void) {
+	s_list_mode = TIE_XVT_LIST_CLOSED;
+	s_list_top = 0;
+	s_damage_open = 0;
+	s_damage_has_arrows = 0;
+	s_damage_selected = -1;
+}
+
+static bool TieXvtMfd_TargetingWorks(void) { return pstate.subsystem_health_percent[TARGETING_SYSTEM] != 0; }
+
+/* Systems knocked out (health 0) and fitted, in repair order. */
+static unsigned TieXvtMfd_DamagedSystems(uint8_t systems[NUM_SYSTEMS]) {
+	uint8_t by_rank[NUM_SYSTEMS];
+	unsigned count = 0;
+	memset(by_rank, 0xFF, sizeof by_rank);
+	for (unsigned i = 0; i < NUM_SYSTEMS; ++i)
+		if (pstate.subsystem_repair_priority[i] < NUM_SYSTEMS)
+			by_rank[pstate.subsystem_repair_priority[i]] = (uint8_t)i;
+	for (unsigned rank = 0; rank < NUM_SYSTEMS; ++rank) {
+		uint8_t sys = by_rank[rank];
+		if (sys < NUM_SYSTEMS && !pstate.subsystem_health_percent[sys] && pstate.player_craft &&
+			(pstate.player_craft->subsystem_active & (uint16_t)systemmask[sys]))
+			systems[count++] = sys;
+	}
+	return count;
+}
+
+static int TieXvtMfd_DamageSelected(void) {
+	uint8_t systems[NUM_SYSTEMS];
+	unsigned count = TieXvtMfd_DamagedSystems(systems);
+	for (unsigned i = 0; i < count; ++i)
+		if (systems[i] == s_damage_selected)
+			return s_damage_selected;
+	return count ? systems[0] : -1;
+}
+
+static bool TieXvtMfd_DamageHasKeys(void) {
+	return s_damage_open && (s_damage_has_arrows || s_list_mode == TIE_XVT_LIST_CLOSED);
+}
+
+static void TieXvtMfd_ToggleList(int mode) {
+	/* Both lists need the targeting computer, as in XvT. */
+	if (!TieXvtMfd_TargetingWorks()) {
+		argtable[0] = damagemsg[TARGETING_SYSTEM];
+		argtable[1] = MSG_SYS_DAMAGED;
+		msg_messageprintf(MSG_SYSTEM_STATUS);
+		return;
+	}
+	s_list_mode = s_list_mode == mode ? TIE_XVT_LIST_CLOSED : mode;
+	s_list_top = 0;
+	s_damage_has_arrows = 0;
+}
+
+static void TieXvtMfd_ToggleDamage(void) {
+	uint8_t systems[NUM_SYSTEMS];
+	if (s_damage_open) {
+		s_damage_open = 0;
+		s_damage_has_arrows = 0;
+		s_damage_selected = -1;
+	} else if (!TieXvtMfd_DamagedSystems(systems)) {
+		msg_messagetext(MSG_SYSTEM_STATUS, "All systems operational");
+	} else {
+		s_damage_open = 1;
+		s_damage_has_arrows = 1;
+		s_damage_selected = systems[0];
+	}
+}
+
+/* Damage_FindAdjacentDamagedSystem: the next or previous damaged system in
+ * repair order, wrapping. */
+static void TieXvtMfd_MoveDamageSelection(int step) {
+	uint8_t systems[NUM_SYSTEMS];
+	unsigned count = TieXvtMfd_DamagedSystems(systems), at = 0;
+	int selected = TieXvtMfd_DamageSelected();
+	if (!count)
+		return;
+	while (at < count && systems[at] != selected)
+		++at;
+	s_damage_selected = systems[(at + count + (step < 0 ? count - 1 : 1)) % count];
+}
+
+/* damage_damageroom's Enter: the highlighted system ranks first and the
+ * ones ahead of it move down one. */
+static void TieXvtMfd_RepairSelectedFirst(void) {
+	int selected = TieXvtMfd_DamageSelected();
+	if (selected < 0)
+		return;
+	uint8_t top = pstate.subsystem_repair_priority[selected];
+	for (unsigned i = 0; i < NUM_SYSTEMS; ++i)
+		if (top > pstate.subsystem_repair_priority[i])
+			pstate.subsystem_repair_priority[i]++;
+	pstate.subsystem_repair_priority[selected] = 0;
+	s_damage_selected = selected;
+}
+
+bool TieXvtMfd_HandleKey(uint16_t key) {
+	if (!TieFlightTweaks_XvtHud())
+		return false;
+	switch (key) {
+		case 'f':
+			TieXvtMfd_ToggleList(TIE_XVT_LIST_FRIENDLY);
+			return true;
+		case 'F':
+			TieXvtMfd_ToggleList(TIE_XVT_LIST_ENEMY);
+			return true;
+		case 'd':
+			TieXvtMfd_ToggleDamage();
+			return true;
+		case 3: /* Up */
+			if (TieXvtMfd_DamageHasKeys())
+				TieXvtMfd_MoveDamageSelection(-1);
+			else if (s_list_mode && s_list_top)
+				--s_list_top;
+			return s_list_mode || s_damage_open;
+		case 4: /* Down; the capture clamps it to the rows there are. */
+			if (TieXvtMfd_DamageHasKeys())
+				TieXvtMfd_MoveDamageSelection(1);
+			else if (s_list_mode)
+				++s_list_top;
+			return s_list_mode || s_damage_open;
+		case 13: /* Enter: instead of matching speed while the display has the keys. */
+			if (TieXvtMfd_DamageHasKeys()) {
+				TieXvtMfd_RepairSelectedFirst();
+				return true;
+			}
+			return false;
+		default:
+			return false;
+	}
+}
+
+/* ---- Capture ---- */
+
+/* 0 friendly, 1 enemy (as the R key judges it), 2 neither. */
+static int TieXvtMfd_Relation(uint16_t obj) {
+	uint8_t mine = objects[pstate.object_idx].side, side = objects[obj].side;
+	if (side == mine || ((side == 1 || side == 4) && (mine == 1 || mine == 4)))
+		return 0;
+	if ((side == 2 && (int8_t)mission_file_header.mission.neutral_name[0][0] != '1') ||
+		(side == 3 && (int8_t)mission_file_header.mission.neutral_name[1][0] != '1') ||
+		(side == 5 && (int8_t)mission_file_header.mission.neutral_name[3][0] != '1'))
+		return 2;
+	return 1;
+}
+
+/* panel_buildobjectname's flight-group-name color for a side. */
+static uint8_t TieXvtMfd_SideColor(uint8_t side) {
+	return side == 0 ? 0x52 : side == 1 || side == 4 ? 0x4A : side == 2 ? 0x46 : 0x56;
+}
+
+static bool TieXvtMfd_Listed(uint16_t obj) {
+	if (obj >= NUM_CRAFTS || !objects[obj].ship_idx || objects[obj].category || !objects[obj].craft_ptr)
+		return false;
+	/* Craft in hangars or hyperspace drop out, as from the R key. */
+	uint8_t ff = objects[obj].craft_ptr->flight_flag;
+	return !ff || ff == 6;
+}
+
+/* XvT title case: all-capital words keep their first letter only. */
+static void TieXvtMfd_TitleCase(char* text) {
+	for (char* word = text; *word;) {
+		char* end = word;
+		bool letters = true, upper = true;
+		while (*end && *end != ' ') {
+			letters = letters && isalpha((unsigned char)*end);
+			upper = upper && !islower((unsigned char)*end);
+			++end;
+		}
+		if (letters && upper && end - word >= 2 && !(end - word == 3 && !strncmp(word, "TIE", 3)))
+			for (char* c = word + 1; c < end; ++c)
+				*c = (char)tolower((unsigned char)*c);
+		word = *end ? end + 1 : end;
+	}
+}
+
+/* Mfd_BuildScratchCraftListName: flight group and craft number, 9 characters. */
+static void TieXvtMfd_ListName(uint16_t obj, char* out, size_t capacity) {
+	const EFGStruct* fg = &fg_array[objects[obj].fg_idx];
+	char name[sizeof fg->name + 1] = { 0 }, text[32];
+	memcpy(name, fg->name, sizeof fg->name);
+	if ((int8_t)fg->count > 1)
+		snprintf(text, sizeof text, "%s %d", name, objects[obj].craft_ptr->craft_idx_in_fg + 1);
+	else
+		snprintf(text, sizeof text, "%s", name);
+	snprintf(out, capacity < 10 ? capacity : 10, "%s", text);
+	TieXvtMfd_TitleCase(out);
+}
+
+/* Any object's name without color escapes. */
+static void TieXvtMfd_ObjectName(uint16_t obj, char* out, size_t capacity) {
+	char saved[sizeof tempstring];
+	size_t n = 0;
+	memcpy(saved, tempstring, sizeof saved);
+	panel_buildobjectname(obj, 3);
+	for (const char* p = tempstring; *p && n + 1 < capacity; ++p) {
+		if ((uint8_t)*p == 0xFE) {
+			if (!p[1])
+				break;
+			++p;
+			continue;
+		}
+		out[n++] = *p;
+	}
+	out[n] = 0;
+	memcpy(tempstring, saved, sizeof saved);
+	TieXvtMfd_TitleCase(out);
+}
+
+static int8_t TieXvtMfd_Percent(int32_t value, int32_t maximum) {
+	if (maximum <= 0)
+		return -1;
+	if (value < 0)
+		value = 0;
+	int32_t pct = (value * 100 + maximum / 2) / maximum;
+	return (int8_t)(pct > 127 ? 127 : pct);
+}
+
+/* Mfd_GetFlightGroupGoalStatusStringId: the flight group's primary goal
+ * while it is still to do. */
+static const char* TieXvtMfd_GoalWord(uint16_t obj) {
+	uint8_t fg = objects[obj].fg_idx;
+	if (fgstatus[fg].primary_status == 1 || fgstatus[fg].primary_status == 2)
+		return "";
+	switch ((int8_t)fg_array[fg].pri_win_cond) {
+		case 2:
+			return "Destroy";
+		case 3:
+			return "Attack";
+		case 4:
+			return "Capture";
+		case 5:
+			return objects[obj].craft_ptr->inspected ? "" : "Inspect";
+		case 6:
+			return "Board";
+		case 8:
+			return "Disable";
+		default:
+			return "";
+	}
+}
+
+static void TieXvtMfd_CaptureList(TieHudState* hud) {
+	uint16_t rows[NUM_CRAFTS];
+	unsigned count = 0;
+	if (s_list_mode == TIE_XVT_LIST_CLOSED)
+		return;
+	if (!TieXvtMfd_TargetingWorks()) {
+		s_list_mode = TIE_XVT_LIST_CLOSED;
+		return;
+	}
+	if (s_list_mode == TIE_XVT_LIST_ENEMY) {
+		/* Only the craft a pilot fights: fighters, transports and shuttles. */
+		for (uint16_t i = 0; i < NUM_CRAFTS; ++i)
+			if (TieXvtMfd_Listed(i) && TieXvtMfd_Relation(i) == 1 &&
+				(objects[i].genus == GENUS_FIGHTER || objects[i].genus == GENUS_TRANSPORT))
+				rows[count++] = i;
+	} else {
+		/* The player's own flight group first, then the others in mission order. */
+		unsigned own = objects[pstate.object_idx].fg_idx;
+		for (int pass = 0; pass <= (int)mission_file_header.num_fg; ++pass) {
+			unsigned fg = pass == 0 ? own : (unsigned)pass - 1;
+			if (pass && fg == own)
+				continue;
+			for (uint16_t i = 0; i < NUM_CRAFTS; ++i)
+				if (TieXvtMfd_Listed(i) && TieXvtMfd_Relation(i) != 1 && objects[i].fg_idx == fg)
+					rows[count++] = i;
+		}
+	}
+	/* XvT groups rows by team, keeping their order within each. */
+	for (unsigned i = 1; i < count; ++i)
+		for (unsigned j = i; j > 0 && objects[rows[j]].side < objects[rows[j - 1]].side; --j) {
+			uint16_t t = rows[j];
+			rows[j] = rows[j - 1];
+			rows[j - 1] = t;
+		}
+	if (s_list_top + LIST_ROWS > count)
+		s_list_top = count > LIST_ROWS ? count - LIST_ROWS : 0;
+
+	hud->xvt_list_mode = (uint8_t)s_list_mode;
+	for (unsigned i = s_list_top; i < count && hud->xvt_list_count < LIST_ROWS; ++i) {
+		uint16_t obj = rows[i];
+		const CraftData* cp = objects[obj].craft_ptr;
+		__typeof__(hud->xvt_list_rows[0])* row = &hud->xvt_list_rows[hud->xvt_list_count++];
+		TieXvtMfd_ListName(obj, row->name, sizeof row->name);
+		row->name_color = TieXvtMfd_SideColor(objects[obj].side);
+		row->shield_pct = TieXvtMfd_Percent(cp->forward_shield + cp->rear_shield,
+											2 * spec_data[cp->species_idx].shield_points);
+		row->hull_pct = TieXvtMfd_Percent((int32_t)cp->hull_max - cp->hull_damage, cp->hull_max);
+		uint16_t target = obj == pstate.object_idx ? pstate.target_obj_idx : (uint16_t)cp->ai_target_ref;
+		if (target < NUM_CRAFTS && TieXvtMfd_Listed(target)) {
+			TieXvtMfd_ListName(target, row->target, sizeof row->target);
+			row->target_color = TieXvtMfd_SideColor(objects[target].side);
+		} else if (target < 0x3800 && objects[target].ship_idx) {
+			TieXvtMfd_ObjectName(target, row->target, sizeof row->target);
+			row->target_color = TieXvtMfd_SideColor(objects[target].side);
+		} else {
+			snprintf(row->target, sizeof row->target, "None");
+			row->target_color = 0x46;
+		}
+		if (s_list_mode == TIE_XVT_LIST_ENEMY)
+			snprintf(row->orders, sizeof row->orders, "%s", TieXvtMfd_GoalWord(obj));
+	}
+}
+
+static void TieXvtMfd_CaptureDamage(TieHudState* hud) {
+	uint8_t systems[NUM_SYSTEMS];
+	unsigned count;
+	int selected;
+	if (!s_damage_open)
+		return;
+	count = TieXvtMfd_DamagedSystems(systems);
+	if (!count) {
+		/* XvT closes the display once every system is repaired. */
+		s_damage_open = 0;
+		s_damage_has_arrows = 0;
+		s_damage_selected = -1;
+		return;
+	}
+	selected = TieXvtMfd_DamageSelected();
+	hud->xvt_damage_open = 1;
+	hud->xvt_damage_active = TieXvtMfd_DamageHasKeys() ? 1 : 0;
+	for (unsigned i = 0; i < count; ++i) {
+		unsigned seconds = pstate.subsystem_repair_seconds[systems[i]];
+		__typeof__(hud->xvt_damage_rows[0])* row = &hud->xvt_damage_rows[hud->xvt_damage_count++];
+		snprintf(row->name, sizeof row->name, "%s", k_system_names[systems[i]]);
+		row->minutes = (uint8_t)(seconds / 60 > 99 ? 99 : seconds / 60);
+		row->seconds = (uint8_t)(seconds % 60);
+		row->selected = systems[i] == selected;
+	}
+}
+
+void TieXvtMfd_Capture(TieHudState* hud) {
+	hud->xvt_list_mode = 0;
+	hud->xvt_list_count = 0;
+	hud->xvt_damage_open = 0;
+	hud->xvt_damage_active = 0;
+	hud->xvt_damage_count = 0;
+	if (!TieFlightTweaks_XvtHud()) {
+		TieXvtMfd_Reset();
+		return;
+	}
+	if (!pstate.player_craft || pstate.object_idx >= NUM_CRAFTS)
+		return;
+	TieXvtMfd_CaptureList(hud);
+	TieXvtMfd_CaptureDamage(hud);
+}
