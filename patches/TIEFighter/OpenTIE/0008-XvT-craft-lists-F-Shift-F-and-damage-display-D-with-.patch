--- a/src/tie_remaster/flight/cockpit/renderer.c
+++ b/src/tie_remaster/flight/cockpit/renderer.c
@@ -3102,6 +3102,201 @@ static bool TieCockpitRenderer_FlightHudRecordLists(TieCockpitRenderer* cg, Aero
 	return ok;
 }
 
+/* ---- flight.xvt_hud: XvT's F / Shift+F craft lists and D damage display ----
+ * Boxes at XvT's places in every 640 cockpit (Balance of Power .INT elements
+ * 130 and 133), drawn in XvT's layout with TIE's cockpit font and colors.
+ * The craft list is filled in the cockpit and see-through with it off; the
+ * damage box has no fill and shows its frame while it has Up / Down. */
+enum {
+	XVT_LIST_X = 415,
+	XVT_LIST_Y = 296,
+	XVT_LIST_W = 225,
+	XVT_LIST_H = 94,
+	XVT_DAMAGE_X = 433,
+	XVT_DAMAGE_Y = 105,
+	XVT_DAMAGE_W = 207,
+	XVT_DAMAGE_H = 90,
+	XVT_ROW_STEP = 10,
+	XVT_LIST_FILL = 0x141C28,
+	XVT_DAMAGE_SELECTED = 0x1C3C78,
+	XVT_LABEL = 0x46, /* TIE's CMD label blue */
+	XVT_VALUE = 0x47, /* and its value color */
+	XVT_AMBER = 0x4E,
+	XVT_RED = 0x4A,
+};
+
+typedef struct TieCockpitRendererXvtPen {
+	TieCockpitRenderer* cg;
+	const TieScene2dTextSpace* space;
+	float shift_px; /* Widescreen cockpit-off HUD shift, in target pixels. */
+	TieUIText recs[64];
+	int n;
+} TieCockpitRendererXvtPen;
+
+static float TieCockpitRenderer_XvtMeasure(TieCockpitRendererXvtPen* p, const char* s) {
+	return TieScene2dTextRenderer_MeasureFestringClassic(p->cg->text_renderer, TIE_FONT_DOMAIN_COCKPIT,
+														  FONT_MICRO64, p->space, s);
+}
+
+/* Text at (x, y), clipped to `width` classic pixels. */
+static void TieCockpitRenderer_XvtText(TieCockpitRendererXvtPen* p, float x, float y, const char* s,
+									   uint8_t logical, float width) {
+	if (!s || !s[0] || width <= 0.0f ||
+		!TieCockpitText_Push(p->recs, &p->n, (int)(sizeof p->recs / sizeof p->recs[0]), (int16_t)x, (int16_t)y,
+							 s, TieCockpitText_RemapColor(logical)))
+		return;
+	TieUIText* t = &p->recs[p->n - 1];
+	t->font_id = FONT_MICRO64;
+	t->clip_left = (int16_t)x;
+	t->clip_top = (int16_t)(y - 1);
+	t->clip_right = (int16_t)(x + width);
+	t->clip_bottom = (int16_t)(y + XVT_ROW_STEP + 1);
+}
+
+static void TieCockpitRenderer_XvtRightText(TieCockpitRendererXvtPen* p, float right, float y, const char* s,
+											uint8_t logical) {
+	const float w = TieCockpitRenderer_XvtMeasure(p, s);
+	TieCockpitRenderer_XvtText(p, right - w, y, s, logical, w + 1.0f);
+}
+
+/* A fill in classic 640x480 coordinates, unaffected by the cockpit's lower stretch. */
+static void TieCockpitRenderer_XvtFill(TieCockpitRendererXvtPen* p, float x, float y, float w, float h,
+									   float r, float g, float b, float a) {
+	const TieCockpitRendererDrawSpace* space = &p->cg->pending_space;
+	const float sx = space->scale_x * (float)space->coord_w / 640.0f;
+	const float sy = space->scale_y * (float)space->coord_h / 480.0f;
+	const float color[4] = { r * a, g * a, b * a, a };
+	AeronDrawList_AddFill(p->cg->record_list, space->fit_x + p->shift_px + x * sx, space->fit_y + y * sy, w * sx,
+						  h * sy, color, AERON_BLIT2D_BLEND_PMA, NULL);
+}
+
+static void TieCockpitRenderer_XvtFillRgb(TieCockpitRendererXvtPen* p, float x, float y, float w, float h,
+										  uint32_t rgb, float a) {
+	float r, g, b;
+	TieScene2dSrgb_PalToLinearRgb(rgb, &r, &g, &b);
+	TieCockpitRenderer_XvtFill(p, x, y, w, h, r, g, b, a);
+}
+
+static void TieCockpitRenderer_XvtFrame(TieCockpitRendererXvtPen* p, const TieSnapshot* snap, float x, float y,
+										float w, float h) {
+	float r, g, b;
+	TieCockpitRenderer_MsgColorToTint(snap, XVT_LABEL, &r, &g, &b);
+	TieCockpitRenderer_XvtFill(p, x, y, w, 1, r, g, b, 1);
+	TieCockpitRenderer_XvtFill(p, x, y + h - 1, w, 1, r, g, b, 1);
+	TieCockpitRenderer_XvtFill(p, x, y, 1, h, r, g, b, 1);
+	TieCockpitRenderer_XvtFill(p, x + w - 1, y, 1, h, r, g, b, 1);
+}
+
+static uint8_t TieCockpitRenderer_XvtHealthColor(int pct) {
+	return pct <= 20 ? XVT_RED : pct <= 50 ? XVT_AMBER : XVT_VALUE;
+}
+
+static void TieCockpitRenderer_XvtCraftList(TieCockpitRendererXvtPen* p, const TieSnapshot* snap) {
+	const TieHudState* h = &snap->hud;
+	const bool enemy = h->xvt_list_mode == 2;
+	const float half = XVT_ROW_STEP / 2.0f;
+	const float left = XVT_LIST_X + 2, top = XVT_LIST_Y + 2, right = XVT_LIST_X + XVT_LIST_W - 2;
+	float bottom = top + XVT_ROW_STEP * (h->xvt_list_count + 1);
+	if (bottom > XVT_LIST_Y + XVT_LIST_H - 2 || !h->xvt_list_count)
+		bottom = XVT_LIST_Y + XVT_LIST_H - 2;
+	const float fx = left - 2, fy = top - 2, fw = right - left + 4, fh = bottom - top + 4;
+	TieCockpitRenderer_XvtFillRgb(p, fx, fy, fw, fh, XVT_LIST_FILL, snap->cockpit.view_idx == 0 ? 1.0f : 0.55f);
+	TieCockpitRenderer_XvtFrame(p, snap, fx, fy, fw, fh);
+
+	const float health_x = left + 11 * half;
+	TieCockpitRenderer_XvtText(p, left, top, "Craft", XVT_LABEL, health_x - left);
+	TieCockpitRenderer_XvtText(p, health_x, top, "SHD/HULL", XVT_LABEL, right - health_x);
+	const float target_x = health_x + TieCockpitRenderer_XvtMeasure(p, "SHD/HULL") + half;
+	const float orders_x = target_x + 17 * half;
+	if (enemy) {
+		TieCockpitRenderer_XvtText(p, target_x, top, "Target", XVT_LABEL, orders_x - target_x);
+		TieCockpitRenderer_XvtText(p, orders_x, top, "Orders", XVT_LABEL, right - orders_x);
+	} else {
+		TieCockpitRenderer_XvtRightText(p, right, top, "Target", XVT_LABEL);
+	}
+
+	const float digits = TieCockpitRenderer_XvtMeasure(p, "000");
+	for (unsigned i = 0; i < h->xvt_list_count; ++i) {
+		const float y = top + XVT_ROW_STEP * (float)(i + 1);
+		if (y + XVT_ROW_STEP - 2 > bottom + 0.5f)
+			break;
+		const __typeof__(h->xvt_list_rows[0])* row = &h->xvt_list_rows[i];
+		char value[8];
+		TieCockpitRenderer_XvtText(p, left, y, row->name, row->name_color, health_x - left);
+		float x = health_x + half;
+		snprintf(value, sizeof value, "%d", row->shield_pct > 0 ? row->shield_pct : 0);
+		TieCockpitRenderer_XvtRightText(p, x + digits, y, value, TieCockpitRenderer_XvtHealthColor(row->shield_pct));
+		x += digits;
+		TieCockpitRenderer_XvtText(p, x, y, "/", row->name_color, 8);
+		x += TieCockpitRenderer_XvtMeasure(p, "/");
+		if (row->hull_pct > 0) {
+			snprintf(value, sizeof value, "%d", row->hull_pct);
+			TieCockpitRenderer_XvtRightText(p, x + digits, y, value,
+											TieCockpitRenderer_XvtHealthColor(row->hull_pct));
+		}
+		if (enemy) {
+			TieCockpitRenderer_XvtText(p, target_x, y, row->target, row->target_color, orders_x - target_x - half);
+			TieCockpitRenderer_XvtText(p, orders_x, y, row->orders, row->name_color, right - orders_x);
+		} else {
+			const float avail = right - (x + digits + half);
+			const float w = fminf(TieCockpitRenderer_XvtMeasure(p, row->target), avail);
+			TieCockpitRenderer_XvtText(p, right - w, y, row->target, row->target_color, avail);
+		}
+	}
+}
+
+static void TieCockpitRenderer_XvtDamage(TieCockpitRendererXvtPen* p, const TieSnapshot* snap) {
+	const TieHudState* h = &snap->hud;
+	const float step = XVT_ROW_STEP;
+	const float left = XVT_DAMAGE_X + 2, top = XVT_DAMAGE_Y + 2, right = XVT_DAMAGE_X + XVT_DAMAGE_W - 2;
+	float bottom = top + step * (h->xvt_damage_count + 1) + 2;
+	if (bottom > XVT_DAMAGE_Y + XVT_DAMAGE_H - 2)
+		bottom = XVT_DAMAGE_Y + XVT_DAMAGE_H - 2;
+	if (h->xvt_damage_active)
+		TieCockpitRenderer_XvtFrame(p, snap, left - 2, top - 2, right - left + 4, bottom - top + 4);
+	const char* title = "Damage Assessment";
+	TieCockpitRenderer_XvtText(p, left + (right - left - TieCockpitRenderer_XvtMeasure(p, title)) / 2.0f, top,
+							   title, XVT_LABEL, right - left);
+	for (unsigned i = 0; i < h->xvt_damage_count; ++i) {
+		const __typeof__(h->xvt_damage_rows[0])* row = &h->xvt_damage_rows[i];
+		const float y = top + step * (float)(i + 1);
+		if (y + step > bottom + 0.5f)
+			break;
+		if (row->selected)
+			TieCockpitRenderer_XvtFillRgb(p, left, y - 1, right - left, step, XVT_DAMAGE_SELECTED, 1.0f);
+		char time[8];
+		snprintf(time, sizeof time, "%02u:%02u", row->minutes, row->seconds);
+		const float time_w = TieCockpitRenderer_XvtMeasure(p, time);
+		TieCockpitRenderer_XvtText(p, left, y, row->name, XVT_VALUE, right - left - time_w - 4);
+		TieCockpitRenderer_XvtRightText(p, right, y, time, XVT_RED);
+	}
+}
+
+static void TieCockpitRenderer_DrawXvtMfd(TieCockpitRenderer* cg, const TieSnapshot* snap,
+										  const TieScene2dTextSpace* space) {
+	const TieHudState* h = &snap->hud;
+	if (!cg->text_renderer || (!h->xvt_list_mode && !h->xvt_damage_open) ||
+		(snap->cockpit.view_idx != 0 && snap->cockpit.view_idx != 19))
+		return;
+	static TieCockpitRendererXvtPen pen;
+	pen.cg = cg;
+	pen.space = space;
+	/* Both boxes sit on the right; with the cockpit off they follow the HUD out to the edge. */
+	pen.shift_px = s_hud_spread_px;
+	pen.n = 0;
+	if (h->xvt_list_mode)
+		TieCockpitRenderer_XvtCraftList(&pen, snap);
+	if (h->xvt_damage_open)
+		TieCockpitRenderer_XvtDamage(&pen, snap);
+	if (pen.n > 0) {
+		const TieCockpitRendererDrawSpace* d = &cg->pending_space;
+		TieScene2dTextRenderer_RecordFestringScaled(cg->text_renderer, cg->record_list, space->classic_w,
+													space->classic_h, space, pen.recs, pen.n, snap->palette,
+													d->fit_x + pen.shift_px, d->fit_y, d->scale_x, d->scale_y,
+													d->target_w, d->target_h);
+	}
+}
