+
+enum {
+	XVT_WASH_FIRST_ID = FSFX_XVT_FIRST_ID + TIE_XVT_CONTROL_COUNT,
+	XVT_WASH_COUNT = 2,
+	XVT_SOUND_PRIORITY = 126,
+};
+
+/* OpenXvT sounds 42-48 (SFXBLAST.LST from ID 4) and their g_fsfxBaseVolumeBySfxSlot volumes. */
+static const char* const s_control_files[TIE_XVT_CONTROL_COUNT] = {
+	"xvt_control_sounds/BEEP-01.WAV",  "xvt_control_sounds/SMCLICK1.WAV", "xvt_control_sounds/SET_OFF2.WAV",
+	"xvt_control_sounds/SET_VLO3.WAV", "xvt_control_sounds/SET_LO2.WAV",  "xvt_control_sounds/SET_MED2.WAV",
+	"xvt_control_sounds/SET_HI2.WAV"
+};
+static const uint8_t s_control_volumes[TIE_XVT_CONTROL_COUNT] = { 127, 95, 56, 56, 56, 56, 56 };
+/* OpenXvT sounds 78 (star destroyers) and 79 (other ships). */
+static const char* const s_wash_files[XVT_WASH_COUNT] = { "xvt_engine_wash/sd-lp-1.wav",
+														  "xvt_engine_wash/cal-flyb.wav" };
+
+_Static_assert(TIE_XVT_CONTROL_COUNT + XVT_WASH_COUNT == FSFX_XVT_SOUND_COUNT, "XvT sound slots");
+
+static uint32_t Le32(const uint8_t* p) {
+	return p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint16_t Le16(const uint8_t* p) { return (uint16_t)(p[0] | p[1] << 8); }
+
+/* Converts an 8-bit mono PCM WAV into a VOC file (type 1 blocks, unsigned 8-bit, plus a terminator), which
+ * imuse_start_sound recognises by its "Creative Voice File" header. NULL on any format it does not handle. */
+static void* TieXvtSounds_WavToVoc(const uint8_t* wav, size_t size) {
+	const uint8_t* samples = NULL;
+	uint32_t sample_bytes = 0;
+	uint32_t rate = 0;
+	bool format = false;
+	size_t at;
+
+	if (size < 12 || memcmp(wav, "RIFF", 4) || memcmp(wav + 8, "WAVE", 4))
+		return NULL;
+	for (at = 12; at + 8 <= size;) {
+		uint32_t chunk = Le32(wav + at + 4);
+		if (chunk > size - at - 8)
+			return NULL;
+		if (!memcmp(wav + at, "fmt ", 4) && chunk >= 16) {
+			const uint8_t* f = wav + at + 8;
+			format = Le16(f) == 1 && Le16(f + 2) == 1 && Le16(f + 14) == 8;
+			rate = Le32(f + 4);
+		} else if (!memcmp(wav + at, "data", 4)) {
+			samples = wav + at + 8;
+			sample_bytes = chunk;
+		}
+		at += 8 + chunk + (chunk & 1);
+	}
+	if (!format || !samples || !sample_bytes || rate < 4000 || rate > 48000)
+		return NULL;
+
+	enum { BLOCK = 0xFFF0 };
+	static const uint8_t header[26] = { 'C', 'r', 'e', 'a', 't', 'i', 'v', 'e', ' ', 'V', 'o', 'i', 'c',
+										'e', ' ', 'F', 'i', 'l', 'e', 0x1A, 0x1A, 0x00, 0x0A, 0x01, 0x29, 0x11 };
+	uint32_t blocks = (sample_bytes + BLOCK - 1) / BLOCK;
+	uint8_t* voc = malloc(sizeof header + sample_bytes + blocks * 6 + 1);
+	uint8_t* out = voc;
+	int divisor = 256 - (int)((1000000 + rate / 2) / rate);
+	uint32_t done;
+
+	if (!voc)
+		return NULL;
+	memcpy(out, header, sizeof header);
+	out += sizeof header;
+	if (divisor < 0)
+		divisor = 0;
+	for (done = 0; done < sample_bytes;) {
+		uint32_t n = sample_bytes - done < BLOCK ? sample_bytes - done : BLOCK;
+		uint32_t length = n + 2;
+		*out++ = 1;
+		*out++ = (uint8_t)length;
+		*out++ = (uint8_t)(length >> 8);
+		*out++ = (uint8_t)(length >> 16);
+		*out++ = (uint8_t)divisor;
+		*out++ = 0; /* 8-bit unsigned PCM */
+		memcpy(out, samples + done, n);
+		out += n;
+		done += n;
+	}
+	*out = 0;
+	return voc;
+}
+
+static void* TieXvtSounds_LoadWav(const char* path) {
+	uint8_t* data = NULL;
+	size_t size = 0;
+	void* voc = NULL;
+
+	if (AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, path, 1u << 20, &data, &size))
+		voc = TieXvtSounds_WavToVoc(data, size);
+	free(data);
+	if (!voc)
+		Aeron_LogWarn("tie.audio", "XvT sound %s is missing or unsupported; keeping TIE's", path);
+	return voc;
+}
+
+void TieXvtSounds_Free(void) {
+	uint16_t i;
+
+	for (i = 0; i < FSFX_XVT_SOUND_COUNT; ++i) {
+		uint16_t id = (uint16_t)(FSFX_XVT_FIRST_ID + i);
+		if (im) {
+			imuse_stop_sound(im, id);
+			imuse_forget_sound(im, id);
+		}
+		free(soundhandles[id]);
+		soundhandles[id] = NULL;
+	}
+}
+
+void TieXvtSounds_Load(void) {
+	uint16_t i;
+
+	TieXvtSounds_Free();
+	if (TieFlightTweaks_XvtControlSounds())
+		for (i = 0; i < TIE_XVT_CONTROL_COUNT; ++i)
+			soundhandles[FSFX_XVT_FIRST_ID + i] = TieXvtSounds_LoadWav(s_control_files[i]);
+	if (TieFlightTweaks_XvtEngineWash())
+		for (i = 0; i < XVT_WASH_COUNT; ++i)
+			soundhandles[XVT_WASH_FIRST_ID + i] = TieXvtSounds_LoadWav(s_wash_files[i]);
+}
+
+bool TieXvtSounds_PlayControl(TieXvtControlSound sound) {
+	intptr_t id = FSFX_XVT_FIRST_ID + sound;
+
+	if ((unsigned)sound >= TIE_XVT_CONTROL_COUNT || !TieFlightTweaks_XvtControlSounds() || !soundhandles[id])
+		return false;
+	if (!im || !sfxenabled || !inflight_sound_vol)
+		return true;
+	if (imuse_get_param(im, id, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)
+		imuse_stop_sound(im, id);
+	if (imuse_start_sound(im, id, XVT_SOUND_PRIORITY))
+		return true;
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_GROUP, IMUSE_GROUP_SFX);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_PRIORITY, XVT_SOUND_PRIORITY);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_PAN, 64);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_VOL, s_control_volumes[sound]);
+	return true;
+}
+
+void TieXvtSounds_UpdateEngineWash(void) {
+	int playing = -1;
+	int volume = 0;
+	int strength = 0;
+	uint16_t source_type = 0;
+	int i;
+
+	if (!im)
+		return;
+	if (sfxenabled && inflight_sound_vol && !mapflag)
+		strength = collide_enginewashsound(&source_type);
+	if (strength > 0) {
+		/* OpenXvT fsfx_UpdateFlightSfx: the star destroyer loop for the Interdictor, Victory, Imperial and Super
+		 * Star Destroyers, the other loop for everything else. */
+		playing = source_type >= 51 && source_type <= 54 ? 0 : 1;
+		if (!soundhandles[XVT_WASH_FIRST_ID + playing])
+			playing = -1;
+		/* XvT: 4 * exterior volume * strength / 10. As in OpenXW, audible from the wash's edge and full from a
+		 * quarter strength. The SFX group volume applies the player's setting. */
+		volume = 40 + strength * 6;
+		if (volume > 127)
+			volume = 127;
+	}
+	for (i = 0; i < XVT_WASH_COUNT; ++i)
+		if (i != playing && imuse_get_param(im, XVT_WASH_FIRST_ID + i, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)
+			imuse_stop_sound(im, XVT_WASH_FIRST_ID + i);
+	if (playing < 0)
+		return;
+	intptr_t id = XVT_WASH_FIRST_ID + playing;
+	if (!(imuse_get_param(im, id, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)) {
+		if (imuse_start_wave(im, id, XVT_SOUND_PRIORITY, IMUSE_WAVE_START_LOOP))
+			return;
+		imuse_set_param(im, id, IMUSE_PARAM_SOUND_GROUP, IMUSE_GROUP_SFX);
+		imuse_set_param(im, id, IMUSE_PARAM_SOUND_PAN, 64);
+	}
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_VOL, volume);
+}
diff --git a/src/tie_runtime/audio/xvt_sounds.h b/src/tie_runtime/audio/xvt_sounds.h
new file mode 100644
index 0000000..acd9a65
--- /dev/null
+++ b/src/tie_runtime/audio/xvt_sounds.h
@@ -0,0 +1,34 @@
+#ifndef TIE_RUNTIME_AUDIO_XVT_SOUNDS_H
+#define TIE_RUNTIME_AUDIO_XVT_SOUNDS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* X-Wing vs TIE Fighter flight sounds, read from WAVs that the packaging script copies out of an XvT
+ * installation into RESOURCE xvt_control_sounds/ and xvt_engine_wash/. They are converted to VOC and kept in
+ * FSFX soundhandles past the TIE98 table (FSFX_XVT_FIRST_ID), where gamesnd_GetSoundAddr serves them to iMUSE.
+ *
+ * flight.xvt_control_sounds: OpenXvT flight.c's key sounds. The confirm beep for energy transfers and firing
+ * modes, the small click for throttle keys and refused transfers, and one tone per recharge setting.
+ * flight.xvt_engine_wash: OpenXvT fsfx_UpdateFlightSfx's engine wash loop. */
+typedef enum TieXvtControlSound {
+	TIE_XVT_CONTROL_CONFIRM,     /* XvT 42, beep-01 */
+	TIE_XVT_CONTROL_CLICK,       /* XvT 43, smclick1 */
+	TIE_XVT_CONTROL_SETTING_OFF, /* XvT 44-48: recharge rate 0 (all to engines) to 4 */
+	TIE_XVT_CONTROL_SETTING_VERY_LOW,
+	TIE_XVT_CONTROL_SETTING_LOW,
+	TIE_XVT_CONTROL_SETTING_MEDIUM,
+	TIE_XVT_CONTROL_SETTING_HIGH,
+	TIE_XVT_CONTROL_COUNT
+} TieXvtControlSound;
+
+/* fsfx_loadsfx calls Load after the flight bank; fsfx_freesfx calls Free. */
+void TieXvtSounds_Load(void);
+void TieXvtSounds_Free(void);
+/* Plays an XvT control sound. False when the option is off or the sound is missing, so the caller can play
+ * TIE's own sound instead; true (even if muted) otherwise. */
+bool TieXvtSounds_PlayControl(TieXvtControlSound sound);
+/* Per frame, with the player engine sound: starts, adjusts or stops the engine wash loop. */
+void TieXvtSounds_UpdateEngineWash(void);
+
+#endif
