+#ifdef TIE_MODERN
+/* flight.xvt_shields: XvT evens the player's banks after every hit. When the hit bank is below the other,
+ * half the difference moves across (a depleted bank takes half of the other), and the shields return to
+ * balanced. */
+static void collide_xvtbalanceshields(CraftData* cp, uint16_t hit_side) {
+	int16_t* banks = &cp->forward_shield;
+	int hit = banks[hit_side];
+	int other = banks[hit_side ^ 1];
+	int cap = 2 * spec_data[cp->species_idx].shield_points;
+	int moved;
+
+	if (!mission.difficulty)
+		cap *= 2;
+	if (hit >= other)
+		return;
+	moved = (other - hit) / 2;
+	if (hit + moved > cap)
+		moved = cap > hit ? cap - hit : 0;
+	if (moved <= 0)
+		return;
+	banks[hit_side] = (int16_t)(hit + moved);
+	banks[hit_side ^ 1] = (int16_t)(other - moved);
+	cp->is_player_craft = 1; /* shield distribution: balanced */
+}
+
+/* flight.xvt_engine_wash (OpenXvT collide_ApplyEngineWashDamage): flying in the exhaust behind a working
+ * freighter's or starship's engines drains the player's shields, then hull. The wash is a box behind each
+ * engine mesh of the OPT model that widens and weakens with depth. */
+enum {
+	COLLIDE_WASH_UPDATE_TICKS = 29,
+	COLLIDE_WASH_RANGE_SCALE = 3,
+	COLLIDE_WASH_LENGTH_SCALE = 8,
+	COLLIDE_WASH_MAX_DAMAGE = 64,
+	COLLIDE_WASH_PERCENT = 100,
+	COLLIDE_WASH_MESSAGE_TICKS = 5 * 236,
+	COLLIDE_WASH_SSD = 54,         /* XvT's SPECIAL_ENGINE_WASH_OBJECT_TYPE */
+	COLLIDE_WASH_CALAMARI = 49,    /* XvT's ASYMMETRIC_ENGINE_WASH_OBJECT_TYPE */
+};
+static int16_t s_wash_damage_override = -1;
+static uint16_t s_wash_accum;
+static uint32_t s_wash_message_wait;
+static uint8_t s_wash_was_active;
+/* XvT's engineWashSourceObjIdx/engineWashStrength: the strongest wash of the last update, for the sound. */
+static uint16_t s_wash_source = 0xFFFF;
+static int s_wash_strength;
+
+static int32_t collide_q15dot(int16_t ax, int16_t ay, int16_t az, int32_t bx, int32_t by, int32_t bz) {
+	return (int32_t)(((int64_t)ax * bx + (int64_t)ay * by + (int64_t)az * bz) >> 15);
+}
+
+/* Applies one source's wash to the player; returns nonzero when any engine's wash reached it. Model space is
+ * the OPT's: X side, Y aft, Z up (pai_calcrotatedpoint takes side = X, up = Z, forward = -Y). */
+static int collide_enginewash(uint16_t source_idx) {
+	FlightObject* source = &objects[source_idx];
+	FlightObject* player = pstate.player;
+	uint16_t type = source->ship_idx;
+	int extent = modelbounds_getmaxextent(type);
+	int32_t dx = (int32_t)((uint32_t)player->world_x - (uint32_t)source->world_x);
+	int32_t dy = (int32_t)((uint32_t)player->world_y - (uint32_t)source->world_y);
+	int32_t dz = (int32_t)((uint32_t)player->world_z - (uint32_t)source->world_z);
+	int32_t local_side, local_aft, local_up, nose_side, nose_aft, nose_up;
+	int mesh_count, mesh;
+	int washed = 0;
+
+	if (extent <= 0 || (int64_t)COLLIDE_WASH_RANGE_SCALE * extent < collide_roughdistance3d(dx, dy, dz))
+		return 0;
+	if (source->orient_dirty) {
+		fview_calcrotatemove(source->pitch, source->heading, source);
+		fview_calcrotateorient(source->roll, 0, source);
+	}
+	if (player->orient_dirty) {
+		fview_calcrotatemove(player->pitch, player->heading, player);
+		fview_calcrotateorient(player->roll, 0, player);
+	}
+	local_side = collide_q15dot(source->side_x, source->side_y, source->side_z, dx, dy, dz);
+	local_aft = -collide_q15dot(source->fwd_x, source->fwd_y, source->fwd_z, dx, dy, dz);
+	if (local_aft < -extent)
+		return 0;
+	local_up = collide_q15dot(source->up_x, source->up_y, source->up_z, dx, dy, dz);
+	/* The player's nose in the same model space picks the shield bank facing the engine. */
+	nose_side = collide_q15dot(source->side_x, source->side_y, source->side_z, player->fwd_x, player->fwd_y,
+							   player->fwd_z);
+	nose_aft = -collide_q15dot(source->fwd_x, source->fwd_y, source->fwd_z, player->fwd_x, player->fwd_y,
+							   player->fwd_z);
+	nose_up = collide_q15dot(source->up_x, source->up_y, source->up_z, player->fwd_x, player->fwd_y, player->fwd_z);
+
+	mesh_count = modelmesh_getcount(type);
+	for (mesh = 0; mesh < mesh_count; ++mesh) {
+		int min_x, min_y, min_z, max_x, max_y, max_z, cx, cy, cz;
+		int length_extent, side_extent, up_extent, wash_length, depth, side_offset, up_offset, damage;
+		int64_t to_engine;
+		CraftData* saved_craftptr;
+
+		if (modelmesh_gettype(type, mesh) != TIE_MESH_ENGINE)
+			continue;
+		cx = modelmesh_getcenterx(type, mesh);
+		cy = modelmesh_getcentery(type, mesh);
+		cz = modelmesh_getcenterz(type, mesh);
+		/* Engines on the front half (CAL.OPT's under-bow pods) would wash along the hull; XvT's models have
+		 * none there. */
+		if (cy < 0)
+			continue;
+		min_x = modelmesh_getboundsminx(type, mesh);
+		min_y = modelmesh_getboundsminy(type, mesh);
+		min_z = modelmesh_getboundsminz(type, mesh);
+		max_x = modelmesh_getboundsmaxx(type, mesh);
+		max_y = modelmesh_getboundsmaxy(type, mesh);
+		max_z = modelmesh_getboundsmaxz(type, mesh);
+		length_extent = max_y - min_y;
+		if (type == COLLIDE_WASH_SSD)
+			length_extent >>= 6;
+		side_extent = max_x - min_x;
+		up_extent = max_z - min_z;
+		if (type == COLLIDE_WASH_SSD && local_up > max_z)
+			continue;
+		if (type == COLLIDE_WASH_CALAMARI && cz < 0 && local_up > max_z)
+			continue;
+		if (length_extent < side_extent)
+			length_extent = side_extent;
+		if (length_extent < up_extent)
+			length_extent = up_extent;
+		wash_length = COLLIDE_WASH_LENGTH_SCALE * length_extent;
+		if (wash_length > 2 * extent)
+			wash_length = 2 * extent;
+		if (type == COLLIDE_WASH_SSD)
+			depth = (wash_length >> 8) - max_y + local_aft;
+		else
+			depth = local_aft - min_y;
+		if (depth <= 0 || wash_length < depth)
+			continue;
+		side_offset = abs(local_side - cx);
+		up_offset = abs(local_up - cz);
+		side_extent += side_extent >> 1;
+		side_extent += (int)((int64_t)depth * side_extent / wash_length);
+		up_extent += up_extent >> 1;
+		up_extent += (int)((int64_t)depth * up_extent / wash_length);
+		if (side_extent < side_offset || up_extent < up_offset || side_extent + up_extent <= 0)
+			continue;
+		damage = (wash_length >> 8) *
+				 (COLLIDE_WASH_PERCENT * (wash_length - depth) / wash_length *
+				  (COLLIDE_WASH_PERCENT * (side_extent + up_extent - up_offset - side_offset) /
+				   (side_extent + up_extent)) /
+				  COLLIDE_WASH_PERCENT) /
+				 COLLIDE_WASH_PERCENT;
+		if (type == COLLIDE_WASH_SSD) {
+			damage >>= 4;
+			damage += damage >> 1;
+		}
+		if (damage > COLLIDE_WASH_MAX_DAMAGE)
+			damage = COLLIDE_WASH_MAX_DAMAGE;
+		if (damage > s_wash_strength) {
+			s_wash_strength = damage;
+			s_wash_source = source_idx;
+		}
+		/* As XvT: with the shields down the wash only scorches the hull. */
+		if (pstate.player_craft->forward_shield + pstate.player_craft->rear_shield == 0)
+			damage >>= 3;
+		if (damage < 1)
+			damage = 1;
+		/* Facing the engine: front bank. */
+		to_engine = (int64_t)nose_side * (cx - local_side) + (int64_t)nose_aft * (cy - local_aft) +
+					(int64_t)nose_up * (cz - local_up);
+		saved_craftptr = craftptr;
+		s_wash_damage_override = (int16_t)damage;
+		collide_damagecraft(pstate.object_idx, 0xFFFF, source_idx, to_engine >= 0 ? 0 : 1);
+		s_wash_damage_override = -1;
+		craftptr = saved_craftptr;
+		washed = 1;
+		if (pstate.player_craft->flight_flag)
+			break;
+	}
+	return washed;
+}
+
+/* Every 29 ticks, as XvT, from frame ticks so replays repeat it. */
+static void collide_updateenginewash(void) {
+	uint16_t i;
+	int washed = 0;
+
+	if (!TieFlightTweaks_XvtEngineWash() || !TIE_FLIGHT_TIE98 || inflight_invulnerable || hyperspaceflag ||
+		mission.train_craft_type || pstate.player_craft->flight_flag || !pstate.player_craft->status_flags) {
+		s_wash_strength = 0;
+		return;
+	}
+	if (s_wash_message_wait > frameticks)
+		s_wash_message_wait -= frameticks;
+	else
+		s_wash_message_wait = 0;
+	s_wash_accum = (uint16_t)(s_wash_accum + frameticks);
+	if (s_wash_accum < COLLIDE_WASH_UPDATE_TICKS)
+		return;
+	s_wash_accum %= COLLIDE_WASH_UPDATE_TICKS;
+	s_wash_strength = 0;
+	s_wash_source = 0xFFFF;
+	for (i = 0; i < NUM_CRAFTS; ++i) {
+		FlightObject* source = &objects[i];
+
+		if (i == pstate.object_idx || !source->ship_idx || source->category ||
+			(source->genus != GENUS_FREIGHTER && source->genus != GENUS_STARSHIP))
+			continue;
+		if (!source->craft_ptr || !source->craft_ptr->status_flags)
+			continue;
+		washed |= collide_enginewash(i);
+		if (pstate.player_craft->flight_flag)
+			break;
+	}
+	if (washed && !replayviewmode && (!s_wash_was_active || !s_wash_message_wait)) {
+		msg_messagetext(MSG_COLLISION_OCCURRED, "You're taking damage from engine wash!");
+		s_wash_message_wait = COLLIDE_WASH_MESSAGE_TICKS;
+	}
+	s_wash_was_active = (uint8_t)washed;
+}
+
+int collide_enginewashsound(uint16_t* source_ship_idx) {
+	if (s_wash_strength <= 0 || s_wash_source >= NUM_CRAFTS || !objects[s_wash_source].ship_idx)
+		return 0;
+	*source_ship_idx = objects[s_wash_source].ship_idx;
+	return s_wash_strength;
+}
+#endif
