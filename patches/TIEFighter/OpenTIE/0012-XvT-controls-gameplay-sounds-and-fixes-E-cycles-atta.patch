+/* More X-Wing vs TIE Fighter behaviour, each its own flight.* key:
+ * xvt_shields: a hit moves half the difference from the stronger bank to the weaker hit bank (player).
+ * xvt_turning: the player's turn rate follows XvT's throttle and power curve.
+ * xvt_engine_wash: damage and sound behind working capital ship and freighter engines.
+ * start_overshield: the player launches with both banks at the recharge ceiling.
+ * xvt_recharge: T/F and T/B cannons recharge 3 per step instead of 2, Y-Wing shields twice as fast.
+ * skip_empty_warheads: W skips empty launchers; the last warhead fired switches to the cannons.
+ * xvt_control_sounds: XvT's tones and clicks for power, throttle and weapon keys. */
+enum {
+	TIE_XVT_OPTION_SHIELDS,
+	TIE_XVT_OPTION_TURNING,
+	TIE_XVT_OPTION_ENGINE_WASH,
+	TIE_XVT_OPTION_START_OVERSHIELD,
+	TIE_XVT_OPTION_RECHARGE,
+	TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS,
+	TIE_XVT_OPTION_CONTROL_SOUNDS,
+	TIE_XVT_OPTION_COUNT
+};
+/* The option's key under flight: in config.yaml ("xvt_shields" ...). */
+const char* TieFlightTweaks_XvtOptionKey(int option);
+bool TieFlightTweaks_XvtOption(int option);
+void TieFlightTweaks_SetXvtOption(int option, bool enabled);
+#define TieFlightTweaks_XvtShields() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_SHIELDS)
+#define TieFlightTweaks_XvtTurning() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_TURNING)
+#define TieFlightTweaks_XvtEngineWash() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_ENGINE_WASH)
+#define TieFlightTweaks_StartOvershield() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_START_OVERSHIELD)
+#define TieFlightTweaks_XvtRecharge() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_RECHARGE)
+#define TieFlightTweaks_SkipEmptyWarheads() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS)
+#define TieFlightTweaks_XvtControlSounds() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_CONTROL_SOUNDS)
 
 #endif
