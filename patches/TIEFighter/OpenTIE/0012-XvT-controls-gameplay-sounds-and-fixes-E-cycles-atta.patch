@@ -93,10 +317,17 @@ int16_t instrumentdisable[] = { 0x200, 0x040, 0x020, 0x006, 0x400,  0x180, 0x010
 void collide_collisions(void) {
 	uint16_t projectile_idx;
 
-	if (hyperspaceflag && !hyperabortflag)
+	if (hyperspaceflag && !hyperabortflag) {
+#ifdef TIE_MODERN
+		s_wash_strength = 0;
+#endif
 		return;
+	}
 
 	if (!pstate.player->genus) {
+#ifdef TIE_MODERN
+		collide_updateenginewash();
+#endif
 		CraftData* tgt_craft;
 		uint16_t hit_offset;
 		uint16_t target_idx;
@@ -1218,6 +1449,10 @@ char collide_damagecraft(uint16_t target_obj_idx, uint16_t component_idx, uint16
 
 	if (objects[target_obj_idx].genus == GENUS_GATE)
 		damage = 0;
+#ifdef TIE_MODERN
+	if (s_wash_damage_override >= 0)
+		damage = s_wash_damage_override;
+#endif
 
 	/* Step 3: shield absorption. shield_side selects forward_shield (0)
 	 * or rear_shield (1), adjacent int16 fields at +0xCA / +0xCC. */
@@ -1227,6 +1462,10 @@ char collide_damagecraft(uint16_t target_obj_idx, uint16_t component_idx, uint16
 		if (target_obj_idx == pstate.object_idx) {
 			shieldblink = (uint8_t)shield_side;
 			timers[TIMER_SHIELD_FLASH] += 59;
+#ifdef TIE_MODERN
+			if (TieFlightTweaks_XvtShields())
+				collide_xvtbalanceshields(craftptr, shield_side);
+#endif
 		}
 	} else {
 		/* Step 4: shield overflow. */
@@ -1235,6 +1474,10 @@ char collide_damagecraft(uint16_t target_obj_idx, uint16_t component_idx, uint16
 
 		damage -= (&craftptr->forward_shield)[shield_side];
 		(&craftptr->forward_shield)[shield_side] = 0;
+#ifdef TIE_MODERN
+		if (target_obj_idx == pstate.object_idx && TieFlightTweaks_XvtShields())
+			collide_xvtbalanceshields(craftptr, shield_side);
+#endif
 
 		if (damage) {
 			if ((atk_species != 141 && atk_species != 142) || target_obj_idx == pstate.object_idx) {
@@ -1569,8 +1812,15 @@ char collide_damagecraft(uint16_t target_obj_idx, uint16_t component_idx, uint16
 				spin = -spin;
 			objects[target_obj_idx].spin_rate = spin;
 			if (heading_kick) {
+#ifdef TIE_MODERN
+				/* Halve the signed kick. The original unsigned halving turned a negative (left wing) kick into a
+				 * ~174 degree flip, sending the wreck back into the pursuing player. */
+				objects[target_obj_idx].heading =
+					(uint16_t)objects[target_obj_idx].heading - (int16_t)heading_kick / 2;
+#else
 				objects[target_obj_idx].heading =
 					(uint16_t)objects[target_obj_idx].heading - heading_kick / 2;
+#endif
 				objects[target_obj_idx].orient_dirty = 1;
 				objects[target_obj_idx].move_dirty = 1;
 			}
