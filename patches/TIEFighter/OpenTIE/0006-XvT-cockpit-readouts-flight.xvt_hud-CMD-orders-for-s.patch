+#ifdef TIE_MODERN
+/* flight.xvt_hud: X-Wing vs TIE Fighter's CMD (Hud_UpdateTargetDetails) shows a
+ * starfighter's orders instead of its cargo and targeted component: the first
+ * word of its status report on the left, the craft or waypoint it is after on
+ * the right. TIE's report phrases start with words such as "on" and "doing",
+ * so each maps to the word XvT's rewritten phrase starts with. The status is
+ * the threat display's: disabled craft await boarding, and stopped craft on
+ * hangar/hyperspace/home orders are waiting. */
+static const char* const xvt_order_words[] = {
+	"Holding",	  /* 0x7A holding steady */
+	"Patrolling", /* 0x7B on patrol */
+	"Protecting", /* 0x7C protecting craft */
+	"Patrolling", /* 0x7D patrolling for craft to attack */
+	"Patrolling", /* 0x7E patrolling for escorters */
+	"Attacking",  /* 0x7F setting up for attack run */
+	"Attacking",  /* 0x80 attacking target */
+	"Evading",	  /* 0x81 doing evasive maneuver */
+	"Following",  /* 0x82 following flight leader */
+	"Looking",	  /* 0x83 looking for craft to disable */
+	"Escorting",  /* 0x84 flying escort */
+	"Looking",	  /* 0x85 looking for craft to board */
+	"Looking",	  /* 0x86 looking for craft to capture */
+	"Looking",	  /* 0x87 looking for craft to pick up */
+	"Docking",	  /* 0x88 performing docking operation */
+	"Flying",	  /* 0x89 flying to rendezvous point */
+	"Waiting",	  /* 0x8A awaiting boarding craft */
+	"Awaiting",	  /* 0x8B awaiting boarding */
+	"Holding",	  /* 0x8C holding station */
+	"Flying",	  /* 0x8D flying home */
+	"Entering",	  /* 0x8E entering hangar */
+	"Exiting",	  /* 0x8F exiting hangar */
+	"Hypering",	  /* 0x90 entering hyperspace */
+	"Hypering",	  /* 0x91 exiting hyperspace */
+	"Flying",	  /* 0x92 following flight plan */
+	"Awaiting",	  /* 0x93 awaiting return of craft */
+	"Awaiting",	  /* 0x94 awaiting launch of craft */
+	"Changing",	  /* 0x95 changing orders */
+	"Awaiting",	  /* 0x96 awaiting further orders */
+	"Waiting",	  /* 0x97 waiting */
+	"Deploying",  /* 0x98 dropping off craft */
+};
+
+static bool s_xvtcmd_shown;
+
+void panel_xvtcmdorders(void) {
+	uint16_t target = pstate.target_obj_idx;
+	TieHudState* hud;
+	CraftData* cp;
+	uint16_t order, link;
+	unsigned message;
+
+	if (!TieFlightTweaks_XvtHud() || target >= NUM_CRAFTS || objects[target].category ||
+		objects[target].genus != GENUS_FIGHTER) {
+		if (s_xvtcmd_shown) {
+			/* Repaint TIE's cargo and component lines. */
+			s_xvtcmd_shown = false;
+			oldinstruments[63] = -1;
+			oldinstruments[65] = -1;
+			hud = TieSnapshotBuilder_HudMut();
+			hud->target_cargo[0] = '\0';
+			hud->target_subsystem_text[0] = '\0';
+			hud->cmd_orders = 0;
+		}
+		return;
+	}
+	s_xvtcmd_shown = true;
+	hud = TieSnapshotBuilder_HudMut();
+	hud->cmd_orders = 1;
+	cp = objects[target].craft_ptr;
+
+	order = cp->current_order;
+	if (!cp->status_flags)
+		order = 42;
+	else if (!objects[target].current_speed && order >= 45 && order <= 54)
+		order = 66;
+	message = order < sizeof convertmessage ? convertmessage[order] : 0;
+	snprintf(hud->target_cargo, sizeof hud->target_cargo, "%s",
+			 message >= 0x7A && message - 0x7A < sizeof xvt_order_words / sizeof xvt_order_words[0]
+				 ? xvt_order_words[message - 0x7A]
+				 : "");
+	hud->instruments[63].color = 0x46;
+
+	link = (uint16_t)cp->ai_target_ref;
+	if (!cp->status_flags || order == 66 || link == 0xFF || link == 0xFFFF || link == target) {
+		hud->target_subsystem_text[0] = '\0';
+	} else {
+		char saved[sizeof tempstring];
+		memcpy(saved, tempstring, sizeof saved);
+		panel_buildobjectname(link, 3);
+		TieHudSnapshot_CopyFestringText(hud->target_subsystem_text, sizeof hud->target_subsystem_text,
+										(const uint8_t*)tempstring);
+		memcpy(tempstring, saved, sizeof saved);
+	}
+	hud->instruments[65].color = 0x4E;
+}
+#endif
