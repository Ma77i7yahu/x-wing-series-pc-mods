diff --git a/src/tie/laser.c b/src/tie/laser.c
index 2dfa60e..96f603f 100644
--- a/src/tie/laser.c
+++ b/src/tie/laser.c
@@ -474,6 +474,54 @@ void laser_chargeshields(uint16_t shooter_obj_idx, uint16_t shield_side, int16_t
 		shields[shield_side] = cap;
 }
 
+#ifdef TIE_MODERN
+/* X-Wing Alliance style "lasers and ion cannons fire linked": one trigger fires both
+ * cannon banks, each fully linked. Entered with the link key after "fire linked";
+ * the next press goes back to single fire. Reset when the player's craft is created. */
+static bool s_player_banks_linked;
+
+bool laser_canlinkcannonbanks(const CraftData* craft) {
+	return craft && craft->laser_group_cnt >= 2 && craft->laser_type[0] && craft->laser_type[1];
+}
+
+bool laser_playerbankslinked(void) {
+	return s_player_banks_linked && !pstate.player_weapon_mode && laser_canlinkcannonbanks(pstate.player_craft);
+}
+
+void laser_setplayerbankslinked(bool linked) { s_player_banks_linked = linked; }
+#endif
+
+/* Fires one player cannon bank if its cooldown allows; force_linked fires every cannon in it. */
+static void laser_fireplayerbank(uint16_t bank, bool force_linked) {
+	int16_t cd;
+
+	cd = (int16_t)pstate.player_craft->laser_cooldown[bank];
+	if (cd) {
+		cd -= (int16_t)frameticks;
+		if (cd < 0)
+			cd = 0;
+	}
+	if (cd < (int16_t)frameticks) {
+		if (cd)
+			pstate.player_craft->laser_cooldown[bank] -= frameticks;
+		else
+			pstate.player_craft->laser_cooldown[bank] = 0;
+
+		if (pstate.player_craft->status_flags & 0x10) {
+			uint8_t saved_mode = pstate.player_craft->laser_owner_player[bank];
+			if (force_linked)
+				pstate.player_craft->laser_owner_player[bank] = 3;
+			laser_firelasersystem(pstate.object_idx, bank);
+			pstate.player_craft->laser_owner_player[bank] = saved_mode;
+			pstate.player_craft->laser_cooldown[bank] += frameticks;
+		} else {
+			argtable[0] = (uint16_t)(bank + 29);
+			argtable[1] = 25;
+			msg_messageprintf(MSG_SYSTEM_STATUS);
+		}
+	}
+}
+
