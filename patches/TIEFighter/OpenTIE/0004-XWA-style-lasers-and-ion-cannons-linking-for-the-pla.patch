+/* XWA-style: the active AI craft fires its ion cannons with its lasers
+ * (flight.ai_ion_link). Disable orders (19) keep the original ions only. */
+static bool paifight_ionlinkwithlasers(void) {
+	int mode = TieFlightTweaks_AiIonLink();
+	if (mode == TIE_AI_ION_LINK_OFF)
+		return false;
+	if (mode == TIE_AI_ION_LINK_FRIENDLY)
+		return pstate.object_idx < NUM_OBJECTS &&
+			   objects[ai.active_obj_idx].side == objects[pstate.object_idx].side;
+	return true;
+}
+#endif
