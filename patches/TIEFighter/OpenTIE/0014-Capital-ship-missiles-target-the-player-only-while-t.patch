From 0d9fde1eff9e49ea790e4c043be05cdbfc50169e Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sun, 11 Oct 2026 11:45:28 +1100
Subject: [PATCH 14/18] Capital ship missiles target the player only while
 targeted for 2 s, as in XvT (flight.xvt_capital_missiles)

---
 resources/config.yaml                 |  4 ++++
 src/tie/laser.c                       | 19 +++++++++++++++++++
 src/tie/laser.h                       |  2 ++
 src/tie/paifight.c                    | 19 ++++++++++++++++---
 src/tie_app/config/app_config.c       |  2 +-
 src/tie_app/settings/settings.c       |  2 ++
 src/tie_runtime/hooks/flight_tweaks.c |  4 ++--
 src/tie_runtime/hooks/flight_tweaks.h |  4 ++++
 8 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/resources/config.yaml b/resources/config.yaml
index 84f02ba..f382f45 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -76,6 +76,10 @@ flight:
   # energy transfers, weapon selection and the throttle keys
   # (resources/xvt_control_sounds).
   xvt_control_sounds: true
+  # Capital ships launch missiles at you only while you keep them targeted (after
+  # 2 seconds, so T can scroll past), as in X-Wing vs TIE Fighter, rather than at
+  # whoever last hit them for the rest of the mission.
+  xvt_capital_missiles: true
   models:
     source: original
     smooth_angle_degrees: 90
diff --git a/src/tie/laser.c b/src/tie/laser.c
index 5884029..ca7c198 100644
--- a/src/tie/laser.c
+++ b/src/tie/laser.c
@@ -128,6 +128,12 @@ enum {
 	SLAM_DISENGAGED = ((uint16_t)-1),
 };
 
+#ifdef TIE_MODERN
+/* How long the player has held the current target (laser_playertargetheldticks). */
+static uint16_t s_held_target = 0xFFFF;
+static uint16_t s_held_ticks;
+#endif
+
 /* ================================================================== */
 /* laser_weaponsfire -- per-frame master dispatch.                     */
 /* ================================================================== */
@@ -139,6 +145,15 @@ void laser_weaponsfire(void) {
 	uint16_t n;
 	uint16_t s;
 
+#ifdef TIE_MODERN
+	if (pstate.target_obj_idx != s_held_target) {
+		s_held_target = pstate.target_obj_idx;
+		s_held_ticks = 0;
+	} else if (s_held_ticks < 0x7FFF) {
+		s_held_ticks = (uint16_t)(s_held_ticks + frameticks);
+	}
+#endif
+
 	/* ----- Phase 1: missile lock gauge --------------------------- */
 	if (pstate.player_weapon_mode) {
 		uint16_t missile_hp = spec_data[pstate.player_spec_num].missile_start[pstate.player_weapon_group];
@@ -512,6 +527,10 @@ void laser_setplayerbankslinked(bool linked) { s_player_banks_linked = linked; }
 #endif
 
 #ifdef TIE_MODERN
+uint16_t laser_playertargetheldticks(uint16_t obj_idx) {
+	return obj_idx == s_held_target && obj_idx == pstate.target_obj_idx ? s_held_ticks : 0;
+}
+
 int laser_playerlauncherwarheads(uint16_t group) {
 	const CraftData* cp = pstate.player_craft;
 	uint16_t slot;
diff --git a/src/tie/laser.h b/src/tie/laser.h
index a85a382..b94358e 100644
--- a/src/tie/laser.h
+++ b/src/tie/laser.h
@@ -173,6 +173,8 @@ void laser_fireplayerweapon(void);
 bool laser_canlinkcannonbanks(const CraftData* craft);
 bool laser_playerbankslinked(void);
 void laser_setplayerbankslinked(bool linked);
+/* Ticks the player has kept obj_idx as the current target; 0 when it is not the target. */
+uint16_t laser_playertargetheldticks(uint16_t obj_idx);
 /* flight.skip_empty_warheads: warheads left in the player's launcher group (all of its racks). */
 int laser_playerlauncherwarheads(uint16_t group);
 /* Points a single-fire launcher at its fuller rack, so an uneven pair never tries the empty one. */
diff --git a/src/tie/paifight.c b/src/tie/paifight.c
index aea1d86..d073c78 100644
--- a/src/tie/paifight.c
+++ b/src/tie/paifight.c
@@ -59,6 +59,10 @@ int32_t shooterz;
 uint8_t escortfg;
 
 #ifdef TIE_MODERN
+/* flight.xvt_capital_missiles: 2 s of the player holding a capital ship as the target before it may launch
+ * at the player. */
+enum { PAIFIGHT_CAPITAL_MISSILE_GRACE_TICKS = 2 * 236 };
+
 /* XWA-style: the active AI craft fires its ion cannons with its lasers
  * (flight.ai_ion_link). Disable orders (19) keep the original ions only. */
 static bool paifight_ionlinkwithlasers(void) {
@@ -967,9 +971,18 @@ int16_t paifight_missiledefenseorder(void) {
 					if (!objects[a].ship_idx)
 						continue;
 					ac = objects[a].craft_ptr;
-					if (!(((uint16_t)ac->ai_target_ref == ai.active_obj_idx &&
-						   (ac->mode_byte == 12 || ac->mode_byte == 23)) ||
-						  a == craftptr->attacker_idx))
+#ifdef TIE_MODERN
+					/* flight.xvt_capital_missiles (OpenXvT paifight turret warheads): the player is a missile
+					 * target only while targeting this ship, after a short grace so T can scroll past it.
+					 * TIE also fired at whoever last hit the ship, for the rest of the mission. */
+					if (a == pstate.object_idx && TieFlightTweaks_XvtCapitalMissiles()) {
+						if (laser_playertargetheldticks(ai.active_obj_idx) < PAIFIGHT_CAPITAL_MISSILE_GRACE_TICKS)
+							continue;
+					} else
+#endif
+						if (!(((uint16_t)ac->ai_target_ref == ai.active_obj_idx &&
+							   (ac->mode_byte == 12 || ac->mode_byte == 23)) ||
+							  a == craftptr->attacker_idx))
 						continue;
 
 					if (!pai_worthytarget(a))
diff --git a/src/tie_app/config/app_config.c b/src/tie_app/config/app_config.c
index c3cebfd..f36a506 100644
--- a/src/tie_app/config/app_config.c
+++ b/src/tie_app/config/app_config.c
@@ -185,7 +185,7 @@ static bool TieAppConfig_ValidateSchemaKeys(const AeronConfigFile* document, boo
 				  "player_engine_sound", "fix_axis_input_bias", "widescreen", "cockpit_stretch", "widescreen_hud",
 				  "laser_convergence", "xvt_lasers", "ai_ion_link", "xvt_throttle", "xvt_hud", "xvt_shields",
 				  "xvt_turning", "xvt_engine_wash", "start_overshield", "xvt_recharge", "skip_empty_warheads",
-				  "xvt_control_sounds", "models");
+				  "xvt_control_sounds", "xvt_capital_missiles", "models");
 	VALIDATE_KEYS(document, "flight.models", warn, "source", "smooth_angle_degrees", "opt_emissive_strength",
 				  "opt_projectile_emissive_strength");
 	VALIDATE_KEYS(document, "input", warn, "controllers", "gamepad_defaults", "keyboard", "mouse_flight",
diff --git a/src/tie_app/settings/settings.c b/src/tie_app/settings/settings.c
index 3f0b187..d89e8c9 100644
--- a/src/tie_app/settings/settings.c
+++ b/src/tie_app/settings/settings.c
@@ -827,6 +827,8 @@ static void TieSettings_GamePage(AeronUiContext* ui) {
 		{ TIE_XVT_OPTION_RECHARGE, "Recharge Rates", "XvT: faster T/F and T/B laser, and Y-Wing shield, recharge." },
 		{ TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS, "Empty Warhead Launchers",
 		  "XvT: W skips empty launchers; back to lasers after the last warhead." },
