 	};
 	static const char* const xvt_styles[] = { "TIE Fighter", "X-Wing vs TIE Fighter" };
 	for (size_t row = 0; row < sizeof xvt_rows / sizeof xvt_rows[0]; ++row) {
diff --git a/src/tie_runtime/hooks/flight_tweaks.c b/src/tie_runtime/hooks/flight_tweaks.c
index 8d56a0f..67bc156 100644
--- a/src/tie_runtime/hooks/flight_tweaks.c
+++ b/src/tie_runtime/hooks/flight_tweaks.c
@@ -38,12 +38,12 @@ bool TieFlightTweaks_XvtHud(void) { return s_xvt_hud; }
 
 void TieFlightTweaks_SetXvtHud(bool enabled) { s_xvt_hud = enabled; }
 
-static bool s_xvt_options[TIE_XVT_OPTION_COUNT] = { true, true, true, true, true, true, true };
+static bool s_xvt_options[TIE_XVT_OPTION_COUNT] = { true, true, true, true, true, true, true, true };
 
 const char* TieFlightTweaks_XvtOptionKey(int option) {
 	static const char* const keys[TIE_XVT_OPTION_COUNT] = {
 		"xvt_shields",	  "xvt_turning",		 "xvt_engine_wash",	   "start_overshield",
-		"xvt_recharge", "skip_empty_warheads", "xvt_control_sounds",
+		"xvt_recharge", "skip_empty_warheads", "xvt_control_sounds", "xvt_capital_missiles",
 	};
 	return option >= 0 && option < TIE_XVT_OPTION_COUNT ? keys[option] : "";
 }
diff --git a/src/tie_runtime/hooks/flight_tweaks.h b/src/tie_runtime/hooks/flight_tweaks.h
index 099f273..451b4b2 100644
--- a/src/tie_runtime/hooks/flight_tweaks.h
+++ b/src/tie_runtime/hooks/flight_tweaks.h
@@ -56,6 +56,7 @@ enum {
 	TIE_XVT_OPTION_RECHARGE,
 	TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS,
 	TIE_XVT_OPTION_CONTROL_SOUNDS,
+	TIE_XVT_OPTION_CAPITAL_MISSILES,
 	TIE_XVT_OPTION_COUNT
 };
 /* The option's key under flight: in config.yaml ("xvt_shields" ...). */
@@ -69,5 +70,8 @@ void TieFlightTweaks_SetXvtOption(int option, bool enabled);
 #define TieFlightTweaks_XvtRecharge() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_RECHARGE)
 #define TieFlightTweaks_SkipEmptyWarheads() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS)
 #define TieFlightTweaks_XvtControlSounds() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_CONTROL_SOUNDS)
+/* xvt_capital_missiles: capital ship missile launchers fire at the player only while the player has held that
+ * ship as the target for 2 s, not at whoever last hit the ship. */
+#define TieFlightTweaks_XvtCapitalMissiles() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_CAPITAL_MISSILES)
 
 #endif
