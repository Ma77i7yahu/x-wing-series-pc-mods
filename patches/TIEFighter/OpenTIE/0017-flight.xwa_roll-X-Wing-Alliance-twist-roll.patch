+/* Widescreen and convergence options live with the flight options but do not
+ * change the flight profile, so they apply without queueing a profile switch. */
+static void TieSettings_SetFlightTweaks(const TieAppLiveFlightOptions* flight) {
+	char error[512];
+	if (!TieFlightOptions_Set(flight, error, sizeof error))
+		TieSettings_SettingsReportError(error);
+}
