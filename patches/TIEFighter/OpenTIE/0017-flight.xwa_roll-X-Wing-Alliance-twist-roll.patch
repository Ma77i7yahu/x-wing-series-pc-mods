 	/* The turn command is carried in int16 smoothing state. */
 	return (uint16_t)(result > 0x7FFF ? 0x7FFF : result);
 }
+
+/* xwa_roll: X-Wing Alliance's twist-roll gain (OpenXWA flight.c player integration), Q15 like
+ * the roll_rate_cache percentage. XWA scales the ModelDef rollRate by XvT's throttle curve and
+ * power steps (always, not only with xvt_turning) and rolls input * rate / 14336; the result is
+ * applied twice over, as here. -1 keeps TIE Fighter's own rate (craft XWA has no rate for). */
+static int32_t user_xwarollgain(void) {
+	enum { PEAK = 0x5555, POWER_NEUTRAL = 4, POWER_STEP = 0xC00 };
+	const CraftData* cp = pstate.player_craft;
+	int32_t rate;
+	int32_t throttle;
+	int32_t scale;
+	int32_t redirect;
+
+	if (!TieFlightTweaks_XwaRoll() || !cp)
+		return -1;
+	switch (objects[pstate.object_idx].ship_idx) {
+		case SPECIES_X_WING: rate = 9216; break;
+		case SPECIES_Y_WING: rate = 7168; break;
+		case SPECIES_A_WING: rate = 12288; break;
+		case SPECIES_B_WING: rate = 8704; break;
+		case SPECIES_TIE_FIGHTER: rate = 11776; break;
+		case SPECIES_TIE_INTERCEPTOR: rate = 12800; break;
+		case SPECIES_TIE_BOMBER: rate = 10752; break;
+		case SPECIES_TIE_ADVANCED: rate = 12800; break;
+		case SPECIES_TIE_DEFENDER: rate = 12800; break;
+		case SPECIES_MISSILE_BOAT: rate = 13312; break;
+		case SPECIES_T_WING: rate = 9216; break;
+		case SPECIES_Z_95_HEADHUNTER: rate = 10752; break;
+		case SPECIES_R_41_STARCHASER: rate = 8960; break;
+		case SPECIES_ASSAULT_GUNBOAT: rate = 10240; break;
+		default: return -1;
+	}
+	throttle = (cp->status_flags & 0x40) ? (int32_t)cp->throttle_speed + 1 : 0;
+	scale = throttle < PEAK ? 2 * throttle + PEAK : 0x10000 - (throttle - PEAK) / 2;
+	if (cp->subsystem_active & 1)
+		redirect = cp->shield_power + cp->laser_power;
+	else
+		redirect = 2 * cp->laser_power;
+	rate = (int32_t)(((int64_t)rate * scale) >> 16);
+	rate += (int32_t)(((int64_t)rate * POWER_STEP * (POWER_NEUTRAL - redirect)) >> 16);
+	return rate < 0 ? 0 : (int32_t)(((int64_t)rate * 32768) / 14336);
+}
