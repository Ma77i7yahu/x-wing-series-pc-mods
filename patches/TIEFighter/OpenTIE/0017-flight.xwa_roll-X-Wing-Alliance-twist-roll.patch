+								 : TieAxisInputHook_Scale(user_xvtturngain((uint16_t)(math2_percentage(
+															  pstate.player_craft->roll_rate_cache, 0x3000u) >>
+														  1)),
+														  inputdeltaroll);
+			}
 #endif
 			if ((pstate.player_craft->status_flags & 0x20) == 0) {
 				x_input = 0;
@@ -2536,7 +2585,7 @@ void user_inputforplane(void) {
 				 * analog roll input, so the auto component does not fight the
