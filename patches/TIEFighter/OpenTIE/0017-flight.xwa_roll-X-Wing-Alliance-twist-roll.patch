-  # Start each mission with the shields charged to double strength, as in XvT.
-  start_overshield: true
-  # Recharge as in X-Wing vs TIE Fighter: TIE Fighter and TIE Bomber cannons
-  # recharge half again as fast, Y-Wing shields twice as fast. Base rates match.
