+bool TieAppConfig_SetVideo(TieAppConfigState* state, const TieAppVideoConfig* video, char* error,
+						   size_t capacity) {
+	AeronConfigFile* candidate = NULL;
+	AeronConfigError aeron_error = { 0 };
+	if (!state || !video)
