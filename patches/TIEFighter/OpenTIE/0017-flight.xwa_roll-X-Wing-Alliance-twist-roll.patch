+	}
+	bool launch_accepted = true;
+	if (launch_changed && !TieLaunchOptions_Set(&launch)) {
+		TieSettings_SettingsReportError("invalid launch settings");
+		launch_accepted = false;
+	}
+	bool flight_accepted = true;
+	if (flight_changed) {
+		char error[512];
+		if (!TieFlightOptions_Set(&flight, error, sizeof error)) {
+			TieSettings_SettingsReportError(error);
+			flight_accepted = false;
+		}
+	}
+	if ((launch_changed || flight_changed) && launch_accepted && flight_accepted) {
+		char error[512] = { 0 };
+		if (!TieSettings_RequestSelectedFlightProfile(&launch, &flight, error, sizeof error))
+			TieSettings_SettingsReportError(error[0] ? error : "could not queue the selected flight engine");
+	}
+	AeronUi_Help(ui, "Flight-engine and update-rate changes take effect on the next flight.");
+	TieSettings_LaunchRestartNotice(ui);
+
+	AeronUi_Spacer(ui, 8.0f);
+	AeronUi_Header(ui, "Flight Gameplay");
+	bool inflight_changed = false;
+	int collision = inflight.starfighter_collision_damage;
+	if (AeronUi_Selector(ui, "Starfighter Collision Damage", &collision, off_on, 2)) {
+		inflight.starfighter_collision_damage = collision != 0;
+		inflight_changed = true;
+	}
+	int invulnerable = inflight.player_invulnerable;
+	if (AeronUi_Selector(ui, "Player Spacecraft", &invulnerable, vulnerability, 2)) {
+		inflight.player_invulnerable = invulnerable != 0;
+		inflight_changed = true;
+	}
+	int unlimited = inflight.unlimited_ammunition;
+	if (AeronUi_Selector(ui, "Ammunition", &unlimited, ammunition, 2)) {
+		inflight.unlimited_ammunition = unlimited != 0;
+		inflight_changed = true;
+	}
+	if (inflight_changed) {
+		char error[512];
+		if (!TieInflightSettings_Set(&inflight, error, sizeof error))
+			TieSettings_SettingsReportError(error);
+	}
+
+	static const int convergence_values[] = { 0, 300, 400, 550, 700, 1000 };
+	static const char* const convergence_labels[] = { "Off (Parallel)", "300 m", "400 m",
+													  "550 m",          "700 m", "1000 m" };
+	TieAppLiveFlightOptions tweaks;
+	TieFlightOptions_Get(&tweaks);
+	int convergence = 0;
+	for (int index = 1; index < 6; ++index)
+		if (tweaks.laser_convergence_m >= convergence_values[index])
+			convergence = index;
+	if (AeronUi_Selector(ui, "Laser Convergence", &convergence, convergence_labels, 6)) {
+		tweaks.laser_convergence_m = convergence_values[convergence];
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, "Lasers converge on the target ahead, or at this distance; parallel with no target.");
+	static const char* const laser_styles[] = { "TIE Fighter", "X-Wing vs TIE Fighter" };
+	int laser_style = tweaks.xvt_lasers;
+	if (AeronUi_Selector(ui, "Laser Rate and Speed", &laser_style, laser_styles, 2)) {
+		tweaks.xvt_lasers = laser_style != 0;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	static const char* const throttle_styles[] = { "TIE Fighter", "X-Wing vs TIE Fighter" };
+	int throttle_style = tweaks.xvt_throttle;
+	if (AeronUi_Selector(ui, "Acceleration and Braking", &throttle_style, throttle_styles, 2)) {
+		tweaks.xvt_throttle = throttle_style != 0;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, throttle_style ? "All craft accelerate and brake at XvT rates; big throttle cuts brake fast."
+									: "Original: slow acceleration, and throttle cuts shed only 20 speed per second.");
+	static const char* const roll_styles[] = { "TIE Fighter", "X-Wing Alliance" };
+	int roll_style = tweaks.xvt_options[TIE_XVT_OPTION_XWA_ROLL];
+	if (AeronUi_Selector(ui, "Twist Roll", &roll_style, roll_styles, 2)) {
+		tweaks.xvt_options[TIE_XVT_OPTION_XWA_ROLL] = roll_style != 0;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, roll_style ? "The roll axis rolls at XWA's rate for each craft; turns still bank while you twist."
+								: "Original: TIE Fighter's roll rate; twisting switches off the bank into turns.");
+	static const char* const ion_link_labels[] = { "Off", "Friendly Only", "All Craft" };
+	int ion_link = tweaks.ai_ion_link;
+	if (AeronUi_Selector(ui, "AI Laser & Ion Linking", &ion_link, ion_link_labels, 3)) {
+		tweaks.ai_ion_link = ion_link;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, ion_link == TIE_AI_ION_LINK_OFF
+						 ? "Original: AI craft fire lasers, and ion cannons only on disable orders."
+						 : "AI Gunboats, Defenders, Y-Wings, B-Wings etc. fire ions with lasers (ions only to disable).");
+	static const struct {
+		int option;
+		const char* label;
+		const char* help;
+	} xvt_rows[] = {
+		{ TIE_XVT_OPTION_SHIELDS, "Shield Hits", "XvT: a hit draws energy from the other shield, then shields balance." },
+		{ TIE_XVT_OPTION_TURNING, "Turning", "XvT: tightest turns at 1/3 throttle; power settings change the rate." },
+		{ TIE_XVT_OPTION_ENGINE_WASH, "Engine Wash", "XvT: damage and sound behind capital ship engines." },
+		{ TIE_XVT_OPTION_START_OVERSHIELD, "Shields at Launch", "XvT: start each mission with double shields." },
+		{ TIE_XVT_OPTION_RECHARGE, "Recharge Rates", "XvT: faster T/F and T/B laser, and Y-Wing shield, recharge." },
+		{ TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS, "Empty Warhead Launchers",
+		  "XvT: W skips empty launchers; back to lasers after the last warhead." },
+		{ TIE_XVT_OPTION_CAPITAL_MISSILES, "Capital Ship Missiles",
+		  "XvT: they launch at you only while you keep them targeted (2 s grace)." },
+	};
+	static const char* const xvt_styles[] = { "TIE Fighter", "X-Wing vs TIE Fighter" };
+	for (size_t row = 0; row < sizeof xvt_rows / sizeof xvt_rows[0]; ++row) {
+		int style = tweaks.xvt_options[xvt_rows[row].option];
+		if (AeronUi_Selector(ui, xvt_rows[row].label, &style, xvt_styles, 2)) {
+			tweaks.xvt_options[xvt_rows[row].option] = style != 0;
+			TieSettings_SetFlightTweaks(&tweaks);
+		}
+		if (style)
+			AeronUi_Help(ui, xvt_rows[row].help);
+	}
+	int bonus_goals = tweaks.xvt_options[TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS];
+	if (AeronUi_Toggle(ui, "Show Bonus Goals in Campaign", &bonus_goals)) {
+		tweaks.xvt_options[TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS] = bonus_goals != 0;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, bonus_goals ? "The goals screen lists bonus goals in Tour of Duty missions, as in the simulator."
+								 : "Original: campaign bonus goals stay hidden until you complete them.");
+}
