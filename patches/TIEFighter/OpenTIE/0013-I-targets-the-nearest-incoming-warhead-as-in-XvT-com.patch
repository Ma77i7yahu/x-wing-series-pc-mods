 #define USER_XVT_ONLY_SOUND(xvt) ((void)TieXvtSounds_PlayControl(xvt))
 static uint16_t user_nextattacker(void);
+static uint16_t user_findincomingwarhead(void);
 
 /* flight.xvt_turning, XvT's player turn rate (OpenXvT player.c): the throttle setting t maps to 1/3 + 2t
  * below 1/3 throttle and to 1 - (t - 1/3)/2 above it, so turns are tightest at 1/3 throttle (TIE's own
@@ -1875,8 +1876,25 @@ void user_inputforplane(void) {
 				}
 				break;
 			}
+#ifdef TIE_MODERN
+			/* 'i': XvT's nearest warhead homing on the player, else on a friendly craft. */
+			case KEY_i: {
+				uint16_t warhead = user_findincomingwarhead();
+
+				if (warhead == 0xFFFF)
+					break;
+				user_setnewtarget(warhead);
+				/* Targeting the announced warhead answers its "Key to Target?" prompt, as Space does. */
+				if (pstate.space_confirm_action == 1 && warhead == (uint16_t)pstate.msg_arg_obj_idx)
+					pstate.space_confirm_action = 0;
+				break;
+			}
+			/* Alt+I (TIE's I): component tracking toggle. */
+			case KEY_ALT_I: {
+#else
 			/* 'i': radar toggle. */
 			case KEY_i: {
+#endif
 				pstate.radar_enable ^= 1u;
 				argtable[0] = (uint16_t)(pstate.radar_enable + 86);
 				msg_messageprintf(MSG_CMD_TRACK_TOGGLE);
@@ -3664,6 +3682,38 @@ static bool user_isattackerof(uint16_t idx, uint16_t obj_idx) {
 		   (!cp->flight_flag || cp->flight_flag == 6);
 }
 
+/* I, as XvT's (OpenXvT player.c): the nearest warhead homing on the player, else the nearest homing on a
+ * craft of the player's side. Laser bolts share the projectile slots; only warhead species count. */
+static uint16_t user_findincomingwarhead(void) {
+	uint16_t player = pstate.object_idx;
+	uint16_t nearest = 0xFFFF;
+	uint32_t nearest_dist = 0xFFFFFFFFu;
+	int pass;
+	uint16_t obj;
+
+	for (pass = 0; pass < 2 && nearest == 0xFFFF; ++pass) {
+		for (obj = NUM_CRAFTS; obj < WARHEAD_SLOT_END; ++obj) {
+			uint16_t species = objects[obj].ship_idx;
+			uint16_t target;
+
+			if (!species || (unsigned int)(species - WEAPON_SPECIES_BASE) >= WARHEAD_TYPE_COUNT ||
+				!projectile_is_warhead_type[species - WEAPON_SPECIES_BASE])
+				continue;
+			target = warheads[obj - NUM_CRAFTS].target_obj;
+			if (pass == 0 ? target != player
+						  : target == player || target >= NUM_CRAFTS || !objects[target].ship_idx ||
+								objects[target].side != objects[player].side)
+				continue;
+			pai_distancebetween(player, obj);
+			if ((uint32_t)trig2_polardistance < nearest_dist) {
+				nearest = obj;
+				nearest_dist = (uint32_t)trig2_polardistance;
+			}
+		}
+	}
+	return nearest;
+}
+
 /* E, cycling as XvT's does (OpenXvT flight.c FLIGHT_KEY_E): when the current target is attacking the player,
  * the next attacker after it in slot order, wrapping; otherwise TIE's nearest attacker. */
 static uint16_t user_nextattacker(void) {
