From 82e6b8bda66fd18af11b433c9c5d9a57cc7cd785 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Tue, 10 Nov 2026 07:33:20 +1100
Subject: [PATCH 16/18] Goals screen lists campaign bonus goals as in the
 combat simulator (flight.campaign_bonus_goals)

Retail sets showbonusgoals off for Tour of Duty missions, hiding bonus goals
until completed. The new option (default on, Game page toggle) keeps it on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 resources/config.yaml                 | 3 +++
 src/tie/goals.c                       | 6 ++++++
 src/tie_app/config/app_config.c       | 2 +-
 src/tie_app/settings/settings.c       | 7 +++++++
 src/tie_runtime/hooks/flight_tweaks.c | 3 ++-
 src/tie_runtime/hooks/flight_tweaks.h | 4 ++++
 6 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/resources/config.yaml b/resources/config.yaml
index f382f45..ff4901f 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -80,6 +80,9 @@ flight:
   # 2 seconds, so T can scroll past), as in X-Wing vs TIE Fighter, rather than at
   # whoever last hit them for the rest of the mission.
   xvt_capital_missiles: true
+  # The goals screen lists bonus goals in campaign (Tour of Duty) missions too,
+  # as the combat simulator does. The original hides them until completed.
+  campaign_bonus_goals: true
   models:
     source: original
     smooth_angle_degrees: 90
diff --git a/src/tie/goals.c b/src/tie/goals.c
index 85dd20e..61bfc50 100644
--- a/src/tie/goals.c
+++ b/src/tie/goals.c
@@ -2,6 +2,7 @@
 #ifdef TIE_MODERN
 #include "tie_runtime/display/classic_display.h"
 #include "tie_runtime/runtime/goals_task.h"
+#include "tie_runtime/hooks/flight_tweaks.h"
 #endif
 #include "tie/edition.h"
 #include "tie/flight_surface_tie98.h"
@@ -175,6 +176,11 @@ int32_t goals_missiongoalsroom(void) {
 		}
 
 		showbonusgoals = (uint8_t)(mission.mission_mode != 4);
+#ifdef TIE_MODERN
+		/* flight.campaign_bonus_goals: list them in Tour of Duty missions as in the combat simulator. */
+		if (TieFlightTweaks_CampaignBonusGoals())
+			showbonusgoals = 1;
+#endif
 
 		festring_setlinewrap(0);
 		festring_setautofill(1);
diff --git a/src/tie_app/config/app_config.c b/src/tie_app/config/app_config.c
index f36a506..8a42c8b 100644
--- a/src/tie_app/config/app_config.c
+++ b/src/tie_app/config/app_config.c
@@ -185,7 +185,7 @@ static bool TieAppConfig_ValidateSchemaKeys(const AeronConfigFile* document, boo
 				  "player_engine_sound", "fix_axis_input_bias", "widescreen", "cockpit_stretch", "widescreen_hud",
 				  "laser_convergence", "xvt_lasers", "ai_ion_link", "xvt_throttle", "xvt_hud", "xvt_shields",
 				  "xvt_turning", "xvt_engine_wash", "start_overshield", "xvt_recharge", "skip_empty_warheads",
-				  "xvt_control_sounds", "xvt_capital_missiles", "models");
+				  "xvt_control_sounds", "xvt_capital_missiles", "campaign_bonus_goals", "models");
 	VALIDATE_KEYS(document, "flight.models", warn, "source", "smooth_angle_degrees", "opt_emissive_strength",
 				  "opt_projectile_emissive_strength");
 	VALIDATE_KEYS(document, "input", warn, "controllers", "gamepad_defaults", "keyboard", "mouse_flight",
diff --git a/src/tie_app/settings/settings.c b/src/tie_app/settings/settings.c
index d89e8c9..e8e66dc 100644
--- a/src/tie_app/settings/settings.c
+++ b/src/tie_app/settings/settings.c
@@ -840,6 +840,13 @@ static void TieSettings_GamePage(AeronUiContext* ui) {
 		if (style)
 			AeronUi_Help(ui, xvt_rows[row].help);
 	}
+	int bonus_goals = tweaks.xvt_options[TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS];
+	if (AeronUi_Toggle(ui, "Show Bonus Goals in Campaign", &bonus_goals)) {
+		tweaks.xvt_options[TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS] = bonus_goals != 0;
+		TieSettings_SetFlightTweaks(&tweaks);
+	}
+	AeronUi_Help(ui, bonus_goals ? "The goals screen lists bonus goals in Tour of Duty missions, as in the simulator."
+								 : "Original: campaign bonus goals stay hidden until you complete them.");
 }
 
 /* Follows OpenXW's mouse page with TIE's button behavior. */
diff --git a/src/tie_runtime/hooks/flight_tweaks.c b/src/tie_runtime/hooks/flight_tweaks.c
index 67bc156..f72693c 100644
--- a/src/tie_runtime/hooks/flight_tweaks.c
+++ b/src/tie_runtime/hooks/flight_tweaks.c
@@ -38,12 +38,13 @@ bool TieFlightTweaks_XvtHud(void) { return s_xvt_hud; }
 
 void TieFlightTweaks_SetXvtHud(bool enabled) { s_xvt_hud = enabled; }
 
-static bool s_xvt_options[TIE_XVT_OPTION_COUNT] = { true, true, true, true, true, true, true, true };
+static bool s_xvt_options[TIE_XVT_OPTION_COUNT] = { true, true, true, true, true, true, true, true, true };
 
 const char* TieFlightTweaks_XvtOptionKey(int option) {
 	static const char* const keys[TIE_XVT_OPTION_COUNT] = {
 		"xvt_shields",	  "xvt_turning",		 "xvt_engine_wash",	   "start_overshield",
 		"xvt_recharge", "skip_empty_warheads", "xvt_control_sounds", "xvt_capital_missiles",
+		"campaign_bonus_goals",
 	};
 	return option >= 0 && option < TIE_XVT_OPTION_COUNT ? keys[option] : "";
 }
diff --git a/src/tie_runtime/hooks/flight_tweaks.h b/src/tie_runtime/hooks/flight_tweaks.h
index 451b4b2..cd28e2a 100644
--- a/src/tie_runtime/hooks/flight_tweaks.h
+++ b/src/tie_runtime/hooks/flight_tweaks.h
@@ -57,6 +57,7 @@ enum {
 	TIE_XVT_OPTION_SKIP_EMPTY_WARHEADS,
 	TIE_XVT_OPTION_CONTROL_SOUNDS,
 	TIE_XVT_OPTION_CAPITAL_MISSILES,
+	TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS,
 	TIE_XVT_OPTION_COUNT
 };
 /* The option's key under flight: in config.yaml ("xvt_shields" ...). */
@@ -73,5 +74,8 @@ void TieFlightTweaks_SetXvtOption(int option, bool enabled);
 /* xvt_capital_missiles: capital ship missile launchers fire at the player only while the player has held that
  * ship as the target for 2 s, not at whoever last hit the ship. */
 #define TieFlightTweaks_XvtCapitalMissiles() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_CAPITAL_MISSILES)
+/* campaign_bonus_goals: the goals screen lists bonus goals in Tour of Duty missions too, as the combat
+ * simulator does. Retail hides them there until they are completed (goals.c showbonusgoals). */
+#define TieFlightTweaks_CampaignBonusGoals() TieFlightTweaks_XvtOption(TIE_XVT_OPTION_CAMPAIGN_BONUS_GOALS)
 
 #endif
