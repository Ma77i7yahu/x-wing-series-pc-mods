+static const char* const g_hostConfigPointDefenseNames[XWA_POINT_DEFENSE_COUNT] = { "original", "reduced",
+																					 "off" };
+
+/* Lenient: an unknown value logs a warning and keeps the default rather than
+ * refusing to start, since this is a convenience setting. */
+static void host_config_point_defense(const AeronConfigFile* config, XwaPointDefense* out) {
+	const AeronConfigNode* node = AeronConfigFile_GetNode(config, "gameplay.point_defense");
+	const char* value;
+	int index;
+
+	if (!node) {
+		return;
+	}
+	/* YAML reads a bare off as boolean false. */
+	if (AeronConfigNode_Type(node) == AERON_CONFIG_BOOL) {
+		if (!AeronConfigNode_Bool(node, 1)) {
+			*out = XWA_POINT_DEFENSE_OFF;
+			return;
+		}
+	} else if ((value = AeronConfigNode_String(node, NULL)) != NULL) {
+		for (index = 0; index < XWA_POINT_DEFENSE_COUNT; ++index) {
+			if (strcmp(value, g_hostConfigPointDefenseNames[index]) == 0) {
+				*out = (XwaPointDefense)index;
+				return;
+			}
+		}
+	}
+	Aeron_LogWarn("xwa.config", "ignoring invalid 'gameplay.point_defense'; expected original, reduced, or off");
+}
