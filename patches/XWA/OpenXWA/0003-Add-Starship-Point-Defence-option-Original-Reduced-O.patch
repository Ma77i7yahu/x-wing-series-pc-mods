diff --git a/src/xwa/flight/ai/paifight.c b/src/xwa/flight/ai/paifight.c
index bdec87c..ee9f362 100644
--- a/src/xwa/flight/ai/paifight.c
+++ b/src/xwa/flight/ai/paifight.c
@@ -1,5 +1,9 @@
 #include "xwa/flight/ai/ai_internal.h"
 
+#ifdef XWA_MODERN
+#include "xwa_runtime/config/modern_gameplay_options.h"
+#endif
+
 // GLOBAL: XWA 0x917E60
 int g_paifightSearchOriginX;
 
@@ -34,6 +38,44 @@ static __inline int paifight_HasClearTurretSelfDefenseShotZXY(uint16_t targetObj
 static __inline int paifight_GunnerSelfDefenseTargetIsAlreadyCovered(uint16_t targetObjIdx);
 static __inline int paifight_IsCraftAttackingSelf(uint16_t candidateObjIdx, CraftData* candidateCraft);
 
+#ifdef XWA_MODERN
+/* OpenXWA point-defence setting: whether the current AI craft's turrets may
+ * engage this warhead. Only freighters, starships and platforms are affected;
+ * turreted transports such as the YT series keep their original defence.
+ * REDUCED rolls once per warhead (kept in mobj->pointDefenseRoll) so a skipped
+ * warhead stays skipped for its whole flight. The roll uses its own generator
+ * so the game's GameRand sequence is unchanged. */
+static int paifight_PointDefenseMayEngageWarhead(uint16_t projectileObjIdx) {
+	static uint32_t s_rollState = 0x2545f491u;
+	MobileObject* mobj;
+	int defenderGenus;
+
+	defenderGenus = g_objectTable[g_paiContext.aiObjIdx].genusId;
+	if (defenderGenus != GENUS_Freighter && defenderGenus != GENUS_Starship && defenderGenus != GENUS_Platform) {
+		return 1;
+	}
+	switch (XwaModernGameplayOptions_GetPointDefense()) {
+		case XWA_POINT_DEFENSE_OFF:
+			return 0;
+		case XWA_POINT_DEFENSE_REDUCED:
+			break;
+		default:
+			return 1;
+	}
+	mobj = g_objectTable[projectileObjIdx].mobj;
+	if (mobj->pointDefenseRoll == 0) {
+		s_rollState ^= s_rollState << 13;
+		s_rollState ^= s_rollState >> 17;
+		s_rollState ^= s_rollState << 5;
+		mobj->pointDefenseRoll =
+			(uint8_t)((s_rollState % 100u) < XWA_POINT_DEFENSE_REDUCED_ENGAGE_PERCENT ? 1 : 2);
+	}
+	return mobj->pointDefenseRoll == 1;
+}
+#else
+#define paifight_PointDefenseMayEngageWarhead(projectileObjIdx) 1
+#endif
+
 // FUNCTION: XWA 0x4A83F0
 uint16_t paifight_SelectTargetComponentMesh(uint16_t targetObjIdx) {
 	uint16_t targetMesh;
@@ -718,7 +760,8 @@ int16_t paifight_FindNearestAttackerOfMatchingTarget(uint16_t target1Type, uint1
 #else
 							g_projectileWarheadClassByType[projectileType - OBJ_LaserRebel] != 0 &&
 #endif
-							projectileObject->mobj->pWarheadGuidance->targetObjIdx == targetObjIdx) {
+							projectileObject->mobj->pWarheadGuidance->targetObjIdx == targetObjIdx &&
+							paifight_PointDefenseMayEngageWarhead(projectileObjIdx)) {
 							uint32_t rangeScore;
 
 							rangeScore = (uint32_t)collide_roughdistance3d(
@@ -3114,7 +3157,8 @@ char paifight_gunnerselfdefenseorder(void) {
 					projectileObj = &g_objectTable[projectileObjIdx];
 					if (projectileObj->objectType == OBJ_None || projectileObj->genusId == GENUS_Explosion ||
 						!paifight_IsWarheadClassProjectile(projectileObj->objectType) ||
-						projectileObj->mobj->pWarheadGuidance->targetObjIdx != g_paiContext.aiObjIdx) {
+						projectileObj->mobj->pWarheadGuidance->targetObjIdx != g_paiContext.aiObjIdx ||
+						!paifight_PointDefenseMayEngageWarhead((uint16_t)projectileObjIdx)) {
 						continue;
 					}
 
