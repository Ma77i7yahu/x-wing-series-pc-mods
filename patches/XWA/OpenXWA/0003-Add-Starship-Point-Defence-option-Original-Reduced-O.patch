diff --git a/src/xwa_runtime/config/modern_gameplay_options.c b/src/xwa_runtime/config/modern_gameplay_options.c
new file mode 100644
index 0000000..568b00b
--- /dev/null
+++ b/src/xwa_runtime/config/modern_gameplay_options.c
@@ -0,0 +1,40 @@
+#include "xwa_runtime/config/modern_gameplay_options.h"
+
+#include "aeron/log.h"
+
+static struct {
+	XwaPointDefense point_defense;
+	XwaModernGameplayOptionsPersistFn persist;
+} g_modernGameplayOptions = { XWA_POINT_DEFENSE_DEFAULT, NULL };
+
+void XwaModernGameplayOptions_Configure(XwaPointDefense point_defense, XwaModernGameplayOptionsPersistFn persist) {
+	if (point_defense < XWA_POINT_DEFENSE_ORIGINAL || point_defense >= XWA_POINT_DEFENSE_COUNT) {
+		point_defense = XWA_POINT_DEFENSE_DEFAULT;
+	}
+	g_modernGameplayOptions.point_defense = point_defense;
+	g_modernGameplayOptions.persist = persist;
+}
+
+XwaPointDefense XwaModernGameplayOptions_GetPointDefense(void) { return g_modernGameplayOptions.point_defense; }
+
+int XwaModernGameplayOptions_SetPointDefense(XwaPointDefense point_defense) {
+	char error[512];
+
+	if (point_defense < XWA_POINT_DEFENSE_ORIGINAL || point_defense >= XWA_POINT_DEFENSE_COUNT) {
+		return 0;
+	}
+	if (point_defense == g_modernGameplayOptions.point_defense) {
+		return 1;
+	}
+	g_modernGameplayOptions.point_defense = point_defense;
+	if (!g_modernGameplayOptions.persist) {
+		return 1;
+	}
+	error[0] = '\0';
+	if (!g_modernGameplayOptions.persist(point_defense, error, sizeof error)) {
+		Aeron_LogError("xwa.config", "%s",
+					   error[0] ? error : "could not persist gameplay options to user configuration");
+		return 0;
+	}
+	return 1;
+}
diff --git a/src/xwa_runtime/config/modern_gameplay_options.h b/src/xwa_runtime/config/modern_gameplay_options.h
new file mode 100644
index 0000000..cdf84fe
--- /dev/null
+++ b/src/xwa_runtime/config/modern_gameplay_options.h
@@ -0,0 +1,36 @@
+#ifndef XWA_RUNTIME_MODERN_GAMEPLAY_OPTIONS_H
+#define XWA_RUNTIME_MODERN_GAMEPLAY_OPTIONS_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* How readily starship laser turrets shoot down incoming warheads. ORIGINAL
+ * engages every warhead; REDUCED gives each warhead a single launch-time roll
+ * (XWA_POINT_DEFENSE_REDUCED_ENGAGE_PERCENT) on whether turrets engage it at
+ * all; OFF never engages warheads, as in the earlier Totally Games titles. */
+typedef enum XwaPointDefense {
+	XWA_POINT_DEFENSE_ORIGINAL = 0,
+	XWA_POINT_DEFENSE_REDUCED,
+	XWA_POINT_DEFENSE_OFF,
+	XWA_POINT_DEFENSE_COUNT,
+} XwaPointDefense;
+
+#define XWA_POINT_DEFENSE_DEFAULT XWA_POINT_DEFENSE_REDUCED
+#define XWA_POINT_DEFENSE_REDUCED_ENGAGE_PERCENT 33
+
+typedef int (*XwaModernGameplayOptionsPersistFn)(XwaPointDefense point_defense, char* error,
+												 size_t error_size);
+
+void XwaModernGameplayOptions_Configure(XwaPointDefense point_defense, XwaModernGameplayOptionsPersistFn persist);
+XwaPointDefense XwaModernGameplayOptions_GetPointDefense(void);
+/* Applies immediately and writes the user configuration. */
+int XwaModernGameplayOptions_SetPointDefense(XwaPointDefense point_defense);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
