@@ -891,6 +922,7 @@ int XwaHostConfig_Load(AeronVfs* vfs, XwaHostConfig* out, char* error, size_t er
 			return host_config_error(error, error_size, "'input' must be a mapping in %s", path);
 		}
 	}
+	host_config_point_defense(config, &out->point_defense);
 	if (AeronConfigFile_GetNode(config, "paths.resources")) {
 		Aeron_LogWarn("xwa.config",
 					  "deprecated setting 'paths.resources' is ignored; resources are application-owned");
@@ -1199,6 +1231,27 @@ int XwaHostConfig_SaveInputOptions(AeronVfs* vfs, const XwaModernInputOptions* o
 	return host_config_save_user_document(vfs, document, error, error_size);
 }
 
+int XwaHostConfig_SavePointDefense(AeronVfs* vfs, XwaPointDefense point_defense, char* error,
+								   size_t error_size) {
+	AeronConfigFile* document = NULL;
+	AeronConfigError config_error = { 0 };
+
+	if (!vfs || point_defense < XWA_POINT_DEFENSE_ORIGINAL || point_defense >= XWA_POINT_DEFENSE_COUNT) {
+		return host_config_error(error, error_size, "cannot save invalid gameplay settings to %s",
+								 "config.yaml");
+	}
+	if (!host_config_prepare_user_document(vfs, &document, error, error_size)) {
+		return 0;
+	}
+	if (!AeronConfigFile_SetString(document, "gameplay.point_defense",
+								   g_hostConfigPointDefenseNames[point_defense], &config_error)) {
+		AeronConfigFile_Destroy(document);
+		return host_config_error(error, error_size, "could not update user configuration: %s",
+								 config_error.message);
+	}
+	return host_config_save_user_document(vfs, document, error, error_size);
+}
