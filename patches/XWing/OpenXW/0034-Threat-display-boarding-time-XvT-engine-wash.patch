+				snprintf(boarding, sizeof boarding, "+ %ld:%02ld BOARDING", (long)(r->boarding_remaining_s / 60),
+						 (long)(r->boarding_remaining_s % 60));
+				float used = Measure(&pen, "TIME REMAINING: ") + Measure(&pen, remaining) + Measure(&pen, "  ");
+				Text(&pen, x + used, y + 3 * line, boarding, THREAT_YELLOW, width - used);
+			}
+		}
 	}
 	return true;
 }
