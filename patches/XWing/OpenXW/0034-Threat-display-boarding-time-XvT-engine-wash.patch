diff --git a/src/xw/flight/object/collide.c b/src/xw/flight/object/collide.c
index dab0905..7801979 100644
--- a/src/xw/flight/object/collide.c
+++ b/src/xw/flight/object/collide.c
@@ -119,6 +119,158 @@ int g_collisionSegmentStartWorldY = 0;
 // GLOBAL: XW 0x6377B8
 int g_collisionSegmentStartWorldZ = 0;
 
+#ifdef XW_MODERN
+/* game.xvt_engine_wash (OpenXvT collide_ApplyEngineWashDamage): flying in the exhaust behind a working
+ * freighter's or starship's engines drains the player's shields, then hull. The wash is a box behind each
+ * engine mesh of the OPT model that widens and weakens with depth. */
+enum {
+	COLLIDE_WASH_UPDATE_TICKS = 29,
+	COLLIDE_WASH_RANGE_SCALE = 3,
+	COLLIDE_WASH_LENGTH_SCALE = 8,
+	COLLIDE_WASH_MAX_DAMAGE = 64,
+	COLLIDE_WASH_PERCENT = 100,
+	COLLIDE_WASH_MESSAGE_TICKS = 5 * XW_SIMULATION_TICKS_PER_SECOND,
+};
+static int16_t s_washDamageOverride = -1;
+static uint32_t s_washLastBucket = UINT32_MAX, s_washLastMessageTick;
+static uint8_t s_washWasActive;
+
+static uint32_t collide_missionticks(void) {
+	uint32_t seconds = ((uint32_t)g_missionElapsedClock.hours * 60 + g_missionElapsedClock.minutes) * 60 +
+					   g_missionElapsedClock.seconds;
+	return seconds * XW_SIMULATION_TICKS_PER_SECOND +
+		   (uint32_t)(XW_SIMULATION_TICKS_PER_SECOND - g_missionElapsedClock.subsecondTicks);
+}
+
+static int32_t collide_q15dot(int16_t ax, int16_t ay, int16_t az, int32_t bx, int32_t by, int32_t bz) {
+	return (int32_t)(((int64_t)ax * bx + (int64_t)ay * by + (int64_t)az * bz) >> FVIEW_MATRIX_FRACTION_BITS);
+}
+
+/* Applies one source's wash to the player; returns nonzero when any engine's wash reached it. */
+static int collide_enginewash(uint16_t sourceIndex) {
+	ObjectRecord* source = &g_objectTable[sourceIndex];
+	ObjectRecord* player = g_playerFlightState.object;
+	int extent = g_modelTypeTable[source->objectType].maxBoundsExtent;
+	int32_t dx = (int32_t)((uint32_t)player->worldX - (uint32_t)source->worldX);
+	int32_t dy = (int32_t)((uint32_t)player->worldY - (uint32_t)source->worldY);
+	int32_t dz = (int32_t)((uint32_t)player->worldZ - (uint32_t)source->worldZ);
+	int64_t range = (int64_t)COLLIDE_WASH_RANGE_SCALE * extent;
+	int washed = 0;
+	if ((int64_t)dx * dx + (int64_t)dy * dy + (int64_t)dz * dz > range * range)
+		return 0;
+	if (source->orientMatrixDirty != 0) {
+		fview_calcrotatemove(source->pitch, source->yaw, source);
+		fview_calcrotateorient(source->roll, 0, source);
+	}
+	/* Model space as starship.c's collision sweep: X side, Y aft (negated forward), Z up. */
+	int32_t localSide = collide_q15dot(source->cachedSideX, source->cachedSideY, source->cachedSideZ, dx, dy, dz);
+	int32_t localAft =
+		-collide_q15dot(source->cachedForwardX, source->cachedForwardY, source->cachedForwardZ, dx, dy, dz);
+	int32_t localUp = collide_q15dot(source->cachedUpX, source->cachedUpY, source->cachedUpZ, dx, dy, dz);
+	if (localAft < -extent)
+		return 0;
+	/* The player's nose in the same model space picks the shield bank facing the engine. */
+	int32_t noseSide = collide_q15dot(source->cachedSideX, source->cachedSideY, source->cachedSideZ,
+									  player->cachedForwardX, player->cachedForwardY, player->cachedForwardZ);
+	int32_t noseAft = -collide_q15dot(source->cachedForwardX, source->cachedForwardY, source->cachedForwardZ,
+									  player->cachedForwardX, player->cachedForwardY, player->cachedForwardZ);
+	int32_t noseUp = collide_q15dot(source->cachedUpX, source->cachedUpY, source->cachedUpZ, player->cachedForwardX,
+									player->cachedForwardY, player->cachedForwardZ);
+	int meshCount = ModelMesh_GetCachedObjectTypeMeshCount(source->objectType);
+	for (int meshIndex = 0; meshIndex < meshCount; ++meshIndex) {
+		const MeshDescriptor* engine = ModelMesh_GetCachedDescriptor(source->objectType, meshIndex);
+		if (!engine || engine->meshType != MODEL_MESH_TYPE_ENGINE)
+			continue;
+		/* Engines on the front half (CAL.OPT's under-bow pods) would wash along the hull; XvT's models have
+		 * none there. */
+		if (engine->center.y < 0)
+			continue;
+		int lengthExtent = (int)(engine->boxMax.y - engine->boxMin.y);
+		int sideExtent = (int)(engine->boxMax.x - engine->boxMin.x);
+		int upExtent = (int)(engine->boxMax.z - engine->boxMin.z);
+		if (lengthExtent < sideExtent)
+			lengthExtent = sideExtent;
+		if (lengthExtent < upExtent)
+			lengthExtent = upExtent;
+		int washLength = COLLIDE_WASH_LENGTH_SCALE * lengthExtent;
+		if (washLength > 2 * extent)
+			washLength = 2 * extent;
+		int depth = localAft - (int)engine->boxMin.y;
+		if (depth <= 0 || washLength < depth)
+			continue;
+		int sideOffset = abs(localSide - (int)engine->center.x);
+		int upOffset = abs(localUp - (int)engine->center.z);
+		sideExtent += sideExtent >> 1;
+		sideExtent += (int)((int64_t)depth * sideExtent / washLength);
+		upExtent += upExtent >> 1;
+		upExtent += (int)((int64_t)depth * upExtent / washLength);
+		if (sideExtent < sideOffset || upExtent < upOffset || sideExtent + upExtent <= 0)
+			continue;
+		int damage = (washLength >> 8) *
+					 (COLLIDE_WASH_PERCENT * (washLength - depth) / washLength *
+					  (COLLIDE_WASH_PERCENT * (sideExtent + upExtent - upOffset - sideOffset) / (sideExtent + upExtent)) /
+					  COLLIDE_WASH_PERCENT) /
+					 COLLIDE_WASH_PERCENT;
+		if (damage > COLLIDE_WASH_MAX_DAMAGE)
+			damage = COLLIDE_WASH_MAX_DAMAGE;
+		/* As XvT: with the shields down the wash only scorches the hull. */
+		if (g_playerFlightState.craft->shieldEnergy[XW_SHIELD_FRONT] +
+				g_playerFlightState.craft->shieldEnergy[XW_SHIELD_REAR] ==
+			0)
+			damage >>= 3;
+		if (damage < 1)
+			damage = 1;
+		/* Facing the engine: front bank. */
+		int64_t toEngine = (int64_t)noseSide * ((int)engine->center.x - localSide) +
+						   (int64_t)noseAft * ((int)engine->center.y - localAft) +
+						   (int64_t)noseUp * ((int)engine->center.z - localUp);
+		CraftData* savedCraft = g_curCraft;
+		s_washDamageOverride = (int16_t)damage;
+		collide_damagecraft(g_playerFlightState.objectIndex, -1, sourceIndex,
+							toEngine >= 0 ? XW_SHIELD_FRONT : XW_SHIELD_REAR);
+		s_washDamageOverride = -1;
+		g_curCraft = savedCraft;
+		washed = 1;
+		if (g_playerFlightState.craft->objectKind != XW_CRAFT_OBJECT_KIND_0)
+			break;
+	}
+	return washed;
+}
+
+/* Every 29 mission ticks, as XvT, from the mission clock so replays repeat it exactly. */
+static void collide_updateenginewash(void) {
+	if (!XwFlightTweaks_XvtEngineWash() || XwFlightTypes_Dos() || g_flightInvulnerabilityEnabled != 0 ||
+		g_hyperspaceflag != 0 || g_playerFlightState.craft->objectKind != XW_CRAFT_OBJECT_KIND_0)
+		return;
+	uint32_t now = collide_missionticks();
+	uint32_t bucket = now / COLLIDE_WASH_UPDATE_TICKS;
+	if (bucket == s_washLastBucket)
+		return;
+	s_washLastBucket = bucket;
+	int washed = 0;
+	for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index) {
+		ObjectRecord* source = &g_objectTable[index];
+		const CraftData* sourceCraft;
+		if (index == g_playerFlightState.objectIndex || source->objectType == XW_OBJ_NONE ||
+			(source->genusId != XW_GENUS_FREIGHTER && source->genusId != XW_GENUS_STARSHIP) ||
+			source->familyId != XW_OBJECT_FAMILY_CRAFT)
+			continue;
+		sourceCraft = source->instanceData;
+		if (!sourceCraft || sourceCraft->workingSubsystems == 0)
+			continue;
+		washed |= collide_enginewash(index);
+		if (g_playerFlightState.craft->objectKind != XW_CRAFT_OBJECT_KIND_0)
+			break;
+	}
+	if (washed && g_replayviewmode == 0 &&
+		(!s_washWasActive || now - s_washLastMessageTick >= COLLIDE_WASH_MESSAGE_TICKS)) {
+		msg_messagetext(XW_MSG_INCOMING_MISSILE_TARGET_PROMPT, "\013You're taking damage from engine wash!");
+		s_washLastMessageTick = now;
+	}
+	s_washWasActive = (uint8_t)washed;
+}
+#endif
+
 // FUNCTION: XW 0x402E10
 void collide_collisions(void) {
 	uint16_t collisionObjectIndex;
@@ -142,6 +294,8 @@ void collide_collisions(void) {
 			ObjectRecord* object;
 #ifdef XW_MODERN
 			if (continuation.phase != XW_COLLISION_LOOP_PLAYER_GATE)
+				collide_updateenginewash();
+			if (continuation.phase != XW_COLLISION_LOOP_PLAYER_GATE)
 #endif
 			{
 #ifdef XW_MODERN
@@ -1465,6 +1619,10 @@ int16_t collide_damagecraft(uint16_t victimObjIdx, int16_t hitMeshIndex, uint16_
 		sourceObjectType = g_objectTable[sourceObjOrMissionPointRef].objectType;
 		damageAmount = g_objectTable[sourceObjOrMissionPointRef].damageAmount;
 	}
+#ifdef XW_MODERN
+	if (s_washDamageOverride >= 0)
+		damageAmount = s_washDamageOverride;
+#endif
 	if (g_objectTable[victimObjIdx].genusId == XW_GENUS_STARSHIP) {
 		damageAmount >>= COLLIDE_STARSHIP_DAMAGE_SHIFT;
 	}
