+/* Threat display: how long the target's boarding has to run. The target is the boarding craft, or the craft
+ * docked with it. paiman_boardmaneuver counts aiOrderProgress units of PAIMAN_BOARD_DURATION_UNIT_TICKS once
+ * docked; on the way in, the whole order (aiOrderParameter units) is still ahead. */
+static void CaptureBoarding(XwSnapReadout* r, uint16_t ref, const CraftData* craft) {
+	const CraftData* boarder = craft->aiManeuverId == PAIORDER_MANEUVER_BOARD ? craft : NULL;
+	for (uint16_t index = 0; !boarder && index < XW_CRAFT_OBJECT_COUNT; ++index) {
+		const CraftData* other;
+		if (index == ref || !LiveObject(index) || g_objectTable[index].familyId != XW_OBJECT_FAMILY_CRAFT)
+			continue;
+		other = g_objectTable[index].instanceData;
+		if (other && other->aiManeuverId == PAIORDER_MANEUVER_BOARD && other->aiTargetRef == ref &&
+			other->aiManeuverPhase == PAIMAN_BOARD_TRANSFER)
+			boarder = other;
+	}
+	if (!boarder)
+		return;
+	uint32_t ticks;
