+/* XvT's craft name box shows nothing in X-Wing, so it is erased from the art. The Y-Wing's hangs over the
+ * canopy opening and is cleared; the others sit on dithered panel and take the average of the darker half of
+ * the panel around them, which is how that panel reads once smoothed. */
+static void EraseNameBox(const char* lfd_name, unsigned width, uint8_t* rgba) {
+	static const struct {
+		const char* lfd;
+		int16_t x0, y0, x1, y1;
+		bool clear;
+	} kNameBoxes[] = {
+		{ "XWING12", 92, 457, 192, 480, false },
+		{ "YWING12", 0, 311, 98, 329, true },
+		{ "AWING12", 120, 459, 221, 480, false },
+	};
+	enum { RING = 4 };
+	for (unsigned i = 0; i < sizeof kNameBoxes / sizeof kNameBoxes[0]; ++i) {
+		if (strcasecmp(lfd_name, kNameBoxes[i].lfd))
+			continue;
+		int x0 = kNameBoxes[i].x0, y0 = kNameBoxes[i].y0, x1 = kNameBoxes[i].x1, y1 = kNameBoxes[i].y1;
+		uint8_t fill[4] = { 0, 0, 0, 0 };
+		if (!kNameBoxes[i].clear) {
+			/* Brightness histogram of the ring (r+g+b), then the mean of the pixels at or below its median. */
+			unsigned histogram[766] = { 0 }, count = 0;
+			for (int y = y0 - RING; y < y1 + RING; ++y)
+				for (int x = x0 - RING; x < x1 + RING; ++x) {
+					if (x < 0 || y < 0 || x >= 640 || y >= 480 || (x >= x0 && x < x1 && y >= y0 && y < y1))
+						continue;
+					const uint8_t* p = rgba + ((size_t)y * width + x) * 4;
+					if (p[3]) {
+						++histogram[p[0] + p[1] + p[2]];
+						++count;
+					}
+				}
+			unsigned median = 0;
+			for (unsigned seen = 0; median < 765 && (seen += histogram[median]) < (count + 1) / 2;)
+				++median;
+			unsigned long sum[3] = { 0, 0, 0 }, n = 0;
+			for (int y = y0 - RING; y < y1 + RING; ++y)
+				for (int x = x0 - RING; x < x1 + RING; ++x) {
+					if (x < 0 || y < 0 || x >= 640 || y >= 480 || (x >= x0 && x < x1 && y >= y0 && y < y1))
+						continue;
+					const uint8_t* p = rgba + ((size_t)y * width + x) * 4;
+					if (p[3] && (unsigned)(p[0] + p[1] + p[2]) <= median) {
+						for (unsigned c = 0; c < 3; ++c)
+							sum[c] += p[c];
+						++n;
+					}
+				}
+			if (!n)
+				continue;
+			for (unsigned c = 0; c < 3; ++c)
+				fill[c] = (uint8_t)(sum[c] / n);
+			fill[3] = 255;
+		}
+		for (int y = y0; y < y1; ++y)
+			for (int x = x0; x < x1; ++x)
+				memcpy(rgba + ((size_t)y * width + x) * 4, fill, 4);
+	}
+}
