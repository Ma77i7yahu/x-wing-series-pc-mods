 		return Dos94_starship_damagecomponent(victimObjIdx, hitMeshIndex, damageAmount);
 	}
 #endif
-	if (hitMeshIndex == 0)
+#ifdef XW_MODERN
+	const bool xvt = XwXvtComponents_Active();
+#else
+	const bool xvt = false;
+#endif
+	if (hitMeshIndex <= 0)
 		return damageAmount;
 	meshIndex = hitMeshIndex - 1;
 	meshSlot = meshIndex;
 	componentHp = g_curCraft->componentHp[meshSlot];
 	if (componentHp == 0 || componentHp == STARSHIP_COMPONENT_HP_INDESTRUCTIBLE)
 		return damageAmount;
-	damageAmount >>= STARSHIP_COMPONENT_DAMAGE_SHIFT;
-	if (componentHp <= damageAmount) {
+	if (xvt) {
+#ifdef XW_MODERN
+		/* XvT Craft_DamageComponent (0x4A6990): hit points are in units of 16 damage, nothing is lost to the
+		 * shift, a hit always does at least 1, and the remainder carries on to the hull. */
+		unsigned componentDamage = 16u * componentHp;
+		if (damageAmount == 0)
+			damageAmount = 1;
+		if (damageAmount < componentDamage) {
+			int remaining = (int)(componentDamage - damageAmount) >> 4;
+			g_curCraft->componentHp[meshSlot] = (uint8_t)(remaining != 0 ? remaining : 1);
+			return 0;
+		}
 		g_curCraft->componentHp[meshSlot] = 0;
-		damageAmount = (damageAmount - componentHp) << STARSHIP_COMPONENT_DAMAGE_SHIFT;
+		damageAmount = (uint16_t)(damageAmount - componentDamage);
+		if (!XwXvtComponents_Destroyed(victimObjIdx, meshIndex))
+			return damageAmount;
+#endif
+	} else
+		damageAmount >>= STARSHIP_COMPONENT_DAMAGE_SHIFT;
+	if (xvt || componentHp <= damageAmount) {
 		victimSlot = victimObjIdx;
-		g_curCraft->componentState[meshSlot] = STARSHIP_COMPONENT_DESTROYED;
+		if (!xvt) {
+			g_curCraft->componentHp[meshSlot] = 0;
+			damageAmount = (damageAmount - componentHp) << STARSHIP_COMPONENT_DAMAGE_SHIFT;
+			g_curCraft->componentState[meshSlot] = STARSHIP_COMPONENT_DESTROYED;
+		}
 		objectType = g_objectTable[victimSlot].objectType;
-		if (objectType == XW_OBJ_CORELLIAN_CORVETTE) {
+		if (xvt) {
+			/* XwXvtComponents_Destroyed applied XvT's effects. */
+		} else if (objectType == XW_OBJ_CORELLIAN_CORVETTE) {
 			if (meshIndex == STARSHIP_DESTRUCTION_MESH_2) {
 				g_curCraft->weaponSlots[0].firingGate = 0;
 				g_curCraft->weaponSlots[1].firingGate = 0;
