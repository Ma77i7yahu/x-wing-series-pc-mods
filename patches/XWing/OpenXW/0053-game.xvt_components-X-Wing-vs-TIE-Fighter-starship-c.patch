+++ b/src/xw_runtime/runtime/xvt_components.h
@@ -0,0 +1,57 @@
+#ifndef XW_RUNTIME_RUNTIME_XVT_COMPONENTS_H
+#define XW_RUNTIME_RUNTIME_XVT_COMPONENTS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct CraftData;
+
+/* game.xvt_components: starship components as in X-Wing vs TIE Fighter (1998 flight only). The OPT's mesh
+ * descriptors decide everything, as in XvT: every mesh with explosion flag 2 gets XvT's hit points for its
+ * type (g_meshTypeComponentMaxHp) and stays visible (X-Wing hides the turrets of every starship but the
+ * corvette); laser and warhead hits on a mesh with explosion flag 1 go to the component first once the
+ * craft's shields are down (shield generators take them at any time, as X-Wing's ISD generators do); a
+ * destroyed turret or gun stops the weapon slots it carries; losing the last shield generator drops the
+ * shields; and the player can target components (, and Shift+,), shown in the CMD, boxed on the HUD, used
+ * for the CMD range and warhead lock, and homed on by warheads. Mesh indices are 0-based. */
+enum { XW_XVT_COMPONENT_NONE = 0xFFFF };
+
+bool XwXvtComponents_Active(void);
+
+/* create.c: replace X-Wing's component setup for a new craft (not starfighters). */
+void XwXvtComponents_InitCraft(uint16_t objectIndex);
+
+/* collide_damagecraft: whether a hit on mesh ordinal hitMeshIndex (1-based, as passed) goes to the
+ * component first. */
+bool XwXvtComponents_RouteDamage(uint16_t victimObjIdx, int16_t hitMeshIndex);
+
+/* starship_damagecomponent, once a component's hit points reach zero: XvT's effects. False when the mesh
+ * is not destroyable (no explosion, it stays drawn). */
+bool XwXvtComponents_Destroyed(uint16_t victimObjIdx, uint16_t meshIndex);
+
+/* The player's targeted component of the current target, or XW_XVT_COMPONENT_NONE. */
+uint16_t XwXvtComponents_Selected(void);
+/* The component to box and range: the selection when the target is a starship. */
+uint16_t XwXvtComponents_BoxComponent(void);
