diff --git a/src/xw_runtime/runtime/xvt_components.c b/src/xw_runtime/runtime/xvt_components.c
new file mode 100644
index 0000000..c1f201f
--- /dev/null
+++ b/src/xw_runtime/runtime/xvt_components.c
@@ -0,0 +1,323 @@
+#include "xw_runtime/runtime/xvt_components.h"
+#include "xw/assets/model_mesh.h"
+#include "xw/audio/fsfx.h"
+#include "xw/flight/ai/pai.h"
+#include "xw/flight/object/craft.h"
+#include "xw/flight/object/create.h"
+#include "xw/flight/object/laser.h"
+#include "xw/flight/object/starship.h"
+#include "xw/flight/player/user.h"
+#include "xw/flight/xw.h"
+#include "xw/math/trig2.h"
+#include "xw_runtime/config/flight_tweaks.h"
+#include "xw_runtime/runtime/flight_types.h"
+#include <string.h>
+
+/* XvT MeshComponentType values used here. */
+enum {
+	MESH_HULL = 1,
+	MESH_FUSELAGE = 3,
+	MESH_LASER_TURRET = 4,
+	MESH_LASER_GUN = 5,
+	MESH_SHIELD_GENERATOR = 8,
+	MESH_HULL_18 = 18,
+	MESH_ANTENNA = 19,
+	MESH_LASER_TURRET_21 = 21,
+	MESH_TYPE_COUNT = 32,
+	EXPLOSION_ROUTES_DAMAGE = 1,
+	EXPLOSION_DESTROYABLE = 2,
+	COMPONENT_HP_NONE = 0xFF,
+	COMPONENT_SLOTS = 50,
+};
+
+/* XvT 0x524220 g_meshTypeComponentMaxHp, in 16-damage units. */
+static const uint8_t kMaxHp[MESH_TYPE_COUNT] = {
+	0xFF, 0xFF, 0xFF, 0xFF, 0x18, 0x04, 0xFF, 0xFF, 0x40, 0xFF, 0x20, 0x30, 0x30, 0x30, 0x70, 0xFF,
+	0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x18, 0x20, 0x30, 0x30, 0x30, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+};
+
+/* XvT strings.txt 1734-1765. */
+static const char* const kNames[MESH_TYPE_COUNT] = {
+	"Hull",		"Hull",		"Wing",		"Fuselage", "Lasr Tur", "Lasr Gun", "Engine",	"Bridge",
+	"Shld Gen", "Enrg Gen", "Whead Ln", "Comm Sys", "Beam Sys", "Comm Sys", "Dock Plt", "Land Plt",
+	"Hangar",	"Cargo",	"Hull",		"Antenna",	"Wing",		"Lasr Tur", "Whead Ln", "Comm Sys",
+	"Beam Sys", "Comm Sys", "Cockpit",	"Hull",		"Hull",		"Hull",		"Hull",		"Hull",
+};
+
+static uint16_t s_target = XW_PLAYER_NO_TARGET;
+static uint8_t s_targetType;
+static uint16_t s_component = XW_XVT_COMPONENT_NONE;
+static struct {
+	uint16_t target, component;
+} s_guidance[LASER_WARHEAD_GUIDANCE_COUNT];
+
+bool XwXvtComponents_Active(void) { return XwFlightTweaks_XvtComponents() && !XwFlightTypes_Dos(); }
+
+static int MeshCount(int objectType) {
+	int count = ModelMesh_GetCachedObjectTypeMeshCount(objectType);
+	return count < 0 ? 0 : count > COMPONENT_SLOTS ? COMPONENT_SLOTS : count;
+}
+
+static const MeshDescriptor* Descriptor(int objectType, int meshIndex) {
+	return meshIndex < MeshCount(objectType) ? ModelMesh_GetCachedDescriptor(objectType, meshIndex) : NULL;
+}
+
+static int MeshType(int objectType, int meshIndex) {
+	const MeshDescriptor* descriptor = Descriptor(objectType, meshIndex);
+	return descriptor ? descriptor->meshType : -1;
+}
+
+/* MeshDescriptor +0x4 is XvT's explosionType, +0x38 its targetId. */
+static int Explosion(int objectType, int meshIndex) {
+	const MeshDescriptor* descriptor = Descriptor(objectType, meshIndex);
+	return descriptor ? descriptor->field_04 : 0;
+}
+
+static int TargetGroup(int objectType, int meshIndex) {
+	const MeshDescriptor* descriptor = Descriptor(objectType, meshIndex);
+	int32_t group = 0;
+	if (descriptor)
+		memcpy(&group, descriptor->gap38, sizeof group);
+	return group;
+}
+
+static bool IsCraft(uint16_t ref) {
+	return ref < XW_CRAFT_OBJECT_COUNT && g_objectTable[ref].objectType != XW_OBJ_NONE &&
+		   g_objectTable[ref].familyId == XW_OBJECT_FAMILY_CRAFT && g_objectTable[ref].instanceData != NULL;
+}
+
+void XwXvtComponents_InitCraft(uint16_t objectIndex) {
+	/* Starfighters keep X-Wing's setup: their guns have no turret firing gate to stop, and X-Wing hides
+	 * their gun meshes. */
+	if (!IsCraft(objectIndex) || g_objectTable[objectIndex].genusId == XW_GENUS_STARFIGHTER)
+		return;
+	CraftData* craft = g_objectTable[objectIndex].instanceData;
+	int objectType = g_objectTable[objectIndex].objectType;
+	for (unsigned i = 0; i < COMPONENT_SLOTS; ++i) {
+		craft->componentState[i] = 0;
+		craft->meshRotation[i] = 0;
+		craft->componentHp[i] = COMPONENT_HP_NONE;
+	}
+	/* XvT Mission spawn (0x45F0F0): hit points for every destroyable mesh. */
+	int count = MeshCount(objectType);
+	for (int mesh = 0; mesh < count; ++mesh) {
+		int type = MeshType(objectType, mesh);
+		if (type >= 0 && type < MESH_TYPE_COUNT && (Explosion(objectType, mesh) & EXPLOSION_DESTROYABLE))
+			craft->componentHp[mesh] = kMaxHp[type];
+	}
+}
+
+bool XwXvtComponents_RouteDamage(uint16_t victimObjIdx, int16_t hitMeshIndex) {
+	if (hitMeshIndex <= 0 || !IsCraft(victimObjIdx) || g_objectTable[victimObjIdx].genusId == XW_GENUS_STARFIGHTER)
+		return false;
+	int objectType = g_objectTable[victimObjIdx].objectType, mesh = hitMeshIndex - 1;
+	if (!(Explosion(objectType, mesh) & EXPLOSION_ROUTES_DAMAGE))
+		return false;
+	const CraftData* craft = g_objectTable[victimObjIdx].instanceData;
+	/* XvT 0x41FC50 (difficulty above easy): components only once both shield banks are empty. X-Wing's ISD
+	 * shield generators take hits through the shields, which its missions are built around. */
+	return MeshType(objectType, mesh) == MESH_SHIELD_GENERATOR ||
+		   craft->shieldEnergy[XW_SHIELD_FRONT] + craft->shieldEnergy[XW_SHIELD_REAR] <= 0;
+}
+
+/* XvT selects by mesh (Craft_IsSelectableDamageComponentMesh): not the decorative hull pieces, and only the
+ * first mesh of each hull target group. */
+static bool Selectable(int objectType, int mesh) {
+	int type = MeshType(objectType, mesh);
+	if (type < 0 || type == MESH_HULL_18 || type == MESH_ANTENNA)
+		return false;
+	int group = TargetGroup(objectType, mesh);
+	if (group == 0 || (group == 1 && type != MESH_HULL && type != MESH_FUSELAGE))
+		return true;
+	int count = MeshCount(objectType);
+	for (int other = 0; other < count; ++other)
+		if (TargetGroup(objectType, other) == group && MeshType(objectType, other) == type)
+			return other == mesh;
+	return false;
+}
+
+static bool Intact(const CraftData* craft, int objectType, int mesh) {
+	return craft->componentState[mesh] == 0 && craft->componentHp[mesh] != 0 && Selectable(objectType, mesh);
+}
+
+void XwXvtComponents_DistanceTo(uint16_t fromRef, uint16_t toRef, uint16_t meshIndex) {
+	int toX, toY, toZ;
+	create_getworldposition(toRef, 0);
+	toX = g_resolvedWorldX;
+	toY = g_resolvedWorldY;
+	toZ = g_resolvedWorldZ;
+	if (meshIndex != XW_XVT_COMPONENT_NONE && IsCraft(toRef)) {
+		int objectType = g_objectTable[toRef].objectType;
+		/* As Targeting_ProjectObjectOrMissionPoint places a component. */
+		pai_RotateLocalVectorToWorldScratch(&g_objectTable[toRef], ModelMesh_GetCenterX(objectType, meshIndex),
+											ModelMesh_GetCenterZ(objectType, meshIndex),
+											(int32_t)(0u - (uint32_t)ModelMesh_GetCenterY(objectType, meshIndex)));
+		toX = (int32_t)((uint32_t)toX + (uint32_t)g_rotatedX);
+		toY = (int32_t)((uint32_t)toY + (uint32_t)g_rotatedY);
+		toZ = (int32_t)((uint32_t)toZ + (uint32_t)g_rotatedZ);
+	}
+	create_getworldposition(fromRef, 0);
+	trig2_ctop((int)((unsigned)toX - (unsigned)g_resolvedWorldX), (int)((unsigned)toY - (unsigned)g_resolvedWorldY),
+			   (int)((unsigned)toZ - (unsigned)g_resolvedWorldZ));
+}
+
+/* XvT Player_SelectTargetComponentMesh: the nearest hull or fuselage of a starship; the first one of any
+ * other craft. */
+static uint16_t AutoSelect(uint16_t target) {
+	int objectType = g_objectTable[target].objectType, count = MeshCount(objectType);
+	bool starship = g_objectTable[target].genusId == XW_GENUS_STARSHIP;
+	uint16_t best = 0;
+	uint32_t nearest = UINT32_MAX;
+	int32_t polar = g_trig2PolarDistance;
+	int16_t pitch = g_trig2Pitch, yaw = g_trig2Yaw;
+	for (int mesh = 0; mesh < count; ++mesh) {
+		int type = MeshType(objectType, mesh);
+		if (type != MESH_HULL && type != MESH_FUSELAGE)
+			continue;
+		if (!starship) {
+			best = (uint16_t)mesh;
+			break;
+		}
+		XwXvtComponents_DistanceTo(g_playerFlightState.objectIndex, target, (uint16_t)mesh);
+		if ((uint32_t)g_trig2PolarDistance < nearest) {
+			nearest = (uint32_t)g_trig2PolarDistance;
+			best = (uint16_t)mesh;
+		}
+	}
+	g_trig2PolarDistance = polar;
+	g_trig2Pitch = pitch;
+	g_trig2Yaw = yaw;
+	return best;
+}
+
+void XwXvtComponents_OnNewTarget(void) {
+	uint16_t target = g_playerFlightState.currentTargetObjectIdx;
+	s_target = target;
+	s_component = XW_XVT_COMPONENT_NONE;
+	if (!XwXvtComponents_Active() || !IsCraft(target) || g_objectTable[target].genusId == XW_GENUS_STARFIGHTER)
+		return;
+	s_targetType = (uint8_t)g_objectTable[target].objectType;
+	s_component = AutoSelect(target);
+}
+
+uint16_t XwXvtComponents_Selected(void) {
+	uint16_t target = g_playerFlightState.currentTargetObjectIdx;
+	if (!XwXvtComponents_Active() || !IsCraft(target) || g_objectTable[target].genusId == XW_GENUS_STARFIGHTER)
+		return XW_XVT_COMPONENT_NONE;
+	/* Targets set without user_setnewtarget, or a slot reused by a new craft. */
+	if (target != s_target || g_objectTable[target].objectType != s_targetType)
+		XwXvtComponents_OnNewTarget();
+	return s_component;
+}
+
+uint16_t XwXvtComponents_BoxComponent(void) {
+	uint16_t component = XwXvtComponents_Selected();
+	uint16_t target = g_playerFlightState.currentTargetObjectIdx;
+	return component != XW_XVT_COMPONENT_NONE && g_objectTable[target].genusId == XW_GENUS_STARSHIP
+			   ? component
+			   : XW_XVT_COMPONENT_NONE;
+}
+
+static bool Advance(uint16_t target, int direction) {
+	const CraftData* craft = g_objectTable[target].instanceData;
+	int objectType = g_objectTable[target].objectType, count = MeshCount(objectType);
+	if (count <= 0)
+		return false;
+	int mesh = s_component == XW_XVT_COMPONENT_NONE ? (direction > 0 ? -1 : 0) : s_component;
+	for (int attempt = 0; attempt < count; ++attempt) {
+		mesh = (mesh + direction + count) % count;
+		if (Intact(craft, objectType, mesh)) {
+			s_component = (uint16_t)mesh;
+			return true;
+		}
+	}
+	return false;
+}
+
+void XwXvtComponents_Cycle(int direction) {
+	if (XwXvtComponents_Selected() == XW_XVT_COMPONENT_NONE)
+		return;
+	if (Advance(g_playerFlightState.currentTargetObjectIdx, direction < 0 ? -1 : 1))
+		fsfx_triggersfx(FSFX_TARGET_SELECTED_SLOT, FSFX_UNPOSITIONED_OBJECT);
+}
+
+const char* XwXvtComponents_Name(int objectType, uint16_t meshIndex) {
+	int type = MeshType(objectType, meshIndex);
+	return type >= 0 && type < MESH_TYPE_COUNT ? kNames[type] : "";
+}
+
+/* Which turret or gun mesh carries an X-Wing weapon slot: the nearest one to its hardpoint (X-Wing's table
+ * has no mesh index; for the corvette this gives X-Wing's own mesh 2 = slots 0-1, mesh 0 = slots 2-3). */
+static int SlotMesh(const CraftData* craft, int objectType, unsigned slot) {
+	const XwWeaponHardpoint* point = &g_craftTypeDefs[craft->craftTypeIndex].weaponHardpoints[slot];
+	/* Hardpoints are (side, up, forward); mesh centres (x, y, z) with forward = -y. */
+	int64_t side = point->x, up = point->z, forward = point->y;
+	int best = -1, count = MeshCount(objectType);
+	int64_t nearest = INT64_MAX;
+	for (int mesh = 0; mesh < count; ++mesh) {
+		int type = MeshType(objectType, mesh);
+		if (type != MESH_LASER_TURRET && type != MESH_LASER_GUN && type != MESH_LASER_TURRET_21)
+			continue;
+		int64_t dx = ModelMesh_GetCenterX(objectType, mesh) - side;
+		int64_t dy = -ModelMesh_GetCenterY(objectType, mesh) - forward;
+		int64_t dz = ModelMesh_GetCenterZ(objectType, mesh) - up;
+		int64_t distance = dx * dx + dy * dy + dz * dz;
+		if (distance < nearest) {
+			nearest = distance;
+			best = mesh;
+		}
+	}
+	return best;
+}
+
+bool XwXvtComponents_Destroyed(uint16_t victimObjIdx, uint16_t meshIndex) {
+	if (!IsCraft(victimObjIdx))
+		return false;
+	CraftData* craft = g_objectTable[victimObjIdx].instanceData;
+	int objectType = g_objectTable[victimObjIdx].objectType;
+	if (!(Explosion(objectType, meshIndex) & EXPLOSION_DESTROYABLE))
+		return false;
+	craft->componentState[meshIndex] = STARSHIP_COMPONENT_DESTROYED;
+
+	/* XvT Craft_DamageComponent: a player whose selected component goes moves on to the next one. */
+	if (victimObjIdx == g_playerFlightState.currentTargetObjectIdx && victimObjIdx == s_target &&
+		s_component == meshIndex)
+		Advance(victimObjIdx, 1);
+
+	int type = MeshType(objectType, meshIndex);
+	if (type == MESH_LASER_TURRET || type == MESH_LASER_GUN || type == MESH_LASER_TURRET_21) {
+		/* XvT fires each slot from its mesh only while the mesh has hit points (0x404710, 0x4166A0). The
+		 * starship turret sweep skips slots whose firingGate is 0, as for X-Wing's corvette turrets. */
+		for (unsigned slot = 0; slot < craft->laserSlotCount && slot < 12; ++slot)
+			if (craft->weaponSlots[slot].firingGate != 0 && SlotMesh(craft, objectType, slot) == meshIndex) {
+				craft->weaponSlots[slot].firingGate = 0;
+				craft->weaponSlots[slot].laserCharge = 0;
+			}
+	} else if (type == MESH_SHIELD_GENERATOR) {
+		/* X-Wing's ISD rule for every craft with generators: the last one takes the shields with it. */
+		int count = MeshCount(objectType);
+		for (int mesh = 0; mesh < count; ++mesh)
+			if (MeshType(objectType, mesh) == MESH_SHIELD_GENERATOR && craft->componentHp[mesh] != 0)
+				return true;
+		craft->shieldEnergy[XW_SHIELD_FRONT] = 0;
+		craft->shieldEnergy[XW_SHIELD_REAR] = 0;
+		craft->workingSubsystems &= (uint8_t)~XW_CRAFT_SUBSYSTEM_SHIELDS;
+	}
+	return true;
+}
+
+void XwXvtComponents_SetGuidance(unsigned guidanceIndex, uint16_t target, uint16_t meshIndex) {
+	if (guidanceIndex < LASER_WARHEAD_GUIDANCE_COUNT) {
+		s_guidance[guidanceIndex].target = target;
+		s_guidance[guidanceIndex].component = meshIndex;
+	}
+}
+
+uint16_t XwXvtComponents_Guidance(unsigned guidanceIndex, uint16_t target) {
+	/* Slots also launched by paths that never set this (surface guns, starship turrets): the target must
+	 * match. */
+	if (guidanceIndex >= LASER_WARHEAD_GUIDANCE_COUNT || !XwXvtComponents_Active() ||
+		s_guidance[guidanceIndex].target != target || !IsCraft(target))
+		return XW_XVT_COMPONENT_NONE;
+	return s_guidance[guidanceIndex].component;
+}
diff --git a/src/xw_runtime/runtime/xvt_components.h b/src/xw_runtime/runtime/xvt_components.h
new file mode 100644
index 0000000..67d4554
