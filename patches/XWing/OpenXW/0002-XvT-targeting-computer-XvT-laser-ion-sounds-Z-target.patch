diff --git a/src/xw_runtime/snapshot/render_readout.c b/src/xw_runtime/snapshot/render_readout.c
new file mode 100644
index 0000000..52c7e15
--- /dev/null
+++ b/src/xw_runtime/snapshot/render_readout.c
@@ -0,0 +1,169 @@
+/* render.xvt_readout: X-Wing vs TIE Fighter style target and craft status text for the modern HUD. */
+#include "xw_runtime/snapshot/render_readout.h"
+#include "xw/flight/ai/pai.h"
+#include "xw/flight/hud/festring.h"
+#include "xw/flight/hud/msg.h"
+#include "xw/flight/hud/panel.h"
+#include "xw/flight/mission/mission.h"
+#include "xw/flight/object/craft.h"
+#include "xw/flight/object/create.h"
+#include "xw/flight/object/laser.h"
+#include "xw/flight/player/user.h"
+#include "xw/flight/replay/replay.h"
+#include "xw/flight/xw.h"
+#include "xw/math/math2.h"
+#include "xw/math/trig2.h"
+#include "xw_dos94/flight/hud/replay.h"
+#include "xw_runtime/runtime/flight_panel.h"
+#include "xw_runtime/runtime/flight_types.h"
+#include "xw_runtime/snapshot/render_objects.h"
+#include <ctype.h>
+#include <string.h>
+
+/* Copies visible text, dropping the flight font's color escapes, uppercased for the HUD fonts. */
+static void CopyText(char* out, size_t capacity, const char* in) {
+	size_t n = 0;
+	for (; in && *in && n + 1 < capacity; ++in) {
+		unsigned char c = (unsigned char)*in;
+		if (c == FLIGHT_TEXT_COLOR_ESCAPE) {
+			if (!in[1])
+				break;
+			++in;
+			continue;
+		}
+		if (c < FLIGHT_TEXT_FIRST_DRAWABLE_BYTE && c != ' ')
+			continue;
+		out[n++] = (char)toupper(c);
+	}
+	out[n] = 0;
+}
+
+static int Percent(int value, int maximum) {
+	if (maximum <= 0)
+		return -1;
+	if (value < 0)
+		value = 0;
+	return (int)((value * 100L + maximum / 2) / maximum);
+}
+
+static int ShieldPercent(const CraftData* craft) {
+	int nominal = g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[XW_SHIELD_FRONT] +
+				  g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[XW_SHIELD_REAR];
+	if (nominal <= 0)
+		return -1;
+	if (!(craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_SHIELDS))
+		return 0;
+	int energy = (craft->shieldEnergy[XW_SHIELD_FRONT] > 0 ? craft->shieldEnergy[XW_SHIELD_FRONT] : 0) +
+				 (craft->shieldEnergy[XW_SHIELD_REAR] > 0 ? craft->shieldEnergy[XW_SHIELD_REAR] : 0);
+	return Percent(energy, nominal);
+}
+
+static int HullPercent(const CraftData* craft) {
+	if (!craft->hullMax)
+		return -1;
+	int remaining = (int)craft->hullMax - (int)craft->hullDamage;
+	return Percent(remaining, craft->hullMax);
+}
+
+static bool LiveObject(uint16_t ref) {
+	return ref < XW_OBJECT_COUNT && g_objectTable[ref].objectType != XW_OBJ_NONE &&
+		   g_objectTable[ref].genusId != XW_GENUS_EXPLOSION_EFFECT;
+}
+
+static void ObjectName(uint16_t ref, char* out, size_t capacity) {
+	uint16_t type = ref < XW_MISSION_OBJECT_REF_BASE ? g_objectTable[ref].objectType
+													 : g_missionObjects[ref - XW_MISSION_OBJECT_REF_BASE].objectType;
+	char saved[FLIGHT_TEXT_SCRATCH_CAPACITY];
+	memcpy(saved, g_flightTextScratchBuffer, sizeof saved);
+	panel_buildobjectname(ref, type);
+	CopyText(out, capacity, g_flightTextScratchBuffer);
+	memcpy(g_flightTextScratchBuffer, saved, sizeof saved);
+}
+
+static void CaptureTarget(XwSnapReadout* r) {
+	uint16_t ref = g_playerFlightState.currentTargetObjectIdx;
+	if (ref == XW_OBJECT_SLOT_UNAVAILABLE)
+		return;
+	if (ref < XW_MISSION_OBJECT_REF_BASE ? !LiveObject(ref)
+										 : ref - XW_MISSION_OBJECT_REF_BASE >= MISSION_OBJECT_COUNT ||
+											   g_missionObjects[ref - XW_MISSION_OBJECT_REF_BASE].objectType ==
+												   XW_OBJ_NONE)
+		return;
+	r->target_valid = 1;
+	r->target = XwRenderObjects_Id(ref);
+	r->target_shield_pct = r->target_hull_pct = r->target_system_pct = -1;
+	ObjectName(ref, r->target_name, sizeof r->target_name);
+	/* Mission objects (mines, buoys) carry no IFF. */
+	if (ref < XW_MISSION_OBJECT_REF_BASE) {
+		uint8_t iff = g_objectTable[ref].iff;
+		r->target_relation = iff == g_playerFlightState.object->iff ? 0 : iff <= 1 ? 1 : 2;
+	} else
+		r->target_relation = 2;
+
+	/* pai_distancebetween changes trig2 globals; keep the CMD's distance scale (units * 161 >> 16). */
+	int32_t polar = g_trig2PolarDistance;
+	int16_t pitch = g_trig2Pitch, yaw = g_trig2Yaw;
+	pai_distancebetween(g_playerFlightState.objectIndex, ref);
+	unsigned hundredths = (unsigned)(((uint64_t)(uint32_t)g_trig2PolarDistance * PANEL_DISTANCE_SCALE) >>
+									 PANEL_DISTANCE_SCALE_SHIFT);
+	r->target_distance_hundredths = (uint16_t)(hundredths > 9999 ? 9999 : hundredths);
+	g_trig2PolarDistance = polar;
+	g_trig2Pitch = pitch;
+	g_trig2Yaw = yaw;
+
+	if (ref >= XW_MISSION_OBJECT_REF_BASE || g_objectTable[ref].familyId != XW_OBJECT_FAMILY_CRAFT) {
+		/* Warheads report what they are tracking, as the CMD does. */
+		if (ref < XW_MISSION_OBJECT_REF_BASE && XwFlightTypes_IsWarhead(g_objectTable[ref].objectType)) {
+			const WarheadGuidanceState* guidance = g_objectTable[ref].instanceData;
+			strcpy(r->target_orders, guidance && guidance->homingTier ? "TRACKING" : "UNGUIDED");
+			if (guidance && guidance->homingTier) {
+				if (guidance->targetObjIdx == g_playerFlightState.objectIndex)
+					strcpy(r->target_order_target, "OUR CRAFT");
+				else if (LiveObject(guidance->targetObjIdx))
+					ObjectName(guidance->targetObjIdx, r->target_order_target, sizeof r->target_order_target);
+			}
+		}
+		return;
+	}
+	const CraftData* craft = g_objectTable[ref].instanceData;
+	if (!craft)
+		return;
+	r->target_shield_pct = (int16_t)ShieldPercent(craft);
+	r->target_hull_pct = (int16_t)HullPercent(craft);
+	/* X-Wing tracks eight subsystems as working bits rather than XvT's system damage percentage. */
+	unsigned working = 0;
+	for (unsigned bit = 0; bit < 8; ++bit)
+		working += (craft->workingSubsystems >> bit) & 1;
+	r->target_system_pct = (int16_t)Percent((int)working, 8);
+	if (g_craftTypeDefs[craft->craftTypeIndex].hasCargo) {
+		r->cargo_valid = 1;
+		char cargo[sizeof craft->cargoName + 1] = { 0 };
+		memcpy(cargo, craft->cargoName, sizeof craft->cargoName);
+		CopyText(r->target_cargo, sizeof r->target_cargo,
+				 !craft->isInspected ? "UNKNOWN" : cargo[0] ? cargo : "NONE");
+	}
+	if (craft->aiCurrentPlanId < USER_AI_STATUS_COUNT) {
+		unsigned message = g_aiPlanStatusMessageIds[craft->aiCurrentPlanId];
+		if (message && message < XW_MSG_TEMPLATE_COUNT)
+			CopyText(r->target_orders, sizeof r->target_orders, g_flightMessageTemplates[message]);
+	}
+	if (craft->aiTargetRef != ref && craft->aiTargetRef < XW_OBJECT_COUNT && LiveObject(craft->aiTargetRef)) {
+		if (craft->aiTargetRef == g_playerFlightState.objectIndex)
+			strcpy(r->target_order_target, "OUR CRAFT");
+		else
+			ObjectName(craft->aiTargetRef, r->target_order_target, sizeof r->target_order_target);
+	}
+}
+
+void XwReadout_Capture(XwSnapReadout* r) {
+	memset(r, 0, sizeof *r);
+	if (!g_playerFlightState.craft || !g_playerFlightState.object || g_replayviewmode)
+		return;
+	const XwFlightPanelLayout* layout = XwFlightPanel_Layout();
+	r->cmd = (XwSnapRect) { g_hudElementLayouts[PANEL_RADAR_TARGET_ELEMENT].x,
+							g_hudElementLayouts[PANEL_RADAR_TARGET_ELEMENT].y, layout->width, layout->footerBottom };
+	r->valid = r->cmd.width > 0 && r->cmd.height > 0;
+	/* The CMD shows nothing while the targeting computer is damaged or switched off by damage. */
+	if (r->valid && (g_playerFlightState.craft->activeHudFeatureMask & PANEL_CMD_FEATURE))
+		CaptureTarget(r);
+}
