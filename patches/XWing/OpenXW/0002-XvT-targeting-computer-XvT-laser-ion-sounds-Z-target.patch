diff --git a/src/xw_runtime/audio/weapon_sounds.c b/src/xw_runtime/audio/weapon_sounds.c
new file mode 100644
index 0000000..cfc2001
--- /dev/null
+++ b/src/xw_runtime/audio/weapon_sounds.c
@@ -0,0 +1,109 @@
+#include "xw_runtime/audio/weapon_sounds.h"
+#include "xw/audio/fsfx.h"
+#include "xw/util/memory.h"
+#include "xw_runtime/config/config.h"
+#include <aeron/aeron.h>
+#include <aeron/log.h>
+#include <aeron/vfs.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* XvT's SFXBLAST.LST order for species 137-142, matching X-Wing projectile indices 0-5. */
+static const char* const g_xvtCannonSounds[6] = { "REB-LS-2", "REB-LS-4", "TL-SHT-1",
+												  "TL-BIG-B", "W-LASR-3", "CANNON-1" };
+static bool g_loaded;
+
+static uint32_t Le32(const uint8_t* p) { return p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+
+static uint16_t Le16(const uint8_t* p) { return (uint16_t)(p[0] | p[1] << 8); }
+
+/* Converts an 8-bit mono PCM WAV into VOC audio blocks (type 1, unsigned 8-bit) plus a terminator, in a new
+ * memory handle. Returns 0 on any format it does not handle. */
+static uint16_t WavToVoc(const uint8_t* wav, size_t size) {
+	if (size < 12 || memcmp(wav, "RIFF", 4) || memcmp(wav + 8, "WAVE", 4))
+		return 0;
+	const uint8_t* samples = NULL;
+	uint32_t sampleBytes = 0, rate = 0;
+	bool format = false;
+	for (size_t at = 12; at + 8 <= size;) {
+		uint32_t chunk = Le32(wav + at + 4);
+		if (chunk > size - at - 8)
+			return 0;
+		if (!memcmp(wav + at, "fmt ", 4) && chunk >= 16) {
+			const uint8_t* f = wav + at + 8;
+			format = Le16(f) == 1 && Le16(f + 2) == 1 && Le16(f + 14) == 8;
+			rate = Le32(f + 4);
+		} else if (!memcmp(wav + at, "data", 4)) {
+			samples = wav + at + 8;
+			sampleBytes = chunk;
+		}
+		at += 8 + chunk + (chunk & 1);
+	}
+	if (!format || !samples || !sampleBytes || rate < 4000 || rate > 48000)
+		return 0;
+	/* One block per 64 KiB keeps the 24-bit size field and the iMUSE reader's chunking comfortable. */
+	enum { BLOCK = 0xFFF0 };
+	uint32_t blocks = (sampleBytes + BLOCK - 1) / BLOCK;
+	uint32_t total = sampleBytes + blocks * 6 + 1;
+	uint16_t handle = Memory_AllocHandle(total, 0);
+	uint8_t* out = handle ? Memory_LockHandle(handle) : NULL;
+	if (!out) {
+		if (handle)
+			Memory_FreeHandle(handle);
+		return 0;
+	}
+	int divisor = 256 - (int)((1000000 + rate / 2) / rate);
+	if (divisor < 0)
+		divisor = 0;
+	for (uint32_t done = 0; done < sampleBytes;) {
+		uint32_t n = sampleBytes - done < BLOCK ? sampleBytes - done : BLOCK;
+		uint32_t length = n + 2;
+		*out++ = 1;
+		*out++ = (uint8_t)length;
+		*out++ = (uint8_t)(length >> 8);
+		*out++ = (uint8_t)(length >> 16);
+		*out++ = (uint8_t)divisor;
+		*out++ = 0; /* 8-bit unsigned PCM */
+		memcpy(out, samples + done, n);
+		out += n;
+		done += n;
+	}
+	*out = 0;
+	return handle;
+}
+
+void XwWeaponSounds_Apply(void) {
+	g_loaded = false;
+	if (!XwConfig_Settings()->xvt_weapon_sounds)
+		return;
+	uint16_t handles[6] = { 0 };
+	for (unsigned i = 0; i < 6; ++i) {
+		char path[64];
+		snprintf(path, sizeof path, "xvt_weapon_sounds/%s.WAV", g_xvtCannonSounds[i]);
+		uint8_t* data = NULL;
+		size_t size = 0;
+		if (AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, path, 1 << 20, &data, &size))
+			handles[i] = WavToVoc(data, size);
+		free(data);
+		if (!handles[i]) {
+			Aeron_LogWarn("xw.audio", "XvT weapon sound %s is missing or unsupported; keeping X-Wing's", path);
+			for (unsigned j = 0; j < i; ++j)
+				Memory_FreeHandle(handles[j]);
+			return;
+		}
+	}
+	for (unsigned i = 0; i < 6; ++i) {
+		unsigned slot = FSFX_FIRST_PLAYABLE_SLOT + i;
+		if (g_fsfxLoadedSoundHandles[slot])
+			Memory_FreeHandle(g_fsfxLoadedSoundHandles[slot]);
+		g_fsfxLoadedSoundHandles[slot] = handles[i];
+	}
+	g_loaded = true;
+}
+
+int XwWeaponSounds_SoundIndex(int projectileIndex, bool sourceIsStarship) {
+	if (g_loaded && !sourceIsStarship && (projectileIndex == 1 || projectileIndex == 5))
+		return projectileIndex - 1;
+	return projectileIndex;
+}
