diff --git a/src/xw_remaster/hud_readout.c b/src/xw_remaster/hud_readout.c
new file mode 100644
index 0000000..769f698
--- /dev/null
+++ b/src/xw_remaster/hud_readout.c
@@ -0,0 +1,245 @@
+/* render.xvt_targeting_computer: X-Wing vs TIE Fighter style CMD contents, drawn in the cockpit's CMD screen
+ * (or floating at the same place with the cockpit off): target name, shields/hull/systems, a live 3D view of
+ * the target, its orders and range. */
+#include "xw_remaster/hud_readout.h"
+#include "xw_remaster/target_view.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct Pen {
+	const XwHudDraw* d;
+	const XwHudImage* font;
+	const AeronRuntimeAtlas* atlas;
+	float sx, sy; /* Classic pixel to target pixel scales. */
+} Pen;
+
+static void Linear(uint32_t rgb, float alpha, float out[4]) {
+	for (unsigned i = 0; i < 3; ++i) {
+		float v = ((rgb >> (16 - 8 * i)) & 255) / 255.f;
+		out[i] = (v <= 0.04045f ? v / 12.92f : powf((v + 0.055f) / 1.055f, 2.4f)) * alpha;
+	}
+	out[3] = alpha;
+}
+
+static const AeronDecodedGlyph* Glyph(const Pen* p, char c) {
+	const AeronDecodedFont* f = &p->font->font;
+	unsigned ch = (unsigned char)c;
+	if (ch < f->first_char || ch - f->first_char >= f->glyph_count)
+		return NULL;
+	return &f->glyphs[ch - f->first_char];
+}
+
+/* Width in classic pixels. */
+static float Measure(const Pen* p, const char* text) {
+	float w = 0;
+	for (; *text; ++text) {
+		const AeronDecodedGlyph* g = Glyph(p, *text);
+		w += g ? g->advance : p->font->font.cell_width;
+	}
+	return w;
+}
+
+/* Draws text at classic coordinates, clipped to max_width classic pixels. */
+static void Text(const Pen* p, float x, float y, const char* text, uint32_t rgb, float max_width) {
+	float rgba[4];
+	Linear(rgb, 1, rgba);
+	unsigned index = p->font->atlas_frame;
+	if (index >= (unsigned)p->atlas->layout.frame_count)
+		return;
+	unsigned page = p->atlas->layout.pages ? p->atlas->layout.pages[index] : 0;
+	AeronSpriteRect frame = p->atlas->layout.frames[index];
+	AeronRuntimeAtlasPage pg = p->atlas->pages[page];
+	float limit = x + max_width;
+	for (; *text; ++text) {
+		const AeronDecodedGlyph* g = Glyph(p, *text);
+		float advance = g ? g->advance : p->font->font.cell_width;
+		if (x + advance > limit + 0.5f)
+			break;
+		/* Per-glyph rectangle: the font image stacks foreground, shadow and fill planes. */
+		if (g && *text != ' ' && g->height) {
+			AeronDrawList2DSprite s = { .texture = pg.texture,
+										.src_u0 = (frame.x + g->x) / pg.width,
+										.src_v0 = (frame.y + g->y) / pg.height,
+										.src_u1 = (frame.x + g->x + g->advance) / pg.width,
+										.src_v1 = (frame.y + g->y + g->height) / pg.height,
+										.dst_x = p->d->offset_x + x * p->sx,
+										.dst_y = p->d->offset_y + y * p->sy,
+										.dst_w = g->advance * p->sx,
+										.dst_h = g->height * p->sy,
+										.tint = { rgba[0], rgba[1], rgba[2], rgba[3] },
+										.blend = AERON_BLIT2D_BLEND_PMA,
+										.filter = AERON_BLIT2D_FILTER_NEAREST };
+			AeronDrawList_AddSprite(p->d->list, &s);
+		}
+		x += advance;
+	}
+}
+
+static void Centered(const Pen* p, const XwSnapRect* r, float y, const char* text, uint32_t rgb) {
+	float w = Measure(p, text);
+	Text(p, r->x + fmaxf(1, (r->width - w) / 2), y, text, rgb, r->width - 2);
+}
+
+static void Fill(const Pen* p, float x, float y, float w, float h, uint32_t rgb, float alpha) {
+	float rgba[4];
+	Linear(rgb, alpha, rgba);
+	AeronDrawList_AddFill(p->d->list, p->d->offset_x + x * p->sx, p->d->offset_y + y * p->sy, w * p->sx,
+						  h * p->sy, rgba, AERON_BLIT2D_BLEND_PMA, NULL);
+}
+
+enum {
+	LABEL = 0x5A9BFF,
+	VALUE = 0xE6EEFF,
+	FRIENDLY = 0x5AFF5A,
+	HOSTILE = 0xFF4A4A,
+	OTHER = 0x6EAAFF,
+	BACKDROP = 0x020617
+};
+
+static void Stat(char* out, size_t n, const char* label, int pct) {
+	if (pct < 0)
+		snprintf(out, n, "%s --", label);
+	else
+		snprintf(out, n, "%s %d%%", label, pct);
+}
+
+bool XwHudCmd_Active(const XwRenderSnapshot* s) {
+	const XwSnapCamera* c = &s->camera;
+	return XwFlightTweaks_XvtTargetingComputer() && s->flight_version == 98 && s->readout.valid &&
+		   !c->replay_mode && !s->cockpit.suppressed &&
+		   (c->hud_state == 0 || c->hud_state == XW_SNAP_VIEW_FULL_FORWARD);
+}
+
+bool XwHudCmd_Draw(const XwHudDraw* d) {
+	const XwRenderSnapshot* s = d->snapshot;
+	const XwSnapReadout* r = &s->readout;
+	if (!d->definition)
+		return true;
+	XwRenderAssetId font_id = d->definition->fonts[1] ? d->definition->fonts[1] : d->definition->fonts[0];
+	const XwHudImage* font =
+		font_id ? XwHudAssets_Image((XwHudImageKey) { .source = font_id, .kind = XW_HUD_IMAGE_FONT }) : NULL;
+	const AeronRuntimeAtlas* atlas = font ? XwHudAssets_Atlas(font) : NULL;
+	if (!font || !atlas || !font->font.glyph_count)
+		return true;
+	Pen pen = { d, font, atlas, d->layout.scale_x, d->layout.scale_y };
+	unsigned glyph_h = 0;
+	for (unsigned i = 0; i < font->font.glyph_count; ++i)
+		if (font->font.glyphs[i].height > glyph_h)
+			glyph_h = font->font.glyphs[i].height;
+	float line = glyph_h + 2.0f;
+	const XwSnapRect* box = &r->cmd;
+	bool cockpit_off = s->camera.hud_state == XW_SNAP_VIEW_FULL_FORWARD;
+
+	/* Cover X-Wing's own CMD artwork; with the cockpit off, a translucent panel at the same place. */
+	Fill(&pen, box->x, box->y, box->width, box->height, BACKDROP, cockpit_off ? 0.55f : 1.0f);
+	if (!r->target_valid)
+		return true;
+
+	float top = box->y + 1, bottom = box->y + box->height;
+	Centered(&pen, box, top,
+			 r->target_name, r->target_relation == 0 ? FRIENDLY : r->target_relation == 1 ? HOSTILE : OTHER);
+	char shd[16], hull[16], sys[16], stats[64];
+	Stat(shd, sizeof shd, "SHD", r->target_shield_pct);
+	Stat(hull, sizeof hull, "HULL", r->target_hull_pct);
+	Stat(sys, sizeof sys, "SYS", r->target_system_pct);
+	/* X-Wing's CMD is narrower than XvT's: tighten the spacing, drop the percent signs, shorten HULL, and as a
+	 * last resort put SYS on a line of its own. */
+	float fit = box->width - 2;
+	unsigned stat_lines = 1;
+	snprintf(stats, sizeof stats, "%s  %s  %s", shd, hull, sys);
+	if (Measure(&pen, stats) > fit)
+		snprintf(stats, sizeof stats, "%s %s %s", shd, hull, sys);
+	if (Measure(&pen, stats) > fit) {
+		char* out = stats;
+		for (const char* in = stats; *in; ++in)
+			if (*in != '%')
+				*out++ = *in;
+		*out = 0;
+	}
+	if (Measure(&pen, stats) > fit) {
+		char* h = strstr(stats, "HULL");
+		if (h)
+			memmove(h + 3, h + 4, strlen(h + 4) + 1);
+	}
+	if (Measure(&pen, stats) > fit) {
+		snprintf(stats, sizeof stats, "%s %s", shd, hull);
+		Centered(&pen, box, top + 2 * line, sys, LABEL);
+		stat_lines = 2;
+	}
+	Centered(&pen, box, top + line, stats, LABEL);
+
+	/* Bottom rows as in XvT: range centred on the last line, orders (or an alert status) above it, and
+	 * cargo or the order's target above that. */
+	char dist[24];
+	snprintf(dist, sizeof dist, "DIST %u.%02u", r->target_distance_hundredths / 100,
+			 r->target_distance_hundredths % 100);
+	float last = bottom - line;
+	Centered(&pen, box, last, dist, VALUE);
+	/* Orders only: SHD/HULL/SYS already show what X-Wing's status words ("SHLD DOWN") reported. */
+	const char* orders = r->target_orders;
+	float image_bottom = last - 1;
+	if (orders[0]) {
+		/* Wrap long orders ("LEADING FORMATION FLIGHT") onto two lines at a word break. */
+		char first[48], second[48] = "";
+		snprintf(first, sizeof first, "%s", orders);
+		if (Measure(&pen, first) > fit) {
+			char* cut = NULL;
+			for (char* space = strchr(first, ' '); space; space = strchr(space + 1, ' ')) {
+				*space = 0;
+				bool fits = Measure(&pen, first) <= fit;
+				*space = ' ';
+				if (!fits)
+					break;
+				cut = space;
+			}
+			if (cut) {
+				snprintf(second, sizeof second, "%s", cut + 1);
+				*cut = 0;
+			}
+		}
+		uint32_t color = LABEL;
+		if (second[0]) {
+			image_bottom -= line;
+			Centered(&pen, box, last - 2 * line, first, color);
+			Centered(&pen, box, last - line, second, color);
+		} else
+			Centered(&pen, box, last - line, first, color);
+		image_bottom -= line;
+	}
+	char detail[64] = "";
+	if (r->cargo_valid)
+		snprintf(detail, sizeof detail, "CARGO %s", r->target_cargo);
+	else if (r->target_order_target[0])
+		snprintf(detail, sizeof detail, "> %s", r->target_order_target);
+	if (detail[0]) {
+		image_bottom -= line;
+		Centered(&pen, box, image_bottom + 1, detail, VALUE);
+	}
+
+	/* The live 3D view between the stats and the bottom rows, letterboxed to its aspect. */
+	float aspect = 1;
+	AeronTexture* view = XwTargetView_Texture(&aspect);
+	float area_top = top + (1 + stat_lines) * line, area_h = image_bottom - area_top, area_w = box->width - 4;
+	if (view && area_h > 4 && area_w > 4) {
+		float w = area_w * pen.sx, h = area_h * pen.sy;
+		if (w / h > aspect)
+			w = h * aspect;
+		else
+			h = w / aspect;
+		AeronDrawList2DSprite sprite = { .texture = view,
+										 .src_u0 = 0,
+										 .src_v0 = 0,
+										 .src_u1 = 1,
+										 .src_v1 = 1,
+										 .dst_x = d->offset_x + (box->x + box->width / 2.0f) * pen.sx - w / 2,
+										 .dst_y = d->offset_y + (area_top + area_h / 2) * pen.sy - h / 2,
+										 .dst_w = w,
+										 .dst_h = h,
+										 .tint = { 1, 1, 1, cockpit_off ? 0.9f : 1 },
+										 .blend = AERON_BLIT2D_BLEND_PMA,
+										 .filter = AERON_BLIT2D_FILTER_LINEAR };
+		AeronDrawList_AddSprite(d->list, &sprite);
+	}
+	return true;
+}
