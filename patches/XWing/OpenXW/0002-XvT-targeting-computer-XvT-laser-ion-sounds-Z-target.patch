diff --git a/src/xw_remaster/target_view.c b/src/xw_remaster/target_view.c
new file mode 100644
index 0000000..ec806c9
--- /dev/null
+++ b/src/xw_remaster/target_view.c
@@ -0,0 +1,175 @@
+/* render.xvt_targeting_computer: a live 3D view of the player's target for the CMD, as in X-Wing vs TIE Fighter
+ * and OpenTIE's targeting display. The target is seen from the player's camera direction at a fixed framing
+ * distance, so its attitude matches what the pilot would see. */
+#include "xw_remaster/target_view.h"
+#include "xw_remaster/assets.h"
+#include "xw_remaster/component_animation.h"
+#include "xw_remaster/config.h"
+#include "xw_remaster/lighting.h"
+#include "xw_remaster/ship.h"
+#include <aeron/aeron.h>
+#include <aeron/asset/opt_model.h>
+#include <math.h>
+#include <string.h>
+
+enum { TARGET_VIEW_W = 448, TARGET_VIEW_H = 256 };
+
+static AeronScene3D* scene;
+static AeronSceneMeshTable table;
+static AeronTexture* texture;
+static bool prepared;
+
+static bool Ensure(void) {
+	if (scene)
+		return true;
+	scene = AeronScene_Create(&(AeronScene3DDesc) { .rt_width = TARGET_VIEW_W,
+												   .rt_height = TARGET_VIEW_H,
+												   .color_format = AERON_TEXTURE_FORMAT_RGBA16_FLOAT,
+												   .with_normal_rt = 0,
+												   .sample_count = AERON_SAMPLE_COUNT_1,
+												   .temporal_mode = AERON_TEMPORAL_OFF,
+												   .view_space_to_meters = AERON_OPT_METERS_PER_UNIT });
+	return scene != NULL;
+}
+
+static const XwSnapObject* FindTarget(const XwRenderSnapshot* s) {
+	for (unsigned i = 0; i < s->object_count; ++i)
+		if (XwRenderMath_SameObject(s->objects[i].id, s->readout.target))
+			return &s->objects[i];
+	return NULL;
+}
+
+static void Normalize(float v[3]) {
+	float length = sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+	if (length > 1e-6f)
+		for (unsigned i = 0; i < 3; ++i)
+			v[i] /= length;
+}
+
+bool XwTargetView_Render(const XwRenderSnapshot* s) {
+	texture = NULL;
+	if (!s || s->flight_version != 98 || !s->world_valid || !s->readout.target_valid)
+		return true;
+	const XwSnapObject* object = FindTarget(s);
+	const XwRenderAssetSetView* set = XwRenderAssets_Set(s->flight_assets);
+	if (!object || !set || set->failed)
+		return true;
+	XwShipSelection selection;
+	if (XwShip_Select(&set->bindings, object, &selection) != 1)
+		return true;
+	const XwMeshAsset* asset = XwRemasterAssets_Mesh(selection.asset_id);
+	const XwSnapCraft* craft = object->craft_index < s->craft_count ? &s->crafts[object->craft_index] : NULL;
+	if (!asset || !XwShip_BuildMeshTable(asset, object, craft, selection.component,
+										 XwComponentAnimation_Angles(object, false), &table))
+		return true;
+	if (!Ensure())
+		return false;
+
+	/* The model sits at the origin; the camera looks at it along the pilot's line of sight. */
+	AeronSceneMeshInstance instance = { .mesh = asset->mesh,
+										.variant = selection.variant,
+										.mesh_table = &table,
+										.prev_mesh_table = &table,
+										.zero_velocity = 1,
+										.cull_mode = AERON_CULL_BACK,
+										.shadow_flags = AERON_SCENE_INSTANCE_NO_CAST_SHADOW |
+														AERON_SCENE_INSTANCE_NO_RECEIVE_SHADOW };
+	XwRenderMath_ObjectMatrix(object, 98, object->world_pos, instance.transform);
+	memcpy(instance.prev_transform, instance.transform, sizeof instance.transform);
+	/* Frame by the model's own bounding box; the culling radius is too conservative for multi-part craft. */
+	float half2 = 0, scale = 0;
+	for (unsigned i = 0; i < 3; ++i) {
+		float half = (asset->mesh->bound_max[i] - asset->mesh->bound_min[i]) * 0.5f;
+		half2 += half * half;
+		const float* m = instance.transform;
+		scale = fmaxf(scale, sqrtf(m[i] * m[i] + m[4 + i] * m[4 + i] + m[8 + i] * m[8 + i]));
+	}
+	/* Centre the bounding box rather than the model origin. */
+	float centre[3], local[3];
+	for (unsigned i = 0; i < 3; ++i)
+		local[i] = (asset->mesh->bound_min[i] + asset->mesh->bound_max[i]) * 0.5f;
+	for (unsigned r = 0; r < 3; ++r) {
+		const float* m = instance.transform + 4 * r;
+		centre[r] = m[0] * local[0] + m[1] * local[1] + m[2] * local[2];
+	}
+	float radius = sqrtf(half2) * scale * 0.85f;
+	if (!(radius > 0))
+		return true;
+
+	float forward[3];
+	XwRenderMath_Local(s->camera.world_pos, object->world_pos, forward);
+	Normalize(forward);
+	if (!(fabsf(forward[0]) + fabsf(forward[1]) + fabsf(forward[2]) > 0))
+		memcpy(forward, s->camera.rows + 6, sizeof forward);
+	float down[3] = { s->camera.rows[3], s->camera.rows[4], s->camera.rows[5] };
+	float along = down[0] * forward[0] + down[1] * forward[1] + down[2] * forward[2];
+	for (unsigned i = 0; i < 3; ++i)
+		down[i] -= forward[i] * along;
+	Normalize(down);
+	float rows[9] = { down[1] * forward[2] - down[2] * forward[1],
+					  down[2] * forward[0] - down[0] * forward[2],
+					  down[0] * forward[1] - down[1] * forward[0],
+					  down[0],
+					  down[1],
+					  down[2],
+					  forward[0],
+					  forward[1],
+					  forward[2] };
+	float v_half = 0.32f, h_half = atanf(tanf(v_half) * TARGET_VIEW_W / TARGET_VIEW_H);
+	float distance = radius / sinf(v_half) * 1.08f;
+	AeronSceneCamera camera = { .h_half_rad = h_half,
+								.v_half_rad = v_half,
+								.near_z = fmaxf(1.0f, distance - radius * 2.0f),
+								.viewport = { 0, 0, TARGET_VIEW_W, TARGET_VIEW_H } };
+	if (!XwRenderMath_BasisQuat(rows, camera.ori))
+		return true;
+	for (unsigned i = 0; i < 3; ++i)
+		camera.pos[i] = centre[i] - forward[i] * distance;
+
+	if (!AeronScene_Begin(scene, &camera) || !AeronScene_SetMeshSampler(scene, XwRemasterConfig_MeshSampler()))
+		return false;
+	if (!prepared && !(prepared = AeronScene_PrepareResources(scene, AERON_CULL_BACK)))
+		return false;
+	/* The CMD backdrop colour (sRGB #020617) in linear light, so the image blends into the panel. */
+	AeronScene_SetClearColor(scene, (const float[4]) { 0.0006f, 0.0018f, 0.0080f, 1 });
+	AeronScene_SetPost(scene, &(AeronScenePostDesc) { 0 });
+	AeronScene_SetDirectionalShadow(scene, &(AeronSceneDirectionalShadowDesc) { .enabled = 0 });
+	/* Aeron validates the slice count even when clustering is off. */
+	if (!AeronScene_SetClusteredLights(scene, &(AeronSceneClusteredLightDesc) { .enabled = 0, .depth_slices = 16 }))
+		return false;
+	/* XvT's CMD model is brightly lit whatever the mission's sun: key light from over the viewer's shoulder
+	 * plus a strong ambient fill. */
+	XwSnapAppearance light = s->appearance;
+	for (unsigned i = 0; i < 3; ++i)
+		light.direction_q15[i] =
+			(int32_t)(-(forward[i] * 0.6f + rows[3 + i] * 0.55f - rows[i] * 0.35f) * 32767.0f);
+	light.directional_enabled = 1;
+	XwLighting_EnvironmentAmbient(scene, &light, camera.pos, 0.30f);
+	AeronScene_AddMeshInstance(scene, &instance);
+	AeronCommandBuffer* cmd = Aeron_AcquireCommandBuffer();
+	if (!cmd)
+		return false;
+	Aeron_GpuDebugPush(cmd, "X-Wing XvT targeting computer");
+	if (!AeronScene_Render(scene, cmd)) {
+		Aeron_CancelCommandBuffer(cmd);
+		return false;
+	}
+	Aeron_GpuDebugPop(cmd);
+	if (!Aeron_SubmitCommandBuffer(cmd))
+		return false;
+	texture = AeronScene_ColorTexture(scene);
+	return true;
+}
+
+AeronTexture* XwTargetView_Texture(float* aspect) {
+	if (aspect)
+		*aspect = (float)TARGET_VIEW_W / TARGET_VIEW_H;
+	return texture;
+}
+
+void XwTargetView_Shutdown(void) {
+	AeronScene_Destroy(scene);
+	scene = NULL;
+	texture = NULL;
+	prepared = false;
+}
