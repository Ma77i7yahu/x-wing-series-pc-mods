+
+/* ---- view_target (Z): X-Wing vs TIE Fighter's threat display ----
+ * XvT's frame art (cp640\TIEFTRTD.LFD, entries "thrt64") is copied into RESOURCE xvt_threat_display at
+ * packaging time. Its window is transparent; the target camera shows through it. */
+
+static AeronTexture* g_threatFrame;
+static bool g_threatFrameFailed;
+
+static bool LoadThreatFrame(void) {
+	if (g_threatFrame || g_threatFrameFailed)
+		return g_threatFrame != NULL;
+	g_threatFrameFailed = true;
+	uint8_t* lfd = NULL;
+	size_t size = 0;
+	if (!AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, "xvt_threat_display/TIEFTRTD.LFD", 1 << 22,
+						  &lfd, &size)) {
+		Aeron_LogWarn("xw.hud", "XvT threat display art is missing; Z shows the plain target camera");
+		return false;
+	}
+	const uint8_t *panl = NULL, *pltt = NULL;
+	size_t panl_size = 0, pltt_size = 0;
+	for (size_t at = 0; at + 16 <= size;) {
+		uint32_t length = lfd[at + 12] | (uint32_t)lfd[at + 13] << 8 | (uint32_t)lfd[at + 14] << 16 |
+						  (uint32_t)lfd[at + 15] << 24;
+		if (length > size - at - 16)
+			break;
+		if (!memcmp(lfd + at, "PANL", 4)) {
+			panl = lfd + at + 16;
+			panl_size = length;
+		} else if (!memcmp(lfd + at, "PLTT", 4)) {
+			pltt = lfd + at + 16;
+			pltt_size = length;
+		}
+		at += 16 + length;
+	}
+	AeronPnlBitmap bitmap = { 0 };
+	AeronDecodeError error = { 0 };
+	bool ok = panl && pltt && pltt_size >= 2 && AeronPnl_DecodeIndexed(panl, panl_size, 0, 0, &bitmap, &error);
+	uint8_t* rgba = ok ? malloc((size_t)bitmap.width * bitmap.height * 4) : NULL;
+	if (rgba) {
+		uint8_t palette[256][3] = { { 0 } };
+		unsigned first = pltt[0], last = pltt[1];
+		bool six_bit = true;
+		for (size_t i = 2; i < pltt_size; ++i)
+			six_bit = six_bit && pltt[i] < 64;
+		for (unsigned i = first; i <= last && 2 + (i - first) * 3 + 2 < pltt_size; ++i)
+			for (unsigned c = 0; c < 3; ++c) {
+				unsigned v = pltt[2 + (i - first) * 3 + c];
+				palette[i][c] = (uint8_t)(six_bit ? v * 4 : v);
+			}
+		/* Premultiplied: the window and other uncovered pixels are fully transparent. */
+		for (size_t i = 0; i < (size_t)bitmap.width * bitmap.height; ++i) {
+			bool covered = bitmap.coverage[i] != 0;
+			for (unsigned c = 0; c < 3; ++c)
+				rgba[i * 4 + c] = covered ? palette[bitmap.indices[i]][c] : 0;
+			rgba[i * 4 + 3] = covered ? 255 : 0;
+		}
+		AeronCommandBuffer* cmd = Aeron_AcquireCommandBuffer();
+		g_threatFrame = cmd ? Aeron_CreateTexture(&(AeronTextureDesc) {
+								  .width = bitmap.width,
+								  .height = bitmap.height,
+								  .format = AERON_TEXTURE_FORMAT_RGBA8_SRGB,
+								  .usage = AERON_TEXTURE_USAGE_SAMPLED | AERON_TEXTURE_USAGE_TRANSFER_DST,
+								  .debug_name = "xw.xvt_threat_display" })
+							: NULL;
+		if (g_threatFrame &&
+			Aeron_UploadTextureDataCmd(cmd, &(AeronTextureUploadDesc) {
+												.texture = g_threatFrame,
+												.width = bitmap.width,
+												.height = bitmap.height,
+												.raw_data = rgba,
+												.raw_size = (size_t)bitmap.width * bitmap.height * 4 }) &&
+			Aeron_SubmitCommandBuffer(cmd))
+			g_threatFrameFailed = false;
+		else {
+			if (cmd)
+				Aeron_CancelCommandBuffer(cmd);
+			Aeron_DestroyTexture(g_threatFrame);
+			g_threatFrame = NULL;
+		}
+		free(rgba);
+	}
+	AeronIndexedFrame_Free(&bitmap);
+	free(lfd);
+	return g_threatFrame != NULL;
+}
+
+void XwHudThreat_Shutdown(void) {
+	Aeron_DestroyTexture(g_threatFrame);
+	g_threatFrame = NULL;
+	g_threatFrameFailed = false;
+}
+
+bool XwHudThreat_Active(const XwRenderSnapshot* s) {
+	return XwFlightTweaks_XvtTargetingComputer() && s->readout.threat_view && s->readout.target_valid &&
+		   !s->camera.replay_mode && LoadThreatFrame();
+}
+
+enum { THREAT_RED = 0xFF4A3A, THREAT_BLUE = 0x5A9BFF, THREAT_GREEN = 0x3CE650, THREAT_YELLOW = 0xF0C030,
+	   THREAT_WHITE = 0xF0F0F0 };
+
+static void Labelled(const Pen* p, float x, float y, float max_width, const char* label, uint32_t label_rgb,
+					 const char* value, uint32_t value_rgb) {
+	Text(p, x, y, label, label_rgb, max_width);
+	float w = Measure(p, label) + Measure(p, " ");
+	Text(p, x + w, y, value, value_rgb, max_width - w);
+}
+
+bool XwHudThreat_Draw(const XwHudDraw* d) {
+	const XwSnapReadout* r = &d->snapshot->readout;
+	float tw = d->layout.target_width, th = d->layout.target_height;
+	float unit = fminf(tw / 640.0f, th / 480.0f);
+	float ox = (tw - 640 * unit) / 2, oy = (th - 480 * unit) / 2;
+	/* XvT's display is 4:3; widescreen sides stay dark around it. */
+	const float black[4] = { 0, 0, 0, 1 };
+	if (ox > 0) {
+		AeronDrawList_AddFill(d->list, 0, 0, ox + 1, th, black, AERON_BLIT2D_BLEND_PMA, NULL);
+		AeronDrawList_AddFill(d->list, tw - ox - 1, 0, ox + 1, th, black, AERON_BLIT2D_BLEND_PMA, NULL);
+	}
+	AeronDrawList2DSprite frame = { .texture = g_threatFrame,
+									.src_u0 = 0,
+									.src_v0 = 0,
+									.src_u1 = 1,
+									.src_v1 = 1,
+									.dst_x = ox,
+									.dst_y = oy,
+									.dst_w = 640 * unit,
+									.dst_h = 480 * unit,
+									.tint = { 1, 1, 1, 1 },
+									.blend = AERON_BLIT2D_BLEND_PMA,
+									.filter = AERON_BLIT2D_FILTER_LINEAR };
+	AeronDrawList_AddSprite(d->list, &frame);
+
+	if (!d->definition)
+		return true;
+	/* The cockpit's larger HUD font when it fits the frame's boxes, as XvT's own text does. */
+	const XwHudImage* font = NULL;
+	for (unsigned i = 0; i < 2 && !font; ++i) {
+		XwRenderAssetId id = d->definition->fonts[i];
+		const XwHudImage* candidate =
+			id ? XwHudAssets_Image((XwHudImageKey) { .source = id, .kind = XW_HUD_IMAGE_FONT }) : NULL;
+		unsigned height = 0;
+		for (unsigned g = 0; candidate && g < candidate->font.glyph_count; ++g)
+			if (candidate->font.glyphs[g].height > height)
+				height = candidate->font.glyphs[g].height;
+		if (candidate && height && height <= 14)
+			font = candidate;
+	}
+	const AeronRuntimeAtlas* atlas = font ? XwHudAssets_Atlas(font) : NULL;
+	if (!font || !atlas)
+		return true;
+	/* Text in the frame's 640x480 pixels; X-Wing's 640-wide fonts map one to one. */
+	Pen pen = { d, font, atlas, unit, unit, ox, oy };
+	uint32_t name_rgb = r->target_relation == 0 ? THREAT_GREEN : r->target_relation == 1 ? THREAT_RED : THREAT_BLUE;
+
+	/* Top boxes: name, range, cargo. */
+	{
+		XwSnapRect name_box = { 100, 31, 146, 14 };
+		Centered(&pen, &name_box, name_box.y, r->target_name, name_rgb);
+		char dist[16];
+		snprintf(dist, sizeof dist, "%u.%02u", r->target_distance_hundredths / 100, r->target_distance_hundredths % 100);
+		Labelled(&pen, 272, 31, 108, "DIST:", THREAT_RED, dist, THREAT_RED);
+		Labelled(&pen, 400, 31, 146, "CARGO:", THREAT_BLUE, r->cargo_valid ? r->target_cargo : "NONE", THREAT_BLUE);
+	}
+	/* Status boxes under the window. */
+	{
+		static const float boxes[3] = { 106, 180, 254 };
+		const char* labels[3] = { "SHD:", "HULL:", "SYS:" };
+		const int16_t values[3] = { r->target_shield_pct, r->target_hull_pct, r->target_system_pct };
+		const uint32_t colors[3] = { THREAT_BLUE, THREAT_GREEN, THREAT_YELLOW };
+		for (unsigned i = 0; i < 3; ++i) {
+			char value[8];
+			if (values[i] < 0)
+				snprintf(value, sizeof value, "--");
+			else
+				snprintf(value, sizeof value, "%d", values[i]);
+			Labelled(&pen, boxes[i], 287, 60, labels[i], colors[i], value, colors[i]);
+		}
+	}
+	/* Lower panel: orders, destination, distance to destination, time remaining. */
+	{
+		float x = 132, y = 357, line = 18, width = 376;
+		char orders[80];
+		snprintf(orders, sizeof orders, "%s%s%s", r->target_orders,
+				 r->target_order_target[0] ? " " : "", r->target_order_target);
+		Labelled(&pen, x, y, width, "CURRENT ORDERS:", THREAT_BLUE, r->target_orders[0] ? orders : "NONE",
+				 THREAT_YELLOW);
+		Labelled(&pen, x, y + line, width, "CURRENT DESTINATION:", THREAT_BLUE,
+				 r->destination_valid ? r->destination : "NONE", THREAT_WHITE);
+		char distance[16] = "UNKNOWN", remaining[16] = "UNKNOWN";
+		if (r->destination_valid)
+			snprintf(distance, sizeof distance, "%u.%02u", r->destination_distance_hundredths / 100,
+					 r->destination_distance_hundredths % 100);
+		if (r->destination_valid && r->time_remaining_s >= 0)
+			snprintf(remaining, sizeof remaining, "%ld:%02ld", (long)(r->time_remaining_s / 60),
+					 (long)(r->time_remaining_s % 60));
+		Labelled(&pen, x, y + 2 * line, width, "DISTANCE TO DESTINATION:", THREAT_BLUE, distance, THREAT_RED);
+		Labelled(&pen, x, y + 3 * line, width, "TIME REMAINING:", THREAT_BLUE, remaining, THREAT_GREEN);
+	}
+	return true;
+}
