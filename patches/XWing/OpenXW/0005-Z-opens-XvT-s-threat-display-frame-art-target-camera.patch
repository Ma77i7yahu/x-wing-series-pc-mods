+/* XvT's threat display: where the target's AI is heading, how far that is, and how long it will take. */
+static void CaptureDestination(XwSnapReadout* r, uint16_t ref, const CraftData* craft) {
+	/* XWI point order: start 1, waypoints 1-3, starts 2-3, hyperspace. */
+	static const char* const points[7] = { "START", "WAYPT 1", "WAYPT 2", "WAYPT 3", "START", "START",
+										   "HYPERSPACE" };
+	uint16_t aim = craft->aiTargetRef;
