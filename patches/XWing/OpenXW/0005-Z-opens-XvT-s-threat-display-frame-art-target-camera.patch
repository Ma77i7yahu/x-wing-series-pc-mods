 /* view_target (Z): set while the camera chases the player's target. Other view keys can take the camera
  * away, so it only counts while the camera is still external on a non-player object. */
 static int s_targetViewFlag, s_targetViewPreviousExternal;
+static int16_t s_targetViewPreviousDistance;
 #define s_targetViewActive                                                                                  \
 	(s_targetViewFlag && g_flightCamera.externalViewActive != 0 &&                                          \
 	 g_flightCamera.focusObjectRef != g_playerFlightState.objectIndex)
 
+int user_targetviewactive(void) { return s_targetViewActive; }
+
+/* XvT's threat display frames the target: chase distance from the game's own model size. */
+static void user_frametargetview(uint16_t target) {
+	int distance = g_modelTypeTable[g_objectTable[target].objectType].maxBoundsExtent * 2;
+	if (distance < USER_CAMERA_MIN_DISTANCE)
+		distance = USER_CAMERA_MIN_DISTANCE;
+	/* Capital ships need more room than the manual zoom's USER_CAMERA_MAX_DISTANCE. */
+	if (distance > INT16_MAX)
+		distance = INT16_MAX;
+	g_flightCamera.externalDistance = (int16_t)distance;
+}
+
 /* Leaves the target view; the caller has already pointed the camera focus back at the player. */
 static void user_endtargetview(void) {
 	s_targetViewFlag = 0;
+	g_flightCamera.externalDistance = s_targetViewPreviousDistance;
 	g_flightCamera.externalViewActive = s_targetViewPreviousExternal;
 	if (!s_targetViewPreviousExternal) {
 		g_flightCamera.hudAimX = g_flightCamera.savedHudAimX;
@@ -254,11 +269,19 @@ void user_userinterface(void) {
 	 * the cockpit instead of following whatever takes the slot. */
 	if (g_replayviewmode == 0 && s_targetViewActive) {
 		const ObjectRecord* focus = &g_objectTable[g_flightCamera.focusObjectRef];
+		uint16_t target = g_playerFlightState.currentTargetObjectIdx;
 		if (focus->objectType == XW_OBJ_NONE || focus->genusId == XW_GENUS_EXPLOSION_EFFECT ||
 			focus->familyId != XW_OBJECT_FAMILY_CRAFT) {
 			g_flightCamera.focusObjectRef = g_playerFlightState.objectIndex;
 			user_endtargetview();
 			user_resetview();
+		} else if (target != g_flightCamera.focusObjectRef && target < g_mainObjectSlotEnd &&
+				   target != g_playerFlightState.objectIndex && g_objectTable[target].objectType != XW_OBJ_NONE &&
+				   g_objectTable[target].familyId == XW_OBJECT_FAMILY_CRAFT) {
+			/* As in XvT, cycling targets in the threat display moves the camera to the new target. */
+			g_flightCamera.focusObjectRef = target;
+			user_frametargetview(target);
+			user_resetview();
 		}
 	}
 #endif
@@ -724,7 +747,9 @@ void user_inputforplane(void) {
 					g_flightCamera.savedHudAimY = g_flightCamera.hudAimY;
 				}
 				s_targetViewPreviousExternal = g_flightCamera.externalViewActive;
+				s_targetViewPreviousDistance = g_flightCamera.externalDistance;
 				g_flightCamera.focusObjectRef = g_playerFlightState.currentTargetObjectIdx;
+				user_frametargetview(g_flightCamera.focusObjectRef);
 				g_flightCamera.externalViewActive = 1;
 				s_targetViewFlag = 1;
 				user_resetview();
