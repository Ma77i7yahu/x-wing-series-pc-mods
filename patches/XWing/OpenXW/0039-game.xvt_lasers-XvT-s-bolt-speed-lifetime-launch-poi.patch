diff --git a/src/xw_runtime/runtime/xvt_hardpoints.c b/src/xw_runtime/runtime/xvt_hardpoints.c
new file mode 100644
index 0000000..ca0fad2
--- /dev/null
+++ b/src/xw_runtime/runtime/xvt_hardpoints.c
@@ -0,0 +1,49 @@
+#include "xw_runtime/runtime/xvt_hardpoints.h"
+#include "xw_runtime/config/flight_tweaks.h"
+#include "xw_runtime/runtime/flight_types.h"
+
+enum { MAX_SLOTS = 8 };
+
+typedef struct Point {
+	int16_t side, up, forward;
+} Point;
+
+typedef struct Craft {
+	uint8_t type, slots; /* X-Wing craft type index; slots 0..slots-1 are replaced. */
+	Point points[MAX_SLOTS];
+} Craft;
+
+/* XvT CP640/IVFILES OPT hardpoints (x, -y, z as ModelMesh_GetHardpoint reads them), in XvT's slot order:
+ * each laser group, then each warhead launcher, by mesh then hardpoint. */
+static const Craft kCraft[] = {
+	/* X-W: cannons top left, bottom left, bottom right, top right; torpedoes. */
+	{ 0, 6, { { -182, 66, 131 }, { -182, -38, 131 }, { 182, -38, 131 }, { 182, 66, 131 }, { 17, -4, 332 },
+			  { -18, -4, 332 } } },
+	/* B-W (Balance of Power): lasers on the wing tips and lower wing, ions above the cockpit; torpedoes. */
+	{ 3, 8, { { -231, -53, 204 }, { 0, -456, 163 }, { 232, -53, 204 }, { -11, 166, 159 }, { 0, 164, 197 },
+			  { 12, 166, 159 }, { 37, -55, 66 }, { -36, -55, 66 } } },
+	/* T/F. */
+	{ 4, 2, { { -17, -32, 70 }, { 15, -33, 70 } } },
+	/* T/I: top left, bottom left, top right, bottom right. */
+	{ 5, 4, { { -174, 40, 286 }, { -174, -46, 286 }, { 174, 40, 286 }, { 174, -46, 286 } } },
+	/* SHU (all four X-Wing shuttle types use the Lambda model). */
+	{ 16, 4, { { -185, 10, 211 }, { 185, 10, 211 }, { -103, 129, 211 }, { 101, 129, 211 } } },
+	{ 17, 4, { { -185, 10, 211 }, { 185, 10, 211 }, { -103, 129, 211 }, { 101, 129, 211 } } },
+	{ 18, 4, { { -185, 10, 211 }, { 185, 10, 211 }, { -103, 129, 211 }, { 101, 129, 211 } } },
+	{ 19, 4, { { -185, 10, 211 }, { 185, 10, 211 }, { -103, 129, 211 }, { 101, 129, 211 } } },
+};
+
+bool XwXvtHardpoints_Get(unsigned craftTypeIndex, unsigned slot, int16_t* side, int16_t* up, int16_t* forward) {
+	if (!XwFlightTweaks_XvtLasers() || XwFlightTypes_Dos())
+		return false;
+	for (unsigned i = 0; i < sizeof kCraft / sizeof kCraft[0]; ++i)
+		if (kCraft[i].type == craftTypeIndex) {
+			if (slot >= kCraft[i].slots)
+				return false;
+			*side = kCraft[i].points[slot].side;
+			*up = kCraft[i].points[slot].up;
+			*forward = kCraft[i].points[slot].forward;
+			return true;
+		}
+	return false;
+}
diff --git a/src/xw_runtime/runtime/xvt_hardpoints.h b/src/xw_runtime/runtime/xvt_hardpoints.h
new file mode 100644
index 0000000..8f6c1a2
--- /dev/null
+++ b/src/xw_runtime/runtime/xvt_hardpoints.h
@@ -0,0 +1,22 @@
+#ifndef XW_RUNTIME_RUNTIME_XVT_HARDPOINTS_H
+#define XW_RUNTIME_RUNTIME_XVT_HARDPOINTS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* game.xvt_lasers: where X-Wing vs TIE Fighter fires each weapon slot from, for the 1998 craft whose XvT
+ * positions differ from X-Wing's table. XvT keeps the same static table as X-Wing, then rebuilds a weapon
+ * group from the OPT's hardpoints when the OPT has them (fediskio.c), so the X-Wing, B-Wing (Balance of
+ * Power OPT), TIE fighter, TIE interceptor and shuttle fire from their model's guns, in mesh order. Slot
+ * counts match X-Wing's; craft whose counts differ (the TIE Advanced) and capital ships keep X-Wing's.
+ * False (keep the table) for other craft, other slots, DOS flight, or with xvt_lasers off. */
+bool XwXvtHardpoints_Get(unsigned craftTypeIndex, unsigned slot, int16_t* side, int16_t* up, int16_t* forward);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
