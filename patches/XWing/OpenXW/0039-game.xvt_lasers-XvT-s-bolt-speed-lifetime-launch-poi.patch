+/* XvT's g_projectileDamageByObjectType for its cannon types 137-142 (rebel laser, rebel turbo, imperial laser,
+ * imperial turbo, ion, ion turbo), which line up with X-Wing's 143-148 (the turbo is X-Wing's charged shot). */
+static const int16_t kXvtSpeed[CANNON_PROJECTILE_TYPES] = { 2000, 2000, 1800, 1800, 1400, 1600 };
+/* Lifetime as a fraction of X-Wing's: XvT 1, 1.5, 1, 1.5, 1.5, 2 s against X-Wing's 2, 3, 2, 3, 5, 5 s. */
+static const int16_t kXvtLifetimeRatio[CANNON_PROJECTILE_TYPES][2] = { { 1, 2 }, { 1, 2 },  { 1, 2 },
+																		{ 1, 2 }, { 3, 10 }, { 2, 5 } };
+enum { XVT_CANNON_LAUNCH_OFFSET = 921 };
+
+static bool XvtCannon(int index) { return s_xvt_lasers && index >= 0 && index < CANNON_PROJECTILE_TYPES; }
+
+int16_t XwFlightTweaks_ProjectileSpeed(int index, int16_t base) { return XvtCannon(index) ? kXvtSpeed[index] : base; }
 
 int16_t XwFlightTweaks_ProjectileLifetimeTicks(int index, int16_t baseTicks) {
-	return s_xvt_lasers && index >= 0 && index < CANNON_PROJECTILE_TYPES ? (int16_t)(baseTicks / 2) : baseTicks;
+	return XvtCannon(index)
+			   ? (int16_t)((int32_t)baseTicks * kXvtLifetimeRatio[index][0] / kXvtLifetimeRatio[index][1])
+			   : baseTicks;
+}
+
+int16_t XwFlightTweaks_ProjectileLaunchOffset(int index, int16_t base) {
+	return XvtCannon(index) ? XVT_CANNON_LAUNCH_OFFSET : base;
 }
