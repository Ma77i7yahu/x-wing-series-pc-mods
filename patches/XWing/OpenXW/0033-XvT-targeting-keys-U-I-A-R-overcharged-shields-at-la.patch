+#ifdef XW_MODERN
+				/* As XvT's R: shuttles, transports and tugs count alongside fighters. */
+				uint8_t genus = g_objectTable[index].genusId;
+				if (g_objectTable[index].objectType != XW_OBJ_NONE &&
+					index != g_playerFlightState.objectIndex &&
+					(genus == XW_GENUS_STARFIGHTER || genus == XW_GENUS_TRANSPORT || genus == XW_GENUS_UTILITY) &&
+					g_objectTable[index].iff != g_objectTable[g_playerFlightState.objectIndex].iff) {
+#else
 				if (g_objectTable[index].objectType != XW_OBJ_NONE &&
 					index != g_playerFlightState.objectIndex &&
 					g_objectTable[index].genusId == XW_GENUS_STARFIGHTER &&
 					g_objectTable[index].iff != g_objectTable[g_playerFlightState.objectIndex].iff) {
+#endif
 					uint8_t kind = ((CraftData*)g_objectTable[index].instanceData)->objectKind;
 					if (kind == XW_CRAFT_OBJECT_KIND_0 || kind == XW_CRAFT_OBJECT_KIND_6) {
 						pai_distancebetween(g_playerFlightState.objectIndex, index);
@@ -1223,6 +1316,24 @@ void user_inputforplane(void) {
 			user_setnewtarget(target);
 			break;
 		}
+#ifdef XW_MODERN
+		case USER_KEY_TARGET_NEWEST:
+			user_setnewtarget(user_findnewestcraft());
+			break;
+		case USER_KEY_TARGET_INCOMING_WARHEAD: {
+			uint16_t warhead = user_findincomingwarhead();
+			user_setnewtarget(warhead);
+			/* Targeting the announced warhead answers its "press space" prompt, as space does. */
+			if (warhead != XW_PLAYER_NO_TARGET &&
+				warhead == g_playerFlightState.incomingWarheadObjectIndex &&
+				g_playerFlightState.incomingWarheadAlertState == USER_WARHEAD_ALERT_TRACKING)
+				g_playerFlightState.incomingWarheadAlertState = 0;
+			break;
+		}
+		case USER_KEY_TARGET_ATTACKER_OF_TARGET:
+			user_setnewtarget(user_findattackeroftarget(g_playerFlightState.currentTargetObjectIdx));
+			break;
+#endif
 		case 'i':
 			g_playerFlightState.hudTargetDetailsEnabled ^= 1;
 			g_hudCachedTargetObjectIdx = USER_HUD_TARGET_CACHE_RESET;
