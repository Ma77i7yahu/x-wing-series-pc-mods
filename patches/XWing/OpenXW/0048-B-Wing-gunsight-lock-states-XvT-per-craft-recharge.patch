From 84a86140d69ac5498b5433127df01f7754417db4 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sun, 11 Oct 2026 07:22:30 +1100
Subject: [PATCH 48/59] B-Wing gunsight lock states; XvT per-craft recharge

- hud_instruments.c: the B-Wing gunsight (91x68, the same as XvT's) was past
  the 4000 px overlay cut-off, so with the XvT cockpit its lit and lock
  states never drew. The gunsight element is now exempt.
- game.xvt_recharge (Game page Recharge Rates): the base rates already match
  XvT (20 shield / 2 laser per power step per second, same caps and shield
  strengths). XvT also doubles the Y-Wing's shield recharge and gives TIE
  fighters and bombers 3 laser charge per step.
---
 resources/config.yaml                    |  3 +++
 src/xw/flight/object/laser.c             | 18 ++++++++++++++++--
 src/xw_app/settings/game_page.c          |  2 ++
 src/xw_remaster/hud_instruments.c        |  9 +++++----
 src/xw_remaster/xvt_cockpit.h            |  2 ++
 src/xw_runtime/config/flight_tweaks.c    |  5 +++++
 src/xw_runtime/config/flight_tweaks.h    |  5 +++++
 src/xw_runtime/config/preference_apply.c |  1 +
 src/xw_runtime/config/settings.c         |  1 +
 src/xw_runtime/config/settings.h         |  2 +-
 10 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/resources/config.yaml b/resources/config.yaml
index bd3d67e..c438339 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -277,6 +277,9 @@ game:
   # Player shields as in X-Wing vs TIE Fighter: after a hit, the hit bank draws
   # energy from the other until they are even, and the shield setting returns to even.
   xvt_shields: true
+  # Recharge as in X-Wing vs TIE Fighter: the Y-Wing's shields recharge twice as fast,
+  # and TIE fighters and bombers recharge their lasers half again as fast. Base rates match.
+  xvt_recharge: true
   # Player turn rate as in X-Wing vs TIE Fighter: tightest at 1/3 throttle (stock
   # X-Wing rate), 2/3 of that at full throttle and 1/3 when stopped.
   xvt_turning: true
diff --git a/src/xw/flight/object/laser.c b/src/xw/flight/object/laser.c
index 0deb268..178ef1d 100644
--- a/src/xw/flight/object/laser.c
