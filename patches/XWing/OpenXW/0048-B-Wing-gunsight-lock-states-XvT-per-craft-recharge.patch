+#ifdef XW_MODERN
+			/* game.xvt_recharge: XvT doubles the Y-Wing's shield recharge and gives TIE fighters and bombers 3
+			 * laser charge per power step instead of 2 (OpenXvT laser_weaponsfire). */
+			int shieldRechargeStep = LASER_SHIELD_RECHARGE_STEP, laserRechargeStep = LASER_CHARGE_RECHARGE_STEP;
+			if (XwFlightTweaks_XvtRecharge()) {
+				int canonicalType = XwFlightTypes_CanonicalType(powerObject->objectType);
+				if (canonicalType == XW_OBJ_Y_WING)
+					shieldRechargeStep *= 2;
+				if (canonicalType == XW_OBJ_TIE_FIGHTER || canonicalType == XW_OBJ_TIE_BOMBER)
+					laserRechargeStep = 3;
+			}
+#else
+			enum { shieldRechargeStep = LASER_SHIELD_RECHARGE_STEP, laserRechargeStep = LASER_CHARGE_RECHARGE_STEP };
+#endif
