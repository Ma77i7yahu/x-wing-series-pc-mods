+++ b/src/xw_remaster/xvt_cockpit.c
@@ -30,10 +30,7 @@ enum {
 	HUD_BASE = 144, /* XvT's cockpit-off HUD element set. */
 	VIEW_NONE = 18,
 	VIEW_HUD = 19,
-	/* Messages leave the 1998 bottom strip as XvT's do (both centred): ship status just above the cockpit,
-	 * mission traffic at the top between the radars. */
-	MESSAGE_STATUS_Y = 208,
-	MESSAGE_TRAFFIC_Y = 4,
+	MESSAGE_Y = 208, /* Messages move from the 1998 bottom strip to just above the cockpit, centred, as XvT's. */
 	MESSAGE_STRIP_Y = 457,
 	ART_CACHE = 24
 };
@@ -591,7 +588,7 @@ bool XwXvtCockpit_Pane(const XwHudDraw* d, unsigned pane, int x, int y, int* dx,
 	ComputeOffsets(def);
 	switch (pane) {
 		case XW_SNAP_PANE_READY_MESSAGE:
-			*dy = (d->snapshot->cockpit.message_top ? MESSAGE_TRAFFIC_Y : MESSAGE_STATUS_Y) - MESSAGE_STRIP_Y;
+			*dy = MESSAGE_Y - MESSAGE_STRIP_Y;
 			*plain = true;
 			return true;
 		/* The CMD shows speed and throttle as XvT's does. */
