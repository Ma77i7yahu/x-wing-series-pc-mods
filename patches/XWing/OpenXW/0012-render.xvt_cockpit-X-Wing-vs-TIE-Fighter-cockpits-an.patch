+#ifndef XW_REMASTER_XVT_COCKPIT_H
+#define XW_REMASTER_XVT_COCKPIT_H
+#include "xw_remaster/hud_draw.h"
+
+/* render.xvt_cockpit: X-Wing vs TIE Fighter's cockpit art (Balance of Power CP640, copied into RESOURCE
+ * xvt_cockpit at packaging time) replaces the 1998 cockpit. X-Wing's own instruments keep drawing, moved
+ * to where XvT's cockpit has them; the XvT-style CMD fills XvT's CMD screen. */
+
+/* True when this frame's cockpit view is drawn with XvT art. */
+bool XwXvtCockpit_Active(const XwRenderSnapshot* snapshot);
+/* The XvT cockpit for the current view, in place of XwHudDraw_Base. */
+bool XwXvtCockpit_DrawBase(const XwHudDraw* draw);
+/* Where X-Wing element `index` draws: classic-pixel offset from its X-Wing position. False hides it. */
+bool XwXvtCockpit_Element(const XwHudDraw* draw, unsigned index, int* dx, int* dy);
+/* Instrument sprites larger than this many pixels are X-Wing's damage overlays, which do not fit XvT art. */
+enum { XW_XVT_COCKPIT_OVERLAY_PIXELS = 3000 };
+/* Pane placement as for elements, for a pane whose contents start at classic (x, y) (INT32_MAX when empty).
+ * `plain` drops the pane's fills and text backgrounds. */
+bool XwXvtCockpit_Pane(const XwHudDraw* draw, unsigned pane, int x, int y, int* dx, int* dy, bool* plain);
+/* XvT's CMD screen in classic pixels. False when the X-Wing CMD position applies. */
+bool XwXvtCockpit_CmdRect(const XwRenderSnapshot* snapshot, XwSnapRect* rect);
+/* Text of a captured HUD pane in reading order ("" when absent). */
+void XwXvtCockpit_PaneText(const XwRenderSnapshot* snapshot, unsigned pane, char* out, size_t capacity);
+void XwXvtCockpit_Shutdown(void);
+#endif
