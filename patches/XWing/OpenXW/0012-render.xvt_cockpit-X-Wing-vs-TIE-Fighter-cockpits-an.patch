+/* render.xvt_cockpit: X-Wing vs TIE Fighter cockpits for 1998 flight.
+ *
+ * The 1998 cockpits were cut down from XvT's (the message strip takes the bottom of the screen) and some were
+ * rearranged. X-Wing's instruments keep their own state and sprites and move to where XvT's cockpit has the
+ * same instrument; anything else moves with its nearest instrument. The cockpit-off HUD (view 19) takes XvT's
+ * HUD art, with the shields, power bars, warheads and clock moved to where XvT's HUD has them.
+ *
+ * Art and layouts are the Balance of Power CP640 files (<craft>.int, the view LFDs), copied into RESOURCE
+ * xvt_cockpit by the packaging script. The .int holds 28 view descriptors (36 bytes), 288 element records
+ * (12 bytes: forward cockpit 0-143, cockpit-off HUD 144-287) and the panel sprite file name. */
+#include "xw_remaster/xvt_cockpit.h"
+#include "xw_runtime/config/flight_tweaks.h"
+#include <aeron/aeron.h>
+#include <aeron/asset/lfd.h>
+#include <aeron/asset/pnl.h>
+#include <aeron/log.h>
+#include <aeron/vfs.h>
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+	DESCRIPTORS = 28,
+	DESCRIPTOR_BYTES = 36,
+	ELEMENTS = 288,
+	ELEMENT_BYTES = 12,
+	HUD_BASE = 144, /* XvT's cockpit-off HUD element set. */
+	VIEW_NONE = 18,
+	VIEW_HUD = 19,
+	MESSAGE_Y = 100,    /* Messages move from the 1998 bottom strip to just under the radars. */
+	MESSAGE_STRIP_Y = 456,
+	ART_CACHE = 24
+};
+
+/* X-Wing (and XvT) element and pane indices used here. */
+enum {
+	EL_SHIELD_FIRST = 15,
+	EL_SHIELD_LAST = 20, /* Front, front overcharge, rear, rear overcharge, distribution, hull. */
+	EL_HULL = 20,
+	EL_THROTTLE = 22,
+	EL_ENGINE_POWER = 28,
+	EL_SHIELD_POWER = 30,
+	EL_WARHEAD_COUNT = 13,
+	EL_CLOCK = 32,
+	EL_MAX_SPEED = 27,
+	XVT_HULL = 39,
+	XVT_ENGINE_POWER = 42,
+	XVT_CLOCK = 121 /* XvT's speed readout; in the cockpit-off HUD set, its lower right box. */
+};
+
+typedef struct Descriptor {
+	uint8_t enabled;
+	char lfd[10];
+	XwSnapRect viewport;
+	int16_t projection_offset_y;
+} Descriptor;
+
+typedef struct Element {
+	int16_t x, y, selector, color;
+} Element;
+
+typedef struct Craft {
+	char name[8]; /* "xwing", "ywing", "awing", "bwing". */
+	bool loaded;
+	Descriptor views[DESCRIPTORS];
+	Element elements[ELEMENTS];
+} Craft;
+
+typedef struct Art {
+	char name[10];
+	uint32_t palette_hash;
+	AeronTexture* texture;
+	uint64_t used;
+} Art;
+
+static Craft g_craft;
+static char g_failed[8];
+static Art g_art[ART_CACHE];
+static uint64_t g_use;
+
+static uint16_t U16(const uint8_t* p) { return (uint16_t)(p[0] | p[1] << 8); }
+
+/* The X-Wing cockpit base names its craft: XWING12.LFD and so on. */
+static bool CraftName(const XwRenderSnapshot* s, char out[8]) {
+	const XwCockpitDefinition* d = XwCockpitAssets_Definition(s->cockpit.definition);
+	const XwRenderSource* source = d ? XwRenderAssets_Source(d->views[0].image) : NULL;
+	if (!source)
+		return false;
+	const char* base = source->path;
+	for (const char* p = source->path; *p; ++p)
+		if (*p == '/' || *p == '\\')
+			base = p + 1;
+	static const char* const known[] = { "XWING", "YWING", "AWING", "BWING" };
+	for (unsigned i = 0; i < 4; ++i)
+		if (!strncasecmp(base, known[i], 5)) {
+			for (unsigned c = 0; c < 5; ++c)
+				out[c] = (char)tolower((unsigned char)known[i][c]);
+			out[5] = 0;
+			return true;
+		}
+	return false;
+}
+
+static bool LoadCraft(const char* name) {
+	if (g_craft.loaded && !strcmp(g_craft.name, name))
+		return true;
+	if (!strcmp(g_failed, name))
+		return false;
+	memset(&g_craft, 0, sizeof g_craft);
+	char path[64];
+	snprintf(path, sizeof path, "xvt_cockpit/%s.int", name);
+	uint8_t* bytes = NULL;
+	size_t size = 0;
+	if (!AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, path, 1 << 16, &bytes, &size) ||
+		size < DESCRIPTORS * DESCRIPTOR_BYTES + ELEMENTS * ELEMENT_BYTES) {
+		free(bytes);
+		Aeron_LogWarn("xw.hud", "XvT cockpit layout %s is missing; the 1998 cockpit stays", path);
+		snprintf(g_failed, sizeof g_failed, "%s", name);
+		return false;
+	}
+	for (unsigned i = 0; i < DESCRIPTORS; ++i) {
+		const uint8_t* p = bytes + i * DESCRIPTOR_BYTES;
+		Descriptor* d = &g_craft.views[i];
+		d->enabled = p[0];
+		memcpy(d->lfd, p + 1, 9);
+		d->lfd[9] = 0;
+		d->viewport = (XwSnapRect) { U16(p + 10), U16(p + 12), U16(p + 14), U16(p + 16) };
+		d->projection_offset_y = (int16_t)U16(p + 18);
+	}
+	for (unsigned i = 0; i < ELEMENTS; ++i) {
+		const uint8_t* p = bytes + DESCRIPTORS * DESCRIPTOR_BYTES + i * ELEMENT_BYTES;
+		g_craft.elements[i] = (Element) { (int16_t)U16(p), (int16_t)U16(p + 2), (int16_t)U16(p + 4),
+										  (int16_t)U16(p + 6) };
+	}
+	free(bytes);
+	snprintf(g_craft.name, sizeof g_craft.name, "%s", name);
+	g_craft.loaded = true;
+	return true;
+}
+
+/* XvT's view aliases: 0x80+n shares view n's art, 0xC0+n mirrors it. */
+static bool Resolve(unsigned view, unsigned* resource, bool* mirrored) {
+	if (view >= DESCRIPTORS || view == VIEW_NONE)
+		return false;
+	unsigned enabled = g_craft.views[view].enabled;
+	*mirrored = enabled >= 0xC0;
+	*resource = enabled >= 0xC0 ? enabled - 0xC0 : enabled >= 0x80 ? enabled - 0x80 : view;
+	return enabled && *resource < DESCRIPTORS && g_craft.views[*resource].lfd[0];
+}
+
+bool XwXvtCockpit_Active(const XwRenderSnapshot* s) {
+	char name[8];
+	unsigned resource;
+	bool mirrored;
+	return XwFlightTweaks_XvtCockpit() && XwFlightTweaks_XvtTargetingComputer() && s->flight_version == 98 &&
+		   s->hud_valid && !s->camera.replay_mode && !s->cockpit.suppressed && CraftName(s, name) &&
+		   LoadCraft(name) && Resolve(s->cockpit.view, &resource, &mirrored);
+}
+
+/* FlightSw_CopyViewportSpanMaskRle runs at 640 wide: positive parity is the world opening. */
+static int MaskRun(const uint8_t** cursor, const uint8_t* end) {
+	if (*cursor == end)
+		return -1;
+	unsigned value = *(*cursor)++;
+	if (value)
+		return (int)value;
+	if (*cursor == end)
+		return -1;
+	unsigned extension = *(*cursor)++;
+	if (extension == 255)
+		return 511;
+	if (extension)
+		return 256 + (int)extension;
+	if (*cursor == end)
+		return -1;
+	return 511 + (uint8_t)(*(*cursor)++ + 1);
+}
+
+static void ApplyMask(AeronIndexedFrame* frame, const AeronLfdEntry* mask, XwSnapRect rect) {
+	if (rect.x < 0 || rect.y < 0 || rect.x + rect.width > frame->width || rect.y + rect.height > frame->height)
+		return;
+	const uint8_t *p = mask->data, *end = p + mask->size;
+	for (int y = 0; y < rect.height && p != end; ++y) {
+		int8_t state = (int8_t)*p++;
+		for (int x = 0; x < rect.width;) {
+			int run = MaskRun(&p, end);
+			if (run <= 0)
+				return;
+			int visible = run < rect.width - x ? run : rect.width - x;
+			if (state >= 0)
+				memset(frame->coverage + (size_t)(rect.y + y) * frame->width + rect.x + x, 0, (size_t)visible);
+			x += visible;
+			state = (int8_t)-state;
+		}
+	}
+}
+
+static uint32_t Hash(const uint32_t colors[256]) {
+	uint32_t h = 2166136261u;
+	for (unsigned i = 0; i < 256; ++i)
+		h = (h ^ colors[i]) * 16777619u;
+	return h;
+}
+
+/* Cockpit colors 0-63 come from the view's PLTT; the rest are the flight palette, as in XvT. */
+static AeronTexture* Texture(const char* lfd_name, XwSnapRect aperture, const uint32_t flight[256]) {
+	uint32_t colors[256];
+	memcpy(colors, flight, sizeof colors);
+	char path[64];
+	snprintf(path, sizeof path, "xvt_cockpit/%s.lfd", lfd_name);
+	for (char* c = path; *c; ++c)
+		*c = (char)tolower((unsigned char)*c);
+	uint8_t* bytes = NULL;
+	size_t size = 0;
+	AeronLfd lfd = { 0 };
+	if (!AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, path, 1 << 22, &bytes, &size) ||
+		!AeronLfd_Parse(bytes, size, &lfd, NULL)) {
+		free(bytes);
+		return NULL;
+	}
+	const AeronLfdEntry* panl = AeronLfd_Find(&lfd, AERON_LFD_FOURCC('P', 'A', 'N', 'L'));
+	const AeronLfdEntry* pltt = AeronLfd_Find(&lfd, AERON_LFD_FOURCC('P', 'L', 'T', 'T'));
+	const AeronLfdEntry* mask = AeronLfd_Find(&lfd, AERON_LFD_FOURCC('M', 'A', 'S', 'K'));
+	if (pltt && pltt->size >= 2)
+		for (unsigned i = pltt->data[0]; i <= pltt->data[1] && i < 256 && 2 + (i - pltt->data[0]) * 3 + 2 < pltt->size;
+			 ++i) {
+			const uint8_t* rgb = pltt->data + 2 + (i - pltt->data[0]) * 3;
+			uint32_t argb = 0xff000000u;
+			for (unsigned c = 0; c < 3; ++c) {
+				unsigned v = rgb[c] >> 2; /* Six-bit VGA DAC values. */
+				argb |= (uint32_t)((v << 2) | (v >> 4)) << (16 - 8 * c);
+			}
+			colors[i] = argb;
+		}
+	AeronIndexedFrame frame = { 0 };
+	AeronTexture* texture = NULL;
+	if (panl && AeronPnl_DecodeIndexed(panl->data, panl->size, 0, -1, &frame, NULL)) {
+		if (mask)
+			ApplyMask(&frame, mask, aperture);
+		size_t pixels = (size_t)frame.width * frame.height;
+		uint8_t* rgba = malloc(pixels * 4);
+		if (rgba) {
+			for (size_t i = 0; i < pixels; ++i) {
+				uint32_t argb = colors[frame.indices[i]];
+				bool covered = frame.coverage[i] != 0;
+				rgba[i * 4 + 0] = covered ? (uint8_t)(argb >> 16) : 0;
+				rgba[i * 4 + 1] = covered ? (uint8_t)(argb >> 8) : 0;
+				rgba[i * 4 + 2] = covered ? (uint8_t)argb : 0;
+				rgba[i * 4 + 3] = covered ? 255 : 0;
+			}
+			AeronCommandBuffer* cmd = Aeron_AcquireCommandBuffer();
+			texture = cmd ? Aeron_CreateTexture(&(AeronTextureDesc) {
+								.width = frame.width,
+								.height = frame.height,
+								.format = AERON_TEXTURE_FORMAT_RGBA8_SRGB,
+								.usage = AERON_TEXTURE_USAGE_SAMPLED | AERON_TEXTURE_USAGE_TRANSFER_DST,
+								.debug_name = "xw.xvt_cockpit" })
+						  : NULL;
+			if (!texture || !Aeron_UploadTextureDataCmd(cmd, &(AeronTextureUploadDesc) {
+															 .texture = texture,
+															 .width = frame.width,
+															 .height = frame.height,
+															 .raw_data = rgba,
+															 .raw_size = pixels * 4 }) ||
+				!Aeron_SubmitCommandBuffer(cmd)) {
+				if (cmd)
+					Aeron_CancelCommandBuffer(cmd);
+				Aeron_DestroyTexture(texture);
+				texture = NULL;
+			}
+			free(rgba);
+		}
+	}
+	AeronIndexedFrame_Free(&frame);
+	AeronLfd_Free(&lfd);
+	free(bytes);
+	if (!texture)
+		Aeron_LogWarn("xw.hud", "Unable to prepare XvT cockpit art %s", path);
+	return texture;
+}
+
+static AeronTexture* CachedArt(const char* lfd_name, XwSnapRect aperture, const uint32_t flight[256]) {
+	uint32_t hash = Hash(flight);
+	Art* slot = &g_art[0];
+	for (unsigned i = 0; i < ART_CACHE; ++i) {
+		if (g_art[i].texture && !strcmp(g_art[i].name, lfd_name) && g_art[i].palette_hash == hash) {
+			g_art[i].used = ++g_use;
+			return g_art[i].texture;
+		}
+		if (!g_art[i].texture || g_art[i].used < slot->used)
+			slot = &g_art[i];
+	}
+	Aeron_DestroyTexture(slot->texture);
+	memset(slot, 0, sizeof *slot);
+	slot->texture = Texture(lfd_name, aperture, flight);
+	if (slot->texture) {
+		snprintf(slot->name, sizeof slot->name, "%s", lfd_name);
+		slot->palette_hash = hash;
+		slot->used = ++g_use;
+	}
+	return slot->texture;
+}
+
+static void Blit(const XwHudDraw* d, AeronTexture* texture, float x0, float x1, float shift, bool mirrored) {
+	float u0 = x0 / 640.0f, u1 = x1 / 640.0f;
+	if (mirrored) {
+		u0 = 1 - u0;
+		u1 = 1 - u1;
+	}
+	AeronDrawList2DSprite sprite = { .texture = texture,
+									 .src_u0 = u0,
+									 .src_v0 = 0,
+									 .src_u1 = u1,
+									 .src_v1 = 1,
+									 .dst_x = d->offset_x + shift + x0 * d->layout.scale_x,
+									 .dst_y = d->offset_y,
+									 .dst_w = (x1 - x0) * d->layout.scale_x,
+									 .dst_h = 480 * d->layout.scale_y,
+									 .tint = { 1, 1, 1, 1 },
+									 .blend = AERON_BLIT2D_BLEND_PMA,
+									 .filter = AERON_BLIT2D_FILTER_NEAREST };
+	AeronDrawList_AddSprite(d->list, &sprite);
+}
+
+bool XwXvtCockpit_DrawBase(const XwHudDraw* d) {
+	const XwRenderSnapshot* s = d->snapshot;
+	unsigned resource;
+	bool mirrored;
+	if (!Resolve(s->cockpit.view, &resource, &mirrored))
+		return true;
+	const Descriptor* v = &g_craft.views[resource];
+	AeronTexture* texture = CachedArt(v->lfd, v->viewport, s->cockpit.palette_argb);
+	if (!texture)
+		return true;
+	/* Widescreen cockpit-off HUD: the sides move out with the instruments over them; the CMD block
+	 * (x 188-451) stays whole in the middle. */
+	if (d->edge_shift > 0 && s->cockpit.view == VIEW_HUD) {
+		Blit(d, texture, 0, 182, -d->edge_shift, mirrored);
+		Blit(d, texture, 182, 456, 0, mirrored);
+		Blit(d, texture, 456, 640, d->edge_shift, mirrored);
+	} else
+		Blit(d, texture, 0, 640, 0, mirrored);
+	return true;
+}
+
+/* X-Wing forward elements and their XvT counterparts, by role. Each group pairs in left-to-right order
+ * (then top to bottom), since the two games number a craft's cannons and launchers differently. */
+enum { GROUP_SIZE = 8 };
+
+typedef struct Group {
+	char craft; /* 'b': B-Wing only, '-': all but the B-Wing, 0: every craft. */
+	uint8_t count, xw[GROUP_SIZE], xvt[GROUP_SIZE];
+} Group;
+
+/* XvT gives each cannon role eight slots. The B-Wing's six cannons use X-Wing's slots 3-8 for charge bars,
+ * 58-63 for ready lights and 66-71 for the gunsight marks. */
+static const Group kGroups[] = {
+	{ '-', 4, { 3, 4, 5, 6 }, { 3, 4, 5, 6 } },                       /* Laser charge bars. */
+	{ '-', 4, { 7, 8, 9, 10 }, { 11, 12, 13, 14 } },                  /* Laser ready lights. */
+	{ 'b', 6, { 3, 4, 5, 6, 7, 8 }, { 3, 4, 5, 6, 7, 8 } },
+	{ 'b', 6, { 58, 59, 60, 61, 62, 63 }, { 11, 12, 13, 14, 15, 16 } },
+	{ 'b', 6, { 66, 67, 68, 69, 70, 71 }, { 53, 54, 55, 56, 57, 58 } },
+	{ 0, 2, { 11, 12 }, { 19, 20 } },                                 /* Linked fire lights. */
+	{ 0, 2, { 13, 14 }, { 27, 28 } },                                 /* Warhead counts. */
+	{ 0, 1, { 15 }, { 35 } },                                         /* Front shield. */
+	{ 0, 1, { 16 }, { 36 } },                                         /* Front overcharge. */
+	{ 0, 1, { 17 }, { 37 } },                                         /* Rear shield. */
+	{ 0, 1, { 18 }, { 38 } },                                         /* Rear overcharge. */
+	{ 0, 1, { 19 }, { 51 } },                                         /* Shield distribution. */
+	{ 0, 1, { 20 }, { 39 } },                                         /* Hull. */
+	{ 0, 1, { 28 }, { 42 } },                                         /* Engine power. */
+	{ 0, 1, { 29 }, { 43 } },                                         /* Laser power. */
+	{ 0, 1, { 30 }, { 44 } },                                         /* Shield power. */
+	{ 0, 1, { 31 }, { 45 } },                                         /* S-foils. */
+	{ 0, 1, { 33 }, { 47 } },                                         /* Panel indicator lights. */
+	{ 0, 1, { 34 }, { 48 } },
+	{ 0, 1, { 35 }, { 49 } },                                         /* View label. */
+	{ 0, 1, { 36 }, { 50 } },                                         /* Critical warning. */
+	{ 0, 1, { 37 }, { 52 } },                                         /* Gunsight. */
+	{ '-', 4, { 38, 39, 40, 41 }, { 53, 54, 55, 56 } },               /* Gunsight laser marks. */
+	{ 0, 4, { 42, 43, 44, 45 }, { 61, 62, 63, 64 } },                 /* Gunsight range marks. */
+};
+
+typedef struct Offset {
+	int16_t dx, dy;
+	uint8_t state; /* 0 unmapped, 1 mapped, 2 no place in XvT's cockpit. */
+} Offset;
+
+static Offset g_offsets[XW_SNAP_WIDGETS];
+static const XwCockpitDefinition* g_offsets_for;
+static char g_offsets_craft[8];
+
+static bool Placed(const Element* e) { return e->x || e->y; }
+
+static int Before(int ax, int ay, int bx, int by) { return ax != bx ? ax < bx : ay < by; }
+
+/* Indices of `count` points sorted left to right, then top to bottom. */
+static void Order(int (*points)[2], unsigned count, unsigned order[GROUP_SIZE]) {
+	for (unsigned i = 0; i < count; ++i)
+		order[i] = i;
+	for (unsigned i = 1; i < count; ++i)
+		for (unsigned j = i; j > 0 && Before(points[order[j]][0], points[order[j]][1], points[order[j - 1]][0],
+											 points[order[j - 1]][1]);
+			 --j) {
+			unsigned t = order[j];
+			order[j] = order[j - 1];
+			order[j - 1] = t;
+		}
+}
+
+static void ComputeOffsets(const XwCockpitDefinition* d) {
+	if (g_offsets_for == d && !strcmp(g_offsets_craft, g_craft.name))
+		return;
+	memset(g_offsets, 0, sizeof g_offsets);
+	bool bwing = g_craft.name[0] == 'b';
+	for (unsigned g = 0; g < sizeof kGroups / sizeof kGroups[0]; ++g) {
+		const Group* group = &kGroups[g];
+		if ((group->craft == 'b' && !bwing) || (group->craft == '-' && bwing))
+			continue;
+		int xw[GROUP_SIZE][2], xvt[GROUP_SIZE][2];
+		unsigned xw_index[GROUP_SIZE], xvt_index[GROUP_SIZE], n_xw = 0, n_xvt = 0;
+		for (unsigned i = 0; i < group->count; ++i) {
+			const XwCockpitElement* e = &d->elements[group->xw[i]];
+			if (e->x || e->y) {
+				xw_index[n_xw] = group->xw[i];
+				xw[n_xw][0] = e->x;
+				xw[n_xw++][1] = e->y;
+			}
+			const Element* v = &g_craft.elements[group->xvt[i]];
+			if (Placed(v)) {
+				xvt_index[n_xvt] = group->xvt[i];
+				xvt[n_xvt][0] = v->x;
+				xvt[n_xvt++][1] = v->y;
+			}
+		}
+		unsigned a[GROUP_SIZE], b[GROUP_SIZE];
+		Order(xw, n_xw, a);
+		Order(xvt, n_xvt, b);
+		for (unsigned i = 0; i < n_xw; ++i) {
+			Offset* o = &g_offsets[xw_index[a[i]]];
+			if (i < n_xvt) {
+				const Element* v = &g_craft.elements[xvt_index[b[i]]];
+				*o = (Offset) { (int16_t)(v->x - xw[a[i]][0]), (int16_t)(v->y - xw[a[i]][1]), 1 };
+			} else
+				o->state = 2;
+		}
+	}
+	g_offsets_for = d;
+	snprintf(g_offsets_craft, sizeof g_offsets_craft, "%s", g_craft.name);
+}
+
+/* Unmapped elements and panes move with the nearest mapped element. */
+static void Nearest(const XwCockpitDefinition* d, int x, int y, int* dx, int* dy) {
+	long best = -1;
+	for (unsigned i = 0; i < XW_SNAP_WIDGETS; ++i) {
+		if (g_offsets[i].state != 1)
+			continue;
+		long ex = d->elements[i].x - x, ey = d->elements[i].y - y, distance = ex * ex + ey * ey;
+		if (best < 0 || distance < best) {
+			best = distance;
+			*dx = g_offsets[i].dx;
+			*dy = g_offsets[i].dy;
+		}
+	}
+}
+
+/* Cockpit off: from X-Wing element `xw` (forward position) to XvT HUD element `hud`, which shows what
+ * XvT forward element `forward` does. */
+static void HudOffset(const XwCockpitDefinition* d, unsigned xw, unsigned forward, unsigned hud, int* dx,
+					  int* dy) {
+	const Element *f = &g_craft.elements[forward], *h = &g_craft.elements[HUD_BASE + hud];
+	int fx = d->elements[xw].x + g_offsets[xw].dx, fy = d->elements[xw].y + g_offsets[xw].dy;
+	*dx = h->x - f->x + fx - d->elements[xw].x;
+	*dy = h->y - f->y + fy - d->elements[xw].y;
+}
+
+bool XwXvtCockpit_Element(const XwHudDraw* d, unsigned index, int* dx, int* dy) {
+	*dx = *dy = 0;
+	if (index >= XW_SNAP_WIDGETS)
+		return false;
+	ComputeOffsets(d->definition);
+	const XwCockpitElement* e = &d->definition->elements[index];
+	const Offset* o = &g_offsets[index];
+	unsigned view = d->snapshot->cockpit.view;
+	if (view == 0) {
+		/* XvT shows throttle as text in the CMD. */
+		if (index == EL_THROTTLE || o->state == 2)
+			return false;
+		if (o->state == 1) {
+			*dx = o->dx;
+			*dy = o->dy;
+		} else
+			Nearest(d->definition, e->x, e->y, dx, dy);
+		return true;
+	}
+	if (view != VIEW_HUD)
+		return true;
+	/* Cockpit off: the gunsight stays; shields wrap XvT's HUD hull icon; power bars go to the edges. */
+	if (index >= 37 && index <= 45)
+		return true;
+	if (index >= EL_SHIELD_FIRST && index <= EL_SHIELD_LAST && g_offsets[EL_HULL].state == 1) {
+		/* Arcs keep their place around the hull icon. */
+		HudOffset(d->definition, EL_HULL, XVT_HULL, XVT_HULL, dx, dy);
+		*dx += o->state == 1 ? o->dx - g_offsets[EL_HULL].dx : 0;
+		*dy += o->state == 1 ? o->dy - g_offsets[EL_HULL].dy : 0;
+		return true;
+	}
+	if (index >= EL_ENGINE_POWER && index <= EL_SHIELD_POWER && o->state == 1) {
+		unsigned gauge = index - EL_ENGINE_POWER;
+		HudOffset(d->definition, index, XVT_ENGINE_POWER + gauge, XVT_ENGINE_POWER + gauge, dx, dy);
+		return true;
+	}
+	return false;
+}
+
+bool XwXvtCockpit_Pane(const XwHudDraw* d, unsigned pane, int x, int y, int* dx, int* dy, bool* plain) {
+	*dx = *dy = 0;
+	*plain = false;
+	const XwCockpitDefinition* def = d->definition;
+	unsigned view = d->snapshot->cockpit.view;
+	ComputeOffsets(def);
+	switch (pane) {
+		case XW_SNAP_PANE_READY_MESSAGE:
+			*dy = MESSAGE_Y - MESSAGE_STRIP_Y;
+			*plain = true;
+			return true;
+		/* The CMD shows speed and throttle as XvT's does. */
+		case XW_SNAP_PANE_SPEED:
+		case XW_SNAP_PANE_THROTTLE:
+			return false;
+		case XW_SNAP_PANE_VIEW_LABEL:
+		case XW_SNAP_PANE_COURSE:
+		case XW_SNAP_PANE_FRAME_RATE:
+		case XW_SNAP_PANE_REPLAY_TITLE:
+		case XW_SNAP_PANE_REPLAY_STATUS:
+		case XW_SNAP_PANE_REPLAY_BUTTONS:
+			return true;
+		default:
+			break;
+	}
+	if (view == VIEW_HUD) {
+		/* XvT HUD's lower right boxes: warheads, then the clock. Max speed and the film counter have no place. */
+		const Element* box;
+		unsigned anchor;
+		if (pane == XW_SNAP_PANE_WARHEADS) {
+			box = &g_craft.elements[HUD_BASE + 120];
+			anchor = EL_WARHEAD_COUNT;
+		} else if (pane == XW_SNAP_PANE_CLOCK) {
+			box = &g_craft.elements[HUD_BASE + XVT_CLOCK];
+			anchor = EL_CLOCK;
+		} else
+			return false;
+		int left = def->elements[anchor].x;
+		if (pane == XW_SNAP_PANE_WARHEADS && def->elements[EL_WARHEAD_COUNT + 1].x < left)
+			left = def->elements[EL_WARHEAD_COUNT + 1].x;
+		*dx = box->x + 4 - left;
+		*dy = box->y + 3 - def->elements[anchor].y;
+		return true;
+	}
+	if (view != 0 || x == INT32_MAX)
+		return true;
+	/* XvT's speed (121) and throttle (120) readout boxes take the clock and max speed; the CMD shows speed
+	 * and throttle. The offsets put the text inside the boxes as on the X-Wing's panel. */
+	if (pane == XW_SNAP_PANE_CLOCK || pane == XW_SNAP_PANE_MAX_SPEED) {
+		bool clock = pane == XW_SNAP_PANE_CLOCK;
+		const Element* box = &g_craft.elements[clock ? XVT_CLOCK : XVT_CLOCK - 1];
+		/* The B-Wing's boxes are placed but unused by XvT (selector 0). */
+		if (!Placed(box))
+			return false;
+		const XwCockpitElement* e = &def->elements[clock ? EL_CLOCK : EL_MAX_SPEED];
+		*dx = box->x + (clock ? 0 : 22) - e->x;
+		*dy = box->y - (clock ? 14 : 9) - e->y;
+		return true;
+	}
+	if (pane == XW_SNAP_PANE_WARHEADS && g_offsets[EL_WARHEAD_COUNT].state == 1) {
+		*dx = g_offsets[EL_WARHEAD_COUNT].dx;
+		*dy = g_offsets[EL_WARHEAD_COUNT].dy;
+		/* Two counts can map to different XvT spacing; the left one anchors the pane. */
+		if (g_offsets[EL_WARHEAD_COUNT + 1].state == 1 &&
+			def->elements[EL_WARHEAD_COUNT + 1].x < def->elements[EL_WARHEAD_COUNT].x) {
+			*dx = g_offsets[EL_WARHEAD_COUNT + 1].dx;
+			*dy = g_offsets[EL_WARHEAD_COUNT + 1].dy;
+		}
+		return true;
+	}
+	Nearest(def, x, y, dx, dy);
+	return true;
+}
+
+bool XwXvtCockpit_CmdRect(const XwRenderSnapshot* s, XwSnapRect* rect) {
+	if (!XwXvtCockpit_Active(s))
+		return false;
+	if (s->cockpit.view == 0) {
+		/* Element 2 is the CMD's 3D view; the screen around it has a title row above and a status row below. */
+		const Element* crt = &g_craft.elements[2];
+		int top = crt->y - 30, bottom = crt->y + crt->color + 20;
+		*rect = (XwSnapRect) { crt->x, top, crt->selector + 2, (bottom < 480 ? bottom : 478) - top };
+	} else if (s->cockpit.view == VIEW_HUD)
+		*rect = (XwSnapRect) { 232, 358, 176, 120 };
+	else
+		return false;
+	return true;
+}
+
+void XwXvtCockpit_PaneText(const XwRenderSnapshot* s, unsigned pane, char* out, size_t capacity) {
+	size_t n = 0;
+	if (capacity)
+		out[0] = 0;
+	if (pane >= XW_SNAP_HUD_PANES || !capacity)
+		return;
+	const XwSnapCockpit* c = &s->cockpit;
+	XwSnapRange r = c->panes[pane].glyphs;
+	/* Glyph records may repeat a cell when a digit is redrawn; keep the latest by x. */
+	int last_x = -32768;
+	for (unsigned i = 0; i < r.count && r.first + i < c->glyph_count && n + 1 < capacity; ++i) {
+		const XwSnapGlyph* g = &c->glyphs[r.first + i];
+		if (g->x <= last_x)
+			continue;
+		last_x = g->x;
+		if (g->character > ' ' && g->character < 127)
+			out[n++] = (char)g->character;
+	}
+	out[n] = 0;
+}
+
+void XwXvtCockpit_Shutdown(void) {
+	for (unsigned i = 0; i < ART_CACHE; ++i)
+		Aeron_DestroyTexture(g_art[i].texture);
+	memset(g_art, 0, sizeof g_art);
+	memset(&g_craft, 0, sizeof g_craft);
+	g_failed[0] = 0;
+}
