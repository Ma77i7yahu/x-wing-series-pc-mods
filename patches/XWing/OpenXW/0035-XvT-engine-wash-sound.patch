+
+int collide_enginewashsound(uint16_t* sourceObjectType) {
+	uint32_t now = collide_missionticks();
+	/* A stale update (collisions not running: hyperspace, mission end) means no wash. */
+	if (s_washStrength <= 0 || s_washSource >= XW_CRAFT_OBJECT_COUNT || now < s_washStateTick ||
+		now - s_washStateTick > 2 * COLLIDE_WASH_UPDATE_TICKS ||
+		g_objectTable[s_washSource].objectType == XW_OBJ_NONE)
+		return 0;
