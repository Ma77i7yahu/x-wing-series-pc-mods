@@ -0,0 +1,20 @@
+#ifndef XW_RUNTIME_AUDIO_ENGINE_WASH_SOUND_H
+#define XW_RUNTIME_AUDIO_ENGINE_WASH_SOUND_H
+
+#include <stdint.h>
+
+/* game.xvt_engine_wash: X-Wing vs TIE Fighter's engine wash loops (OpenXvT fsfx_UpdateFlightSfx), read from
+ * RESOURCE xvt_engine_wash/ (copied from an XvT installation at packaging time). Star destroyers and the
+ * Interdictor rumble with sd-lp-1, everything else with cal-flyb; louder the stronger the wash. The two waves
+ * play under their own iMUSE sound IDs, outside X-Wing's bank slots and paged music. */
+enum { XW_ENGINE_WASH_SOUND_FIRST_ID = 400, XW_ENGINE_WASH_SOUND_COUNT = 2 };
+
+/* Call after the flight sound bank loads; XwEngineWashSound_Free when it is released. */
+void XwEngineWashSound_Load(void);
+void XwEngineWashSound_Free(void);
+/* Dos94_gamesnd_GetSoundAddr: the VOC data for one of the wash sound IDs, or NULL. */
+void* XwEngineWashSound_Data(intptr_t soundId);
+/* Once per frame, beside the player engine loop. */
+void XwEngineWashSound_Update(void);
+
+#endif
