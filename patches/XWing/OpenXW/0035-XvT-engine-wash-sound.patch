-		g_hyperspaceflag != 0 || g_playerFlightState.craft->objectKind != XW_CRAFT_OBJECT_KIND_0)
+		g_hyperspaceflag != 0 || g_playerFlightState.craft->objectKind != XW_CRAFT_OBJECT_KIND_0) {
