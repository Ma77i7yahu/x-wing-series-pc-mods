index 0000000..335a12b
--- /dev/null
+++ b/src/xw_runtime/audio/engine_wash_sound.c
@@ -0,0 +1,87 @@
+#include "xw_runtime/audio/engine_wash_sound.h"
+#include "xw/audio/fsfx.h"
+#include "xw/flight/object/collide.h"
+#include "xw/flight/object/object.h"
+#include "xw/flight/player/user.h"
+#include "xw/frontend/shell_preferences.h"
+#include "xw/util/memory.h"
+#include "xw_runtime/audio/imuse_session.h"
+#include "xw_runtime/audio/weapon_sounds.h"
+#include "xw_runtime/config/flight_tweaks.h"
+#include "xw_runtime/runtime/flight_types.h"
+#include <aeron/log.h>
+
+/* OpenXvT sounds 78 and 79 (SFXBLAST.LST from ID 4). */
+static const char* const g_washFiles[XW_ENGINE_WASH_SOUND_COUNT] = { "xvt_engine_wash/sd-lp-1.wav",
+																	 "xvt_engine_wash/cal-flyb.wav" };
+static uint16_t g_washHandles[XW_ENGINE_WASH_SOUND_COUNT];
+
+void XwEngineWashSound_Free(void) {
+	for (unsigned i = 0; i < XW_ENGINE_WASH_SOUND_COUNT; ++i) {
+		if (g_dos94Imuse) {
+			imuse_stop_sound(g_dos94Imuse, XW_ENGINE_WASH_SOUND_FIRST_ID + i);
+			imuse_forget_sound(g_dos94Imuse, XW_ENGINE_WASH_SOUND_FIRST_ID + i);
+		}
+		if (g_washHandles[i])
+			Memory_FreeHandle(g_washHandles[i]);
+		g_washHandles[i] = 0;
+	}
+}
+
+void XwEngineWashSound_Load(void) {
+	XwEngineWashSound_Free();
+	if (!XwFlightTweaks_XvtEngineWash())
+		return;
+	for (unsigned i = 0; i < XW_ENGINE_WASH_SOUND_COUNT; ++i) {
+		g_washHandles[i] = XwWeaponSounds_LoadWav(g_washFiles[i]);
+		if (!g_washHandles[i])
+			Aeron_LogWarn("xw.audio", "XvT engine wash sound %s is missing or unsupported", g_washFiles[i]);
+	}
+}
+
+void* XwEngineWashSound_Data(intptr_t soundId) {
+	intptr_t index = soundId - XW_ENGINE_WASH_SOUND_FIRST_ID;
+	if (index < 0 || index >= XW_ENGINE_WASH_SOUND_COUNT || !g_washHandles[index])
+		return NULL;
+	return Memory_LockHandle(g_washHandles[index]);
+}
+
+void XwEngineWashSound_Update(void) {
+	imuse_t* im = g_dos94Imuse;
+	if (!im)
+		return;
+	int playing = -1;
+	int volume = 0;
+	uint16_t sourceType = 0;
+	int strength = 0;
+	if (ShellPreferences_GetSfxEnabled() && g_flightSfxEnabled && g_flightSfxVolume &&
+		!g_playerEngineLoopSuppressed)
+		strength = collide_enginewashsound(&sourceType);
+	if (strength > 0) {
+		uint8_t type = XwFlightTypes_CanonicalType(sourceType);
+		playing = type == XW_OBJ_INTERDICTOR || type == XW_OBJ_MODEL_VSD || type == XW_OBJ_IMPERIAL_STAR_DESTROYER
+					  ? 0
+					  : 1;
+		if (!g_washHandles[playing])
+			playing = -1;
+		/* XvT: 4 * exterior volume * strength / 10, capped at 127; full volume from about half strength. */
+		volume = strength * 127 / 32;
+		if (volume > 127)
+			volume = 127;
+		volume = volume * g_flightSfxVolume / 16;
+		if (volume > 127)
+			volume = 127;
+	}
+	for (int i = 0; i < XW_ENGINE_WASH_SOUND_COUNT; ++i)
+		if (i != playing && imuse_get_param(im, XW_ENGINE_WASH_SOUND_FIRST_ID + i, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)
+			imuse_stop_sound(im, XW_ENGINE_WASH_SOUND_FIRST_ID + i);
+	if (playing < 0)
+		return;
+	intptr_t id = XW_ENGINE_WASH_SOUND_FIRST_ID + playing;
+	if (!(imuse_get_param(im, id, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)) {
+		if (imuse_start_wave(im, id, 127, IMUSE_WAVE_START_LOOP))
+			return;
+		imuse_set_param(im, id, IMUSE_PARAM_SOUND_GROUP, IMUSE_GROUP_SFX);
+	}
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_VOL, volume);
+}
