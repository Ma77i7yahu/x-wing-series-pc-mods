+bool XwXvtCockpit_XvtPosition(unsigned index, int* x, int* y) {
+	if (!g_craft.loaded || index >= HUD_BASE || !Placed(&g_craft.elements[index]))
+		return false;
+	*x = g_craft.elements[index].x;
+	*y = g_craft.elements[index].y;
+	return true;
+}
