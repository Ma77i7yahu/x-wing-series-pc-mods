 		XwXvtCockpit_PaneText(s, XW_SNAP_PANE_SPEED, value, sizeof value);
 		snprintf(speed, sizeof speed, "SPD %s", value[0] ? value : "0");
 		const XwSnapWidget* lever = &s->cockpit.widgets[22];
@@ -156,37 +328,8 @@ bool XwHudCmd_Draw(const XwHudDraw* d) {
 		Fill(&pen, box->x, box->y, box->width, box->height, BACKDROP, cockpit_off ? 0.55f : 1.0f);
 	if (!r->target_valid)
