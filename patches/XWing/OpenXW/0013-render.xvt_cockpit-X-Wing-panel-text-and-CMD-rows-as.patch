diff --git a/src/xw_remaster/hud_readout.c b/src/xw_remaster/hud_readout.c
index 6955f19..082c11f 100644
--- a/src/xw_remaster/hud_readout.c
+++ b/src/xw_remaster/hud_readout.c
@@ -110,6 +110,151 @@ static void Stat(char* out, size_t n, const char* label, int pct) {
 		snprintf(out, n, "%s %d%%", label, pct);
 }
 
+/* Target name and the SHD/HULL/SYS row; returns how many stat rows were used. */
+static unsigned DrawTargetHeader(const Pen* pen, const XwSnapReadout* r, const XwSnapRect* box, float top,
+								 float line) {
+	Centered(pen, box, top, r->target_name,
+			 r->target_relation == 0 ? FRIENDLY : r->target_relation == 1 ? HOSTILE : OTHER);
+	char shd[16], hull[16], sys[16], stats[64];
+	Stat(shd, sizeof shd, "SHD", r->target_shield_pct);
+	Stat(hull, sizeof hull, "HULL", r->target_hull_pct);
+	Stat(sys, sizeof sys, "SYS", r->target_system_pct);
+	/* X-Wing's CMD is narrower than XvT's: tighten the spacing, drop the percent signs, shorten HULL, and as a
+	 * last resort put SYS on a line of its own. */
+	float fit = box->width - 2;
+	unsigned stat_lines = 1;
+	snprintf(stats, sizeof stats, "%s  %s  %s", shd, hull, sys);
+	if (Measure(pen, stats) > fit)
+		snprintf(stats, sizeof stats, "%s %s %s", shd, hull, sys);
+	if (Measure(pen, stats) > fit) {
+		char* out = stats;
+		for (const char* in = stats; *in; ++in)
+			if (*in != '%')
+				*out++ = *in;
+		*out = 0;
+	}
+	if (Measure(pen, stats) > fit) {
+		char* h = strstr(stats, "HULL");
+		if (h)
+			memmove(h + 3, h + 4, strlen(h + 4) + 1);
+	}
+	if (Measure(pen, stats) > fit) {
+		snprintf(stats, sizeof stats, "%s %s", shd, hull);
+		Centered(pen, box, top + 2 * line, sys, LABEL);
+		stat_lines = 2;
+	}
+	Centered(pen, box, top + line, stats, LABEL);
+	return stat_lines;
+}
+
+/* The live 3D view of the target between area_top and area_bottom, letterboxed to its aspect. */
+static void TargetModel(const XwHudDraw* d, const Pen* pen, const XwSnapRect* box, float area_top,
+						float area_bottom, bool translucent) {
+	float aspect = 1;
+	AeronTexture* view = XwTargetView_Texture(&aspect);
+	float area_h = area_bottom - area_top, area_w = box->width - 4;
+	if (!view || area_h <= 4 || area_w <= 4)
+		return;
+	float w = area_w * pen->sx, h = area_h * pen->sy;
+	if (w / h > aspect)
+		w = h * aspect;
+	else
+		h = w / aspect;
+	AeronDrawList2DSprite sprite = { .texture = view,
+									 .src_u0 = 0,
+									 .src_v0 = 0,
+									 .src_u1 = 1,
+									 .src_v1 = 1,
+									 .dst_x = d->offset_x + (box->x + box->width / 2.0f) * pen->sx - w / 2,
+									 .dst_y = d->offset_y + (area_top + area_h / 2) * pen->sy - h / 2,
+									 .dst_w = w,
+									 .dst_h = h,
+									 .tint = { 1, 1, 1, translucent ? 0.9f : 1 },
+									 .blend = AERON_BLIT2D_BLEND_PMA,
+									 .filter = AERON_BLIT2D_FILTER_LINEAR };
+	AeronDrawList_AddSprite(d->list, &sprite);
+}
+
+static unsigned FontHeight(const XwHudImage* font) {
+	unsigned height = 0;
+	for (unsigned i = 0; font && i < font->font.glyph_count; ++i)
+		if (font->font.glyphs[i].height > height)
+			height = font->font.glyphs[i].height;
+	return height;
+}
+
+/* At XvT forward element `index`, as XvT's panel text draws it; X-Wing's fonts are taller than XvT's, so
+ * text is kept on screen. Returns the x after the text. */
+static float PanelText(const Pen* pen, unsigned index, const char* text, uint32_t rgb) {
+	int x, y;
+	if (!XwXvtCockpit_XvtPosition(index, &x, &y))
+		return 0;
+	/* The speed readout sits on its caption, which the screen bottom pushes up. */
+	if (index == 40)
+		y -= 4;
+	int bottom = 480 - (int)FontHeight(pen->font);
+	Text(pen, x, y < bottom ? y : bottom, text, rgb, 80);
+	return x + Measure(pen, text);
+}
+
+enum {
+	PANEL_LABEL = 0xC8CCD8, /* E/L/S, THROTTLE, SPEED. */
+	PANEL_SWITCH = 0xE8A030, /* F/R beside the shield switch. */
+	PANEL_CLOCK = 0xF0D040,
+	PANEL_VALUE = 0xFF4A28
+};
+
+bool XwHudXvtPanel_Draw(const XwHudDraw* d) {
+	const XwRenderSnapshot* s = d->snapshot;
+	if (!d->definition || !XwXvtCockpit_PanelText(s))
+		return true;
+	/* XvT draws the readouts in a larger font than the labels. */
+	const XwHudImage* fonts[2] = { NULL, NULL };
+	for (unsigned i = 0; i < 2; ++i)
+		if (d->definition->fonts[i])
+			fonts[i] = XwHudAssets_Image((XwHudImageKey) { .source = d->definition->fonts[i], .kind = XW_HUD_IMAGE_FONT });
+	if (!fonts[0] || !fonts[1])
+		return true;
+	bool first_larger = FontHeight(fonts[0]) >= FontHeight(fonts[1]);
+	const XwHudImage *large = fonts[first_larger ? 0 : 1], *small = fonts[first_larger ? 1 : 0];
+	const AeronRuntimeAtlas *large_atlas = XwHudAssets_Atlas(large), *small_atlas = XwHudAssets_Atlas(small);
+	if (!large_atlas || !small_atlas)
+		return true;
+	Pen labels = { d, small, small_atlas, d->layout.scale_x, d->layout.scale_y, d->offset_x, d->offset_y };
+	Pen values = { d, large, large_atlas, d->layout.scale_x, d->layout.scale_y, d->offset_x, d->offset_y };
+
+	/* XvT elements: 124/122/123 power gauge letters, 128/129 shield switch, 46 clock, 41 throttle, 40 speed,
+	 * 120/121 their captions. */
+	PanelText(&labels, 124, "E", PANEL_LABEL);
+	PanelText(&labels, 122, "L", PANEL_LABEL);
+	PanelText(&labels, 123, "S", PANEL_LABEL);
+	PanelText(&labels, 128, "F", PANEL_SWITCH);
+	PanelText(&labels, 129, "R", PANEL_SWITCH);
+	PanelText(&labels, 120, "THROTTLE", PANEL_LABEL);
+	PanelText(&labels, 121, "SPEED", PANEL_LABEL);
+
+	/* X-Wing's clock pane holds minutes then two second digits. */
+	char digits[16], text[40];
+	XwXvtCockpit_PaneText(s, XW_SNAP_PANE_CLOCK, digits, sizeof digits);
+	size_t n = strlen(digits);
+	if (n >= 3) {
+		snprintf(text, sizeof text, "%.*s:%s", (int)(n - 2), digits, digits + n - 2);
+		PanelText(&values, 46, text[0] == '0' && text[1] != ':' ? text + 1 : text, PANEL_CLOCK);
+	}
+	const XwSnapWidget* lever = &s->cockpit.widgets[22];
+	unsigned columns = d->definition->width == 320 ? 38 : 74;
+	unsigned percent = lever->visible ? (lever->value * 100 + columns / 2) / columns : 0;
+	snprintf(text, sizeof text, "%u", percent < 100 ? percent : 100);
+	/* The large font's percent sign is a plain slash; XvT's is the small one. */
+	float after = PanelText(&values, 41, text, PANEL_VALUE);
+	int x, y;
+	if (after > 0 && XwXvtCockpit_XvtPosition(41, &x, &y))
+		Text(&labels, after, y + (float)FontHeight(large) - FontHeight(small), "%", PANEL_VALUE, 10);
+	XwXvtCockpit_PaneText(s, XW_SNAP_PANE_SPEED, digits, sizeof digits);
+	PanelText(&values, 40, digits[0] ? digits : "0", PANEL_VALUE);
+	return true;
+}
