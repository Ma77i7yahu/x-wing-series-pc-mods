 src/xw_remaster/hud_readout.h  |   2 +
 src/xw_remaster/hud_renderer.c |   2 +
 src/xw_remaster/xvt_cockpit.c  |  31 +++++
 src/xw_remaster/xvt_cockpit.h  |   5 +
