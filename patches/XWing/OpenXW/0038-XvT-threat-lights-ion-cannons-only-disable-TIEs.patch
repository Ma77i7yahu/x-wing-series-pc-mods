+void XwXvtCockpit_DrawThreats(const XwHudDraw* d) {
+	unsigned view = d->snapshot->cockpit.view;
+	if ((view != 0 && view != VIEW_HUD) || !LoadPanel())
+		return;
+	/* The row sits above the gunsight. With the cockpit off the gunsight keeps X-Wing's place, so the row
+	 * keeps its XvT distance from it. */
+	const Element* gunsight = &g_craft.elements[XVT_GUNSIGHT];
+	int dx = 0, dy = 0;
+	if (view == VIEW_HUD) {
+		dx = d->definition->elements[EL_GUNSIGHT].x - gunsight->x;
+		dy = d->definition->elements[EL_GUNSIGHT].y - gunsight->y;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		const Element* e = &g_craft.elements[XVT_THREAT + i];
+		if (!Placed(e) || e->selector < 0)
+			continue;
+		const Sprite* sprite = GetSprite((unsigned)e->selector + d->snapshot->readout.threats[i], (unsigned)e->color,
+										 PLAIN, 0, d->snapshot->cockpit.palette_argb);
+		if (sprite)
+			DrawSprite(d, sprite, e->x + dx, e->y + dy);
+	}
+}
+
