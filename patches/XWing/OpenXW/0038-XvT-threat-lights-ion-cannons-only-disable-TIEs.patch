+/* OpenXvT Hud_UpdateThreatIndicators with X-Wing's AI fields: a burst in progress (linkMode) at the player,
+ * a turret slot whose firingGate names the player, and panel_updateweaponwarnings' warhead lock. Like that
+ * warning light, all go dark when the weapon warning system is damaged. */
+static void CaptureThreats(XwSnapReadout* r) {
+	if (!(g_playerFlightState.craft->activeHudFeatureMask & PANEL_HUD_WEAPON_WARNING_FEATURE))
+		return;
+	uint16_t player = g_playerFlightState.objectIndex;
+	int16_t max_lock = 0;
+	for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index) {
+		if (index == player || !LiveObject(index) || g_objectTable[index].familyId != XW_OBJECT_FAMILY_CRAFT)
+			continue;
+		const CraftData* craft = g_objectTable[index].instanceData;
+		if (!craft || craft->workingSubsystems == 0)
+			continue;
+		if (craft->aiTargetRef == player) {
+			for (unsigned group = 0; group < craft->cannonClassCount; ++group)
+				if (craft->laserState.linkMode[group] != 0)
+					r->threats[0] = 1;
+			if (craft->aiManeuverId == PAIORDER_MANEUVER_ATTACK_ALTERNATE && craft->warheadLockTicks > max_lock)
+				max_lock = craft->warheadLockTicks;
+		}
+		for (unsigned slot = 0; slot < craft->laserSlotCount; ++slot)
+			if (craft->weaponSlots[slot].firingGate == (int16_t)(player + 1))
+				r->threats[1] = 1;
+	}
+	r->threats[3] = max_lock > PANEL_WEAPON_LOCK_COMPLETE_TICKS ? PANEL_WEAPON_WARNING_LOCKED
+					: max_lock > 0 ? (uint8_t)((g_missionElapsedClock.subsecondTicks / PANEL_WEAPON_WARNING_FLASH_TICKS) & 1)
+								   : 0;
+}
+
