-/* XvT writes names and words in title case ("Alpha 2", "Unknown"): all-capital words of letters only become
- * title case. Type prefixes ("T/F") and designations with digits are kept. */
-static void TitleCase(char* text) {
+void XwReadout_TitleCase(char* text) {
+	static const char* const kKeep[] = { "TIE", "OK" };
 	for (char* word = text; *word;) {
 		char* end = word;
-		bool letters = true, upper = true;
-		while (*end && *end != ' ') {
-			letters = letters && isalpha((unsigned char)*end);
-			upper = upper && !islower((unsigned char)*end);
+		while (*end && *end != ' ')
 			++end;
+		/* Trailing punctuation ("GOLD," "DISABLED.") does not stop a word counting. */
+		char* letters_end = end;
+		while (letters_end > word && strchr(".,!?:;", letters_end[-1]))
+			--letters_end;
+		bool letters = letters_end - word >= 2, upper = true;
+		for (char* c = word; c < letters_end; ++c) {
+			letters = letters && isalpha((unsigned char)*c);
+			upper = upper && !islower((unsigned char)*c);
 		}
-		if (letters && upper && end - word >= 2)
-			for (char* c = word + 1; c < end; ++c)
+		for (unsigned i = 0; letters && i < sizeof kKeep / sizeof kKeep[0]; ++i)
+			if ((size_t)(letters_end - word) == strlen(kKeep[i]) && !strncmp(word, kKeep[i], letters_end - word))
+				letters = false;
+		if (letters && upper)
+			for (char* c = word + 1; c < letters_end; ++c)
 				*c = (char)tolower((unsigned char)*c);
 		word = *end ? end + 1 : end;
 	}
 }
 
+static void TitleCase(char* text) { XwReadout_TitleCase(text); }
