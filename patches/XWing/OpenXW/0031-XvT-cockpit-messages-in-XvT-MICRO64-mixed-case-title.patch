+bool XwHudXvtFont_Load(void) { return LoadXvtFont(); }
+
+/* A pen for XvT's font at classic coordinates: glyphs keep their shape when the cockpit is stretched. */
+static Pen XvtPen(const XwHudDraw* d) {
+	float sx = d->layout.scale_x, sy = d->layout.scale_y;
+	return (Pen) { d, &g_xvtFont, &g_xvtFontAtlas, sx, sy, d->offset_x, d->offset_y, true, sx > sy ? sy / sx : 1 };
+}
+
+void XwHudXvtMessage_Draw(const XwHudDraw* d, int dy) {
+	if (!g_xvtFontReady)
+		return;
+	const XwSnapCockpit* c = &d->snapshot->cockpit;
+	XwSnapRange range = c->panes[XW_SNAP_PANE_READY_MESSAGE].glyphs;
+	if (!range.count || range.first + range.count > c->glyph_count)
+		return;
+	Pen pen = XvtPen(d);
+	unsigned xvt_h = FontHeight(&g_xvtFont);
+	/* One message line per glyph row, read left to right; gaps between glyphs are spaces. */
+	bool done[XW_SNAP_HUD_GLYPHS] = { false };
+	for (unsigned start = 0; start < range.count; ++start) {
+		if (done[start])
+			continue;
+		int line_y = c->glyphs[range.first + start].y;
+		enum { LINE = 200 };
+		const XwSnapGlyph* line[LINE];
+		unsigned n = 0;
+		for (unsigned i = start; i < range.count; ++i) {
+			const XwSnapGlyph* g = &c->glyphs[range.first + i];
+			if (done[i] || g->y != line_y)
+				continue;
+			done[i] = true;
+			if (n == LINE)
+				continue;
+			unsigned at = n++;
+			while (at > 0 && line[at - 1]->x > g->x) {
+				line[at] = line[at - 1];
+				--at;
+			}
+			line[at] = g;
+		}
+		char text[2 * LINE + 1];
+		uint16_t colors[2 * LINE];
+		unsigned length = 0;
+		for (unsigned i = 0; i < n; ++i) {
+			if (i && line[i]->x > line[i - 1]->x + line[i - 1]->advance + 1 && text[length - 1] != ' ') {
+				colors[length] = line[i]->foreground;
+				text[length++] = ' ';
+			}
+			colors[length] = line[i]->foreground;
+			text[length++] = line[i]->character < 256 ? (char)line[i]->character : '?';
+		}
+		text[length] = 0;
+		XwReadout_TitleCase(text);
+		/* Same bottom edge as X-Wing's text, centred on the screen. */
+		float x = (c->screen_width - Measure(&pen, text)) / 2;
+		float y = line_y + dy + (float)line[0]->height - (float)xvt_h;
+		for (unsigned i = 0; i < length; ++i) {
+			float rgba[4];
+			XwHudDraw_Color(d, colors[i], false, rgba);
+			x += GlyphSprite(&pen, x, y, text[i], rgba);
+		}
+	}
+}
