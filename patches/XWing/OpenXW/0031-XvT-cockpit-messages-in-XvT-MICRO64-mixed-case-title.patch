 /* Width in classic pixels. */
 static float Measure(const Pen* p, const char* text) {
 	float w = 0;
-	for (; *text; ++text) {
-		const AeronDecodedGlyph* g = Glyph(p, *text);
-		w += g ? g->advance : p->font->font.cell_width;
-	}
+	for (; *text; ++text)
