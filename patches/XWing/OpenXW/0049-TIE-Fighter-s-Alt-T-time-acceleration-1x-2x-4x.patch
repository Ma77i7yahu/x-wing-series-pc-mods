 src/xw/flight/object/create.c         |  2 ++
 src/xw/flight/player/user.h           |  2 ++
 src/xw_runtime/input/actions.c        |  2 ++
 src/xw_runtime/input/actions.h        |  1 +
 src/xw_runtime/runtime/flight_frame.c | 32 ++++++++++++++++++++++++++-
 src/xw_runtime/runtime/flight_frame.h |  7 ++++++
 src/xw_runtime/runtime/flight_input.c | 11 +++++++++
 src/xw_runtime/runtime/flight_sim.c   |  4 ++++
 9 files changed, 63 insertions(+), 1 deletion(-)

