diff --git a/src/xw_runtime/runtime/flight_frame.c b/src/xw_runtime/runtime/flight_frame.c
index acbac02..1281d2e 100644
--- a/src/xw_runtime/runtime/flight_frame.c
+++ b/src/xw_runtime/runtime/flight_frame.c
@@ -39,6 +39,36 @@
 
 static XwFlightFrame s_frame;
 static XwFlightFrame* s_inputFrame = &s_frame;
+/* TIE Fighter's acceleratedtimesetting / acceleratedtimectr. */
+static unsigned s_timeAcceleration = 1, s_timeAccelerationCounter;
+
+unsigned XwFlightFrame_CycleTimeAcceleration(void) {
+	s_timeAcceleration *= 2;
+	if (s_timeAcceleration > 4)
+		s_timeAcceleration = 1;
+	s_timeAccelerationCounter = 0;
+	return s_timeAcceleration;
+}
+
+void XwFlightFrame_ResetTimeAcceleration(void) { s_timeAcceleration = 1, s_timeAccelerationCounter = 0; }
+
+int XwFlightFrame_SkippedRender(const XwFlightFrame* frame) {
+	return frame->phase == XW_FRAME_IDLE && !frame->rendered && s_timeAcceleration > 1 && g_replayviewmode == 0 &&
+		   g_missionRuntimeState.flightExitRequested == 0;
+}
+
+/* As TIE Fighter: render once per setting, and let the skipped frames' time carry the next step at once. */
+static int TimeAccelerationSkipsRender(void) {
+	if (s_timeAcceleration <= 1)
+		return 0;
+	if (s_timeAccelerationCounter == 0) {
+		s_timeAccelerationCounter = s_timeAcceleration - 1;
+		return 0;
+	}
+	--s_timeAccelerationCounter;
+	g_flightAccumulatedTicks += g_elapsedTicks;
+	return 1;
+}
 
 static int FrameQuitRequested(void) {
 	if (!g_quitRequested)
@@ -194,7 +224,7 @@ int XwFlightFrame_TickState(XwFlightFrame* frame) {
 				XwFlightMode_UpdateScreen();
 				frame->rendered = 1;
 			}
-		} else {
+		} else if (!TimeAccelerationSkipsRender()) {
 			XwFlightMode_UpdateScreen();
 			frame->rendered = 1;
 			if (FrameQuitRequested())
diff --git a/src/xw_runtime/runtime/flight_frame.h b/src/xw_runtime/runtime/flight_frame.h
index b0b0d76..c960117 100644
--- a/src/xw_runtime/runtime/flight_frame.h
+++ b/src/xw_runtime/runtime/flight_frame.h
@@ -40,6 +40,13 @@ void XwFlightFrame_UpdateInput(void);
 /* Cancel only after clearing child tasks and cancelling the input owner. */
 void XwFlightFrame_Cancel(void);
 
+/* Not in X-Wing: TIE Fighter's Alt+T time acceleration. Cycles 1x -> 2x -> 4x -> 1x and returns the new
+ * setting. Live flight renders one frame in every setting and runs the others back to back. */
+unsigned XwFlightFrame_CycleTimeAcceleration(void);
+void XwFlightFrame_ResetTimeAcceleration(void);
+/* The finished frame was simulated without a render; its owner should run the next one at once. */
+int XwFlightFrame_SkippedRender(const XwFlightFrame* frame);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/xw_runtime/runtime/flight_input.c b/src/xw_runtime/runtime/flight_input.c
index a18fce5..1ee283d 100644
--- a/src/xw_runtime/runtime/flight_input.c
+++ b/src/xw_runtime/runtime/flight_input.c
@@ -277,6 +277,17 @@ int XwFlightInput_Tick(XwFlightInput* state) {
 				case USER_KEY_VERSION:
 					msg_messageprintf(XW_MSG_VERSION_BANNER);
 					break;
+				case USER_KEY_TIME_ACCELERATION: {
+					/* TIE Fighter's Alt+T. Live only, so films neither record nor replay it. */
+					static const char* const kText[] = { "\005Time is normal",
+														 "\005Time accelerated to \0072X\005 normal time",
+														 "\005Time accelerated to \0074X\005 normal time" };
+					unsigned setting = XwFlightFrame_CycleTimeAcceleration();
+					msg_messagetext(XW_MSG_MISSION_RESUMED, kText[setting / 2]);
+					fsfx_triggersfx(FSFX_CONTROL_ACKNOWLEDGE_SLOT, FSFX_UNPOSITIONED_OBJECT);
+					g_currentActionKey = 0;
+					break;
+				}
 				default:
 					break;
 			}
diff --git a/src/xw_runtime/runtime/flight_sim.c b/src/xw_runtime/runtime/flight_sim.c
index 7295cb3..f655369 100644
--- a/src/xw_runtime/runtime/flight_sim.c
+++ b/src/xw_runtime/runtime/flight_sim.c
@@ -609,6 +609,8 @@ static LandruTaskStepResult sim_step(void* self) {
 				return LANDRU_TASK_STEP_YIELD;
 			if (XwFlightLoading_Active())
 				sim_prepare_renderer(state, state->phase);
+			else if (XwFlightFrame_SkippedRender(&state->frame))
+				return LANDRU_TASK_STEP_CONTINUE;
 			return LANDRU_TASK_STEP_FRAME_COMPLETE;
 		}
 		sim_hyperspace_end(state);
@@ -646,6 +648,8 @@ static LandruTaskStepResult sim_step(void* self) {
 				return LANDRU_TASK_STEP_YIELD;
 			if (XwFlightLoading_Active())
 				sim_prepare_renderer(state, state->phase);
+			else if (XwFlightFrame_SkippedRender(&state->frame))
+				return LANDRU_TASK_STEP_CONTINUE;
 			return LANDRU_TASK_STEP_FRAME_COMPLETE;
 		}
 		state->phase = SIM_POST_FLIGHT;
