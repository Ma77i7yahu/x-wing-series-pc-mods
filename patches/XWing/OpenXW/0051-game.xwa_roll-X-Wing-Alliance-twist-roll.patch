+// FUNCTION: XW 0x42CC70
+int user_framerateadjust(int16_t step) {
+	return math2_ABoverC32(step, g_elapsedTicks, XW_SIMULATION_TICKS_PER_SECOND);
+}
+
+/* XvT player turn rate (OpenXvT player.c): the throttle setting t maps to 1/3 + 2t below 1/3 throttle and
+ * to 1 - (t - 1/3)/2 above it, so turns are tightest at 1/3 throttle (X-Wing's own rate), 2/3 as tight at
+ * full throttle and 1/3 when stopped or with the engines out. Each step of combined laser + shield
+ * recharge below neutral adds 0xC00/0x10000 (about 5%); each step above takes it away. */
+enum { USER_XVT_TURN_PEAK = 0x5555, USER_XVT_POWER_NEUTRAL = 2 * LASER_RECHARGE_NEUTRAL, USER_XVT_POWER_STEP = 0xC00 };
+
+int user_xvtturngain(int gain) {
+#ifdef XW_MODERN
+	const CraftData* craft = g_playerFlightState.craft;
+	int throttle;
+	int scale;
+	int redirect;
+	if (!XwFlightTweaks_XvtTurning() || craft == NULL)
+		return gain;
+	throttle = (craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_ENGINE) != 0 ? craft->engineThrottle[0] : 0;
+	scale = throttle < USER_XVT_TURN_PEAK ? 2 * throttle + USER_XVT_TURN_PEAK
+										  : 0x10000 - (throttle - USER_XVT_TURN_PEAK) / 2;
+	if (g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[XW_SHIELD_FRONT] != 0)
+		redirect = craft->shieldRedirect + craft->laserRedirect;
+	else
+		redirect = 2 * craft->laserRedirect;
+	scale += (int)(((long long)scale * USER_XVT_POWER_STEP * (USER_XVT_POWER_NEUTRAL - redirect)) >> 16);
+	gain = (int)(((long long)gain * scale) >> 16);
+	/* The turn command is carried in int16 smoothing state. */
+	return gain > INT16_MAX ? INT16_MAX : gain;
+#else
+	return gain;
+#endif
+}
+
+/* game.xwa_roll: X-Wing Alliance's twist-roll gain (OpenXWA flight.c player integration). XWA scales the
+ * craft's ModelDef rollRate by the same throttle curve and power steps as XvT (always, not only with
+ * game.xvt_turning), then rolls input * rate / 14336 per 236 ticks, twice over. Returned in the Q15 form
+ * RollStep multiplies by; -1 for craft XWA has no rate for, which keep X-Wing's own. */
+static int user_xwarollrate(const char* shortName) {
+	static const struct {
+		const char* name;
+		int rate;
+	} kRates[] = { { "X-W", 9216 }, { "Y-W", 7168 }, { "A-W", 12288 }, { "B-W", 8704 }, { "T/F", 11776 },
+				   { "T/I", 12800 }, { "T/B", 10752 }, { "T/A", 12800 }, { "GUN", 10240 } };
+	for (unsigned i = 0; i < sizeof kRates / sizeof kRates[0]; ++i)
+		if (strcmp(shortName, kRates[i].name) == 0)
+			return kRates[i].rate;
+	return -1;
+}
+
+int user_xwarollgain(void) {
+#ifdef XW_MODERN
+	const CraftData* craft = g_playerFlightState.craft;
+	int rate;
+	int throttle;
+	int scale;
+	int redirect;
+	if (!XwFlightTweaks_XwaRoll() || craft == NULL)
+		return -1;
+	rate = user_xwarollrate(g_craftTypeDefs[craft->craftTypeIndex].shortName);
+	if (rate < 0)
+		return -1;
+	throttle = (craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_ENGINE) != 0 ? craft->engineThrottle[0] : 0;
+	scale = throttle < USER_XVT_TURN_PEAK ? 2 * throttle + USER_XVT_TURN_PEAK
+										  : 0x10000 - (throttle - USER_XVT_TURN_PEAK) / 2;
+	if (g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[XW_SHIELD_FRONT] != 0)
+		redirect = craft->shieldRedirect + craft->laserRedirect;
+	else
+		redirect = 2 * craft->laserRedirect;
+	rate = (int)(((long long)rate * scale) >> 16);
+	rate += (int)(((long long)rate * USER_XVT_POWER_STEP * (USER_XVT_POWER_NEUTRAL - redirect)) >> 16);
+	return rate < 0 ? 0 : (int)(((long long)rate * 32768) / 14336);
+#else
+	return -1;
+#endif
+}
