-/* XvT's U (OpenXvT flight.c FLIGHT_KEY_U): the most recently arrived craft, one per flight group (the
- * leader, or a wingman whose leader is gone), skipping the player and craft that are dying or ejected. */
-static uint16_t user_findnewestcraft(void) {
-	uint16_t newest = XW_PLAYER_NO_TARGET;
-	uint16_t newestAge = UINT16_MAX;
-	for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index) {
-		const ObjectRecord* object = &g_objectTable[index];
-		const CraftData* craft;
-		if (object->objectType == XW_OBJ_NONE || index == g_playerFlightState.objectIndex ||
-			object->genusId == XW_GENUS_EXPLOSION_EFFECT || object->familyId != XW_OBJECT_FAMILY_CRAFT)
-			continue;
-		craft = object->instanceData;
-		if (craft->objectKind == XW_CRAFT_OBJECT_KIND_3 || craft->objectKind == XW_CRAFT_OBJECT_KIND_4)
-			continue;
-		if (craft->aiLeaderObjectIndex != XW_CRAFT_NO_AI_LEADER && craft->aiLeaderObjectIndex != index &&
-			craft->aiLeaderObjectIndex < XW_CRAFT_OBJECT_COUNT &&
-			g_objectTable[craft->aiLeaderObjectIndex].objectType != XW_OBJ_NONE)
-			continue;
-		if (object->ageSeconds < newestAge) {
-			newest = index;
-			newestAge = object->ageSeconds;
-		}
-	}
-	return newest;
-}
-
-/* XvT's I (OpenXvT flight.c FLIGHT_KEY_I): the nearest warhead homing on the player, otherwise the nearest
- * one homing on a friendly craft. */
-static uint16_t user_findincomingwarhead(void) {
-	uint16_t player = g_playerFlightState.objectIndex;
-	uint16_t nearest = XW_PLAYER_NO_TARGET;
-	uint32_t nearestDistance = UINT32_MAX;
-	for (int pass = 0; pass < 2 && nearest == XW_PLAYER_NO_TARGET; ++pass) {
-		for (uint16_t index = XW_CRAFT_OBJECT_COUNT; index < USER_WARHEAD_SLOT_END; ++index) {
-			uint16_t type = g_objectTable[index].objectType;
-			uint16_t target;
-			if (type != XwFlightTypes_ObjectType(XW_OBJ_WARHEAD_149) &&
-				type != XwFlightTypes_ObjectType(XW_OBJ_TRACKED_WARHEAD))
-				continue;
-			target = g_warheadGuidanceTable[index - XW_CRAFT_OBJECT_COUNT].targetObjIdx;
-			if (pass == 0 ? target != player
-						  : target == player || target >= XW_CRAFT_OBJECT_COUNT ||
-								g_objectTable[target].objectType == XW_OBJ_NONE ||
-								g_objectTable[target].iff != g_playerFlightState.object->iff)
-				continue;
-			pai_distancebetween(player, index);
-			if ((uint32_t)g_trig2PolarDistance < nearestDistance) {
-				nearest = index;
-				nearestDistance = g_trig2PolarDistance;
-			}
-		}
-	}
-	return nearest;
-}
-
-/* XvT's A (OpenXvT player.c Player_FindAttackerOfTarget): the craft attacking the current target that is
- * nearest to it, other than the player. X-Wing's AI keeps its attack target in aiTargetRef; requiring the
- * attacker to be hostile to a craft target leaves out escorts and boarding craft. */
-static uint16_t user_findattackeroftarget(uint16_t target) {
-	uint16_t nearest = XW_PLAYER_NO_TARGET;
-	uint32_t nearestDistance = UINT32_MAX;
-	if (target == XW_PLAYER_NO_TARGET)
-		return XW_PLAYER_NO_TARGET;
-	for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index) {
-		const ObjectRecord* object = &g_objectTable[index];
-		const CraftData* craft;
-		if (object->objectType == XW_OBJ_NONE || index == target || index == g_playerFlightState.objectIndex ||
-			object->genusId == XW_GENUS_EXPLOSION_EFFECT || object->familyId != XW_OBJECT_FAMILY_CRAFT)
-			continue;
-		craft = object->instanceData;
-		if (craft->aiTargetRef != target || craft->objectKind == XW_CRAFT_OBJECT_KIND_3 ||
-			craft->objectKind == XW_CRAFT_OBJECT_KIND_4 || (!XwFlightTypes_Dos() && craft->workingSubsystems == 0))
-			continue;
-		if (target < XW_CRAFT_OBJECT_COUNT && object->iff == g_objectTable[target].iff)
-			continue;
-		pai_distancebetween(target, index);
-		if ((uint32_t)g_trig2PolarDistance < nearestDistance) {
-			nearest = index;
-			nearestDistance = g_trig2PolarDistance;
-		}
-	}
-	return nearest;
-}
-
-/* E, cycling as XvT's does (OpenXvT flight.c FLIGHT_KEY_E): when the current target is attacking the player,
- * the next attacker after it in slot order, wrapping; otherwise X-Wing's nearest attacker. Attackers are those
- * user_findclosestattacker counts: hostile craft whose AI target is the player. */
-static int user_isplayerattacker(uint16_t index) {
-	const CraftData* craft;
-	if (index >= XW_CRAFT_OBJECT_COUNT || index == g_playerFlightState.objectIndex ||
-		g_objectTable[index].objectType == XW_OBJ_NONE || g_objectTable[index].genusId == XW_GENUS_EXPLOSION_EFFECT ||
-		g_objectTable[index].iff == g_playerFlightState.object->iff)
-		return 0;
-	craft = g_objectTable[index].instanceData;
-	return craft && craft->aiTargetRef == g_playerFlightState.objectIndex &&
-		   (XwFlightTypes_Dos() || craft->workingSubsystems != 0);
-}
-
-static uint16_t user_nextattacker(void) {
-	uint16_t current = g_playerFlightState.currentTargetObjectIdx;
-	if (!user_isplayerattacker(current))
-		return (uint16_t)user_findclosestattacker();
-	for (uint16_t step = 1; step < XW_CRAFT_OBJECT_COUNT; ++step) {
-		uint16_t index = (uint16_t)((current + step) % XW_CRAFT_OBJECT_COUNT);
-		if (user_isplayerattacker(index))
-			return index;
-	}
-	return current;
-}
