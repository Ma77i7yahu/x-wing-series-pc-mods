-		panelrts_setnewpilotview(g_flightCamera.savedHudState == USER_TARGET_ANNOUNCEMENT_HUD_STATE
-									 ? USER_TARGET_ANNOUNCEMENT_HUD_STATE
-									 : 0);
-	}
-}
