 11 files changed, 4282 insertions(+), 4215 deletions(-)

diff --git a/resources/config.yaml b/resources/config.yaml
index 7c83f84..69f3b0f 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -286,6 +286,9 @@ game:
   # Player turn rate as in X-Wing vs TIE Fighter: tightest at 1/3 throttle (stock
   # X-Wing rate), 2/3 of that at full throttle and 1/3 when stopped.
   xvt_turning: true
+  # Twist (roll axis) rolls as in X-Wing Alliance: XWA's roll rate for each craft, its
+  # throttle and power curve and its 8% dead zone; turning still banks while you twist.
+  xwa_roll: true
   # The player launches with both shield banks fully overcharged (twice normal strength,
   # the most recharging can reach). Missions that start with no or half shields are unchanged.
   start_overshield: true
