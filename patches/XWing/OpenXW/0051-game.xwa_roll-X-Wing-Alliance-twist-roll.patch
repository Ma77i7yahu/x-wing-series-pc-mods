+	/* IDB +0x9A: Serialized bytes with no identified direct semantic use. Do not assume padding or assign
+	 * field meaning. */
+	uint8_t gap_9A[2];
+	/* IDB +0x9C: MOVE_moveobjects rotates cockpit local offset and stores X/Y/Z. Camera adds it to world
