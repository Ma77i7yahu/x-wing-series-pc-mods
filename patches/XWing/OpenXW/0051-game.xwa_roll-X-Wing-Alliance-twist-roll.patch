+	g_flightSfxGroupUnmuted = 1;
+	if (g_flightAudioMode != 0) {
+		int volume;
+		if (g_flightMusicVolume != 0)
+			volume = XW_SHELL_VOLUME_STEP * (int8_t)g_flightMusicVolume - 1;
+		else
+			volume = 0;
+		lolevel_ImSetGroupVol(XW_SOUND_GROUP_MUSIC, volume);
