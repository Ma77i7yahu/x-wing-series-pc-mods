-/* XvT's Enter on the damage display: the highlighted system goes to the head of the repair order. The
- * saved order follows, since the map and briefing screens restore it on the way out. */
-static void user_repairselectedfirst(void) {
-	int selected = user_damagedisplayselected();
-	unsigned at = 0;
-	if (selected < 0)
-		return;
-	while (at < XW_PLAYER_SUBSYSTEM_COUNT && g_playerSubsystemRepairPriority[at] != selected)
-		++at;
-	if (at == XW_PLAYER_SUBSYSTEM_COUNT)
-		return;
-	for (; at > 0; --at)
-		g_playerSubsystemRepairPriority[at] = g_playerSubsystemRepairPriority[at - 1];
-	g_playerSubsystemRepairPriority[0] = (uint8_t)selected;
-	s_damageSelected = selected;
-	memcpy(g_playerFlightState.savedSubsystemRepairPriority, g_playerSubsystemRepairPriority,
-		   sizeof(g_playerFlightState.savedSubsystemRepairPriority));
-}
