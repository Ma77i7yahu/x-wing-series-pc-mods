+/* The player's target when it can be shown: a live object-table object or mission object. */
+static uint16_t user_viewabletarget(void) {
+	uint16_t target = g_playerFlightState.currentTargetObjectIdx;
+	if (target == XW_OBJECT_SLOT_UNAVAILABLE || target == g_playerFlightState.objectIndex)
+		return XW_OBJECT_SLOT_UNAVAILABLE;
+	if (target < XW_MISSION_OBJECT_REF_BASE)
+		return target < g_mainObjectSlotEnd && g_objectTable[target].objectType != XW_OBJ_NONE &&
+					   g_objectTable[target].genusId != XW_GENUS_EXPLOSION_EFFECT
+				   ? target
+				   : XW_OBJECT_SLOT_UNAVAILABLE;
+	return target - XW_MISSION_OBJECT_REF_BASE < MISSION_OBJECT_COUNT &&
+				   g_missionObjects[target - XW_MISSION_OBJECT_REF_BASE].objectType != XW_OBJ_NONE
+			   ? target
+			   : XW_OBJECT_SLOT_UNAVAILABLE;
+}
+
+uint16_t user_targetviewobject(void) { return s_targetViewActive ? user_viewabletarget() : XW_OBJECT_SLOT_UNAVAILABLE; }
+
+/* XvT's threat display frames the target: camera distance from the game's own model size. */
+static void user_frametargetview(uint16_t target) {
+	uint16_t type = target < XW_MISSION_OBJECT_REF_BASE
+						? g_objectTable[target].objectType
+						: g_missionObjects[target - XW_MISSION_OBJECT_REF_BASE].objectType;
+	s_targetViewFramed = target;
+	/* Far enough that the whole craft fits the display window, as in XvT. */
+	int distance = g_modelTypeTable[type].maxBoundsExtent * 5;
+	if (distance < USER_CAMERA_MIN_DISTANCE)
+		distance = USER_CAMERA_MIN_DISTANCE;
+	/* Capital ships need more room than the manual zoom's USER_CAMERA_MAX_DISTANCE. */
+	if (distance > INT16_MAX)
+		distance = INT16_MAX;
+	g_flightCamera.externalDistance = (int16_t)distance;
+}
+
+/* XvT's U (OpenXvT flight.c FLIGHT_KEY_U): the most recently arrived craft, one per flight group (the
+ * leader, or a wingman whose leader is gone), skipping the player and craft that are dying or ejected. */
+static uint16_t user_findnewestcraft(void) {
+	uint16_t newest = XW_PLAYER_NO_TARGET;
+	uint16_t newestAge = UINT16_MAX;
+	for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index) {
+		const ObjectRecord* object = &g_objectTable[index];
+		const CraftData* craft;
+		if (object->objectType == XW_OBJ_NONE || index == g_playerFlightState.objectIndex ||
+			object->genusId == XW_GENUS_EXPLOSION_EFFECT || object->familyId != XW_OBJECT_FAMILY_CRAFT)
+			continue;
+		craft = object->instanceData;
+		if (craft->objectKind == XW_CRAFT_OBJECT_KIND_3 || craft->objectKind == XW_CRAFT_OBJECT_KIND_4)
+			continue;
+		if (craft->aiLeaderObjectIndex != XW_CRAFT_NO_AI_LEADER && craft->aiLeaderObjectIndex != index &&
+			craft->aiLeaderObjectIndex < XW_CRAFT_OBJECT_COUNT &&
+			g_objectTable[craft->aiLeaderObjectIndex].objectType != XW_OBJ_NONE)
+			continue;
+		if (object->ageSeconds < newestAge) {
+			newest = index;
+			newestAge = object->ageSeconds;
+		}
+	}
+	return newest;
+}
