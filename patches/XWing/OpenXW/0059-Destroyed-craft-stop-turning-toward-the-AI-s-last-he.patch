From 9d9b91449befe7c1883c2fd551c3aa67871a3251 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Wed, 11 Nov 2026 07:17:34 +1100
Subject: [PATCH 59/59] Destroyed craft stop turning toward the AI's last
 heading

dynamix kept running the AI yaw controller for breaking-up and exploding
craft, so a wreck kept turning toward whatever it had been attacking and
could swing onto the player.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xw/flight/object/dynamix.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/xw/flight/object/dynamix.c b/src/xw/flight/object/dynamix.c
index 6c66f6a..882d015 100644
--- a/src/xw/flight/object/dynamix.c
+++ b/src/xw/flight/object/dynamix.c
@@ -218,7 +218,13 @@ void dynamix_planedynamics(void) {
 					}
 				}
 			}
-			if (craft->objectKind != XW_CRAFT_OBJECT_KIND_2 && craft->aiYawState >= XW_AI_YAW_STATE_1) {
+			if (craft->objectKind != XW_CRAFT_OBJECT_KIND_2 && craft->aiYawState >= XW_AI_YAW_STATE_1
+#ifdef XW_MODERN
+				/* A destroyed craft no longer flies: X-Wing kept turning wrecks to the AI's last heading
+				 * (toward whatever they were attacking), so a wreck could swing onto the player. */
+				&& craft->objectKind != XW_CRAFT_OBJECT_KIND_3 && craft->objectKind != XW_CRAFT_OBJECT_KIND_4
+#endif
+			) {
 				uint16_t delta = craft->aiTargetYaw - object->yaw;
 				if (delta != 0) {
 					uint16_t step;
