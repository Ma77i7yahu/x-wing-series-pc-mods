 bool XwFlightTweaks_XvtDamageDisplay(void);
 void XwFlightTweaks_SetXvtDamageDisplay(bool enabled);
+/* game.skip_empty_warheads: as in X-Wing vs TIE Fighter, W skips a launcher with no warheads left, and
