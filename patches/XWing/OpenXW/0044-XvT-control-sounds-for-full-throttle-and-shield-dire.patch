From 35fb1849e5918fc3a3240b7c1077f683b9a47950 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sun, 11 Oct 2026 06:32:34 +1100
Subject: [PATCH 44/59] XvT control sounds for full throttle, +/- and shield
 direction

Backspace and +/- play XvT's small click, S its confirm beep (click when the shields
are damaged), as in OpenXvT flight.c.
---
 resources/config.yaml       | 2 +-
 src/xw/flight/player/user.c | 9 +++++----
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/resources/config.yaml b/resources/config.yaml
index 221f721..937d543 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -26,7 +26,7 @@ audio:
   # Applies from the next mission.
   xvt_weapon_sounds: true
   # Use X-Wing vs TIE Fighter's tones for recharge rates (one per setting), energy transfers
-  # and the 0, 1/3 and 2/3 throttle keys (resources/xvt_control_sounds). Applies from the next mission.
+  # shield direction and the throttle keys (resources/xvt_control_sounds). Applies from the next mission.
   xvt_control_sounds: true
   player_engine_sound_volume_percent: 30
 music:
diff --git a/src/xw/flight/player/user.c b/src/xw/flight/player/user.c
index 8d3e79f..c46a6c9 100644
--- a/src/xw/flight/player/user.c
+++ b/src/xw/flight/player/user.c
@@ -1054,7 +1054,7 @@ void user_inputforplane(void) {
 			uint16_t engine;
 			for (engine = 0; engine < g_playerFlightState.engineCount; ++engine)
 				user_increasepower(engine, USER_THROTTLE_STEP);
-			fsfx_triggersfx(FSFX_CONTROL_ACKNOWLEDGE_SLOT, FSFX_UNPOSITIONED_OBJECT);
+			USER_CONTROL_SOUND(XW_CONTROL_SOUND_CLICK, FSFX_CONTROL_ACKNOWLEDGE_SLOT);
 			break;
 		}
 		case ']': {
@@ -1070,7 +1070,7 @@ void user_inputforplane(void) {
 			uint16_t engine;
 			for (engine = 0; engine < g_playerFlightState.engineCount; ++engine)
 				user_decreasepower(engine, USER_THROTTLE_STEP);
-			fsfx_triggersfx(FSFX_CONTROL_ACKNOWLEDGE_SLOT, FSFX_UNPOSITIONED_OBJECT);
+			USER_CONTROL_SOUND(XW_CONTROL_SOUND_CLICK, FSFX_CONTROL_ACKNOWLEDGE_SLOT);
 			break;
 		}
 		case '[': {
@@ -1095,7 +1095,7 @@ void user_inputforplane(void) {
 			uint16_t engine;
 			for (engine = 0; engine < g_playerFlightState.engineCount; ++engine)
 				g_playerFlightState.craft->engineThrottle[engine] = XW_CRAFT_THROTTLE_FULL;
-			fsfx_triggersfx(FSFX_THROTTLE_SETTING_SLOT, FSFX_UNPOSITIONED_OBJECT);
+			USER_CONTROL_SOUND(XW_CONTROL_SOUND_CLICK, FSFX_THROTTLE_SETTING_SLOT);
 			g_msgArgTable[0] = XW_MSG_THROTTLE_FULL_POWER;
 			msg_messageprintf(XW_MSG_ENGINE_THROTTLE_SETTING);
 			break;
@@ -1351,11 +1351,12 @@ void user_inputforplane(void) {
 				}
 				g_msgArgTable[0] = g_playerFlightState.craft->shieldDistribMode + XW_MSG_SHIELDS_FULL_FORWARD;
 				msg_messageprintf(XW_MSG_DEFLECTOR_SHIELD_DISTRIBUTION);
-				fsfx_triggersfx(FSFX_CONTROL_ACKNOWLEDGE_SLOT, FSFX_UNPOSITIONED_OBJECT);
+				USER_CONTROL_SOUND(XW_CONTROL_SOUND_CONFIRM, FSFX_CONTROL_ACKNOWLEDGE_SLOT);
 			} else {
 				g_msgArgTable[0] = XW_MSG_SUBSYSTEM_DEFLECTOR_SHIELD;
 				g_msgArgTable[1] = XW_MSG_SUBSYSTEM_DAMAGED_AND_INOPERATIVE;
 				msg_messageprintf(XW_MSG_SUBSYSTEM_STATUS);
+				USER_XVT_ONLY_SOUND(XW_CONTROL_SOUND_CLICK);
 			}
 			break;
 		case USER_KEY_SHIELD_RECHARGE:
