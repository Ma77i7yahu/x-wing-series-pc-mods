+/* XvT's one-word order ("Attacking", "Following") for X-Wing's plan status phrase. */
+static void ShortOrder(char* out, size_t capacity, const char* phrase) {
+	static const struct {
+		const char *key, *word;
+	} kWords[] = {
+		{ "disable", "Disabling" },	   { "attack", "Attacking" },	 { "evasive", "Evading" },
+		{ "escort", "Escorting" },	   { "board", "Boarding" },		 { "capture", "Capturing" },
+		{ "dock", "Docking" },		   { "rendezvous", "Rendezvous" }, { "rescue", "Disabled" },
+		{ "home", "Returning" },	   { "entering", "Entering" },	 { "exiting", "Exiting" },
+		{ "patrol", "Patrolling" },	   { "holding", "Holding" },	 { "follow", "Following" },
+		{ "leading", "Following" },	   { "waiting", "Waiting" },	 { "awaiting", "Waiting" },
+		{ "aid", "Assisting" },		   { "ignoring", "Ignoring" },
+	};
+	for (unsigned i = 0; i < sizeof kWords / sizeof kWords[0]; ++i)
+		if (strstr(phrase, kWords[i].key)) {
+			snprintf(out, capacity, "%s", kWords[i].word);
+			return;
+		}
+	/* Otherwise the phrase's first word. */
+	size_t n = strcspn(phrase, " ");
+	snprintf(out, capacity, "%.*s", (int)n, phrase);
+	if (out[0])
+		out[0] = (char)toupper((unsigned char)out[0]);
+}
