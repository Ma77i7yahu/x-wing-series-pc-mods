+/* XvT's mixed-case flight font (MICRO64.FNT, copied into RESOURCE xvt_cockpit at packaging time) for the
+ * XvT cockpits' CMD text. */
+static XwHudImage g_xvtFont;
+static AeronRuntimeAtlas g_xvtFontAtlas;
+static bool g_xvtFontTried, g_xvtFontReady;
+
+static bool LoadXvtFont(void) {
+	if (g_xvtFontTried)
+		return g_xvtFontReady;
+	g_xvtFontTried = true;
+	uint8_t* bytes = NULL;
+	size_t size = 0;
+	if (!AeronVfs_ReadAll(Aeron_GetVfs(), AERON_VFS_ROOT_RESOURCE, "xvt_cockpit/MICRO64.FNT", 1 << 16, &bytes,
+						  &size)) {
+		Aeron_LogWarn("xw.hud", "XvT's MICRO64.FNT is missing; the CMD uses X-Wing's font");
+		return false;
+	}
+	AeronDecodedFont* f = &g_xvtFont.font;
+	AeronDecodeError error = { 0 };
+	bool ok = AeronBitmapFont_Decode(bytes, size, 4, 32, f, &error);
+	free(bytes);
+	uint8_t* rgba = ok ? malloc((size_t)f->width * f->height * 4) : NULL;
+	if (rgba) {
+		/* Premultiplied white; Text() tints it. */
+		for (size_t i = 0; i < (size_t)f->width * f->height; ++i)
+			memset(rgba + i * 4, f->foreground[i], 4);
+		AeronRuntimeAtlasFrame frame = { .rgba = rgba, .width = f->width, .height = f->height };
+		const AeronRuntimeAtlasOptions options = { .format = AERON_TEXTURE_FORMAT_RGBA8_SRGB,
+												   .color_space = AERON_COLOR_SPACE_SRGB,
+												   .alpha_mode = AERON_IMAGE_ALPHA_PREMULTIPLIED,
+												   .debug_name = "xw.xvt_cmd_font" };
+		AeronCommandBuffer* cmd = Aeron_AcquireCommandBuffer();
+		if (cmd && Aeron_RuntimeAtlasBuild(&g_xvtFontAtlas, cmd, &frame, 1, &options))
+			g_xvtFontReady = Aeron_SubmitCommandBuffer(cmd);
+		else if (cmd)
+			Aeron_CancelCommandBuffer(cmd);
+		free(rgba);
+	}
+	if (!g_xvtFontReady) {
+		Aeron_RuntimeAtlasRelease(&g_xvtFontAtlas);
+		AeronDecodedFont_Free(f);
+	}
+	g_xvtFont.atlas_frame = 0;
+	return g_xvtFontReady;
+}
+
+/* Colors measured from XvT's CMD. */
+enum {
+	XVT_LABEL = 0x2470C4,
+	XVT_VALUE = 0x44A0DC,
+	XVT_GREEN = 0x20AC30,
+	XVT_RED = 0xC03830,
+	XVT_YELLOW = 0xC0A030,
+	XVT_WHITE = 0xC4C4D4
+};
+
+static uint32_t XvtRelationColor(uint8_t relation) {
+	return relation == 0 ? XVT_GREEN : relation == 1 ? XVT_RED : relation == 3 ? XVT_WHITE : XVT_VALUE;
+}
+
+static void XvtStat(const Pen* p, float x, float y, const char* label, int pct) {
+	Text(p, x, y, label, XVT_LABEL, 60);
+	char value[8];
+	if (pct < 0)
+		snprintf(value, sizeof value, "--");
+	else
+		snprintf(value, sizeof value, "%3d%%", pct);
+	Text(p, x + Measure(p, label) + Measure(p, " "), y, value, pct == 0 ? XVT_RED : XVT_VALUE, 40);
+}
+
+/* XvT's CMD around its 3D view: the name, then SHD/HULL/SYS in three columns, above the view; below it, orders
+ * on the left with their target on the right (cargo and the targeted part, always the hull in X-Wing, for
+ * starships and freighters), then the range. */
+static void DrawXvtCmd(const XwHudDraw* d, const Pen* pen, const XwSnapReadout* r, const XwSnapRect* box,
+					   const XwSnapRect* view) {
+	float left = view->x, width = view->width + 2, right = left + width;
+	XwSnapRect row = { view->x, 0, width, 0 };
+	float name_y = fmaxf(box->y + 1, view->y - 27), stats_y = name_y + 13;
+	float orders_y = view->y + view->height + 2, dist_y = orders_y + 13;
+	Centered(pen, &row, name_y, r->target_name, XvtRelationColor(r->target_relation));
+	float scale = view->width / 160.0f;
+	XvtStat(pen, left + 4 * scale, stats_y, "SHD", r->target_shield_pct);
+	XvtStat(pen, left + 58 * scale, stats_y, "HULL", r->target_hull_pct);
+	XvtStat(pen, left + 114 * scale, stats_y, "SYS", r->target_system_pct);
+
+	const char *what = r->target_order_word, *detail = r->target_order_target;
+	uint32_t detail_rgb = XvtRelationColor(r->order_target_relation);
+	if (r->capital) {
+		if (r->cargo_valid)
+			what = r->target_cargo;
+		detail = "Hull";
+		detail_rgb = XVT_YELLOW;
+	}
+	Text(pen, left, orders_y, what, XVT_LABEL, width);
+	float avail = width - Measure(pen, what) - 6;
+	if (detail[0] && avail > 0)
+		Text(pen, right - fminf(Measure(pen, detail), avail), orders_y, detail, detail_rgb, avail);
+
+	char dist[16];
+	snprintf(dist, sizeof dist, "%u.%02u", r->target_distance_hundredths / 100, r->target_distance_hundredths % 100);
+	float label_w = Measure(pen, "DIST  "), x = left + (width - label_w - Measure(pen, dist)) / 2;
+	Text(pen, x, dist_y, "DIST", XVT_LABEL, label_w);
+	Text(pen, x + label_w, dist_y, dist, XVT_VALUE, width);
+
+	TargetModel(d, pen, view, view->y, view->y + view->height, false);
+}
