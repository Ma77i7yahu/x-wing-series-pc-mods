+/* XvT's E (OpenXvT flight.c FLIGHT_KEY_E): from the slot after the current target, wrapping, the first craft
+ * flying normally (object kind 0: not destroyed, leaving or still arriving from hyperspace) with working
+ * systems whose AI is attacking the player (maneuver 12 or 23, the same numbers in X-Wing). XvT checks no IFF.
+ * None: the target stays. */
 static uint16_t user_nextattacker(void) {
-	uint16_t current = g_playerFlightState.currentTargetObjectIdx;
-	if (!user_isplayerattacker(current))
+	if (XwFlightTypes_Dos())
 		return (uint16_t)user_findclosestattacker();
-	for (uint16_t step = 1; step < XW_CRAFT_OBJECT_COUNT; ++step) {
-		uint16_t index = (uint16_t)((current + step) % XW_CRAFT_OBJECT_COUNT);
-		if (user_isplayerattacker(index))
-			return index;
+	uint16_t candidate = g_playerFlightState.currentTargetObjectIdx;
+	for (uint16_t remaining = XW_CRAFT_OBJECT_COUNT; remaining != 0; --remaining) {
+		if (++candidate >= XW_CRAFT_OBJECT_COUNT)
+			candidate = 0;
+		const ObjectRecord* object = &g_objectTable[candidate];
+		if (object->objectType == XW_OBJ_NONE || candidate == g_playerFlightState.objectIndex ||
+			object->genusId == XW_GENUS_EXPLOSION_EFFECT || object->familyId != XW_OBJECT_FAMILY_CRAFT)
+			continue;
+		const CraftData* craft = object->instanceData;
+		if (!craft || craft->workingSubsystems == 0 || craft->objectKind != XW_CRAFT_OBJECT_KIND_0)
+			continue;
+		if (craft->aiTargetRef == g_playerFlightState.objectIndex &&
+			(craft->aiManeuverId == PAIORDER_MANEUVER_ATTACK || craft->aiManeuverId == PAIORDER_MANEUVER_ATTACK_ALTERNATE))
+			return candidate;
 	}
-	return current;
+	return XW_PLAYER_NO_TARGET;
 }
 
