+#ifdef XW_MODERN
+/* XvT ModelMesh_HasFuselage / MeshComponentType: fuselage 3, wings 2 and 20. */
+enum { COLLIDE_XVT_MESH_WING = 2, COLLIDE_XVT_MESH_FUSELAGE = 3, COLLIDE_XVT_MESH_WING_20 = 20 };
+
+/* game.xvt_breakup: XvT collide_damagecraft's destruction of a craft no player flies (0x41FC50 tail). */
+static int16_t collide_xvtbreakup(uint16_t victimObjIdx, uint16_t sourceObjectType, int16_t playGenericImpactSound) {
+	ObjectRecord* victim = &g_objectTable[victimObjIdx];
+	uint16_t victimObjectType = victim->objectType;
+	int meshCount = XwFlightTypes_ComponentCount(victimObjectType);
+	uint16_t maxTumbleAngle = g_craftTypeDefs[g_curCraft->craftTypeIndex].maxTumbleAngle;
+	bool fuselage = false;
+	for (int mesh = 0; mesh < meshCount; ++mesh)
+		if (ModelMesh_GetCachedObjectTypeMeshType(victimObjectType, mesh) == COLLIDE_XVT_MESH_FUSELAGE)
+			fuselage = true;
+	if (!fuselage) {
+		/* XvT also takes the flight group's craft explosion time when set; X-Wing missions have none. */
+		uint16_t rollRate = (math2_getrandom() & COLLIDE_TUMBLE_RANDOM_MASK) + COLLIDE_TUMBLE_MIN;
+		while (rollRate > maxTumbleAngle)
+			rollRate >>= 1;
+		if ((uint16_t)math2_getrandom() < COLLIDE_ANGLE_SIGN_BIT)
+			rollRate = (uint16_t)-(int16_t)rollRate;
+		victim->rollImpulseRate = (int16_t)rollRate;
+		victim->lifetimeTicks = XW_SIMULATION_TICKS_PER_SECOND *
+								((math2_getrandom() & COLLIDE_LARGE_LIFETIME_RANDOM_MASK) + COLLIDE_LARGE_LIFETIME_MIN);
+		g_curCraft->objectKind = XW_CRAFT_OBJECT_KIND_3;
+		return playGenericImpactSound;
+	}
+	if ((uint16_t)g_modelTypeTable[sourceObjectType].maxBoundsExtent > COLLIDE_CRAFT_LARGE_EXTENT ||
+		victim->speed == 0) {
+		victim->lifetimeTicks = 1;
+		fsfx_triggersfx(COLLIDE_CRAFT_EXPLOSION_SOUND, victimObjIdx);
+		g_curCraft->objectKind = XW_CRAFT_OBJECT_KIND_4;
+		return 0;
+	}
+	/* XvT only blows player craft up at once; every AI craft breaks up. A wing on a random side comes off. */
+	uint16_t detachedYawOffset = 0;
+	int16_t detachedRollRate = 0;
+	int side = 0;
+	if (meshCount > 1) {
+		int mesh;
+		side = math2_getrandom() & 1;
+		for (mesh = 0; mesh < meshCount; ++mesh) {
+			int type = ModelMesh_GetCachedObjectTypeMeshType(victimObjectType, mesh);
+			if (g_curCraft->componentState[mesh] == 0 &&
+				(type == COLLIDE_XVT_MESH_WING || type == COLLIDE_XVT_MESH_WING_20)) {
+				int centerX = ModelMesh_GetCenterX(victimObjectType, mesh);
+				if (side ? centerX < 0 : centerX > 0)
+					break;
+			}
+		}
+		if (mesh < meshCount) {
+			uint16_t componentObject = create_createcomponent(victimObjIdx, (char)mesh);
+			if (componentObject != XW_OBJECT_SLOT_UNAVAILABLE) {
+				int16_t wingYawOffset;
+				detachedRollRate = (int16_t)((math2_getrandom() & CREATE_DETACH_ROLL_MASK) + CREATE_DETACH_MIN_ROLL);
+				wingYawOffset = (int16_t)((math2_getrandom() & CREATE_DETACH_YAW_MASK) + COLLIDE_COMPONENT_YAW_MIN);
+				detachedYawOffset = (uint16_t)wingYawOffset;
+				if (side) {
+					wingYawOffset = (int16_t)-wingYawOffset;
+					detachedRollRate = (int16_t)-detachedRollRate;
+				}
+				g_objectTable[componentObject].rollImpulseRate = detachedRollRate;
+				g_objectTable[componentObject].yaw += wingYawOffset;
+				g_objectTable[componentObject].orientMatrixDirty = 1;
+				g_objectTable[componentObject].moveVectorDirty = 1;
+				g_objectTable[componentObject].secondaryAnimationState = XW_OBJECT_ANIMATION_BREAKUP;
+				g_curCraft->componentState[mesh] = CREATE_DETACH_STATE;
+				fsfx_triggersfx(COLLIDE_COMPONENT_DETACH_SOUND, victimObjIdx);
+				playGenericImpactSound = 0;
+			}
+		}
+	}
+	{
+		uint16_t rollRate = (math2_getrandom() & COLLIDE_TUMBLE_RANDOM_MASK) + COLLIDE_TUMBLE_MIN;
+		while (rollRate > maxTumbleAngle)
+			rollRate >>= 1;
+		if ((uint16_t)detachedRollRate < COLLIDE_ANGLE_SIGN_BIT)
+			rollRate = (uint16_t)-(int16_t)rollRate;
+		victim->rollImpulseRate = (int16_t)rollRate;
+	}
+	/* The wreck recoils half the wing's deflection, away from it. */
+	if (detachedYawOffset != 0) {
+		int16_t recoil = (int16_t)(detachedYawOffset >> 1);
+		victim->yaw += side ? recoil : (int16_t)-recoil;
+		victim->orientMatrixDirty = 1;
+		victim->moveVectorDirty = 1;
+	}
+	g_curCraft->objectKind = XW_CRAFT_OBJECT_KIND_3;
+	victim->lifetimeTicks =
+		XW_SIMULATION_TICKS_PER_SECOND * ((math2_getrandom() & 3) + (math2_getrandom() & 7) + 1);
+	g_curCraft->componentState[meshCount] = CREATE_DETACH_STATE;
+	return playGenericImpactSound;
+}
+#endif
