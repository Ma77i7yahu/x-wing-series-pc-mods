+/* Fires one player cannon group if its cooldown allows; forceLinked fires every cannon in it. */
+static void laser_fireplayergroup(uint16_t group, int forceLinked) {
+	int16_t* cooldown = &g_playerFlightState.craft->laserState.fireCooldownTicks[group];
+	int16_t adjustedCooldown = *cooldown;
+	if (adjustedCooldown != 0) {
+		adjustedCooldown -= g_elapsedTicks;
+		if (adjustedCooldown < 0)
+			adjustedCooldown = 0;
+	}
+	if (adjustedCooldown < (int16_t)g_elapsedTicks) {
+		if (adjustedCooldown != 0)
+			*cooldown -= g_elapsedTicks;
+		else
+			*cooldown = 0;
+		if ((g_playerFlightState.craft->workingSubsystems & LASER_CANNON_SUBSYSTEM_MASK) != 0) {
+			uint8_t savedLinkMode = g_playerFlightState.craft->laserState.linkMode[group];
+			if (forceLinked)
+				g_playerFlightState.craft->laserState.linkMode[group] = LASER_LINK_ALL;
+			laser_firelasersystem(g_playerFlightState.objectIndex, group);
+			g_playerFlightState.craft->laserState.linkMode[group] = savedLinkMode;
+			g_playerFlightState.craft->laserState.fireCooldownTicks[group] += g_elapsedTicks;
+		} else {
+			g_msgArgTable[0] = group + XW_MSG_SUBSYSTEM_LASER;
+			g_msgArgTable[1] = XW_MSG_SUBSYSTEM_DAMAGED_AND_INOPERATIVE;
