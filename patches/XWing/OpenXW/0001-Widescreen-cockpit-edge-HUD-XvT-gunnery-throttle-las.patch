@@ -0,0 +1,44 @@
+#include "xw_runtime/config/flight_tweaks.h"
+
+static bool s_cockpit_stretch = true;
+static bool s_widescreen_hud = true;
+static int s_laser_convergence_m = 550;
+static bool s_xvt_lasers = true;
+static int s_ai_ion_link = XW_AI_ION_LINK_ALL;
+static bool s_xvt_throttle = true;
+
+enum { CANNON_PROJECTILE_TYPES = 6 };
+
+bool XwFlightTweaks_CockpitStretch(void) { return s_cockpit_stretch; }
+
+void XwFlightTweaks_SetCockpitStretch(bool enabled) { s_cockpit_stretch = enabled; }
+
+bool XwFlightTweaks_WidescreenHud(void) { return s_widescreen_hud; }
+
+void XwFlightTweaks_SetWidescreenHud(bool enabled) { s_widescreen_hud = enabled; }
+
+int XwFlightTweaks_LaserConvergenceMetres(void) { return s_laser_convergence_m; }
+
+void XwFlightTweaks_SetLaserConvergenceMetres(int metres) { s_laser_convergence_m = metres > 0 ? metres : 0; }
+
+bool XwFlightTweaks_XvtLasers(void) { return s_xvt_lasers; }
+
+void XwFlightTweaks_SetXvtLasers(bool enabled) { s_xvt_lasers = enabled; }
+
+int XwFlightTweaks_AiIonLink(void) { return s_ai_ion_link; }
+
+void XwFlightTweaks_SetAiIonLink(int mode) {
+	s_ai_ion_link = mode < XW_AI_ION_LINK_OFF || mode > XW_AI_ION_LINK_ALL ? XW_AI_ION_LINK_OFF : mode;
+}
+
+bool XwFlightTweaks_XvtThrottle(void) { return s_xvt_throttle; }
+
+void XwFlightTweaks_SetXvtThrottle(bool enabled) { s_xvt_throttle = enabled; }
+
+int16_t XwFlightTweaks_ProjectileSpeed(int index, int16_t base) {
+	return s_xvt_lasers && index >= 0 && index < CANNON_PROJECTILE_TYPES ? (int16_t)(2 * base) : base;
+}
+
+int16_t XwFlightTweaks_ProjectileLifetimeTicks(int index, int16_t baseTicks) {
+	return s_xvt_lasers && index >= 0 && index < CANNON_PROJECTILE_TYPES ? (int16_t)(baseTicks / 2) : baseTicks;
+}
diff --git a/src/xw_runtime/config/flight_tweaks.h b/src/xw_runtime/config/flight_tweaks.h
new file mode 100644
index 0000000..5b5c641
--- /dev/null
+++ b/src/xw_runtime/config/flight_tweaks.h
@@ -0,0 +1,50 @@
+#ifndef XW_RUNTIME_CONFIG_FLIGHT_TWEAKS_H
+#define XW_RUNTIME_CONFIG_FLIGHT_TWEAKS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Widescreen and gameplay options ported from the OpenTIE/OpenXvT builds.
+ *
+ * cockpit_stretch (render.cockpit_stretch): the 4:3 cockpit art spans the whole
+ * widescreen view instead of sitting in a centered 4:3 region.
+ * widescreen_hud (render.hud_widescreen): with the cockpit hidden, the side
+ * instruments move out toward the screen edges.
+ * laser_convergence_m (game.laser_convergence_metres): fallback convergence
+ * distance when the target is off the nose or out of range (see
+ * XwFlightMath_ConvergeLaser).
+ * xvt_lasers (game.xvt_lasers): cannons cycle and fly as in X-Wing vs TIE
+ * Fighter: 47 instead of 78 cooldown ticks per shot, bolts at twice the speed
+ * for half the lifetime (same range). Applies to every craft.
+ * ai_ion_link (game.ai_ion_link): AI craft with lasers and ion cannons fire both
+ * together, X-Wing Alliance style. Disable orders keep ions only.
+ * xvt_throttle (game.xvt_throttle): craft accelerate and brake as in XvT.
+ * Applies to every craft. */
+enum { XW_AI_ION_LINK_OFF = 0, XW_AI_ION_LINK_FRIENDLY = 1, XW_AI_ION_LINK_ALL = 2 };
+
+bool XwFlightTweaks_CockpitStretch(void);
+void XwFlightTweaks_SetCockpitStretch(bool enabled);
+bool XwFlightTweaks_WidescreenHud(void);
+void XwFlightTweaks_SetWidescreenHud(bool enabled);
+int XwFlightTweaks_LaserConvergenceMetres(void);
+void XwFlightTweaks_SetLaserConvergenceMetres(int metres);
+bool XwFlightTweaks_XvtLasers(void);
+void XwFlightTweaks_SetXvtLasers(bool enabled);
+int XwFlightTweaks_AiIonLink(void);
+void XwFlightTweaks_SetAiIonLink(int mode);
+bool XwFlightTweaks_XvtThrottle(void);
+void XwFlightTweaks_SetXvtThrottle(bool enabled);
+
+/* Cannon bolt speed and lifetime for projectile property index `index` (0-5 are
+ * laser and ion cannons), with xvt_lasers applied. */
+int16_t XwFlightTweaks_ProjectileSpeed(int index, int16_t base);
+int16_t XwFlightTweaks_ProjectileLifetimeTicks(int index, int16_t baseTicks);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
