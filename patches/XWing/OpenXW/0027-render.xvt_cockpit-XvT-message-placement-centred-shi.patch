From 919882a41ea0e7fd2bd0e9a35bd16689df15769e Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sat, 10 Oct 2026 20:46:20 +1100
Subject: [PATCH 27/59] render.xvt_cockpit: XvT message placement (centred;
 ship status above the cockpit, mission traffic at the top)

---
 src/xw/flight/hud/msg.c                | 31 ++++++++++++++++++++++++++
 src/xw_remaster/hud_renderer.c         |  9 ++++++++
 src/xw_remaster/xvt_cockpit.c          |  9 +++++---
 src/xw_runtime/snapshot/render_hud.c   |  8 +++++++
 src/xw_runtime/snapshot/render_hud.h   |  2 ++
 src/xw_runtime/snapshot/render_types.h |  1 +
 6 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/src/xw/flight/hud/msg.c b/src/xw/flight/hud/msg.c
index aad6709..31757ef 100644
--- a/src/xw/flight/hud/msg.c
+++ b/src/xw/flight/hud/msg.c
@@ -416,10 +416,41 @@ void msg_getmessagefromqueue(void) {
 	--g_readyMessageQueueCount;
 }
 
+#ifdef XW_MODERN
+/* XvT puts mission traffic (sensor contacts, craft events, wingmen, mission state) at the top of the screen and
+ * ship status above the cockpit. */
+static bool MessageIsTraffic(XwFlightMessageId id) {
+	switch (id) {
+		case XW_MSG_SENSORS_NEW_CRAFT_SINGULAR:
+		case XW_MSG_SENSORS_NEW_CRAFT_PLURAL:
+		case XW_MSG_PROVING_GROUNDS_LEVEL_COMPLETED:
+		case XW_MSG_BONUS_POINTS_AWARDED:
+		case XW_MSG_MISSION_TWO_MINUTES_REMAINING:
+		case XW_MSG_MISSION_ONE_MINUTE_REMAINING:
+		case XW_MSG_MISSION_TIME_EXPIRED_HYPERSPACE:
+		case XW_MSG_MISSION_OBJECTIVES_FAILED_RETURN_TO_BASE:
+		case XW_MSG_CRAFT_EVENT_NUMBERED:
+		case XW_MSG_CRAFT_EVENT_UNNUMBERED:
+		case XW_MSG_RADIO_ACKNOWLEDGED_NUMBERED:
+		case XW_MSG_RADIO_ACKNOWLEDGED_UNNUMBERED:
+		case XW_MSG_CRAFT_REPORT_NUMBERED:
+		case XW_MSG_CRAFT_REPORT_UNNUMBERED:
+		case XW_MSG_MISSION_COMPLETE:
+		case XW_MSG_MISSION_COMPLETION_TEXT:
+		case XW_MSG_PREVIOUS_LEVEL_POINTS_AWARDED:
+		case XW_MSG_EXHAUST_PORT_DIRECT_HIT:
+			return true;
+		default:
+			return false;
+	}
+}
+#endif
+
 // FUNCTION: XW 0x412130
 void msg_messagedisplay(void) {
 #ifdef XW_MODERN
 	int hud_pane = XwHud_Push(XW_SNAP_PANE_READY_MESSAGE);
+	XwHud_MessageTop(MessageIsTraffic(g_readyMessagePaneQueue[0].stateOrMessageId));
 #endif
 
 	uint16_t index;
diff --git a/src/xw_remaster/hud_renderer.c b/src/xw_remaster/hud_renderer.c
index 52d0a2c..3dbbc28 100644
--- a/src/xw_remaster/hud_renderer.c
+++ b/src/xw_remaster/hud_renderer.c
@@ -67,6 +67,15 @@ static void PanePlaces(const XwHudDraw* draw, PanePlace places[XW_SNAP_HUD_PANES
 		}
 		places[p].hidden =
 			!XwXvtCockpit_Pane(draw, p, x, y, &places[p].dx, &places[p].dy, &places[p].plain);
+		/* Messages are centred, as XvT's are. */
+		if (p == XW_SNAP_PANE_READY_MESSAGE && x != INT32_MAX) {
+			int x1 = x;
+			for (unsigned i = 0; i < pane->glyphs.count; ++i) {
+				const XwSnapGlyph* g = &c->glyphs[pane->glyphs.first + i];
+				x1 = g->x + g->advance > x1 ? g->x + g->advance : x1;
+			}
+			places[p].dx += (c->screen_width - (x1 - x)) / 2 - x;
+		}
 	}
 }
 
diff --git a/src/xw_remaster/xvt_cockpit.c b/src/xw_remaster/xvt_cockpit.c
index f15d0c8..4414cde 100644
--- a/src/xw_remaster/xvt_cockpit.c
+++ b/src/xw_remaster/xvt_cockpit.c
@@ -30,8 +30,11 @@ enum {
 	HUD_BASE = 144, /* XvT's cockpit-off HUD element set. */
 	VIEW_NONE = 18,
 	VIEW_HUD = 19,
-	MESSAGE_Y = 100,    /* Messages move from the 1998 bottom strip to just under the radars. */
-	MESSAGE_STRIP_Y = 456,
+	/* Messages leave the 1998 bottom strip as XvT's do (both centred): ship status just above the cockpit,
+	 * mission traffic at the top between the radars. */
+	MESSAGE_STATUS_Y = 208,
+	MESSAGE_TRAFFIC_Y = 4,
+	MESSAGE_STRIP_Y = 457,
 	ART_CACHE = 24
 };
 
@@ -588,7 +591,7 @@ bool XwXvtCockpit_Pane(const XwHudDraw* d, unsigned pane, int x, int y, int* dx,
 	ComputeOffsets(def);
 	switch (pane) {
 		case XW_SNAP_PANE_READY_MESSAGE:
-			*dy = MESSAGE_Y - MESSAGE_STRIP_Y;
+			*dy = (d->snapshot->cockpit.message_top ? MESSAGE_TRAFFIC_Y : MESSAGE_STATUS_Y) - MESSAGE_STRIP_Y;
 			*plain = true;
 			return true;
 		/* The CMD shows speed and throttle as XvT's does. */
diff --git a/src/xw_runtime/snapshot/render_hud.c b/src/xw_runtime/snapshot/render_hud.c
index 30af66c..21808e9 100644
--- a/src/xw_runtime/snapshot/render_hud.c
+++ b/src/xw_runtime/snapshot/render_hud.c
@@ -160,6 +160,14 @@ void XwHud_ViewSelection(unsigned view) {
 	}
 }
 
+void XwHud_MessageTop(bool top) {
+	XwHudState* s = XwHud_Working();
+	if (s && s->cockpit.message_top != top) {
+		s->cockpit.message_top = top;
+		XwHud_Changed(s);
+	}
+}
+
 void XwHud_Widget(unsigned element, unsigned value, unsigned segments, int step_x, int step_y, unsigned empty,
 				  unsigned filled, unsigned kind) {
 	XwHudState* s = XwHud_Working();
diff --git a/src/xw_runtime/snapshot/render_hud.h b/src/xw_runtime/snapshot/render_hud.h
index 973757a..6f9c8cf 100644
--- a/src/xw_runtime/snapshot/render_hud.h
+++ b/src/xw_runtime/snapshot/render_hud.h
@@ -14,6 +14,8 @@ void XwHud_ViewSelection(unsigned view);
 void XwHud_View(unsigned view, const char* base, XwSnapRect aperture, bool mirrored);
 void XwHud_Widget(unsigned element, unsigned value, unsigned segments, int step_x, int step_y, unsigned empty,
 				  unsigned filled, unsigned kind);
+/* The message being drawn is mission traffic (true) or ship status (false). */
+void XwHud_MessageTop(bool top);
 void XwHud_Glyph(unsigned character, unsigned width, unsigned height);
 void XwHud_Fill(int x0, int y0, int x1, int y1);
 void XwHud_Sprite(const uint8_t* source, int x, int y, int transparent, int mirror);
diff --git a/src/xw_runtime/snapshot/render_types.h b/src/xw_runtime/snapshot/render_types.h
index c726e5a..38e8c39 100644
--- a/src/xw_runtime/snapshot/render_types.h
+++ b/src/xw_runtime/snapshot/render_types.h
@@ -283,6 +283,7 @@ typedef struct XwSnapCockpit {
 	XwSnapRect viewport;
 	int32_t projection_offset_y;
 	uint8_t mirrored, suppressed, color_mode;
+	uint8_t message_top; /* The message pane holds mission traffic rather than ship status. */
 	uint32_t palette_argb[256]; /* HUD palette at composition, including RGB text conversion. */
 	XwSnapWidget widgets[XW_SNAP_WIDGETS];
 	XwSnapRadar radar;
