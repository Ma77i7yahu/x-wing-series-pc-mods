 void XwReadout_Capture(XwSnapReadout* r) {
 	memset(r, 0, sizeof *r);
 	r->boarding_remaining_s = -1;
 	if (!g_playerFlightState.craft || !g_playerFlightState.object || g_replayviewmode)
 		return;
 	CaptureThreats(r);
+	CaptureCraftList(&r->craft_list);
 	const XwFlightPanelLayout* layout = XwFlightPanel_Layout();
