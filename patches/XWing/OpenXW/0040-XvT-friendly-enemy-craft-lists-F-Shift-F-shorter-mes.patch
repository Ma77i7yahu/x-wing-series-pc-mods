+/* ---- XvT's F / Shift+F craft lists (Mfd_DrawCraftListPage) ---- */
+
+static bool ListedCraft(uint16_t index) {
+	if (!LiveObject(index) || g_objectTable[index].familyId != XW_OBJECT_FAMILY_CRAFT)
+		return false;
+	const CraftData* craft = g_objectTable[index].instanceData;
+	/* Exploding and breaking-up craft drop out, as from the targeting keys. */
+	return craft && (craft->objectKind == XW_CRAFT_OBJECT_KIND_0 || craft->objectKind == XW_CRAFT_OBJECT_KIND_6);
+}
+
+/* Mfd_BuildScratchCraftListName: the flight group's name and craft number, cut to 9 characters. */
+static void ListName(uint16_t index, char* out, size_t capacity) {
+	const CraftData* craft = g_objectTable[index].instanceData;
+	const XwMissionFlightGroup* group = &g_missionFlightGroups[craft->flightGroupIndex];
+	char name[sizeof group->name + 1] = { 0 };
+	memcpy(name, group->name, sizeof group->name);
+	char text[32];
+	if (group->numberOfCraft > 1)
+		snprintf(text, sizeof text, "%s %d", name, craft->craftIndexInFlightGroup + 1);
+	else
+		snprintf(text, sizeof text, "%s", name);
+	CopyText(out, capacity < 10 ? capacity : 10, text);
+	TitleCase(out);
+}
+
+/* Mfd_GetFlightGroupGoalStatusStringId for X-Wing's single flight-group goal, while it is still to do. */
+static const char* GoalWord(uint16_t index) {
+	const CraftData* craft = g_objectTable[index].instanceData;
+	unsigned fg = craft->flightGroupIndex;
+	if (g_missionRuntimeState.flightGroupGoalState[fg] != XW_MISSION_GOAL_STATE_UNCOMPLETED)
+		return "";
+	const XwMissionFlightGroup* group = &g_missionFlightGroups[fg];
+	switch (group->missionGoal) {
+		case MISSION_GOAL_DESTROY_SPECIAL:
+		case MISSION_GOAL_RECOVER_SPECIAL:
+		case MISSION_GOAL_BOARD_SPECIAL:
+		case MISSION_GOAL_IDENTIFY_SPECIAL:
+			if (craft->craftIndexInFlightGroup != group->specialCraftIndex)
+				return "";
+			break;
+		default:
+			break;
+	}
+	switch (group->missionGoal) {
+		case MISSION_GOAL_IDENTIFY_ALL:
+		case MISSION_GOAL_IDENTIFY_SPECIAL:
+		case MISSION_GOAL_IDENTIFY_HALF:
+			return craft->isInspected ? "" : "Inspect";
+		case MISSION_GOAL_RECOVER_ALL:
+		case MISSION_GOAL_RECOVER_SPECIAL:
+		case MISSION_GOAL_RECOVER_HALF:
+			return "Capture";
+		case MISSION_GOAL_BOARD_ALL:
+		case MISSION_GOAL_BOARD_SPECIAL:
+		case MISSION_GOAL_BOARD_HALF:
+			return "Board";
+		case MISSION_GOAL_DESTROY_ALL:
+		case MISSION_GOAL_DESTROY_SPECIAL:
+		case MISSION_GOAL_DESTROY_HALF:
+			return "Destroy";
+		default:
+			return "";
+	}
+}
+
+static void CaptureCraftList(XwSnapCraftList* list) {
+	int mode = user_craftlistmode();
+	if (mode == USER_CRAFT_LIST_CLOSED)
+		return;
+	/* The lists go with the targeting computer, as in XvT. */
+	if (!(g_playerFlightState.craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_TARGETING)) {
+		user_closecraftlist();
+		return;
+	}
+	uint16_t rows[XW_CRAFT_OBJECT_COUNT];
+	unsigned count = 0;
+	if (mode == USER_CRAFT_LIST_ENEMY) {
+		for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index)
+			if (ListedCraft(index) && Relation(index) == 1)
+				rows[count++] = index;
+	} else {
+		/* The player's own flight group first, then the other friendly ones in mission order. */
+		unsigned own = g_playerFlightState.craft->flightGroupIndex;
+		for (int pass = 0; pass <= (int)g_missionHeader.flightGroupCount; ++pass) {
+			unsigned fg = pass == 0 ? own : (unsigned)pass - 1;
+			if (pass && fg == own)
+				continue;
+			for (uint16_t index = 0; index < XW_CRAFT_OBJECT_COUNT; ++index)
+				if (ListedCraft(index) && Relation(index) != 1 &&
+					((const CraftData*)g_objectTable[index].instanceData)->flightGroupIndex == fg)
+					rows[count++] = index;
+		}
+	}
+	/* XvT groups rows by team, keeping their order within each. */
+	for (unsigned i = 1; i < count; ++i)
+		for (unsigned j = i; j > 0 && Relation(rows[j]) < Relation(rows[j - 1]); --j) {
+			uint16_t t = rows[j];
+			rows[j] = rows[j - 1];
+			rows[j - 1] = t;
+		}
+	user_clampcraftlist(count, XW_SNAP_CRAFT_LIST_ROWS);
+	list->mode = (uint8_t)mode;
+	list->total = (uint16_t)count;
+	list->top = (uint16_t)user_craftlisttop();
+	for (unsigned i = list->top; i < count && list->count < XW_SNAP_CRAFT_LIST_ROWS; ++i) {
+		uint16_t index = rows[i];
+		const CraftData* craft = g_objectTable[index].instanceData;
+		XwSnapCraftListRow* row = &list->rows[list->count++];
+		ListName(index, row->name, sizeof row->name);
+		row->relation = Relation(index);
+		int shield = ShieldPercent(craft), hull = HullPercent(craft);
+		row->shield_pct = (int8_t)(shield > 127 ? 127 : shield);
+		row->hull_pct = (int8_t)(hull > 127 ? 127 : hull);
+		uint16_t target = index == g_playerFlightState.objectIndex ? g_playerFlightState.currentTargetObjectIdx
+																	: craft->aiTargetRef;
+		if (target < XW_OBJECT_COUNT && LiveObject(target)) {
+			if (ListedCraft(target))
+				ListName(target, row->target, sizeof row->target);
+			else
+				ObjectName(target, row->target, sizeof row->target);
+			row->target_relation = Relation(target);
+		} else {
+			strcpy(row->target, "None");
+			row->target_relation = 2;
+		}
+		if (mode == USER_CRAFT_LIST_ENEMY)
+			snprintf(row->status, sizeof row->status, "%s", GoalWord(index));
+	}
+}
