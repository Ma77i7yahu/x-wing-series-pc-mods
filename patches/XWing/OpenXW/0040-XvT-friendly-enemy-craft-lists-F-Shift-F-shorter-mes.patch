+/* ---- XvT's F / Shift+F craft lists (Mfd_DrawCraftListPage) ----
+ * XvT's craft-list box (forward and cockpit-off element 130) is 225 x 94 at (415, 296) in every 640 cockpit.
+ * A header row (Craft, SHD/HULL, Target, and Orders on the enemy list), then a row per craft in its team's
+ * color with shields and hull colored by health; the box shrinks to its rows. In the cockpit the box is
+ * filled; with the cockpit off only its frame is drawn, as in XvT. */
+enum { LIST_X = 415, LIST_Y = 296, LIST_W = 225, LIST_H = 94, LIST_FILL = 0x141C28 };
+
+static uint32_t HealthColor(int pct) { return pct <= 20 ? XVT_RED : pct <= 50 ? XVT_YELLOW : XVT_GREEN; }
+
+/* Text ending at x. */
+static void RightText(const Pen* p, float right, float y, const char* text, uint32_t rgb) {
+	float w = Measure(p, text);
+	Text(p, right - w, y, text, rgb, w + 1);
+}
+
+bool XwHudCraftList_Draw(const XwHudDraw* d) {
+	const XwRenderSnapshot* s = d->snapshot;
+	const XwSnapCraftList* list = &s->readout.craft_list;
+	const XwSnapCamera* c = &s->camera;
+	if (!list->mode || c->replay_mode || s->cockpit.suppressed ||
+		(c->hud_state != 0 && c->hud_state != XW_SNAP_VIEW_FULL_FORWARD) || !LoadXvtFont())
+		return true;
+	Pen pen = XvtPen(d);
+	if (d->edge_shift > 0)
+		pen.ox += XwHudDraw_PaneShift(d, LIST_X, LIST_X + LIST_W);
+	bool enemy = list->mode == 2;
+	float step = FontHeight(&g_xvtFont) + 2, half = FontHeight(&g_xvtFont) / 2.0f;
+	float left = LIST_X + 2, top = LIST_Y + 2, right = LIST_X + LIST_W - 2;
+	float bottom = top + step * (list->count + 1);
+	if (bottom > LIST_Y + LIST_H - 2 || !list->count)
+		bottom = LIST_Y + LIST_H - 2;
+	/* The box (see-through with the cockpit off), then the active page's 1-pixel frame. */
+	float fx = left - 2, fy = top - 2, fw = right - left + 4, fh = bottom - top + 4;
+	Fill(&pen, fx, fy, fw, fh, LIST_FILL, c->hud_state == 0 ? 1 : 0.55f);
+	Fill(&pen, fx, fy, fw, 1, XVT_GREEN, 1);
+	Fill(&pen, fx, fy + fh - 1, fw, 1, XVT_GREEN, 1);
+	Fill(&pen, fx, fy, 1, fh, XVT_GREEN, 1);
+	Fill(&pen, fx + fw - 1, fy, 1, fh, XVT_GREEN, 1);
+
+	float health_x = left + 11 * half;
+	Text(&pen, left, top, "Craft", XVT_GREEN, health_x - left);
+	Text(&pen, health_x, top, "SHD/HULL", XVT_GREEN, right - health_x);
+	float target_x = health_x + Measure(&pen, "SHD/HULL") + half;
+	float orders_x = target_x + 17 * half;
+	if (enemy) {
+		Text(&pen, target_x, top, "Target", XVT_GREEN, orders_x - target_x);
+		Text(&pen, orders_x, top, "Orders", XVT_GREEN, right - orders_x);
+	} else
+		RightText(&pen, right, top, "Target", XVT_GREEN);
+
+	float digits = Measure(&pen, "000");
+	for (unsigned i = 0; i < list->count; ++i) {
+		const XwSnapCraftListRow* row = &list->rows[i];
+		float y = top + step * (i + 1);
+		if (y + step - 2 > bottom + 0.5f)
+			break;
+		uint32_t team = XvtRelationColor(row->relation);
+		Text(&pen, left, y, row->name, team, health_x - left);
+		char value[8];
+		float x = health_x + half;
+		snprintf(value, sizeof value, "%d", row->shield_pct > 0 ? row->shield_pct : 0);
+		RightText(&pen, x + digits, y, value, HealthColor(row->shield_pct));
+		x += digits;
+		Text(&pen, x, y, "/", team, 8);
+		x += Measure(&pen, "/");
+		if (row->hull_pct > 0) {
+			snprintf(value, sizeof value, "%d", row->hull_pct);
+			RightText(&pen, x + digits, y, value, HealthColor(row->hull_pct));
+		}
+		if (enemy) {
+			Text(&pen, target_x, y, row->target, team, orders_x - target_x - half);
+			Text(&pen, orders_x, y, row->status, team, right - orders_x);
+		} else {
+			float avail = right - (x + digits + half);
+			float w = fminf(Measure(&pen, row->target), avail);
+			Text(&pen, right - w, y, row->target, team, avail);
+		}
+	}
+	return true;
+}
