+/* XvT's D damage display. It and the craft lists share Up / Down: the one opened last has them, and the
+ * damage display gets them back when the lists close. Its state changes only from keys (live or from a
+ * film), so films replay the same repair order. */
+static int s_damageOpen;
+static int s_damageHasArrows;
+static int s_damageSelected = -1;
+
 int user_craftlistmode(void) { return s_craftListMode; }
 
 unsigned user_craftlisttop(void) { return s_craftListTop; }
@@ -94,6 +101,82 @@ static void user_togglecraftlist(int mode) {
 	}
 	s_craftListMode = s_craftListMode == mode ? USER_CRAFT_LIST_CLOSED : mode;
 	s_craftListTop = 0;
+	s_damageHasArrows = 0;
+}
+
+unsigned user_damagedsystems(uint8_t* systems) {
+	unsigned count = 0;
+	for (unsigned i = 0; i < XW_PLAYER_SUBSYSTEM_COUNT; ++i) {
+		uint8_t id = g_playerSubsystemRepairPriority[i];
+		if (id < XW_PLAYER_SUBSYSTEM_COUNT && g_playerFlightState.subsystemHealth[id] == 0)
+			systems[count++] = id;
+	}
+	return count;
+}
+
+int user_damagedisplayselected(void) {
+	uint8_t systems[XW_PLAYER_SUBSYSTEM_COUNT];
+	unsigned count = user_damagedsystems(systems);
+	for (unsigned i = 0; i < count; ++i)
+		if (systems[i] == s_damageSelected)
+			return s_damageSelected;
+	return count ? systems[0] : -1;
+}
+
+int user_damagedisplayopen(void) { return s_damageOpen; }
+
+int user_damagedisplayactive(void) {
+	return s_damageOpen && (s_damageHasArrows || s_craftListMode == USER_CRAFT_LIST_CLOSED);
+}
+
+void user_closedamagedisplay(void) {
+	s_damageOpen = 0;
+	s_damageHasArrows = 0;
+	s_damageSelected = -1;
+}
+
+static void user_toggledamagedisplay(void) {
+	uint8_t systems[XW_PLAYER_SUBSYSTEM_COUNT];
+	if (s_damageOpen)
+		user_closedamagedisplay();
+	else if (!user_damagedsystems(systems))
+		msg_messagetext(XW_MSG_SUBSYSTEM_STATUS, "\005All systems operational");
+	else {
+		s_damageOpen = 1;
+		s_damageHasArrows = 1;
+		s_damageSelected = systems[0];
+	}
+}
+
+/* Damage_FindAdjacentDamagedSystem: the next or previous damaged system in repair order, wrapping. */
+static void user_movedamageselection(int step) {
+	uint8_t systems[XW_PLAYER_SUBSYSTEM_COUNT];
+	unsigned count = user_damagedsystems(systems), at = 0;
+	int selected = user_damagedisplayselected();
+	if (!count)
+		return;
+	while (at < count && systems[at] != selected)
+		++at;
+	s_damageSelected = systems[(at + count + (step < 0 ? count - 1 : 1)) % count];
+}
+
+/* XvT's Enter on the damage display: the highlighted system goes to the head of the repair order. The
+ * saved order follows, since the map and briefing screens restore it on the way out. */
+static void user_repairselectedfirst(void) {
+	int selected = user_damagedisplayselected();
+	unsigned at = 0;
+	if (selected < 0)
+		return;
+	while (at < XW_PLAYER_SUBSYSTEM_COUNT && g_playerSubsystemRepairPriority[at] != selected)
+		++at;
+	if (at == XW_PLAYER_SUBSYSTEM_COUNT)
+		return;
+	for (; at > 0; --at)
+		g_playerSubsystemRepairPriority[at] = g_playerSubsystemRepairPriority[at - 1];
+	g_playerSubsystemRepairPriority[0] = (uint8_t)selected;
+	s_damageSelected = selected;
+	memcpy(g_playerFlightState.savedSubsystemRepairPriority, g_playerSubsystemRepairPriority,
+		   sizeof(g_playerFlightState.savedSubsystemRepairPriority));
 }
 
