 }
 
+/* ---- XvT's D damage display (Damage_DisplayMfdPage) ----
+ * X-Wing's systems under XvT's names (strings.txt lines 14-23); XvT has no auto-ejection system. Only the
+ * system first in the repair order counts down (Xw_UpdateMissionClock). */
+static const char* const kDamageNames[XW_PLAYER_SUBSYSTEM_COUNT] = {
+	"Auto-Ejection",   "Hyperdrive",         "Cannon System", "Flight Controls",
+	"Engines",         "Targeting Computer", "Shield System", "Warhead Launcher"
+};
+
+static void CaptureDamageDisplay(XwSnapDamageDisplay* display) {
+	if (!user_damagedisplayopen())
+		return;
+	uint8_t systems[XW_PLAYER_SUBSYSTEM_COUNT];
+	unsigned count = user_damagedsystems(systems);
+	int selected = user_damagedisplayselected();
+	display->open = count != 0;
+	display->active = user_damagedisplayactive() != 0;
+	for (unsigned i = 0; i < count && i < XW_SNAP_DAMAGE_ROWS; ++i) {
+		XwSnapDamageRow* row = &display->rows[display->count++];
+		unsigned seconds = g_playerFlightState.subsystemRepairTimers[systems[i]];
+		CopyText(row->name, sizeof row->name, kDamageNames[systems[i]]);
+		row->minutes = (uint8_t)(seconds / 60 > 99 ? 99 : seconds / 60);
+		row->seconds = (uint8_t)(seconds % 60);
+		row->selected = systems[i] == selected;
+	}
+}
+
