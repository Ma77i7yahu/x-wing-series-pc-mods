 }
 
+/* ---- XvT's D damage display (Damage_DisplayMfdPage) ----
+ * XvT's damage box (forward and cockpit-off element 133) is 207 x 90 at (433, 105) in every 640 cockpit, over
+ * the view. "Damage Assessment" centred in green, then a row per knocked-out system in repair order with its
+ * repair time right-aligned in red; the highlighted row (Up / Down) gets a dark blue bar. Like XvT there is no
+ * fill; the green frame shows while it has the keys, and the box shrinks to its rows. */
+enum { DAMAGE_X = 433, DAMAGE_Y = 105, DAMAGE_W = 207, DAMAGE_H = 90, DAMAGE_SELECTED = 0x1C3C78 };
+
+bool XwHudDamage_Draw(const XwHudDraw* d) {
+	const XwRenderSnapshot* s = d->snapshot;
+	const XwSnapDamageDisplay* damage = &s->readout.damage_display;
+	const XwSnapCamera* c = &s->camera;
+	if (!damage->open || !damage->count || c->replay_mode || s->cockpit.suppressed ||
+		(c->hud_state != 0 && c->hud_state != XW_SNAP_VIEW_FULL_FORWARD) || !LoadXvtFont())
+		return true;
+	Pen pen = XvtPen(d);
+	if (d->edge_shift > 0)
+		pen.ox += XwHudDraw_PaneShift(d, DAMAGE_X, DAMAGE_X + DAMAGE_W);
+	float step = FontHeight(&g_xvtFont) + 1;
+	float left = DAMAGE_X + 2, top = DAMAGE_Y + 2, right = DAMAGE_X + DAMAGE_W - 2;
+	float bottom = top + step * (damage->count + 1) + 2;
+	if (bottom > DAMAGE_Y + DAMAGE_H - 2)
+		bottom = DAMAGE_Y + DAMAGE_H - 2;
+	if (damage->active) {
+		float fx = left - 2, fy = top - 2, fw = right - left + 4, fh = bottom - top + 4;
+		Fill(&pen, fx, fy, fw, 1, XVT_GREEN, 1);
+		Fill(&pen, fx, fy + fh - 1, fw, 1, XVT_GREEN, 1);
+		Fill(&pen, fx, fy, 1, fh, XVT_GREEN, 1);
+		Fill(&pen, fx + fw - 1, fy, 1, fh, XVT_GREEN, 1);
+	}
+	XwSnapRect header = { (int32_t)left, 0, (int32_t)(right - left), 0 };
+	Centered(&pen, &header, top, "Damage Assessment", XVT_GREEN);
+	for (unsigned i = 0; i < damage->count; ++i) {
+		const XwSnapDamageRow* row = &damage->rows[i];
+		float y = top + step * (i + 1);
+		if (y + step > bottom + 0.5f)
+			break;
+		if (row->selected)
+			Fill(&pen, left, y, right - left, step, DAMAGE_SELECTED, 1);
+		char time[8];
+		snprintf(time, sizeof time, "%02u:%02u", row->minutes, row->seconds);
+		float time_w = Measure(&pen, time);
+		Text(&pen, left, y, row->name, XVT_VALUE, right - left - time_w - 4);
+		RightText(&pen, right, y, time, XVT_RED);
+	}
+	return true;
+}
