diff --git a/src/xw_runtime/audio/control_sounds.c b/src/xw_runtime/audio/control_sounds.c
new file mode 100644
index 0000000..4c48eb5
--- /dev/null
+++ b/src/xw_runtime/audio/control_sounds.c
@@ -0,0 +1,66 @@
+#include "xw_runtime/audio/control_sounds.h"
+#include "xw/audio/fsfx.h"
+#include "xw/frontend/shell_preferences.h"
+#include "xw/util/memory.h"
+#include "xw_runtime/audio/imuse_session.h"
+#include "xw_runtime/audio/weapon_sounds.h"
+#include "xw_runtime/config/config.h"
+#include <aeron/log.h>
+
+/* OpenXvT sounds 42-48 (SFXBLAST.LST from ID 4) and their g_fsfxBaseVolumeBySfxSlot volumes. */
+static const char* const g_controlFiles[XW_CONTROL_SOUND_COUNT] = {
+	"xvt_control_sounds/BEEP-01.WAV",  "xvt_control_sounds/SMCLICK1.WAV", "xvt_control_sounds/SET_OFF2.WAV",
+	"xvt_control_sounds/SET_VLO3.WAV", "xvt_control_sounds/SET_LO2.WAV",  "xvt_control_sounds/SET_MED2.WAV",
+	"xvt_control_sounds/SET_HI2.WAV"
+};
+static const uint8_t g_controlVolumes[XW_CONTROL_SOUND_COUNT] = { 127, 95, 56, 56, 56, 56, 56 };
+static uint16_t g_controlHandles[XW_CONTROL_SOUND_COUNT];
+
+void XwControlSounds_Free(void) {
+	for (unsigned i = 0; i < XW_CONTROL_SOUND_COUNT; ++i) {
+		if (g_dos94Imuse) {
+			imuse_stop_sound(g_dos94Imuse, XW_CONTROL_SOUND_FIRST_ID + i);
+			imuse_forget_sound(g_dos94Imuse, XW_CONTROL_SOUND_FIRST_ID + i);
+		}
+		if (g_controlHandles[i])
+			Memory_FreeHandle(g_controlHandles[i]);
+		g_controlHandles[i] = 0;
+	}
+}
+
+void XwControlSounds_Load(void) {
+	XwControlSounds_Free();
+	if (!XwConfig_Settings()->xvt_control_sounds)
+		return;
+	for (unsigned i = 0; i < XW_CONTROL_SOUND_COUNT; ++i) {
+		g_controlHandles[i] = XwWeaponSounds_LoadWav(g_controlFiles[i]);
+		if (!g_controlHandles[i])
+			Aeron_LogWarn("xw.audio", "XvT control sound %s is missing or unsupported; keeping X-Wing's",
+						  g_controlFiles[i]);
+	}
+}
+
+void* XwControlSounds_Data(intptr_t soundId) {
+	intptr_t index = soundId - XW_CONTROL_SOUND_FIRST_ID;
+	if (index < 0 || index >= XW_CONTROL_SOUND_COUNT || !g_controlHandles[index])
+		return NULL;
+	return Memory_LockHandle(g_controlHandles[index]);
+}
+
+bool XwControlSounds_Play(XwControlSound sound) {
+	if ((unsigned)sound >= XW_CONTROL_SOUND_COUNT || !g_controlHandles[sound])
+		return false;
+	imuse_t* im = g_dos94Imuse;
+	if (!im || !ShellPreferences_GetSfxEnabled() || !g_flightSfxEnabled || !g_flightSfxVolume)
+		return true;
+	intptr_t id = XW_CONTROL_SOUND_FIRST_ID + sound;
+	if (imuse_get_param(im, id, IMUSE_PARAM_SOUND_PLAY_COUNT) > 0)
+		imuse_stop_sound(im, id);
+	if (imuse_start_sound(im, id, 64))
+		return true;
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_GROUP, IMUSE_GROUP_SFX);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_PRIORITY, FSFX_PLAYER_PRIORITY);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_PAN, 64);
+	imuse_set_param(im, id, IMUSE_PARAM_SOUND_VOL, g_controlVolumes[sound]);
+	return true;
+}
diff --git a/src/xw_runtime/audio/control_sounds.h b/src/xw_runtime/audio/control_sounds.h
new file mode 100644
index 0000000..43af3e0
--- /dev/null
+++ b/src/xw_runtime/audio/control_sounds.h
@@ -0,0 +1,33 @@
+#ifndef XW_RUNTIME_AUDIO_CONTROL_SOUNDS_H
+#define XW_RUNTIME_AUDIO_CONTROL_SOUNDS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* audio.xvt_control_sounds: X-Wing vs TIE Fighter's cockpit control sounds (OpenXvT flight.c key handling),
+ * read from RESOURCE xvt_control_sounds/ (copied from an XvT installation at packaging time): the confirm beep
+ * for energy transfers, the small click for throttle presets and refused transfers, and the five recharge
+ * setting tones. They play under their own iMUSE sound IDs, after the engine wash loops. */
+typedef enum XwControlSound {
+	XW_CONTROL_SOUND_CONFIRM, /* XvT 42, beep-01 */
+	XW_CONTROL_SOUND_CLICK, /* XvT 43, smclick1 */
+	XW_CONTROL_SOUND_SETTING_OFF, /* XvT 44-48: recharge rate 0 (all to engines) to 4 */
+	XW_CONTROL_SOUND_SETTING_VERY_LOW,
+	XW_CONTROL_SOUND_SETTING_LOW,
+	XW_CONTROL_SOUND_SETTING_MEDIUM,
+	XW_CONTROL_SOUND_SETTING_HIGH,
+	XW_CONTROL_SOUND_COUNT
+} XwControlSound;
+
+enum { XW_CONTROL_SOUND_FIRST_ID = 402 };
+
+/* Call after the flight sound bank loads; XwControlSounds_Free when it is released. */
+void XwControlSounds_Load(void);
+void XwControlSounds_Free(void);
+/* Dos94_gamesnd_GetSoundAddr: the VOC data for one of the control sound IDs, or NULL. */
+void* XwControlSounds_Data(intptr_t soundId);
+/* Plays an XvT control sound. False when the option is off or the sound is missing, so the caller can play
+ * X-Wing's own sound instead; true (even if muted) otherwise. */
+bool XwControlSounds_Play(XwControlSound sound);
+
+#endif
