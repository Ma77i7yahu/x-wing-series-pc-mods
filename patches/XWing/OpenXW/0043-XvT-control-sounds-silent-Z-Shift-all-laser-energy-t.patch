+#ifdef XW_MODERN
+		case USER_KEY_ALL_LASERS_TO_SHIELDS: {
+			/* XvT's Shift+' (OpenXvT flight.c FLIGHT_KEY_QUOTES): drain the lasers one charge at a time, round
+			 * robin, until both banks are full or the lasers are empty. A bank still short takes the whole step
+			 * once the other is full. Full here is X-Wing's recharge ceiling, as for '. With the shields set
+			 * fully forward or aft only that bank fills, as X-Wing's ' does. */
+			CraftData* craft = g_playerFlightState.craft;
+			if ((craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_SHIELDS) != 0) {
+				int16_t capacity =
+					XW_SHIELD_MAX_CHARGE_MULTIPLIER *
+					g_craftTypeDefs[g_playerFlightState.craftTypeIndex].nominalShieldEnergy[XW_SHIELD_FRONT];
+				int fillFront = craft->shieldDistribMode != LASER_SHIELD_DISTRIBUTE_REAR;
+				int fillRear = craft->shieldDistribMode != LASER_SHIELD_DISTRIBUTE_FRONT;
+				int transferred = 0;
+				uint16_t slot = 0;
+				int16_t remaining = 0;
+				for (slot = 0; slot < craft->laserSlotCount; ++slot)
+					if (craft->weaponSlots[slot].laserCharge > 0)
+						remaining += craft->weaponSlots[slot].laserCharge;
+				for (slot = 0; remaining > 0;) {
+					int frontShort = fillFront && craft->shieldEnergy[XW_SHIELD_FRONT] < capacity;
+					int rearShort = fillRear && craft->shieldEnergy[XW_SHIELD_REAR] < capacity;
+					if (!frontShort && !rearShort)
+						break;
+					if (craft->weaponSlots[slot].laserCharge > 0) {
+						int16_t step = frontShort && rearShort
+										   ? USER_SHIELD_PER_LASER_CHARGE / XW_SHIELD_BANK_COUNT
+										   : USER_SHIELD_PER_LASER_CHARGE;
+						--craft->weaponSlots[slot].laserCharge;
+						--remaining;
+						for (int bank = 0; bank < XW_SHIELD_BANK_COUNT; ++bank)
+							if (bank == XW_SHIELD_FRONT ? frontShort : rearShort) {
+								int16_t room = capacity - craft->shieldEnergy[bank];
+								craft->shieldEnergy[bank] += step < room ? step : room;
+							}
+						transferred = 1;
+					}
+					if (++slot >= craft->laserSlotCount)
+						slot = 0;
 				}
+				if (transferred) {
+					USER_CONTROL_SOUND(XW_CONTROL_SOUND_CONFIRM, FSFX_CONTROL_ACKNOWLEDGE_SLOT);
+					msg_messagetext(XW_MSG_TRANSFER_LASERS_TO_SHIELDS,
+									"\005Transferring all laser energy to \007shields");
+				} else
+					USER_XVT_ONLY_SOUND(XW_CONTROL_SOUND_CLICK);
 			} else {
 				g_msgArgTable[0] = XW_MSG_SUBSYSTEM_DEFLECTOR_SHIELD;
 				g_msgArgTable[1] = XW_MSG_SUBSYSTEM_DAMAGED_AND_INOPERATIVE;
@@ -1413,6 +1486,7 @@ void user_inputforplane(void) {
