index 2fcb626..dab0905 100644
--- a/src/xw/flight/object/collide.c
+++ b/src/xw/flight/object/collide.c
@@ -1404,6 +1404,30 @@ void collide_laserhitcraft(uint16_t projectileObjIdx, uint16_t craftObjIdx, int1
 	}
 }
 
+#ifdef XW_MODERN
+/* game.xvt_shields: XvT evens the player's banks after every hit. When the hit bank is below the other,
+ * half the difference moves across (a depleted bank takes half of the other), and the distribution
+ * returns to even. */
+static void collide_xvtbalanceshields(CraftData* craft, uint16_t hitSide) {
+	uint16_t otherSide = hitSide ^ 1;
+	int hit = craft->shieldEnergy[hitSide];
+	int other = craft->shieldEnergy[otherSide];
+	int maxHit = g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[hitSide] *
+				 XW_SHIELD_MAX_CHARGE_MULTIPLIER;
+	int moved;
+	if (hit >= other)
+		return;
+	moved = (other - hit) / 2;
+	if (hit + moved > maxHit)
+		moved = maxHit > hit ? maxHit - hit : 0;
+	if (moved <= 0)
+		return;
+	craft->shieldEnergy[hitSide] = (int16_t)(hit + moved);
+	craft->shieldEnergy[otherSide] = (int16_t)(other - moved);
+	craft->shieldDistribMode = LASER_SHIELD_DISTRIBUTE_EVEN;
+}
+#endif
