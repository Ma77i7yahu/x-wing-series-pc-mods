 }
 
+/* XvT player turn rate (OpenXvT player.c): the throttle setting t maps to 1/3 + 2t below 1/3 throttle and
+ * to 1 - (t - 1/3)/2 above it, so turns are tightest at 1/3 throttle (X-Wing's own rate), 2/3 as tight at
+ * full throttle and 1/3 when stopped or with the engines out. Each step of combined laser + shield
+ * recharge below neutral adds 0xC00/0x10000 (about 5%); each step above takes it away. */
+enum { USER_XVT_TURN_PEAK = 0x5555, USER_XVT_POWER_NEUTRAL = 2 * LASER_RECHARGE_NEUTRAL, USER_XVT_POWER_STEP = 0xC00 };
+
+int user_xvtturngain(int gain) {
+#ifdef XW_MODERN
+	const CraftData* craft = g_playerFlightState.craft;
+	int throttle;
+	int scale;
+	int redirect;
+	if (!XwFlightTweaks_XvtTurning() || craft == NULL)
+		return gain;
+	throttle = (craft->workingSubsystems & XW_CRAFT_SUBSYSTEM_ENGINE) != 0 ? craft->engineThrottle[0] : 0;
+	scale = throttle < USER_XVT_TURN_PEAK ? 2 * throttle + USER_XVT_TURN_PEAK
+										  : 0x10000 - (throttle - USER_XVT_TURN_PEAK) / 2;
+	if (g_craftTypeDefs[craft->craftTypeIndex].nominalShieldEnergy[XW_SHIELD_FRONT] != 0)
+		redirect = craft->shieldRedirect + craft->laserRedirect;
+	else
+		redirect = 2 * craft->laserRedirect;
+	scale += (int)(((long long)scale * USER_XVT_POWER_STEP * (USER_XVT_POWER_NEUTRAL - redirect)) >> 16);
+	gain = (int)(((long long)gain * scale) >> 16);
+	/* The turn command is carried in int16 smoothing state. */
+	return gain > INT16_MAX ? INT16_MAX : gain;
+#else
+	return gain;
+#endif
+}
