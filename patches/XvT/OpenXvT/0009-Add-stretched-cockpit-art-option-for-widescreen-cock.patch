diff --git a/src/xvt_remaster/preview.c b/src/xvt_remaster/preview.c
index 09b12b6..f75cf8d 100644
--- a/src/xvt_remaster/preview.c
+++ b/src/xvt_remaster/preview.c
@@ -239,7 +239,11 @@ static int RenderOne(AeronCommandBuffer* cmd, const XvtRenderSnapshot* s, const
 	if (!XvtRenderMath_Layout(p->camera.screen_width, p->camera.screen_height, (float)tw, (float)th, &layout))
 		return 0;
 	float scale = fminf((float)tw / p->camera.screen_width, (float)th / p->camera.screen_height);
-	int width = crt ? (int)ceilf(p->destination.width * scale) : PREVIEW_WIDTH;
+	/* A stretched cockpit widens the display; widen its view, not its ship. */
+	float widen = crt && XvtRenderMath_CockpitStretched(&s->camera)
+					  ? ((float)tw / p->camera.screen_width) / scale
+					  : 1.0f;
+	int width = crt ? (int)ceilf(p->destination.width * scale * widen) : PREVIEW_WIDTH;
 	int height = crt ? (int)ceilf(p->destination.height * scale) : PREVIEW_HEIGHT;
 	if (!Ensure(slot, width, height))
 		return 0;
@@ -256,7 +260,7 @@ static int RenderOne(AeronCommandBuffer* cmd, const XvtRenderSnapshot* s, const
 		if (!object)
 			return 1;
 		XvtRenderView view;
-		if (!XvtRenderMath_BuildView(&p->camera, p->camera.world_pos, p->destination.width,
+		if (!XvtRenderMath_BuildView(&p->camera, p->camera.world_pos, (int)(p->destination.width * widen + .5f),
 									 p->destination.height, &view))
 			return 0;
 		camera = view.camera;
