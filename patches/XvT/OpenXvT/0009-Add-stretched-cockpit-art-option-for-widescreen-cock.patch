 	return isfinite(*x) && isfinite(*y);
 }
 
+int XvtRenderMath_CockpitStretched(const XvtSnapCamera* cam) {
+	const XvtRenderSettings* settings = XvtRemasterConfig_Effective();
+	return settings && settings->cockpit_stretch && cam && !cam->map_mode && !cam->external &&
+		   cam->hud_state != HUD_VIEW_HUD_ONLY && cam->hud_state != HUD_VIEW_FULL_SCREEN;
+}
+
 int XvtRenderMath_BuildMainView(const XvtSnapCamera* cam, const int32_t origin[3], int width, int height,
 								XvtRenderView* out) {
 	if (!XvtRenderMath_BuildView(cam, origin, width, height, out) || cam->screen_width <= 0 ||
@@ -215,8 +223,12 @@ int XvtRenderMath_BuildMainView(const XvtSnapCamera* cam, const int32_t origin[3
 	AeronSceneCamera* c = &out->camera;
 	c->h_half_rad = atanf(width / (2 * focal));
 	c->v_half_rad = atanf(height / (2 * focal * aspect));
-	/* Map the original viewport's projection center into the fitted cockpit frame. */
-	float cx = (width - cam->screen_width * scale) / 2 + (cam->viewport.x + cam->center_x) * scale;
+	/* Map the original viewport's projection center into the fitted cockpit
+	 * frame, or across the full width when the cockpit art is stretched. The
+	 * projection itself keeps square pixels either way. */
+	float cx = XvtRenderMath_CockpitStretched(cam)
+				   ? (cam->viewport.x + cam->center_x) * ((float)width / cam->screen_width)
+				   : (width - cam->screen_width * scale) / 2 + (cam->viewport.x + cam->center_x) * scale;
 	float cy = (height - cam->screen_height * scale) / 2 +
 			   (cam->viewport.y + cam->center_y + cam->projection_offset_y) * scale;
 	c->proj_x_offset = 2 * cx / width - 1;
