-				g_msgArgTable[1] = SYSTEM_NAME_MESSAGE_ARG;
-				g_msgArgTable[0] = (uint16_t)(selectedWarhead + LASER_SYSTEM_NAME_BASE);
-				msg_emitInFlightMessage(IFMSG_086_ARG_SYSTEM_IS_ARG, playerIdx);
