 	return wholeSecondsTicks;
 }
 
+/* XWA-style "lasers and ions linked": one trigger fires both cannon banks, each fully linked.
+ * Entered with the link key after "fire linked"; the next press goes back to single fire. */
+static uint8_t s_playerCannonBanksLinked[8];
+
+int laser_CanLinkCannonBanks(const CraftData* craft) {
+	enum { GUNNER_LASER_MOUNT_TYPE = 2 };
+	int bank;
+
+	if (craft->cannonClassCount < 2)
+		return 0;
+	for (bank = 0; bank < 2; ++bank) {
+		if (craft->laserState.projectileTypeId[bank] == 0 ||
+			g_modelDefs[craft->modelIndex].laserGroupMountType[bank] == GUNNER_LASER_MOUNT_TYPE)
+			return 0;
+	}
+	return 1;
+}
+
+int laser_PlayerCannonBanksLinked(int playerIdx, const CraftData* craft) {
+	return playerIdx >= 0 && playerIdx < 8 && s_playerCannonBanksLinked[playerIdx] != 0 &&
+		   g_players[playerIdx].selectedWeaponMode == 0 && laser_CanLinkCannonBanks(craft);
+}
+
+void laser_SetPlayerCannonBanksLinked(int playerIdx, int linked) {
+	if (playerIdx >= 0 && playerIdx < 8)
+		s_playerCannonBanksLinked[playerIdx] = (uint8_t)(linked != 0);
+}
+
+/* Fires one cannon bank for a player if its cooldown allows; forceLinked fires every cannon in it. */
+static void laser_FirePlayerCannonBank(int playerIdx, CraftData* craft, int bank, int forceLinked) {
+	enum { SYSTEM_NAME_MESSAGE_ARG = 87, LASER_SYSTEM_NAME_BASE = 92 };
+	int16_t cooldown = craft->laserState.fireCooldownTicks[bank];
+
+	if (g_laserFireTimestampTrackingEnabled != 0) {
+		int lockstepTimestamp = g_players[playerIdx].lockstepTimestamp;
+		if (cooldown != 0) {
+			if (craft->laserState.lastFireTimestamp[bank] < lockstepTimestamp) {
+				cooldown = 0;
+				craft->laserState.lastFireTimestamp[bank] = lockstepTimestamp;
+			} else {
+				cooldown = (int16_t)(2 * g_elapsedTicks);
+			}
+		} else {
+			craft->laserState.lastFireTimestamp[bank] = lockstepTimestamp;
+		}
+	}
+	if ((int16_t)(g_elapsedTicks + (g_elapsedTicks >> 1)) <= cooldown)
+		return;
+	if ((craft->workingSubsystems & CRAFT_SUBSYSTEM_FLAG_CANNONS) != 0) {
+		uint8_t savedLinkMode = craft->laserState.linkMode[bank];
+		if (forceLinked)
+			craft->laserState.linkMode[bank] = 3;
+		laser_firelasersystem(g_players[playerIdx].objectIndex, bank);
+		craft->laserState.linkMode[bank] = savedLinkMode;
+	} else if (playerIdx == g_localPlayer) {
+		g_msgArgTable[1] = SYSTEM_NAME_MESSAGE_ARG;
+		g_msgArgTable[0] = (uint16_t)(bank + LASER_SYSTEM_NAME_BASE);
+		msg_emitInFlightMessage(IFMSG_086_ARG_SYSTEM_IS_ARG, playerIdx);
+	}
+}
+
