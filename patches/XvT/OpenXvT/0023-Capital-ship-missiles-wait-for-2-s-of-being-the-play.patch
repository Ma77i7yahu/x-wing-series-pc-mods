@@ -89,6 +89,8 @@ void laser_fireplayerweapon(int playerIdx);
 int laser_CanLinkCannonBanks(const CraftData* craft);
 int laser_PlayerCannonBanksLinked(int playerIdx, const CraftData* craft);
 void laser_SetPlayerCannonBanksLinked(int playerIdx, int linked);
+/* Game-time ticks the player has kept objectIdx as the current target; 0 when it is not the target. */
+int laser_PlayerTargetHeldTicks(int player, uint16_t objectIdx);
 void laser_firelasersystem(int objectIndex, int laserSystemIndex);
 void laser_firerocketsystem(int objectIndex, unsigned int launcherIndex);
 int laser_firemissile(int objectIndex, int weaponSlotIndex, int projectileTypeId, unsigned int launcherIndex);
diff --git a/src/xvt_app/settings/settings.c b/src/xvt_app/settings/settings.c
index 577d39e..48963c4 100644
--- a/src/xvt_app/settings/settings.c
+++ b/src/xvt_app/settings/settings.c
@@ -76,6 +76,15 @@ static void XvtSettingsMenu_DrawGame(AeronUiContext* ui, const AeronInputSnapsho
 	}
 	AeronUi_Help(ui, ion_link == 0 ? "Original: AI craft fire lasers, and ion cannons only on disable orders."
 									: "AI Y-Wings, B-Wings, Gunboats etc. fire ions with lasers (ions only to disable).");
+	static const char* const grace_labels[] = { "Immediate", "After 2 Seconds" };
+	int grace = XvtConfig_Settings()->capital_missile_grace != 0;
+	if (AeronUi_Selector(ui, "Capital Ship Missiles", &grace, grace_labels, 2)) {
+		char error[1024];
+		if (!XvtConfig_SetCapitalMissileGrace(grace != 0, error, sizeof error))
+			XvtSettingsMenu_ReportError(error);
+	}
+	AeronUi_Help(ui, grace ? "They launch at you once you keep them targeted for 2 s, so T can scroll past them."
+						   : "Original: they launch as soon as you target them.");
 	AeronUi_Spacer(ui, 8.0f);
 	XvtInstallationPage_Draw(ui, input);
 }
diff --git a/src/xvt_runtime/config/config.c b/src/xvt_runtime/config/config.c
index f9151fc..3592dda 100644
--- a/src/xvt_runtime/config/config.c
+++ b/src/xvt_runtime/config/config.c
@@ -515,6 +515,24 @@ bool XvtConfig_SetHardKeepsFriendlySkill(bool enabled, char* error, size_t capac
 	return success;
 }
 
+bool XvtConfig_SetCapitalMissileGrace(bool enabled, char* error, size_t capacity) {
+	AeronConfigFile* updated = NULL;
+	AeronConfigError detail;
+	if (!g_writable)
+		return XvtConfig_Error(error, capacity, "configuration saving is disabled", NULL);
+	if (!AeronConfigFile_Clone(g_user, &updated, &detail))
+		return XvtSettings_FileError(&detail, error, capacity);
+	bool success = enabled == (XvtConfig_DefaultSettings()->capital_missile_grace != 0)
+					   ? AeronConfigFile_Remove(updated, "flight.capital_missile_grace", &detail)
+					   : AeronConfigFile_SetBool(updated, "flight.capital_missile_grace", enabled, &detail);
+	if (success)
+		success = XvtConfig_UpdateUser(updated, 0, error, capacity);
+	else
+		XvtSettings_FileError(&detail, error, capacity);
+	AeronConfigFile_Destroy(updated);
+	return success;
+}
+
 bool XvtConfig_SetAiIonLink(int mode, char* error, size_t capacity) {
 	static const char* const names[] = { "off", "friendly", "all" };
 	AeronConfigFile* updated = NULL;
