From 19d889c0d370c0da7cc5a23d682c860689397825 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sun, 11 Oct 2026 12:02:38 +1100
Subject: [PATCH 23/25] Capital ship missiles wait for 2 s of being the
 player's target (flight.capital_missile_grace)

---
 resources/config.yaml             |  4 ++++
 src/xvt/flight/ai/paifight.c      |  9 +++++++++
 src/xvt/flight/object/laser.c     | 26 ++++++++++++++++++++++++++
 src/xvt/flight/object/laser.h     |  2 ++
 src/xvt_app/settings/settings.c   |  9 +++++++++
 src/xvt_runtime/config/config.c   | 18 ++++++++++++++++++
 src/xvt_runtime/config/config.h   |  2 ++
 src/xvt_runtime/config/settings.c |  1 +
 src/xvt_runtime/config/settings.h |  2 ++
 9 files changed, 73 insertions(+)

diff --git a/resources/config.yaml b/resources/config.yaml
index 46b2f40..490cf98 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -457,3 +457,7 @@ flight:
   # single-player missions keep wingmen at the mission's own skill level;
   # enemies still get Hard's boost. Multiplayer is unaffected.
   hard_keeps_friendly_skill: true
+  # Capital ships launch missiles at you once you have kept them targeted for
+  # 2 seconds, so cycling targets with T past them does not set them off.
+  # false = the original: they launch as soon as you target them.
+  capital_missile_grace: true
diff --git a/src/xvt/flight/ai/paifight.c b/src/xvt/flight/ai/paifight.c
index 52e12d4..f13ede3 100644
--- a/src/xvt/flight/ai/paifight.c
+++ b/src/xvt/flight/ai/paifight.c
@@ -7,6 +7,7 @@
 #include "xvt/flight/flight.h"
 #include "xvt/flight/mission/mission.h"
 #include "xvt/flight/object/collide.h"
+#include "xvt/flight/object/laser.h"
 #include "xvt/flight/object/object.h"
 #include "xvt/flight/player/player.h"
 #include "xvt/math/math2.h"
@@ -1396,6 +1397,14 @@ int16_t paifight_missiledefenseorder(void) {
 										if (g_players[playerOwner].currentTargetObjectIdx !=
 											g_paiContext.objectIndex)
 											continue;
+#ifdef XVT_MODERN
+										/* flight.capital_missile_grace: only after 2 s as the player's
+										 * target, so cycling past the ship with T does not set it off. */
+										if (XvtConfig_Settings()->capital_missile_grace &&
+											laser_PlayerTargetHeldTicks(playerOwner, g_paiContext.objectIndex) <
+												2 * SIMULATION_TICKS_PER_SECOND)
+											continue;
+#endif
 									}
 								}
 
diff --git a/src/xvt/flight/object/laser.c b/src/xvt/flight/object/laser.c
index e989a7f..f772902 100644
--- a/src/xvt/flight/object/laser.c
+++ b/src/xvt/flight/object/laser.c
@@ -71,6 +71,29 @@ const uint8_t g_platformBeamDisabledComponentIds[60] = {
 	0x11, 0x12, 0x17, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0xFF, 0x15, 0x16, 0x17, 0x18, 0x1E, 0xFF,
 };
 
+#ifdef XVT_MODERN
+/* When each player picked their current target (g_gameTime), for laser_PlayerTargetHeldTicks. */
+static uint16_t s_heldTarget[8];
+static int s_heldSince[8];
+
+static void laser_TrackPlayerTargets(void) {
+	for (int player = 0; player < 8; ++player) {
+		uint16_t target = (uint16_t)g_players[player].currentTargetObjectIdx;
+		if (target != s_heldTarget[player] || g_gameTime < s_heldSince[player]) {
+			s_heldTarget[player] = target;
+			s_heldSince[player] = g_gameTime;
+		}
+	}
+}
+
+int laser_PlayerTargetHeldTicks(int player, uint16_t objectIdx) {
+	if (player < 0 || player >= 8 || (uint16_t)g_players[player].currentTargetObjectIdx != objectIdx ||
+		s_heldTarget[player] != objectIdx)
+		return 0;
+	return g_gameTime - s_heldSince[player];
+}
+#endif
+
 // FLAGS: /O2 /G5
 // FUNCTION: XVT 0x404710
 void laser_weaponsfire(void) {
@@ -106,6 +129,9 @@ void laser_weaponsfire(void) {
 	char doPeriodicPowerUpdate;
 	uint16_t objectIdx;
 
+#ifdef XVT_MODERN
+	laser_TrackPlayerTargets();
+#endif
 	doPeriodicPowerUpdate = 0;
 	if (g_flightGlobalCountdownTimers.weaponPowerUpdateTimer == 0
 #ifdef XVT_MODERN
