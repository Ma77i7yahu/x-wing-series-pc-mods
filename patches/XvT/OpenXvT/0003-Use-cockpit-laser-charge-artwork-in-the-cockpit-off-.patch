 			return 0;
+		if (state->view.hud_state == HUD_VIEW_HUD_ONLY)
+			CompilePanel(layout, state);
 	}
 	if (state->view.hud_state == HUD_VIEW_TARGET_CAMERA)
 		for (unsigned bank = 0; bank < 4; ++bank)
