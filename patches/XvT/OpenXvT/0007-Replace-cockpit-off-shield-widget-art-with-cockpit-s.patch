+void XvtHudInstruments_PlaceShields(XvtHudDraw* draw) {
+	draw->shields_replaced = 0;
+	draw->shield_text_dy[0] = draw->shield_text_dy[1] = 0;
+	const XvtCockpitState* state = draw->state;
+	const XvtHudSpriteBinding* hull = &draw->layout->sprites[XVT_HUD_HULL];
+	int hull_w, hull_h, arc_w, arc_h;
+	if (!draw->assets || !draw->assets->base_coverage[XVT_HUD_BASE_WIDGET].count ||
+		!PartBounds(draw, XVT_HUD_HULL, &hull_w, &hull_h) ||
+		!PartBounds(draw, XVT_HUD_PANEL_HULL, &arc_w, &arc_h))
+		return;
+	/* Bounds of the cockpit arcs and icon in forward-cockpit coordinates. */
+	int box[4] = { 32767, 32767, -32768, -32768 };
+	for (unsigned role = XVT_HUD_PANEL_SHIELD; role <= XVT_HUD_PANEL_HULL; ++role) {
+		int width, height;
+		const XvtHudSpriteBinding* binding = &draw->layout->sprites[role];
+		if (!PartBounds(draw, (XvtHudSpriteRole)role, &width, &height))
+			return;
+		IncludeRect(box, binding->x, binding->y, binding->x + width, binding->y + height);
+	}
+	const XvtHudSpriteBinding* icon = &draw->layout->sprites[XVT_HUD_PANEL_HULL];
+	int center_x = hull->x + hull_w / 2, center_y = hull->y + hull_h / 2;
+	draw->shield_dx = center_x - (icon->x + arc_w / 2);
+	draw->shield_dy = center_y - (icon->y + arc_h / 2);
+	/* Keep the lower percentage on screen below the arcs; the upper one moves
+	 * above them. */
+	const XvtCockpitTextField* fore = &state->text_fields[XVT_COCKPIT_TEXT_SHIELD_FORE];
+	const XvtCockpitTextField* aft = &state->text_fields[XVT_COCKPIT_TEXT_SHIELD_AFT];
+	int upper = fore->bounds.y <= aft->bounds.y ? 0 : 1;
+	const XvtCockpitTextField* fields[2] = { fore, aft };
+	const XvtCockpitTextField* low = fields[!upper];
+	const XvtCockpitTextField* high = fields[upper];
+	if (low->caption.visible) {
+		int limit = draw->layout->source_height - low->bounds.height - 1;
+		int bottom = box[3] + draw->shield_dy;
+		if (bottom > limit)
+			draw->shield_dy -= bottom - limit;
+		bottom = box[3] + draw->shield_dy;
+		if (low->bounds.y < bottom + 1)
+			draw->shield_text_dy[!upper] = bottom + 1 - low->bounds.y;
+	}
+	if (high->caption.visible) {
+		int top = box[1] + draw->shield_dy;
+		if (high->bounds.y + high->bounds.height > top - 1)
+			draw->shield_text_dy[upper] = top - 1 - (high->bounds.y + high->bounds.height);
+	}
+	draw->shields_replaced = 1;
+}
