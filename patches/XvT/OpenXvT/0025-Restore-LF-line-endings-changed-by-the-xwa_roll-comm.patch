-static void XvtControllerMapping_QueueKey(uint16_t key) {
-	unsigned next = (g_controller.write + 1) % ACTION_QUEUE_CAPACITY;
-	if (next == g_controller.read) {
-		Aeron_LogWarn("xvt.input", "Controller command queue is full");
