From 5a34c42770bfa111b49dc6395961cda612525ec7 Mon Sep 17 00:00:00 2001
From: Matthew <matthewhale@live.com.au>
Date: Sat, 10 Oct 2026 05:46:29 +1100
Subject: [PATCH 19/25] AI fighters fire ion cannons with lasers at small craft
 (flight.ai_ion_link)

---
 resources/config.yaml             |  5 +++++
 src/xvt/flight/ai/paifight.c      | 26 ++++++++++++++++++++++++++
 src/xvt_runtime/config/settings.c |  3 +++
 src/xvt_runtime/config/settings.h |  2 ++
 4 files changed, 36 insertions(+)

diff --git a/resources/config.yaml b/resources/config.yaml
index 1808b62..97da6f4 100644
--- a/resources/config.yaml
+++ b/resources/config.yaml
@@ -449,3 +449,8 @@ flight:
   # ahead (0.1-2.5 km), otherwise this many metres ahead; parallel with no
   # target selected. 0 = always parallel.
   laser_convergence: 550
+  # AI fighters with lasers and ion cannons (Y-Wing, B-Wing, Assault Gunboat...)
+  # fire both together at starfighters, transports and utility craft. Against
+  # capital ships and freighters, and on disable orders, they keep the original
+  # behaviour. off, friendly (your side only) or all.
+  ai_ion_link: all
diff --git a/src/xvt/flight/ai/paifight.c b/src/xvt/flight/ai/paifight.c
index a12499b..8f85134 100644
--- a/src/xvt/flight/ai/paifight.c
+++ b/src/xvt/flight/ai/paifight.c
@@ -12,6 +12,7 @@
 #include "xvt/math/math2.h"
 #include "xvt/math/trig2.h"
 #include "xvt/util/game_rand.h"
+#include "xvt_runtime/config/config.h"
 
 #include <limits.h>
 #include <string.h>
@@ -33,6 +34,28 @@ const unsigned int g_aiFighterShootMaxRangeBySkill[3] = { 0x6000, 0x8000, 0xA000
 // GLOBAL: XVT 0x52429C
 const uint8_t g_aiFighterShootLinkSlot3ValueBySkill[4] = { 3, 4, 5, 0 };
 
+/* XWA-style: AI fighters fire ion cannons with their lasers (flight.ai_ion_link). Only at small craft,
+ * so wingmen and enemy reinforcements don't slowly ion-disable capital ships and freighters. */
+static int paifight_IonLinkWithLasers(uint16_t targetIndex) {
+	enum { ION_LINK_OFF = 0, ION_LINK_FRIENDLY = 1 };
+	const XvtSettings* settings = XvtConfig_Settings();
+	int mode = settings ? settings->ai_ion_link : ION_LINK_OFF;
+	uint8_t genus;
+
+	if (mode == ION_LINK_OFF || targetIndex >= g_regionMainObjectSlotEnd)
+		return 0;
+	genus = g_objectTable[targetIndex].genusId;
+	if (genus != CRAFT_GENUS_STARFIGHTER && genus != CRAFT_GENUS_TRANSPORT && genus != CRAFT_GENUS_UTILITY_VEHICLE)
+		return 0;
+	if (mode == ION_LINK_FRIENDLY) {
+		int team = g_missionFlightGroups[g_objectTable[g_paiContext.objectIndex].flightGroupIdx].fg.team;
+		int playerTeam = (uint16_t)g_players[g_localPlayer].playerIff;
+		if (team != playerTeam && g_missionTeams[playerTeam].allies[team] == 0)
+			return 0;
+	}
+	return 1;
+}
+
 // FLAGS: /O2 /G5
 // FUNCTION: XVT 0x45C370
 int16_t paifight_scanfortargetorder(void) {
@@ -956,6 +979,9 @@ int16_t paifight_fightershootorder(void) {
 				} else if (strcmp(g_planTable[currentPlanId].name, "disableldr1pln") == 0 &&
 						   g_paiContext.controller->hasLiveTarget == 1) {
 					slotLink = linkMode;
+				} else if (strcmp(g_planTable[currentPlanId].name, "disableldr1pln") != 0 &&
+						   paifight_IonLinkWithLasers(targetIndex)) {
+					slotLink = linkMode;
 				} else {
 					slotLink = 0;
 				}
diff --git a/src/xvt_runtime/config/settings.c b/src/xvt_runtime/config/settings.c
index 77c84fc..2f3c20e 100644
--- a/src/xvt_runtime/config/settings.c
+++ b/src/xvt_runtime/config/settings.c
@@ -235,6 +235,7 @@ int XvtSettings_Parse(const AeronConfigFile* document, const XvtSceneSettings* s
 	static const char* const window_modes[] = { "windowed", "fullscreen" };
 	static const char* const temporal_modes[] = { "off", "native_aa", "quality", "balanced", "performance" };
 	static const char* const sky_modes[] = { "stars", "cube", "procedural" };
+	static const char* const ai_ion_links[] = { "off", "friendly", "all" };
 	int temporal_mode;
 	if (!document || !scene_defaults || !out)
 		return XvtSettings_NodeError(document, "", "configuration document and output are required", error,
@@ -244,6 +245,8 @@ int XvtSettings_Parse(const AeronConfigFile* document, const XvtSceneSettings* s
 			return 0;
 	if (!XvtSettings_ReadChoice(document, "flight.update_rate", flight_rates, 2, &candidate.flight_unlocked,
 								error, capacity) ||
+		!XvtSettings_ReadChoice(document, "flight.ai_ion_link", ai_ion_links, 3, &candidate.ai_ion_link, error,
+								capacity) ||
 		!XvtSettings_ReadChoice(document, "video.window_mode", window_modes, 2, &candidate.fullscreen, error,
 								capacity) ||
 		!XvtSettings_ReadChoice(document, "render.temporal_upscaling.mode", temporal_modes, 5, &temporal_mode,
diff --git a/src/xvt_runtime/config/settings.h b/src/xvt_runtime/config/settings.h
index b31e418..d913ab3 100644
--- a/src/xvt_runtime/config/settings.h
+++ b/src/xvt_runtime/config/settings.h
@@ -92,6 +92,8 @@ typedef struct XvtSettings {
 	int flight_unlocked;
 	/* Player cannons converge this many metres ahead; 0 fires parallel. */
 	int laser_convergence_m;
+	/* AI fighters fire ion cannons with their lasers at small craft: 0 off, 1 friendly only, 2 everyone. */
+	int ai_ion_link;
 	char game_data[XVT_PATH_CAPACITY];
 	char ui_font[XVT_PATH_CAPACITY];
 	char lobby_url[AERON_DPLAY_DIRECTORY_URL_CAPACITY];
