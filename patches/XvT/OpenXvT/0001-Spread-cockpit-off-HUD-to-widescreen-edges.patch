diff --git a/src/xvt_remaster/hud_draw.c b/src/xvt_remaster/hud_draw.c
index 85cfe5e..30f35ba 100644
--- a/src/xvt_remaster/hud_draw.c
+++ b/src/xvt_remaster/hud_draw.c
@@ -6,6 +6,34 @@ AeronDrawList2D* XvtHudDraw_SelectList(const XvtHudDraw* draw, unsigned phase) {
 	return phase <= XVT_COCKPIT_BEFORE_CRT ? draw->before : draw->after;
 }
 
+static XvtHudDraw InZone(const XvtHudDraw* draw, unsigned zone) {
+	XvtHudDraw zoned = *draw;
+	zoned.offset_x += ((float)zone - XVT_HUD_ZONE_CENTER) * draw->spread;
+	zoned.spread = 0;
+	return zoned;
+}
+
+XvtHudDraw XvtHudDraw_ForPoint(const XvtHudDraw* draw, int x, int y) {
+	if (draw->spread == 0)
+		return *draw;
+	const XvtHudAssetSet* assets = draw->assets;
+	unsigned zone = 0;
+	if (assets && assets->base_zones && x >= 0 && y >= 0 && x < assets->base_zones_width &&
+		y < assets->base_zones_height)
+		zone = assets->base_zones[(size_t)y * assets->base_zones_width + x];
+	if (zone)
+		--zone;
+	else {
+		int width = draw->layout->source_width;
+		zone = x * 3 < width ? XVT_HUD_ZONE_LEFT : x * 3 < width * 2 ? XVT_HUD_ZONE_CENTER : XVT_HUD_ZONE_RIGHT;
+	}
+	return InZone(draw, zone);
+}
+
+XvtHudDraw XvtHudDraw_ForRect(const XvtHudDraw* draw, XvtSnapRect rect) {
+	return XvtHudDraw_ForPoint(draw, rect.x + rect.width / 2, rect.y + rect.height / 2);
+}
+
 static XvtSnapRect IntersectRects(XvtSnapRect a, XvtSnapRect b) {
 	int right = a.x + a.width < b.x + b.width ? a.x + a.width : b.x + b.width;
 	int bottom = a.y + a.height < b.y + b.height ? a.y + a.height : b.y + b.height;
@@ -123,7 +151,10 @@ void XvtHudDraw_Part(const XvtHudDraw* draw, XvtHudSpriteRole role, unsigned sta
 	const AeronRuntimeAtlas* atlas = &draw->assets->parts;
 	float width = atlas->layout.classic_w[part->atlas_frame],
 		  height = atlas->layout.classic_h[part->atlas_frame];
-	AppendAtlasSprite(draw, atlas, part->atlas_frame,
+	/* Zone by the binding, not the per-segment offset, so gauges move together. */
+	XvtHudDraw zoned = XvtHudDraw_ForPoint(draw, binding->x + (binding->mirrored ? -(int)width : (int)width) / 2,
+										   binding->y + (int)height / 2);
+	AppendAtlasSprite(&zoned, atlas, part->atlas_frame,
 					  binding->x + offset_x - (binding->mirrored ? width - 1 : 0), binding->y + offset_y, 0,
 					  0, width, height, binding->mirrored, part->monochrome,
 					  draw->state->palette_argb[part->color], phase);
@@ -133,11 +164,15 @@ void XvtHudDraw_Base(const XvtHudDraw* draw) {
 	const AeronRuntimeAtlas* atlas = &draw->assets->base;
 	if (!atlas->layout.frame_count)
 		return;
-	for (unsigned index = 0; index < draw->assets->base_coverage.count; ++index) {
-		const AeronImageCoverageRect* rect = &draw->assets->base_coverage.rects[index];
-		int x = draw->layout->mirrored ? draw->layout->source_width - rect->x - rect->width : rect->x;
-		AppendAtlasSprite(draw, atlas, 0, x, rect->y, rect->x, rect->y, rect->width, rect->height,
-						  draw->layout->mirrored, 0, 0, XVT_COCKPIT_BEFORE_CRT);
+	for (unsigned zone = 0; zone < XVT_HUD_ZONE_COUNT && zone < (unsigned)atlas->layout.frame_count; ++zone) {
+		XvtHudDraw zoned = InZone(draw, zone);
+		const AeronImageCoverage* coverage = &draw->assets->base_coverage[zone];
+		for (unsigned index = 0; index < coverage->count; ++index) {
+			const AeronImageCoverageRect* rect = &coverage->rects[index];
+			int x = draw->layout->mirrored ? draw->layout->source_width - rect->x - rect->width : rect->x;
+			AppendAtlasSprite(&zoned, atlas, zone, x, rect->y, rect->x, rect->y, rect->width, rect->height,
+							  draw->layout->mirrored, 0, 0, XVT_COCKPIT_BEFORE_CRT);
+		}
 	}
 }
 
