-	AeronRuntimeAtlasFrame frame = { rgba, bitmap.width, bitmap.height, 0, 0, 0 };
 	AeronRuntimeAtlasOptions options = g_atlasOptions;
 	options.debug_name = "xvt.cockpit.base";
-	int ok = rgba && Aeron_ImageBuildCoverageRgba8(rgba, bitmap.width, bitmap.height, &set->base_coverage) &&
-			 Aeron_RuntimeAtlasBuild(&set->base, cmd, &frame, 1, &options);
+	size_t pixels = (size_t)bitmap.width * bitmap.height;
+	uint8_t* owner = rgba ? malloc(pixels) : NULL;
+	uint8_t* zoned = owner ? malloc(pixels * 4 * XVT_HUD_ZONE_COUNT) : NULL;
+	set->base_zones = zoned ? calloc(pixels, 1) : NULL;
+	int ok = set->base_zones && AssignBaseZones(rgba, bitmap.width, bitmap.height, owner, set->base_zones);
+	AeronRuntimeAtlasFrame frames[XVT_HUD_ZONE_COUNT];
+	for (unsigned zone = 0; ok && zone < XVT_HUD_ZONE_COUNT; ++zone) {
+		uint8_t* frame = zoned + pixels * 4 * zone;
+		for (size_t pixel = 0; pixel < pixels; ++pixel) {
+			if (owner[pixel] == zone + 1)
+				memcpy(frame + pixel * 4, rgba + pixel * 4, 4);
+			else
+				memset(frame + pixel * 4, 0, 4);
+		}
+		frames[zone] = (AeronRuntimeAtlasFrame) { frame, bitmap.width, bitmap.height, (int32_t)zone, 0, 0 };
+		ok = Aeron_ImageBuildCoverageRgba8(frame, bitmap.width, bitmap.height, &set->base_coverage[zone]);
+	}
+	set->base_zones_width = (uint16_t)bitmap.width;
+	set->base_zones_height = (uint16_t)bitmap.height;
+	ok = ok && Aeron_RuntimeAtlasBuild(&set->base, cmd, frames, XVT_HUD_ZONE_COUNT, &options);
+	free(zoned);
+	free(owner);
 	free(rgba);
 	AeronIndexedFrame_Free(&bitmap);
 	return ok;
@@ -387,8 +504,12 @@ int XvtHudAssets_PrepareResources(AeronCommandBuffer* cmd, const XvtCockpitResou
 			if (g_pending->views[owner] && g_pending->views[owner]->base_asset_id == set->base_asset_id)
 				break;
 		if (owner < view) {
-			set->base = g_pending->views[owner]->base;
-			set->base_coverage = g_pending->views[owner]->base_coverage;
+			const XvtHudAssetSet* shared = g_pending->views[owner];
