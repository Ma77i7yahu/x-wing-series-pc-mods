+typedef struct BaseElement {
+	int left, top, right, bottom;
+	unsigned index;
+	uint8_t zone;
+} BaseElement;
+
+static int CompareElementArea(const void* a, const void* b) {
+	const BaseElement *x = a, *y = b;
+	long long ax = (long long)(x->right - x->left + 1) * (x->bottom - x->top + 1);
+	long long ay = (long long)(y->right - y->left + 1) * (y->bottom - y->top + 1);
+	return ax < ay ? 1 : ax > ay ? -1 : 0;
+}
+
+/* Label 8-connected opaque elements, then give each a zone: elements whose
+ * center lies inside a larger element's box inherit its zone (radar blips,
+ * text inside frames), the rest are placed by which third holds their center.
+ * owner receives each pixel's zone + 1 and regions each element box's zone + 1. */
+static int AssignBaseZones(const uint8_t* rgba, int width, int height, uint8_t* owner, uint8_t* regions) {
+	size_t pixels = (size_t)width * height;
+	int32_t* labels = calloc(pixels, sizeof *labels);
+	int32_t* stack = malloc(pixels * sizeof *stack);
+	unsigned capacity = 256, count = 0;
+	BaseElement* elements = malloc(capacity * sizeof *elements);
+	int ok = labels && stack && elements;
+	for (size_t start = 0; ok && start < pixels; ++start) {
+		if (!rgba[start * 4 + 3] || labels[start])
+			continue;
+		if (count == capacity) {
+			BaseElement* grown = realloc(elements, (capacity *= 2) * sizeof *elements);
+			if (!grown) {
+				ok = 0;
+				break;
+			}
+			elements = grown;
+		}
+		BaseElement* element = &elements[count++];
+		*element = (BaseElement) { width, height, -1, -1, 0, 0 };
+		size_t top = 0;
+		stack[top++] = (int32_t)start;
+		labels[start] = (int32_t)count;
+		while (top) {
+			int32_t pixel = stack[--top];
+			int x = pixel % width, y = pixel / width;
+			element->left = x < element->left ? x : element->left;
+			element->right = x > element->right ? x : element->right;
+			element->top = y < element->top ? y : element->top;
+			element->bottom = y > element->bottom ? y : element->bottom;
+			for (int dy = -1; dy <= 1; ++dy)
+				for (int dx = -1; dx <= 1; ++dx) {
+					int nx = x + dx, ny = y + dy;
+					if (nx < 0 || ny < 0 || nx >= width || ny >= height)
+						continue;
+					size_t next = (size_t)ny * width + nx;
+					if (rgba[next * 4 + 3] && !labels[next]) {
+						labels[next] = (int32_t)count;
+						stack[top++] = (int32_t)next;
+					}
+				}
+		}
+	}
+	if (ok) {
+		unsigned* order = malloc(count * sizeof *order);
+		BaseElement* sorted = malloc(count * sizeof *sorted);
+		ok = (order && sorted) || !count;
+		if (ok && count) {
+			memcpy(sorted, elements, count * sizeof *sorted);
+			for (unsigned index = 0; index < count; ++index)
+				sorted[index].index = index;
+			qsort(sorted, count, sizeof *sorted, CompareElementArea);
+			for (unsigned index = 0; index < count; ++index)
+				order[index] = sorted[index].index;
+			for (unsigned index = 0; index < count; ++index) {
+				BaseElement* element = &elements[order[index]];
+				int cx = (element->left + element->right) / 2, cy = (element->top + element->bottom) / 2;
+				uint8_t zone = regions[(size_t)cy * width + cx];
+				if (!zone)
+					zone = (uint8_t)(cx * 3 < width ? 1 : cx * 3 < width * 2 ? 2 : 3);
+				element->zone = zone;
+				for (int y = element->top; y <= element->bottom; ++y)
+					for (int x = element->left; x <= element->right; ++x)
+						if (!regions[(size_t)y * width + x])
+							regions[(size_t)y * width + x] = zone;
+			}
+			for (size_t pixel = 0; pixel < pixels; ++pixel)
+				owner[pixel] = labels[pixel] ? elements[labels[pixel] - 1].zone : 0;
+		} else if (ok)
+			memset(owner, 0, pixels);
+		free(order);
+		free(sorted);
+	}
+	free(labels);
+	free(stack);
+	free(elements);
+	return ok;
+}
