+enum {
+	PANEL_TOP = 3,
+	PANEL_HEIGHT = 13,
+	PANEL_LEFT = 226, /* 640-wide source units; scaled for other layouts */
+	PANEL_WIDTH = 188,
+	PANEL_BOX = 44,
+	PANEL_GAP = 4,
+	PANEL_SEGMENT = 4
+};
+
+static int PanelText(const XvtHudDraw* draw, XvtSnapRect box, const char* text) {
+	XvtCockpitTextField field = { 0 };
+	field.caption.visible = 1;
+	field.caption.font_tier = 2;
+	field.caption.foreground = 0x4E;
+	field.caption.background = 0;
+	field.caption.alignment = XVT_COCKPIT_ALIGN_CENTER;
+	field.caption.phase = XVT_COCKPIT_AFTER_CRT;
+	snprintf(field.caption.text, sizeof field.caption.text, "%s", text);
+	field.bounds = (XvtSnapRect) { box.x + 1, box.y + 2, box.width - 2, box.height - 3 };
+	field.x = (int16_t)field.bounds.x;
+	field.y = (int16_t)field.bounds.y;
+	/* Draw glyphs only; the box outline is the background. */
+	field.keyed = 1;
+	field.color_key_argb = draw->state->palette_argb[0];
+	return XvtHudText_DrawField(draw, &field);
+}
+
+int XvtHudInstruments_DrawPanel(const XvtHudDraw* draw) {
+	const XvtCockpitPanelReadouts* panel = &draw->state->weapons.panel;
+	if (!panel->visible)
+		return 1;
+	/* Laid out in 640-wide units and scaled to the layout's source width. */
+	float unit = draw->layout->source_width / 640.0f;
+#define U(value) ((int)((value) * unit + .5f))
+	const uint32_t frame = 0xFFB01010, dim = 0xFF183018;
+	const uint32_t bands[3] = { dim, 0xFF30D040, 0xFFE0F070 };
+	int top = U(PANEL_TOP), height = U(PANEL_HEIGHT);
+	int left = (draw->layout->source_width - U(PANEL_WIDTH)) / 2;
+	XvtSnapRect counter = { left, top, U(PANEL_BOX), height };
+	XvtSnapRect clock = { left + U(PANEL_WIDTH) - U(PANEL_BOX), top, U(PANEL_BOX), height };
+	XvtSnapRect lasers = { counter.x + counter.width + U(PANEL_GAP), top,
+						   clock.x - U(PANEL_GAP) - (counter.x + counter.width + U(PANEL_GAP)), height };
+	char text[16];
+	if (panel->countermeasures_visible) {
+		XvtHudDraw_Frame(draw, XVT_COCKPIT_AFTER_CRT, counter, panel->chaff_active ? 0xFFFFFFFF : frame);
+		snprintf(text, sizeof text, "CM %u", panel->countermeasures);
+		if (!PanelText(draw, counter, text))
+			return 0;
+	}
+	XvtHudDraw_Frame(draw, XVT_COCKPIT_AFTER_CRT, clock, frame);
+	snprintf(text, sizeof text, "%u:%02u", panel->clock_minutes, panel->clock_seconds);
+	if (!PanelText(draw, clock, text))
+		return 0;
+	if (panel->lasers_visible && panel->slot_count) {
+		XvtHudDraw_Frame(draw, XVT_COCKPIT_AFTER_CRT, lasers, frame);
+		/* Left-bank slots fill the left column, right-bank slots the right. */
+		unsigned rows[2] = { 0, 0 };
+		for (unsigned slot = 0; slot < panel->slot_count; ++slot)
+			++rows[panel->bank[slot] ? 1 : 0];
+		int column_width = (lasers.width - U(6)) / 2, segment = column_width / 10;
+		if (segment < 2)
+			segment = 2;
+		unsigned row[2] = { 0, 0 };
+		for (unsigned slot = 0; slot < panel->slot_count; ++slot) {
+			unsigned side = panel->bank[slot] ? 1 : 0, count = rows[side] ? rows[side] : 1;
+			int pitch = (height - U(4)) / (int)count;
+			int bar = pitch > 2 ? pitch - 1 : 1;
+			int x = lasers.x + U(2) + (int)side * (column_width + U(2));
+			int y = top + U(2) + (int)row[side]++ * pitch;
+			for (int index = 0; index < 10; ++index)
+				XvtHudDraw_Fill(draw, XVT_COCKPIT_AFTER_CRT,
+								(XvtSnapRect) { x + index * segment, y, segment - 1, bar },
+								bands[index < panel->segments[slot] ? panel->band[slot] : 0]);
+		}
+	}
+#undef U
+	return 1;
+}
+
+int XvtHudInstruments_PanelBottom(const XvtHudDraw* draw) {
+	float unit = draw->layout->source_width / 640.0f;
+	return (int)((PANEL_TOP + PANEL_HEIGHT + 2) * unit + .5f);
+}
