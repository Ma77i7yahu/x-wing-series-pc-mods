diff --git a/src/xvt_remaster/hud_renderer.c b/src/xvt_remaster/hud_renderer.c
index 1962b2b..41e98fe 100644
--- a/src/xvt_remaster/hud_renderer.c
+++ b/src/xvt_remaster/hud_renderer.c
@@ -78,13 +78,22 @@ static HudPreparationKey MakePreparationKey(const XvtCockpitState* state, const
 
 /* Spread the HUD to the screen edges only where the world fills the whole
  * screen: the cockpit-off and full-screen views outside the map. */
-static float SpreadFor(const XvtCockpitState* state, const XvtRenderView* view, float margin) {
+static float SpreadFor(const XvtCockpitState* state, const XvtRenderView* view, const XvtHudDraw* draw) {
 	const XvtRenderSnapshot* snapshot = XvtRenderSnapshot_Current();
 	if (!view || !XvtRemasterConfig_Effective()->hud_widescreen || !snapshot || snapshot->camera.map_mode ||
 		state->view.mirrored ||
 		(state->view.hud_state != HUD_VIEW_HUD_ONLY && state->view.hud_state != HUD_VIEW_FULL_SCREEN))
 		return 0;
-	return margin > 0 ? margin : 0;
+	/* Keep an inset of 8 units (640-wide) so edge gauges and labels stay visible. */
+	float inset = 8.0f * draw->layout->source_width / 640.0f * draw->scale;
+	float spread = draw->offset_x - inset;
+	return spread > 0 ? spread : 0;
+}
+
+static int PanelEnabled(const XvtCockpitState* state, const XvtRenderView* view) {
+	const XvtRenderSnapshot* snapshot = XvtRenderSnapshot_Current();
+	return view && XvtRemasterConfig_Effective()->hud_widescreen && snapshot && !snapshot->camera.map_mode &&
+		   state->view.hud_state == HUD_VIEW_HUD_ONLY && state->weapons.panel.visible;
 }
 
