@@ -118,7 +127,12 @@ int XvtHudRenderer_Prepare(AeronCommandBuffer* cmd, const XvtCockpitState* state
 						.width = width,
 						.height = height };
 	XvtHudLayout_Fit(draw.layout, width, height, &draw.scale, &draw.offset_x, &draw.offset_y);
-	draw.spread = SpreadFor(state, view, draw.offset_x);
+	draw.spread = SpreadFor(state, view, &draw);
+	int panel = PanelEnabled(state, view);
+	if (panel) {
+		draw.message_top = XvtHudInstruments_PanelBottom(&draw);
+		draw.message_shift = draw.message_top;
+	}
 	int crt_visible = state->crt.valid && crt_color;
 	XvtHudDraw display = XvtHudDraw_ForRect(&draw, state->crt.destination);
 	if (!XvtCrt_PrepareView(&state->crt, &state->definition.layout, crt_visible ? crt_color : NULL, width,
@@ -143,7 +157,8 @@ int XvtHudRenderer_Prepare(AeronCommandBuffer* cmd, const XvtCockpitState* state
 	if (crt_visible)
 		XvtHudInstruments_DrawCrtMarker(&draw);
 	XvtHudInstruments_DrawMouseStick(&draw, view);
-	if (!XvtHudPanes_DrawReadouts(&draw, XVT_COCKPIT_AFTER_CRT) || !XvtHudPanes_DrawMessages(&draw) ||
