+static void BuildPanelReadouts(XvtCockpitState* state, const CraftData* craft) {
+	XvtCockpitPanelReadouts* panel = &state->weapons.panel;
+	const ModelDef* model = &g_modelDefs[craft->modelIndex];
+	unsigned count = craft->laserSlotCount > XVT_HUD_WEAPON_SLOTS ? XVT_HUD_WEAPON_SLOTS : craft->laserSlotCount;
+	int cannons = (craft->workingSubsystems & CRAFT_SUBSYSTEM_FLAG_CANNONS) != 0;
+	panel->visible = 1;
+	panel->slot_count = (uint8_t)count;
+	panel->lasers_visible = (craft->damageStats.activeHudFeatureMask & XVT_COCKPIT_FEATURE_LASER_CHARGE) != 0;
+	/* Same charge banding as the forward cockpit's laser charge bars. */
+	for (unsigned index = 0; index < count; ++index) {
+		int charge = craft->weaponSlots[index].laserCharge;
+		panel->bank[index] = index > model->laserGroupLastSlot[0];
+		if (charge > 0 && cannons) {
+			++charge;
+			panel->band[index] = charge <= 64 ? 1 : 2;
+			if (charge > 64)
+				charge -= 64;
+			panel->segments[index] = (uint8_t)(charge / 6 > 10 ? 10 : charge / 6);
+		}
+	}
+	/* The forward layout positions the counter only on craft that carry them. */
+	panel->countermeasures_visible =
+		g_hudElementLayouts[HUD_COCKPIT_INSTRUMENT_BASE_INDEX + 48].x +
+			g_hudElementLayouts[HUD_COCKPIT_INSTRUMENT_BASE_INDEX + 48].y !=
+		0;
+	panel->countermeasures = craft->cmAmmoCount;
+	panel->chaff_active = (uint8_t)craft->chaffActiveTimer != 0;
+	int countdown =
+		g_flightMissionState.provingGroundsModeActive != 0 || g_flightMissionState.missionTimeLimitMinutes != 0;
+	panel->clock_minutes = (uint8_t)(countdown ? g_missionCountdownClock.minutes : g_missionElapsedClock.minutes);
+	panel->clock_seconds = (uint8_t)(countdown ? g_missionCountdownClock.seconds : g_missionElapsedClock.seconds);
+}
