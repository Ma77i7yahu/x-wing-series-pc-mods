+/* Widescreen placement: top panes move below the panel strip; mid-screen panes
+ * stack upward from just above the console, lowest original pane first. */
+static void PlaceMessages(const XvtHudDraw* draw, XvtSnapRect placements[XVT_COCKPIT_MESSAGE_COUNT]) {
+	int top[XVT_COCKPIT_MESSAGE_COUNT], bottom[XVT_COCKPIT_MESSAGE_COUNT], floating[XVT_COCKPIT_MESSAGE_COUNT];
+	for (unsigned pane = 0; pane < XVT_COCKPIT_MESSAGE_COUNT; ++pane) {
+		const XvtCockpitMessage* message = &draw->state->messages.panes[pane];
+		placements[pane] = message->placement;
+		floating[pane] = 0;
+		if (message->placement.y < draw->message_top) {
+			placements[pane].y += draw->message_shift;
+			continue;
+		}
+		if (!draw->message_floor || !message->visible || message->placement.y * 3 <= draw->layout->source_height ||
+			message->placement.y >= draw->message_floor ||
+			message->first_glyph + message->glyph_count > draw->state->overlay_content.glyph_count)
+			continue;
+		top[pane] = INT_MAX;
+		bottom[pane] = 0;
+		for (unsigned index = 0; index < message->glyph_count; ++index) {
+			const XvtCockpitGlyph* glyph = &draw->state->overlay_content.glyphs[message->first_glyph + index];
+			if (glyph->y < top[pane])
+				top[pane] = glyph->y;
+			if (glyph->y + glyph->height > bottom[pane])
+				bottom[pane] = glyph->y + glyph->height;
+		}
+		floating[pane] = bottom[pane] > 0;
+	}
+	int floor = draw->message_floor - 2;
+	for (;;) {
+		int next = -1;
+		for (unsigned pane = 0; pane < XVT_COCKPIT_MESSAGE_COUNT; ++pane)
+			if (floating[pane] &&
+				(next < 0 || draw->state->messages.panes[pane].placement.y >
+								 draw->state->messages.panes[next].placement.y))
+				next = (int)pane;
+		if (next < 0)
+			break;
+		floating[next] = 0;
+		placements[next].y = floor - bottom[next];
+		floor = placements[next].y + top[next] - 2;
+	}
+}
